# ---- review-display highlighters -------------------------------------------
#
# color_diff and highlight_json began as ports of the orientation renderers
# in the hardening repo's nix/claude-shim.bash. Neither has a counterpart
# there any more (the shim's preview became a drift index, then dropped its
# content peek altogether on 2026-09-02: a preview gets read once and the
# authoritative copy skimmed), so these are the authoritative ones, and the
# bash and markdown highlighters below were born here. Two deliberate
# deviations from the originals, both about byte fidelity in a display that
# a trust decision is made from:
#   * stdin instead of a file argument, so the `show` verb can color the
#     ONE buffer it read rather than taking a second look at the file;
#   * LC_ALL=C, so awk indexes bytes and an invalid multibyte sequence
#     survives the round trip unchanged.
# They decorate; they never transform. Color off (not a tty, or NO_COLOR)
# means byte-identical passthrough.

# Colorized unified diff: the ONE renderer for every diff a human reads --
# git's (sgit_diff renders with color.diff=never, and each display pipes the
# captured text through here) and the baseline file diff alike.
#
# Roles: a file header -- every line from `diff --git` or `---` up to the
# first hunk, git's own `Binary files ... differ` excepted -- wears the
# identity magenta: it answers what-am-I-looking-at one level below the gate
# line, so the accent extends the subject role rather than diluting it. A
# hunk header is bold cyan, its label or function context included; removed
# lines red, added lines green, context and `\ No newline` plain. An added
# line's trailing whitespace gets a red background, the blank-at-eol mark
# git's own coloring drew (its space-before-tab and blank-at-eof marks are
# not reproduced).
#
# Lines are classified by the hunk header's own counts, not by prefix alone,
# so a removed line whose text starts with "--" is a removed line, never a
# header.
#
# Inside a line, the part that changed: a run of N removed lines followed
# directly by N added lines (a `\ No newline` between them does not break
# the run) is paired line by line, as Git's contrib diff-highlight pairs
# them. For each pair the common byte prefix and suffix are found, and the
# middle between them gets a dark background (256-color 52 under removed,
# 22 under added), the foreground staying red or green. A pair is marked
# only when what it shares, past their common leading indentation, holds a
# byte that is not whitespace: two unrelated lines at one indent share
# nothing worth pointing at, and marking them would paint each whole line a
# second time. Runs of unequal length are not paired at all. A boundary
# never splits a UTF-8 sequence: the prefix backs off, and the suffix
# shrinks, until the middle starts and ends on a character start (a byte
# outside 0x80-0xBF).
#
# The input is ESCAPED text (untrusted_page runs untrusted_escape first), so
# every hidden character arrives as an escape token; each wears reverse red
# inside whatever color its line or middle has, and no middle boundary cuts
# one in half.
#
# Decoration only: every byte of the input is printed once, in order, and
# the only bytes added are SGR sequences between them. Color off is cat.
color_diff() {
  if [ -z "$HL_ON" ] || ! command -v awk >/dev/null 2>&1; then
    cat; return
  fi
  LC_ALL=C awk -v R=$'\033[31m' -v G=$'\033[32m' \
      -v RH=$'\033[31;48;5;52m' -v GH=$'\033[32;48;5;22m' -v W=$'\033[41m' \
      -v C=$'\033[1;36m' -v M=$'\033[1;35m' -v O=$'\033[0m' \
      -v RV="$SGR_RV" -v RO="$SGR_OFF" "$AWK_UNTRUSTED"'
    # A UTF-8 continuation byte, 10xxxxxx: no boundary lands on one.
    function cont(s, i) { return substr(s, i, 1) ~ /^[\200-\277]$/ }
    # The count half of a hunk range, "-a,b" or "+c,d"; a bare "-a" is 1.
    function count(r,   q) { return (split(r, q, ",") > 1) ? q[2] + 0 : 1 }
    # Bytes i..j of s wearing c, its escapes in reverse red, or nothing when
    # the range is empty.
    function seg(s, i, j, c) { return (j < i) ? "" : c ex(substr(s, i, j - i + 1), c) O }
    # The changed middles of the pair a (removed) and b (added), whole lines
    # with their signs: sets MA..EA and MB..EB, or returns 0 when the pair
    # is not worth marking. Neither boundary splits an escape: the prefix
    # backs off to before one it would cut, the suffix shrinks to after it.
    function middles(a, b,   la, lb, p, s, k, ch) {
      la = length(a); lb = length(b)
      p = 1                                    # the sign byte; shared text starts at 2
      while (p < la && p < lb && substr(a, p + 1, 1) == substr(b, p + 1, 1)) p++
      while (p > 1 && (cont(a, p + 1) || cont(b, p + 1))) p--
      k = escover(a, p + 1); if (k > 0 && k <= p) p = k - 1
      k = escover(b, p + 1); if (k > 0 && k <= p) p = k - 1
      s = 0
      while (s < la - p && s < lb - p && substr(a, la - s, 1) == substr(b, lb - s, 1)) s++
      while (s > 0 && cont(a, la - s + 1)) s--
      do {
        ch = 0
        if (s > 0 && (k = escover(a, la - s + 1)) > 0 && k < la - s + 1) {
          s = la - (k + length(escat(a, k)) - 1); ch = 1
        }
        if (s > 0 && (k = escover(b, lb - s + 1)) > 0 && k < lb - s + 1) {
          s = lb - (k + length(escat(b, k)) - 1); ch = 1
        }
      } while (ch)
      MA = p + 1; EA = la - s; MB = p + 1; EB = lb - s
      if (EA < MA && EB < MB) return 0         # the same text: nothing changed inside
      k = 2
      while (k <= p && substr(a, k, 1) ~ /[ \t]/) k++
      return (substr(a, k, p - k + 1) substr(a, la - s + 1, s)) ~ /[^ \t\r]/
    }
    # One changed line: fg, the middle ms..me on hl, and for an added line
    # its trailing whitespace on W. An empty middle is ms = me + 1.
    function paint(s, fg, hl, ms, me, add,   n, t) {
      n = length(s); t = n + 1
      if (add) while (t > 2 && substr(s, t - 1, 1) ~ /[ \t\r]/) t--
      if (me < ms) { ms = t; me = t - 1 }
      return seg(s, 1, (ms < t ? ms : t) - 1, fg) seg(s, ms, (me < t ? me : t - 1), hl) \
        seg(s, me + 1, t - 1, fg) seg(s, t, n, W)
    }
    # Print the held run, pairing it when its two halves are the same length.
    function flush(   i, k) {
      for (i = 1; i <= nb; i++) { ms[i] = 1; me[i] = 0 }
      if (nm > 0 && nm == np)
        for (k = 1; k <= nm; k++)
          if (middles(buf[mi[k]], buf[pi[k]])) {
            ms[mi[k]] = MA; me[mi[k]] = EA; ms[pi[k]] = MB; me[pi[k]] = EB
          }
      for (i = 1; i <= nb; i++) {
        if (typ[i] == "-")      print paint(buf[i], R, RH, ms[i], me[i], 0)
        else if (typ[i] == "+") print paint(buf[i], G, GH, ms[i], me[i], 1)
        else                    print ex(buf[i], "")
      }
      nb = 0; nm = 0; np = 0
    }
    function hold(t) {
      buf[++nb] = $0; typ[nb] = t
      if (t == "-") mi[++nm] = nb
      if (t == "+") pi[++np] = nb
    }
    {
      c = substr($0, 1, 1)
      if (hunk) {
        took = 1
        if (c == "-" && (ro > 0 || !known))      { if (np > 0) flush(); hold("-"); ro-- }
        else if (c == "+" && (rn > 0 || !known)) { hold("+"); rn-- }
        else if (c == "\\")                      { hold("\\") }
        else if ((c == " " || $0 == "") && ((ro > 0 && rn > 0) || !known)) { flush(); print ex($0, ""); ro--; rn-- }
        else took = 0
        if (took && (!known || ro > 0 || rn > 0)) next
        flush(); hunk = 0
        if (took) next
      }
      if ($0 ~ /^@@ -/) {
        known = 0
        if (match($0, /^@@ -[0-9]+(,[0-9]+)? \+[0-9]+(,[0-9]+)? @@/)) {
          split(substr($0, 4, RLENGTH - 6), r, " ")
          ro = count(r[1]); rn = count(r[2]); known = 1
        }
        print C ex($0, C) O
        hunk = (!known || ro > 0 || rn > 0)
        next
      }
      if ($0 == "" || c == "\\" || $0 ~ /^Binary files /) { print ex($0, ""); next }
      print M ex($0, M) O
    }
    END { flush() }
  '
}

# Display-only shape line for a captured diff: hunk count and +/- line counts,
# so a trimmed-context view still states how many places changed. Read from the
# SAME buffer that is about to be shown, and structurally unable to change it --
# every changed line prints regardless of this count. The "---"/"+++" header
# lines are excluded; a removed line whose own text starts with "--" collides
# with that prefix and is undercounted (cosmetic; color_diff, which reads the
# hunk counts, colors such a line as the removed line it is).
diff_shape() {
  LC_ALL=C awk '
    /^@@/     { h++; next }
    /^\+\+\+/ { next }
    /^---/    { next }
    /^\+/     { a++; next }
    /^-/      { d++; next }
    END { printf "%d hunks, +%d/-%d lines\n", h+0, a+0, d+0 }'
}

# Structural key summary for the baseline diff -- WHICH keys changed, the one
# review aid a plain byte diff cannot render (permissions.allow vs
# permissions.deny, a hook added vs a hook rewritten: invisible in a unified
# diff whose context is just neighboring array entries). Ported from the
# drift index in the hardening repo's nix/claude-shim.bash (drift_keys):
# flatten both sides to sorted "path = value" leaves via jq's tostream, diff
# the flattenings, keep the KEY of every changed leaf. An array collapses to
# its own name (permissions.allow[] -> permissions.allow) so one added entry
# reads as one key with a count, not a cascade of leaves; a key changed on
# both sides carries both counts. Sorted-input side effect: a
# pure reordering shows no key here -- the byte diff below still shows it.
#
# A SUMMARY, NOT A PER-HUNK CLAIM: computed once from whole-document
# flattenings of the two frozen buffers and printed once above the diff,
# attached to no hunk -- so a hostile file that games diff's hunking cannot
# make this line misattribute one hunk's change to another. Like the hunk
# labels below it (see label_hunks, which reads the same parse this block's
# flattening comes from), it orients and does not decide: every changed line
# still prints, and the recorded digest comes from the frozen bytes, not from
# anything summarized here.
#
# rc 1 (no jq, either side not JSON, no temp file) means "no structural
# view": the ceremony prints no keys line and the byte diff stands alone.
# jq stays OPTIONAL here -- require_jq is a hard gate only where
# --ignore-json-key declares a tolerance.
flatten_json_paths() {
  jq -r 'tostream | select(length==2) |
         ((.[0] | map(if type=="number" then "[]" else tostring end) | join("."))
          | gsub("\\.\\[\\]"; "[]"))
         + " = " + (.[1] | tojson)' "$1" 2>/dev/null | sort
}
json_keys_changed() { # <old> <new> -> "<added>\t<removed>\t<key>" rows
  local old="$1" new="$2"
  command -v jq >/dev/null 2>&1 || return 1
  jq -e . "$old" >/dev/null 2>&1 || return 1
  jq -e . "$new" >/dev/null 2>&1 || return 1
  # No temp files: diff reads both flattenings through process substitution, so
  # there is nothing to create and nothing to clean up -- the function cannot leak
  # a temp file on any exit path, no matter how a caller invokes it. (An earlier
  # mktemp version was leak-free only because its sole caller sits on the LHS of
  # `||`, which suppresses errexit through the function so its trailing `rm` was
  # always reached; a future caller without that `||` would have leaked. Removing
  # the files removes the dependency on the caller's errexit context.) Both inputs
  # are validated JSON above, so a flatten cannot fail for content reasons; if one
  # somehow emitted nothing the summary would be incomplete, never wrong -- fail
  # safe to a missing key, never a false one.
  { diff -U0 -- <(flatten_json_paths "$old") <(flatten_json_paths "$new") || true; } | LC_ALL=C awk '
    /^(\+\+\+|---) / { next }
    /^@@/            { next }
    /^[+-]/ {
      mark = substr($0, 1, 1)
      key  = substr($0, 2)
      sub(/ = .*$/, "", key)
      sub(/\[\].*$/, "", key)
      if (key == "") key = "[]"
      if (!(key in seen)) { seen[key] = 1; order[++n] = key }
      if (mark == "+") add[key]++; else del[key]++
    }
    END {
      for (i = 1; i <= n; i++) {
        k = order[i]
        printf "%d\t%d\t%s\n", add[k] + 0, del[k] + 0, k
      }
    }'
}

# The keys block: json_keys_changed rows in, one aligned block out, or nothing
# for an empty row set. The same shape the shim's drift index draws before
# the sudo prompt (claude-shim.bash, "the drift index"), so the orientation
# and the authority never disagree on what a key row looks like:
#
#   keys:         3 keys ·  +3  -2      the totals, in the rows' own columns
#     extra                     -1      a key present on one side only
#     model                 +1  -1      a key changed on both sides
#     permissions.ask       +2          an array grew by two entries
#
# Two right-aligned count columns, sized to the widest +N and -N in the block
# (totals included); a zero side is blank, never "+0", and a blank deletion
# side prints nothing trailing. The sign is part of the token, right-aligned
# with it: "+10" over " +2", never a sign stranded from its digits. Padding
# goes OUTSIDE the color: a padded colored argument aligns to the wrong
# width. House palette: key names are identifiers (cyan); the counts wear
# the diff's own green/red; the label is dim.
#
# The rows arrive ESCAPED (a key name is the file's own text), so the tab
# between fields is spelled `\u{9}` and is split on as such; a key name
# holding a tab of its own escapes the same way, makes a fourth field and is
# dropped, exactly as a raw one was (a missing key, never a false one). Each
# name's escapes wear reverse red inside the cyan.
render_keys_block() {
  LC_ALL=C awk -v cyn="$C_CYN" -v grn="$C_GRN" -v red="$C_RED" -v dim="$C_DIM" -v off="$C_OFF" \
      -v RV="$C_RV" -v RO="$SGR_OFF" "$AWK_UNTRUSTED"'
    function pad(w) { return (w > 0 ? sprintf("%" w "s", "") : "") }
    function cols(a, d,   s) {
      s = ""
      if (aw > 0) s = (a > 0 ? pad(aw - length(a) - 1) grn "+" a off : pad(aw))
      if (d > 0)  s = s (aw > 0 ? "  " : "") pad(dw - length(d) - 1) red "-" d off
      return s
    }
    BEGIN { T = "\\u{9}" }
    {
      if ((k1 = index($0, T)) == 0) next
      r = substr($0, k1 + length(T))
      if ((k2 = index(r, T)) == 0) next
      k = substr(r, k2 + length(T))
      if (k == "" || index(k, T) > 0) next
      n++; add[n] = substr($0, 1, k1 - 1) + 0; del[n] = substr(r, 1, k2 - 1) + 0; key[n] = k
      ta += add[n]; td += del[n]
      if (length(key[n]) > kw) kw = length(key[n])
    }
    END {
      if (n == 0) exit
      if (ta > 0) aw = length(ta) + 1
      if (td > 0) dw = length(td) + 1
      label = (n == 1 ? "1 key" : n " keys") " \302\267"
      ll = length(label) - 1              # the middle dot is two bytes under LC_ALL=C
      # "keys:" (5) + a gap of at least 3 + the label + one space lands on the
      # count column, which the rows put at 2 + kw + 3.
      if (kw < ll + 4) kw = ll + 4
      gap = 2 + kw + 3 - 5 - ll - 1
      printf "%skeys:%s%s%s%s%s %s\n", dim, off, pad(gap), dim, label, off, cols(ta, td)
      for (i = 1; i <= n; i++)
        printf "  %s%s%s%s   %s\n", cyn, ex(key[i], cyn), off, pad(kw - length(key[i])), cols(add[i], del[i])
    }'
}

# Hunk labels for that diff, from the PARSE rather than from the indentation.
# Every "@@ -a,b +c,d @@" header carries the key path of the lines that hunk
# CHANGES, so a reader never has to join the keys block to a hunk by eye.
#
# WHERE THE PATH COMES FROM: jq's stream parser, over the same frozen bytes
# the digest covers. `jq --stream` reports input_line_number with every event,
# so each row pairs a line of the file with the path the parser was inside
# when it finished that value. The path is the PARSER's -- indentation, line
# breaks and spacing cannot move it. That closes the spoof the previous label
# had: it was diff's own -F '^  "', the nearest two-space-indented key, and
# valid JSON may indent a NESTED key at two spaces and thereby plant a
# top-level section name on a change nowhere near the top level.
#
# WHICH LINES ARE CONSULTED: the hunk's CHANGED lines only -- the new-side
# numbers of its "+" lines, or, for a hunk that only deletes, the old-side
# numbers of its "-" lines. Context lines are unchanged by definition and at
# -U1 they are the changed line's siblings, so reading them would pull every
# single-line change up to its parent.
#
# Each changed line is widened by ONE LINE FORWARD, and only forward.
# input_line_number counts newlines consumed, so an event lands on the line
# its value ends on or one line later (measured: the last value in a container
# is reported on the line of the closing bracket). It never lands EARLIER, so
# widening backward could only pull in the PRECEDING sibling and blunt the
# label.
#
# WHAT THE LABEL IS: the longest common prefix of those paths, spelled the way
# the keys block above the diff spells its rows (flatten_json_paths plus
# json_keys_changed) -- dotted components, an array folded to its own name
# (sandbox.filesystem.allowRead, never [1]). Every label is therefore findable
# as a row in the block above it. A hunk spanning siblings labels as their
# parent, which is the truth, and duplicate keys label truthfully, since the
# stream emits each occurrence at its own line.
#
# FAIL-SAFE, ALWAYS TO A PLAIN HEADER: no jq, a side that does not parse
# (non-JSON content, or JSON that is malformed now), or no parser row beside a
# hunk's changed lines leaves that "@@" line exactly as diff wrote it. No
# option is passed to diff any more either, so no diff can answer "unknown
# option" into an empty review.
#
# STILL NOT AUTHORITY ON ITS OWN: a label says WHERE a change sits, never WHAT
# changed. Every changed line prints regardless, and the recorded digest comes
# from the frozen bytes, not from any header. The only readers here are
# pinned's own jq and awk over the frozen copies; git's textconv/ext-diff
# drivers, which DO run repo-controlled code, stay banned in this display.
json_line_paths() { # <file> <tag> -> "<tag>\t<line>\t<component>..." rows
  # Control characters are neutralised so one parser event stays one
  # tab-separated line: a JSON key may DECODE to a string holding a tab or a
  # newline, and a label is display, not data.
  jq -j --stream --arg t "$2" '
    [input_line_number, .[0]]
    | $t + "\t" + (.[0] | tostring)
      + (.[1] | map("\t" + (if type == "number" then "[]"
                            else (tostring | gsub("[[:cntrl:]]"; "?")) end))
              | join(""))
      + "\n"' "$1" 2>/dev/null
}
label_hunks() { # <old-frozen> <new-frozen> -- unified diff on stdin, labeled out
  local old="$1" new="$2" otab="" ntab="" ok=1
  command -v jq >/dev/null 2>&1 || ok=0
  if [ "$ok" -eq 1 ]; then
    # jq's exit status IS the parse verdict: a file that stops being JSON
    # halfway would otherwise hand us a table covering only its first half.
    otab="$(json_line_paths "$old" O)" || ok=0
    ntab="$(json_line_paths "$new" N)" || ok=0
  fi
  if [ "$ok" -eq 0 ]; then cat; return 0; fi
  # Both tables, then a marker, then the diff, down ONE stream: no temp file
  # to leak on any exit path (the rule json_keys_changed follows), and no
  # table smuggled through awk's -v, whose escape processing would eat a
  # backslash in a key name. "D" cannot collide with a table row -- every row
  # opens with a tag and a tab.
  { printf '%s\n' "$otab" "$ntab" D; cat; } | LC_ALL=C awk '
    function clear_want(   k) { for (k in want) delete want[k] }
    function mark(side, l) { want[side SUBSEP l] = 1; want[side SUBSEP (l + 1)] = 1 }
    function joined(m,   j, s) {
      s = ""
      for (j = 1; j <= m; j++) {
        if (lcp[j] == "[]") return s   # the keys block folds an array to its name
        s = (s == "" ? lcp[j] : s "." lcp[j])
      }
      return s
    }
    function label(side,   i, j, m, seen) {
      seen = 0; m = 0
      for (i = 1; i <= nrow[side]; i++) {
        if (!((side SUBSEP rl[side, i]) in want)) continue
        if (!seen) {
          m = rn[side, i]
          for (j = 1; j <= m; j++) lcp[j] = rc[side, i, j]
          seen = 1
        } else {
          if (rn[side, i] < m) m = rn[side, i]
          for (j = 1; j <= m; j++)
            if (rc[side, i, j] != lcp[j]) { m = j - 1; break }
        }
        if (m == 0) break              # nothing in common: no label to print
      }
      return (seen ? joined(m) : "")
    }
    function flush(   i, lab) {
      if (hdr == "") return
      lab = label(nadd > 0 ? "N" : "O")
      print (lab == "" ? hdr : hdr " " lab)
      for (i = 1; i <= nbuf; i++) print buf[i]
      hdr = ""; nbuf = 0; nadd = 0
      clear_want()
    }
    mode == 0 {                        # the two tables, tag-first
      if ($0 == "D") { mode = 1; next }
      k = split($0, f, "\t")
      if (k < 2) next
      s = f[1]; i = ++nrow[s]
      rl[s, i] = f[2] + 0
      rn[s, i] = k - 2
      for (j = 3; j <= k; j++) rc[s, i, j - 2] = f[j]
      next
    }
    /^@@ -[0-9]/ {                     # a header: label the one before it first
      flush()
      hdr = $0
      o = $2; sub(/^-/, "", o); split(o, oa, ","); ol = oa[1] + 0
      n = $3; sub(/^\+/, "", n); split(n, na, ","); nl = na[1] + 0
      next
    }
    hdr == "" { print; next }          # the ---/+++ pair, above the first hunk
    {                                  # a hunk body line, held until its header
      buf[++nbuf] = $0                 # is labeled
      c = substr($0, 1, 1)
      if (c == "+")       { mark("N", nl); nadd++; nl++ }
      else if (c == "-")  { mark("O", ol); ol++ }
      else if (c == "\\") { }          # "\ No newline at end of file"
      else                { nl++; ol++ }
    }
    END { flush() }
  '
}

# Byte-preserving JSON syntax highlighter. It inserts ANSI ONLY between the
# content's original characters -- it never reindents, reorders, or reparses
# -- so what is displayed is EXACTLY what is hashed. (A trust prompt must not
# pretty-print: jq -C would collapse duplicate keys, drop trailing junk, and
# normalize escapes, hiding exactly the tricks a hostile settings file might
# use.) Coloring is best-effort per line -- a malformed token only
# mis-colors; the text stays byte-exact. Strings are assumed single-line
# (true for JSON, which escapes newlines as \n), so it scans line-by-line.
highlight_json() {
  if [ -z "$HL_ON" ] || ! command -v awk >/dev/null 2>&1; then
    cat; return
  fi
  LC_ALL=C awk -v K=$'\033[1;36m' -v S=$'\033[0;32m' -v N=$'\033[0;33m' \
      -v L=$'\033[1;35m' -v P=$'\033[2m' -v O=$'\033[0m' \
      -v RV="$SGR_RV" -v RO="$SGR_OFF" "$AWK_UNTRUSTED"'
    {
      line = $0; n = length(line); i = 1; out = ""
      while (i <= n) {
        c = substr(line, i, 1)
        if (c == "\\" && (e = escat(line, i)) != "") {   # an escape, between tokens
          out = out hx(e, ""); i += length(e)
        }
        else if (c == "\"") {                             # string -> key if a : follows
          s = c; i++
          while (i <= n) {
            d = substr(line, i, 1); s = s d; i++
            if (d == "\\") { s = s substr(line, i, 1); i++; continue }
            if (d == "\"") break
          }
          j = i
          while (j <= n && substr(line, j, 1) ~ /[ \t]/) j++
          if (substr(line, j, 1) == ":") out = out K ex(s, K) O; else out = out S ex(s, S) O
        }
        else if (c ~ /[-0-9]/) {                          # number
          t = c; i++
          while (i <= n && substr(line, i, 1) ~ /[-+0-9.eE]/) { t = t substr(line, i, 1); i++ }
          out = out N t O
        }
        else if (substr(line, i, 4) == "true" || substr(line, i, 4) == "null") { out = out L substr(line, i, 4) O; i += 4 }
        else if (substr(line, i, 5) == "false") { out = out L "false" O; i += 5 }
        else if (c ~ /[][{}:,]/) { out = out P c O; i++ } # punctuation
        else { out = out c; i++ }                         # whitespace / other
      }
      print out
    }
  '
}

# Byte-preserving highlighter for a hook script. Same contract as
# highlight_json: SGR codes only BETWEEN the original bytes, every colored
# token ASCII, so no escape ever lands inside a multibyte sequence. Per line,
# best effort: comments dim, single- and double-quoted strings green with
# the expansions inside them cyan, bare expansions cyan, shell keywords bold
# magenta, the shebang dim. A heredoc body or a string that spans lines only
# mis-colors; the text stays byte-exact.
highlight_bash() {
  if [ -z "$HL_ON" ] || ! command -v awk >/dev/null 2>&1; then
    cat; return
  fi
  LC_ALL=C awk -v K=$'\033[1;36m' -v S=$'\033[0;32m' -v L=$'\033[1;35m' \
      -v P=$'\033[2m' -v O=$'\033[0m' -v Q="'" \
      -v RV="$SGR_RV" -v RO="$SGR_OFF" "$AWK_UNTRUSTED"'
    BEGIN {
      nk = split("if then elif else fi for while until do done case esac in function select local return exit export readonly declare set shift trap break continue", kw, " ")
      for (k = 1; k <= nk; k++) KW[kw[k]] = 1
    }
    # The expansion token starting at i (a "$"), or "" when the $ is bare.
    function varat(line, i, n,   c, j) {
      c = substr(line, i + 1, 1)
      if (c == "{") {
        j = index(substr(line, i), "}")
        return (j == 0) ? "" : substr(line, i, j)
      }
      if (c ~ /[A-Za-z_]/) {
        j = i + 1
        while (j <= n && substr(line, j, 1) ~ /[A-Za-z0-9_]/) j++
        return substr(line, i, j - i)
      }
      if (c ~ /[0-9@*#?!$-]/) return substr(line, i, 2)
      return ""
    }
    {
      line = $0; n = length(line); i = 1; out = ""
      if (NR == 1 && substr(line, 1, 2) == "#!") { print P ex(line, P) O; next }
      while (i <= n) {
        c = substr(line, i, 1)
        prev = (i > 1) ? substr(line, i - 1, 1) : ""
        if (c == "\\" && (e = escat(line, i)) != "") {              # an escape
          out = out hx(e, ""); i += length(e)
        }
        else if (c == "#" && (i == 1 || prev ~ /[ \t;(|&]/)) {      # comment
          out = out P ex(substr(line, i), P) O; break
        }
        else if (c == Q) {                                          # single-quoted
          j = index(substr(line, i + 1), Q)
          if (j == 0) { out = out S ex(substr(line, i), S) O; break }
          out = out S ex(substr(line, i, j + 1), S) O; i += j + 1
        }
        else if (c == "\"") {                                       # double-quoted
          out = out S c; i++
          while (i <= n) {
            d = substr(line, i, 1)
            if (d == "\\" && (e = escat(line, i)) != "") { out = out hx(e, S); i += length(e); continue }
            if (d == "\\") { out = out d substr(line, i + 1, 1); i += 2; continue }
            if (d == "\"") { out = out d; i++; break }
            if (d == "$" && (t = varat(line, i, n)) != "") { out = out K ex(t, K) O S; i += length(t); continue }
            out = out d; i++
          }
          out = out O
        }
        else if (c == "$" && (t = varat(line, i, n)) != "") {       # expansion
          out = out K ex(t, K) O; i += length(t)
        }
        else if (c ~ /[A-Za-z_]/ && prev !~ /[A-Za-z0-9_$\/.-]/) {  # a word
          j = i
          while (j <= n && substr(line, j, 1) ~ /[A-Za-z0-9_]/) j++
          w = substr(line, i, j - i)
          if ((w in KW) && substr(line, j, 1) !~ /[=\/.-]/) out = out L w O
          else out = out w
          i = j
        }
        else { out = out c; i++ }
      }
      print out
    }
  '
}

# Byte-preserving highlighter for a markdown file (an output style). Same
# contract: headings cyan, fenced code blocks and `code` spans green, fence
# lines, rules, blockquote and list markers and table pipes dim, **bold**
# bold. Prose stays uncolored -- in particular no digit or comma coloring,
# which is what routing prose through the JSON highlighter would have done.
highlight_md() {
  if [ -z "$HL_ON" ] || ! command -v awk >/dev/null 2>&1; then
    cat; return
  fi
  LC_ALL=C awk -v K=$'\033[1;36m' -v S=$'\033[0;32m' -v B=$'\033[1m' \
      -v P=$'\033[2m' -v O=$'\033[0m' \
      -v RV="$SGR_RV" -v RO="$SGR_OFF" "$AWK_UNTRUSTED"'
    # Inline spans: `code`, **bold**, and table pipes. Everything else verbatim.
    function inline(s,   n, i, c, j, e, out) {
      n = length(s); i = 1; out = ""
      while (i <= n) {
        c = substr(s, i, 1)
        if (c == "\\" && (e = escat(s, i)) != "") { out = out hx(e, ""); i += length(e); continue }
        if (c == "`") {
          j = index(substr(s, i + 1), "`")
          if (j > 0) { out = out S ex(substr(s, i, j + 1), S) O; i += j + 1; continue }
        }
        else if (c == "*" && substr(s, i + 1, 1) == "*") {
          j = index(substr(s, i + 2), "**")
          if (j > 0) { out = out B ex(substr(s, i, j + 3), B) O; i += j + 3; continue }
        }
        else if (c == "|") { out = out P c O; i++; continue }
        out = out c; i++
      }
      return out
    }
    {
      line = $0
      if (line ~ /^[ \t]*(```|~~~)/) { fence = !fence; print P ex(line, P) O; next }
      if (fence) { print S ex(line, S) O; next }
      if (line ~ /^#+[ \t]/ || line ~ /^#+$/) { print K ex(line, K) O; next }
      if (line ~ /^[ \t]*(---|\*\*\*|___)[-*_ \t]*$/) { print P line O; next }
      pre = ""
      if (match(line, /^[ \t]*>[ \t]?/)) {
        pre = P substr(line, 1, RLENGTH) O; line = substr(line, RLENGTH + 1)
      }
      if (match(line, /^[ \t]*([-*+]|[0-9]+\.)[ \t]+/)) {
        pre = pre P substr(line, 1, RLENGTH) O; line = substr(line, RLENGTH + 1)
      }
      print pre inline(line)
    }
  '
}

# Which highlighter may decorate a path's content, by suffix. Empty for
# everything else (.claude-lane, a file with no suffix): shown raw. This is
# the whole of the routing -- a highlighter never inspects the content to
# decide it applies, so a hostile file cannot pick its own renderer.
highlighter_for() {
  case "$1" in
    *.json)          printf 'highlight_json' ;;
    *.bash|*.sh)     printf 'highlight_bash' ;;
    *.md|*.markdown) printf 'highlight_md' ;;
    *)               printf '' ;;
  esac
}

# May this content be routed through highlighter $1? Decoration only: a
# "no" shows the escaped text with only its escapes styled. A highlighter
# never sees the raw bytes -- untrusted_page hands it escaped text, which
# holds no NUL, no invalid sequence and always ends a line -- so the one
# guard left is about meaning: JSON must parse, so a malformed file is shown
# as it is rather than half-colored as if it were JSON. A tool absent from
# the trusted PATH means no color, never a guess.
# $1 = highlighter name ("" = none); stdin = the raw bytes (read for JSON).
highlight_ok() {
  [ -n "$HL_ON" ] || return 1
  [ -n "$1" ] || return 1
  command -v awk >/dev/null 2>&1 || return 1
  case "$1" in
    highlight_json)
      command -v jq >/dev/null 2>&1 || return 1
      jq -e . >/dev/null 2>&1 || return 1
      ;;
  esac
}

# Review diff. NEVER call `sgit diff` directly for anything a human reads:
# .gitattributes (attacker-writable, and it works UNTRACKED -- no commit, no
# trace in the reviewed content) can route a path through an external diff
# driver (diff.<n>.command) or a textconv filter (diff.<n>.textconv) defined in
# the repo-local .git/config, which is equally attacker-writable. env -i and
# GIT_CONFIG_{GLOBAL,SYSTEM}=/dev/null do NOT stop this -- the drivers come
# from repo-local config, not global/system config or the environment. A
# textconv that maps both sides to one constant renders as an EMPTY diff:
# "this commit changed nothing", for a commit that changed everything.
# --no-ext-diff --no-textconv is the only thing that closes it.
# Measured 2026-07-27 on git 2.54.0; harness + evidence in the hardening repo:
# proofs/claims/git/git-diff-display-falsifiable-by-repo-drivers.md
# The ONLY way to diff in this script. Always carries the hardening flags, so
# a future edit cannot reintroduce a falsifiable review by writing the obvious
# thing; `sgit diff` itself is refused below.
#
# Always plain text: color.diff=never, and a display pipes the captured
# output through color_diff, the one renderer every reviewed diff shares.
# Git's own coloring could mark the header block and whole lines, never the
# part of a line that changed, and decorating its colored output afterwards
# would mean parsing escape sequences out of a display a trust decision
# rests on.
sgit_diff() {
  _sgit_diff_ok=1 sgit -c color.diff=never diff --no-ext-diff --no-textconv "$@"
}

# The size of a two-rev diff in one phrase, "N files +A -D": the spelling
# the step summary's total, the no-shared-history gate and every repo diff's
# closing rule share. Binary files count as changed files and contribute
# nothing to +/- -- what git itself reports for them ("-" in both columns).
# Counted through sgit_diff, so the same hardened flags govern the number
# and the diff it describes; both read the same two immutable objects.
# $1 = from rev (or the empty tree), $2 = to rev.
diff_totals() {
  sgit_diff --numstat "$1" "$2" | LC_ALL=C awk '
    { n++; if ($1 != "-") ins += $1; if ($2 != "-") del += $2 }
    END { printf "%d file%s +%d -%d\n", n, (n == 1 ? "" : "s"), ins, del }'
}

# The closing rule a paged diff leaves behind. `less -RF` draws on the
# terminal's alternate screen and takes the content with it on quit, so
# without this the opening rule stands over nothing -- in scrollback it
# reads as an empty diff, directly above the question that approves it.
# The rule records that a body was shown and how large it was.
# $1 = what ended ("diff", "file"), $2 = its size, already spelled.
print_end_rule() {
  printf '%s--- end of %s: %s ---%s\n' "$C_B" "$1" "$2" "$C_OFF"
}

# ---- the file diff ---------------------------------------------------------
#
# ONE DISPLAY FOR A CHANGE FROM ONE FILE TO ANOTHER, shared by review --file
# (its diff against a verified baseline) and the diff verb, so the two can
# never drift apart: the same diff, labels, keys block, escaper, colorizer,
# gate and closing rule, in that order. Both callers hand it FROZEN copies
# (freeze_file), so everything below reads bytes no one can change between
# two looks.

# The diff and its parts, computed BEFORE any gate announces it, so a diff
# that cannot be made fails while nothing has been promised. Sets FD_DIFF
# (the unified diff, hunks labeled), FD_SHAPE ("+A -D", the gate's and the
# closing rule's spelling) and FD_KEYS (the keys block, or empty).
#
# -U1: unified context lines are UNCHANGED content by definition, and diff
# prints every changed line at any -U level, so trimming context shortens
# the read without ever hiding an edit. label_hunks then names each hunk
# with the key path its changed lines sit under, read out of the same two
# frozen buffers by jq's parser (see its comment); a side that does not
# parse simply keeps diff's plain "@@" headers. The labels name each side
# by role and path: the frozen copies are temp paths that name nothing.
#
# FAIL CLOSED: diff answers 0 (the same) or 1 (different), and anything
# else is trouble; so is a failing label_hunks (each status read from
# PIPESTATUS, under set +e, since 1 is an answer here). Either returns 1 with
# nothing shown, and the caller says what could not be compared. The keys
# block fails safe instead: an empty row set (non-JSON, malformed JSON, or
# no jq -- rc 1 from json_keys_changed) is NO block, never a wrong one. Its
# key names are the file's own text, so the rows go through the escaper
# before render_keys_block lays them out, and a failure of either stops
# the process (untrusted_fail). Called directly, never in a command
# substitution, so that exit ends the process and not a subshell.
file_diff_capture() { # <old-frozen> <new-frozen> <old-label> <new-label>
  local _fd_shape
  FD_DIFF="$(set +e
    diff -U1 --label "$3" --label "$4" "$1" "$2" | label_hunks "$1" "$2"
    _fd_st=("${PIPESTATUS[@]}")
    [ "${_fd_st[0]}" -le 1 ] && [ "${_fd_st[1]}" -eq 0 ])" || return 1
  _fd_shape="$(printf '%s\n' "$FD_DIFF" | diff_shape)"
  # The gate says the magnitude, so the shape's own "+A/-D lines" tail is
  # re-cut to the gate's spelling rather than counted a second time.
  FD_SHAPE="${_fd_shape#*, }"; FD_SHAPE="${FD_SHAPE% lines}"
  FD_SHAPE="${FD_SHAPE/\// }"
  FD_KEYS="$({ json_keys_changed "$1" "$2" || true; } \
    | untrusted_escape | render_keys_block)" || untrusted_fail
}

# The change: row, the magnitude colored the diff's own way -- additions
# green, deletions red -- matching the keys summary and the diff body
# below it. FD_SHAPE is always "+A -D" (diff_shape prints both counts,
# either may be 0), so the first word is the add count and the rest the
# delete count.
file_diff_change_row() {
  printf '%schange:%s     %s%s%s %s%s%s\n' "$C_B" "$C_OFF" \
    "$C_GRN" "${FD_SHAPE%% *}" "$C_OFF" "$C_RED" "${FD_SHAPE#* }" "$C_OFF"
}

# THE GATE BEFORE THE PAGER: nothing full-screen arrives unannounced, and
# what arrives is named with its size first (the change: row above it).
# Enter (or y) opens it; `n` declines without looking, and so does end of
# input. $1 is the decision clause, which names the object. Returns as
# gate_answer does; the caller owns the decline line.
file_diff_gate() { # <decision clause>
  local _fd_gate
  printf -v _fd_gate '%s%s;%s %sEnter%s open %s· %s%sn%s%s skip%s ' \
    "$C_B" "$1" "$C_OFF" "$C_BLU" "$C_OFF" \
    "$C_DIM" "$C_OFF" "$C_BLU" "$C_OFF" "$C_DIM" "$C_OFF"
  gate_answer "$_fd_gate"
}

# The body: the section rule ($1, the program's own words, no value), one
# keys block above the whole diff (see json_keys_changed: a per-hunk
# placement would let one hunk lie about another; absent entirely when
# there is no structural view), the diff through the escaper in diff mode
# and color_diff into the pager, then the closing rule with the size.
file_diff_show() { # <section rule text>
  printf '%s--- %s ---%s\n' "$C_B" "$1" "$C_OFF"
  [ -z "$FD_KEYS" ] || printf '%s\n' "$FD_KEYS"
  untrusted_page color_diff <<<"$FD_DIFF"
  print_end_rule diff "$FD_SHAPE"
}

sgit() {
  # Structural guard: any diff a human might read must carry --no-ext-diff
  # --no-textconv, so reaching for a rendering subcommand here is a bug, not a
  # style choice. Refuse loudly instead of silently rendering through an
  # attacker's driver. Git offers no config switch that disables textconv
  # globally, so per-command flags are the only mechanism -- which is exactly
  # why it needs a guard rather than a convention. (The subcommand is found by
  # scanning past leading global options, since `-c key=val` precedes it.)
  if [ "${_sgit_diff_ok:-0}" -ne 1 ]; then
    local _args _i=0 _sub="" _a
    _args=("$@")
    while [ "$_i" -lt "${#_args[@]}" ]; do   # find the subcommand
      case "${_args[$_i]}" in
        -c) _i=$((_i + 2)) ;;               # -c takes a value; skip both
        --*) _i=$((_i + 1)) ;;
        *) _sub="${_args[$_i]}"; break ;;
      esac
    done
    case "$_sub" in
      # Every subcommand that can RENDER a diff, not just `diff` -- `show` and
      # `log -p` route through the same attacker-controlled drivers. Refusing
      # the whole class means a future edit reaching for any of them has to
      # add a hardened helper rather than silently reopening the hole.
      diff|show|format-patch|diff-tree|diff-index|diff-files|whatchanged|range-diff)
        echo "pinned: internal error -- '$_sub' can render through repo diff drivers; use sgit_diff" >&2
        exit 1 ;;
      log|reflog|stash)
        # Scan only AFTER the subcommand: a leading global `-c key=val` is not
        # log's combined-diff `-c`.
        _i=$((_i + 1))
        while [ "$_i" -lt "${#_args[@]}" ]; do
          _a="${_args[$_i]}"; _i=$((_i + 1))
          case "$_a" in
            -p|-u|--patch|--cc|-c|--full-diff)
              echo "pinned: internal error -- patch-producing '$_sub' renders through repo diff drivers; use sgit_diff" >&2
              exit 1 ;;
          esac
        done ;;
    esac
  fi
  # safe.directory: running as root on a user-owned repo trips git's
  # ownership check, and env -i strips the SUDO_UID escape hatch git
  # would use. Trust exactly $repo, from the command line (protected
  # config). The check's job -- refusing attacker-planted repo config
  # and hooks -- is already done here by scrubbing and hookless commands.
  # attr.tree=<empty tree>: attributes come from an EMPTY tree instead of the
  # working tree, so no .gitattributes -- committed or untracked -- can select a
  # diff driver, textconv filter, or clean/smudge filter for ANY subcommand.
  # This is the only repo-wide switch that exists (there is no config that
  # disables textconv globally), so it is the primary defense; the per-command
  # --no-ext-diff --no-textconv in sgit_diff and the render guard above are the
  # second and third layers. Silently ignored by git older than ~2.40 -- which
  # is why the other two layers still carry their weight.
  # Three more channels the repo's owner writes and git reads by default:
  # refs/replace/<rev> makes every read of <rev> return another object (an
  # approved rev reads back as a crafted commit, and a review diffs against
  # the crafted base, so the change never shows); info/grafts rewrites a
  # commit's parent list (a crafted commit claims the pinned line as its
  # parent and passes the ancestry walk); the shallow file cuts parents off
  # (a true descendant reads as unrelated -- a false alarm, not a false
  # pass). All three are neutralised here, in the one environment every
  # subcommand shares. --no-replace-objects covers only the first, which is
  # why the env form is used. The two file switches name paths that do NOT
  # exist rather than /dev/null: git opens the graft file when it exists and
  # then prints its deprecation hint on every run, and an absent file is
  # simply no grafts. Verified live on git 2.54: each channel honored by
  # default, each inert under its switch.
  env -i PATH="$PATH" HOME=/var/empty \
    GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null \
    GIT_NO_REPLACE_OBJECTS=1 \
    GIT_GRAFT_FILE=/var/empty/no-grafts GIT_SHALLOW_FILE=/var/empty/no-shallow \
    git -C "$repo" --no-pager -c safe.directory="$repo" \
    -c attr.tree=4b825dc642cb6eb9a060e54bf8d69288fbee4904 \
    -c core.fsmonitor=false -c core.pager=cat "$@"
}

# FREE TEXT OUT OF A REPO IS NOT SAFE TO PRINT AS IT IS. A commit subject is
# content the attacker writes, and printf sends it to a terminal verbatim: an
# ESC[1A ESC[2K inside one erases the line above it, and a bidi control or a
# zero-width mark makes it read as something it does not say. So every
# subject, body, tag or path a review screen shows goes through the shared
# escaper (untrusted_escape, above), which shows each such character as an
# escape instead of either printing it or dropping it.
#
# Display only, and only for text that came from elsewhere. Nothing hashed,
# recorded, compared or passed to another program goes through it: the
# record must keep the bytes that were approved.
#
# print_repo_row is the `repo:` row every repo screen opens with: the full
# path, last on the row, its folder name in the subject color. Both parts
# are escaped -- a directory name is bytes anyone could have chosen.
print_repo_row() { # <label-SGR>
  local rd rn
  untrusted_var rd "${repo%/*}/" "$C_DIM"
  untrusted_var rn "${repo##*/}" "$C_B$C_MAG"
  printf '%srepo:%s       %s%s%s%s%s%s\n' "$1" "$C_OFF" "$C_DIM" "$rd" "$C_OFF" "$C_B$C_MAG" "$rn" "$C_OFF"
}
#
# A GATE OR A QUESTION HOLDS NO VALUE whose length this script does not
# choose: a repo's name would push the keys off the line and soft-wrap the
# decision, and the reader would have to find what is being decided inside
# the sentence that asks. So the question names its object with a noun that
# matches a row's label (`approve this candidate?` under `candidate:`,
# `review this range;` under `range:`), and every value it decides about
# stands on a labeled row above it. A question block reads top to bottom:
# the content and its closing rule, the program's advice, the rows, the
# alarm or verdict and any consequence line, the question.
#
# The rows repeat a value only when a listing, a diff or a pager stands
# between its first mention and the question -- what has scrolled away.
# Rows already on screen just above (the identity block of a first
# approval, say) are not printed again.
#
# print_candidate_rows: the `repo:` row and the commit the question approves.
# print_range_rows: the `repo:` row and the range a gate opens, with its
# size ($3, already spelled; it may color its own parts).
print_candidate_rows() { # <rev>
  print_repo_row "$C_DIM"
  printf '%scandidate:%s  %s%s%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$1" "$C_OFF"
}
print_range_rows() { # <from rev> <to rev> <size>
  print_repo_row "$C_DIM"
  printf '%srange:%s      %s%.10s..%.10s%s (%s)\n' "$C_DIM" "$C_OFF" "$C_CYN" "$1" "$2" "$C_OFF" "$3"
}
#
# subject_var is the one-row case: the subject of commit $2, escaped into the
# variable $1 for a row whose color at that point is $3. It ends its row (an
# unbounded value is last on a line). A failed read is an empty subject, or
# $4 when one is given, and then git's own error stays quiet.
subject_var() { # <var> <rev> [resume-SGR] [fallback]
  local _sv_s
  if [ $# -ge 4 ]; then
    _sv_s="$(sgit log -1 --format=%s "$2" 2>/dev/null)" || _sv_s="$4"
  else
    _sv_s="$(sgit log -1 --format=%s "$2")" || _sv_s=""
  fi
  untrusted_var "$1" "$_sv_s" "${3:-}"
}

# The "commits since last approval" listing, one line per commit, oldest
# first, closed by a rule that counts them:
#
#   <hash>  <n> file(s)  +<ins> -<del>  <subject>
#   --- end of listing: <n> commit(s) ---
#
# The aligned columns come first and the subject runs to the end of the
# line, so it is never truncated, never padded and never wrapped by this
# script: a subject longer than the terminal soft-wraps there, back to
# column 0. That is why the closing rule exists -- third-party text proves
# nothing by where it sits, so whatever the review concludes is printed
# below the rule, never beside a subject.
#
# SUBJECTS ONLY, unless the caller asks for the message bodies too. The
# body does not carry the decision: the diff below is the authoritative
# account of what the commits do, and the file and +/- counts are what
# catch a one-line "fix typo" that rewrites forty files. But a commit that
# explains itself only in its body is explained there or nowhere -- the
# diff carries no commit messages at all -- so `review --messages` prints
# the whole message:
#
#   <hash>  <n> file(s)  +<ins> -<del>  <subject>
#   <body line>
#   <body line>
#
#   <hash>  ...
#
# A body prints at COLUMN ZERO, escaped and otherwise verbatim: unwrapped,
# unindented, and without the caller's line prefix. It is a block its author
# laid out, often already formatted, and folding or indenting it would
# re-flow someone else's text. Trailers are body lines like any other and
# print with it. One blank line closes a body before the next commit's row,
# as `git log` does; a commit with no body gets no blank, and the last body
# in a listing gets none either.
#
# A BODY IS A DOCUMENT, A SUBJECT A FIELD (the escaper's doc and field
# layouts, applied after the parse). In a body a tab is layout and prints
# as itself. When a carriage return sits directly before every line feed of
# a body, that is the body's line-ending convention: each pair draws as one
# break, and a dim `CRLF line endings` line under the commit's row, in the
# subject's column, states it once, outside the text (a body line starts at
# column zero, so it cannot stand there). Any other carriage return stays
# escaped where it is. A subject is one line: a tab in it stays escaped,
# since it could push the text after it into another column.
#
# Counts pluralize ("1 file", "2 files") without breaking alignment: the
# count right-aligns in its own digit column and the noun left-aligns
# beside it, so the ones digits stack exactly like the signed +/- numbers
# and the plural "s" hangs into padding where nothing follows it. (A
# whole-token right-align would let a lone singular drag its digit out of
# the column.)
#
# Weight follows the decision: the subject is the text being approved and
# prints in the default weight, while the counts are orientation and stay
# dim.
#
# The counts come from sgit -- the same hardened path the reviewed diff
# takes, so attr.tree=<empty tree> holds here too and no repo-local
# textconv or diff driver can shrink a commit to "nothing changed" in this
# display either. `log --numstat` without -p renders no patch, which is why
# the sgit render guard passes it; --shortstat would mean parsing a
# sentence, so the machine-readable form is the one used.
#
# Binary files count as changed files and contribute nothing to +/-, which
# is exactly what git reports for them ("-" in both columns). A merge has
# no per-commit diff at all (git omits it unless asked), so its counts read
# "-" rather than a fabricated zero; the authoritative diff below covers
# the merged content regardless.
#
# Chronological, oldest first: the listing is read once, top to bottom, and
# ends at the rev the y/N is about -- the same direction the aggregate diff
# reads and --step walks. git's newest-first default serves open-ended
# paging, not a bounded range read in full.
#
# $1 = old rev, $2 = new rev, $3 = line prefix (default none), $4 =
# "messages" to print the bodies (anything else, or absent: subjects only).
print_commit_range() {
  local msg=0 nonce log_esc n
  [ "${4:-}" != messages ] || msg=1
  # DELIMITERS A COMMIT CANNOT FORGE. Message BODIES are multi-line text
  # whoever wrote the commit chose, and they travel this stream alongside
  # the numstat rows that become the file and +/- counts. A fixed sentinel
  # byte would let a body open a block of its own and fabricate a whole row
  # -- a hash, a subject and a file count belonging to no commit -- unpaged,
  # right above the y/N the ancestry alarm is read against. The sentinels
  # carry a nonce drawn per run instead, and a commit's bytes were fixed
  # before the nonce existed. (Inside a block the field separator is still a
  # bare byte: a body that plants one only moves the subject/body boundary,
  # and every byte still prints.)
  #
  # ESCAPED BEFORE IT IS PARSED. The whole stream goes through the escaper
  # first, so the parser below only ever holds escaped text and nothing it
  # prints can carry a raw control byte. The sentinels survive as their own
  # escapes (\u{1}, \u{2}, \u{3}, the numstat tab as \u{9}), and they
  # stay unforgeable: a raw sentinel byte in a message is escaped the same
  # way but cannot know the nonce, and the TEXT "\u{1}" in a message is
  # escaped to "\u{5C}u{1}", which no longer contains the sentinel's
  # spelling. A git failure is tolerated as before (an empty listing); an
  # escaper failure stops the ceremony.
  #
  # One parser, always: the bodies are collected whether or not they print,
  # so $4 decides what reaches the terminal and nothing about how the stream
  # is read. (`log -z` is NOT the answer here -- a NUL inside a message is
  # indistinguishable from git's own separator once both are in the stream.)
  nonce="$(LC_ALL=C od -An -N16 -tx1 /dev/urandom | LC_ALL=C tr -d ' \n')"
  case "$nonce" in
    [0-9a-f][0-9a-f]*) ;;
    *) echo "pinned: internal error -- no nonce for the commit listing" >&2; exit 1 ;;
  esac
  log_esc="$( { sgit log --reverse --numstat \
      --format="%x01${nonce}%x02%h%x02%s%x02%b%x01${nonce}%x03" "${1}..${2}" || true; } \
    | untrusted_escape && printf x)" || untrusted_fail
  printf '%s' "${log_esc%x}" | LC_ALL=C awk \
    -v pre="${3:-}" -v msg="$msg" -v nonce="$nonce" \
    -v cyn="$C_CYN" -v dim="$C_DIM" \
    -v grn="$C_GRN" -v red="$C_RED" -v off="$C_OFF" \
    -v RV="$C_RV" -v RO="$SGR_OFF" "$AWK_UNTRUSTED"'
    # One finished message block: hash, subject, and the body lines under
    # them. The field split is on the FIRST separator each time: a hash is
    # hex and a subject is one line by construction (git folds the whole
    # first paragraph into %s), so a separator planted in the message can
    # only move the subject/body boundary, never invent a field.
    function endmsg(   b, k, i, a, m) {
      n++
      b = buf
      k = index(b, sep); if (k == 0) k = length(b) + 1
      hsh[n] = substr(b, 1, k - 1); b = substr(b, k + length(sep))
      k = index(b, sep); if (k == 0) k = length(b) + 1
      sbj[n] = substr(b, 1, k - 1); b = substr(b, k + length(sep))
      sub(/\n+$/, "", b)                    # %b ends with a newline
      m = (b == "" ? 0 : split(b, a, "\n"))
      bn[n] = m
      for (i = 1; i <= m; i++) bdy[n, i] = a[i]
      nfl[n] = 0; ins[n] = 0; del[n] = 0; mrg[n] = 1
      # %h picks its own length per commit, so the hash gets a column too.
      if (length(hsh[n]) > hw) hw = length(hsh[n])
    }
    # A body line as a document: each tab escape back to the tab it was.
    # Token-aware, so the escaped TEXT of a tab escape (\u{5C}u{9}) stays
    # text: every backslash in escaped text begins an escape.
    function tabs(s,   out, k, t) {
      out = ""
      while ((k = index(s, "\\")) > 0) {
        t = escat(s, k)
        if (t == "") { out = out substr(s, 1, k); s = substr(s, k + 1); continue }
        out = out substr(s, 1, k - 1) (t == tab ? "\t" : t)
        s = substr(s, k + length(t))
      }
      return out s
    }
    BEGIN {
      sep = "\\u{2}"
      st  = "\\u{1}" nonce sep
      en  = "\\u{1}" nonce "\\u{3}"
      tab = "\\u{9}"
      cr  = "\\u{D}"
    }
    {
      line = $0
      if (!inmsg) {
        if (index(line, st) == 1) {         # a commit block opens here
          inmsg = 1; buf = ""; line = substr(line, length(st) + 1)
        } else {
          if (n > 0 && line ~ /^[0-9-]+\\u[{]9[}]/) {   # a numstat row of that commit
            mrg[n] = 0
            nfl[n]++
            k = index(line, tab); f1 = substr(line, 1, k - 1)
            r = substr(line, k + length(tab))
            k = index(r, tab); f2 = (k > 0 ? substr(r, 1, k - 1) : r)
            if (f1 != "-") ins[n] += f1
            if (f2 != "-") del[n] += f2
          }
          next
        }
      }
      p = index(line, en)
      if (p > 0) { buf = buf substr(line, 1, p - 1); inmsg = 0; endmsg(); next }
      buf = buf line "\n"
    }
    END {
      for (j = 1; j <= n; j++) {
        if (mrg[j]) continue
        nn[j] = (nfl[j] == 1 ? "file" : "files")
        if (length(nfl[j]) > nw) nw = length(nfl[j])
        if (length(nn[j]) > fw) fw = length(nn[j])
        if (length(ins[j]) > iw) iw = length(ins[j])
        if (length(del[j]) > dw) dw = length(del[j])
      }
      if (hw < 1) hw = 1
      if (nw < 1) nw = 1
      if (fw < 1) fw = 1
      if (iw < 1) iw = 1
      if (dw < 1) dw = 1
      # The subject column, where the dim detail line under a row starts.
      col = length(pre) + hw + 2 + nw + 1 + fw + 2 + iw + 1 + 1 + dw + 1 + 2
      for (j = 1; j <= n; j++) {
        out = pre cyn sprintf("%-" hw "s", hsh[j]) off "  "
        if (mrg[j])
          out = out dim sprintf("%" nw "s %-" fw "s", "-", "") "  " \
                sprintf("%" (iw + 1) "s", "-") " " sprintf("%" (dw + 1) "s", "-") off
        else
          # The sign is part of the token, right-aligned with it: "+103"
          # over "  +2", never a "+" stranded from its digits.
          out = out dim sprintf("%" nw "d %-" fw "s", nfl[j], nn[j]) off "  " \
                grn sprintf("%" (iw + 1) "s", "+" ins[j]) off " " \
                red sprintf("%" (dw + 1) "s", "-" del[j]) off
        # The subject whole, last on its row: nothing follows it.
        print out "  " ex(sbj[j], "")
        if (!msg) continue
        # CRLF: every line of the body ends in an escaped carriage return
        # (the body was split at its line feeds, so each line had one).
        crlf = (bn[j] > 0)
        for (i = 1; crlf && i <= bn[j]; i++) {
          k = length(bdy[j, i]) - length(cr) + 1
          if (k < 1 || substr(bdy[j, i], k) != cr) crlf = 0
        }
        if (crlf) printf "%" col "s%sCRLF line endings%s\n", "", dim, off
        # The body, at column zero and as its author laid it out -- blank
        # lines inside it included, tabs as layout. The blank after it
        # belongs to the NEXT row; the listing never ends on one.
        for (i = 1; i <= bn[j]; i++) {
          b = bdy[j, i]
          if (crlf) b = substr(b, 1, length(b) - length(cr))
          print ex(tabs(b), "")
        }
        if (bn[j] > 0 && j < n) print ""
      }
    }
  '
  n="$(sgit rev-list --count "${1}..${2}" 2>/dev/null || true)"
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  print_end_rule listing "$n commit$(plural_s "$n")"
}

# THE ANCESTRY LATTICE: how a candidate rev stands to the rev already
# pinned, decided over the COMMIT GRAPH and never by parsing a version
# string. Names are repo content and version sort is a convention; only
# reachability says whether trust is moving forward.
#
#   equal      old == new                  a no-op (the already-pinned path)
#   forward    old is an ancestor of new   the ordinary approval
#   backward   new is an ancestor of old   commits are being UN-approved
#   diverged   neither                     the pinned line is being abandoned
#
# merge-base --is-ancestor is plumbing: it answers by EXIT CODE and renders
# nothing, so no repo-local diff driver or textconv filter is in play. It
# still goes through sgit (env -i, no global/system config, safe.directory
# for the root-on-user-repo case) by giving $repo a local value -- one
# hardened git path, whether or not the caller sits in a resolved-repo
# context.
#
# A rev git cannot reach (a pin the checkout gc'd away, a rewritten history)
# makes both calls fail, which reads as "diverged": neither is provably an
# ancestor of the other, so the ceremony refuses unless the human declares
# it. Fail-closed is the only safe answer to "git cannot relate these".
#
# $1 = repo path, $2 = the pinned rev, $3 = the candidate rev.
ancestry_class() {
  local repo="$1" old="$2" new="$3"
  if [ "$old" = "$new" ]; then printf 'equal'; return 0; fi
  if sgit merge-base --is-ancestor "$old" "$new" 2>/dev/null; then
    printf 'forward'; return 0
  fi
  if sgit merge-base --is-ancestor "$new" "$old" 2>/dev/null; then
    printf 'backward'; return 0
  fi
  printf 'diverged'
}

# The declared non-forward alarm: the ceremony's loudest display, in the
# --trust banner's colors and full-caps `!!!` shape, because both say the
# same kind of thing -- trust is moving somewhere the ordinary reading does
# not cover. Ruled off to a fixed column, so the block reads as one object
# rather than three ragged sentences; every line is fixed-length text plus
# an abbreviated rev, so the width is deterministic.
# $1 = class, $2 = pinned rev, $3 = candidate rev, $4 = merge base (diverged
# only; empty when the two revs have no common ancestor in this checkout).
# The transition's `→` counts as one column, as Ghostty draws it: the line
# is padded in its ASCII form, where ` -> ` is one column wider than ` → `,
# so a line holding it pads to one more, then the stand-in becomes the
# arrow. The ruled-off column is right where `→` draws one column; where it
# draws two (East Asian widths), that line's `!!!` sits one column right,
# which cuts nothing.
_alarm_line() {
  local l w=54
  case "$1" in *" -> "*) w=55 ;; esac
  printf -v l '%-*s' "$w" "$1"
  printf '%s!!! %s !!!%s\n' "$C_RED$C_B" "${l/ -> / → }" "$C_OFF"
}
print_ancestry_alarm() {
  local l
  case "$1" in
    backward)
      l="$(printf 'BACKWARD: %.10s -> %.10s' "$2" "$3")"
      _alarm_line "$l"
      _alarm_line "The candidate is an ANCESTOR of the current pin: the"
      _alarm_line "commits between are being UN-approved."
      ;;
    diverged)
      l="$(printf 'DIVERGED: %.10s -> %.10s' "$2" "$3")"
      _alarm_line "$l"
      _alarm_line "The candidate is NOT on the pinned line of history:"
      if [ -n "${4:-}" ]; then
        _alarm_line "$(printf 'that line is being ABANDONED at ancestor %.10s' "$4")"
        _alarm_line "(history rewrite or side branch)."
      else
        _alarm_line "that line is being ABANDONED, and the two revs share"
        _alarm_line "no common ancestor in this checkout."
      fi
      ;;
  esac
}

# The lattice's gate. The flag DECLARES the relationship the human believes
# they are approving, and reality must CONFORM -- declared, never inferred:
# a tool that inferred "you probably meant to go backward" would be deciding
# the one thing the ceremony exists to make a human decide. So a missing
# declaration refuses, and a WRONG declaration refuses too, naming the class
# that actually holds.
# Prints its refusal on stderr and returns 1; returns 0 to proceed.
# $1 = actual class, $2 = declared class ('' = none), $3 = pinned rev,
# $4 = candidate rev, $5 = repo path (for the remediation line).
ancestry_gate() {
  local actual="$1" declared="$2" old="$3" new="$4" p="$5" phrase
  case "$actual" in
    equal|forward)
      [ -n "$declared" ] || return 0
      printf '%s✗ refused:%s nothing to override -- the candidate is a descendant of the pin\n' \
        "$C2_RED$C2_B" "$C2_OFF" >&2
      say_err "        pinned:      " "$old"
      say_err "        candidate:   " "$new"
      echo "        drop --$declared" >&2
      return 1 ;;
    backward) phrase="is backward of the pin" ;;
    *)        phrase="has diverged from the pin" ;;
  esac
  if [ -z "$declared" ]; then
    printf '%s✗ refused:%s the candidate %s\n' "$C2_RED$C2_B" "$C2_OFF" "$phrase" >&2
  elif [ "$declared" != "$actual" ]; then
    printf '%s✗ refused:%s --%s declared, but the candidate %s\n' \
      "$C2_RED$C2_B" "$C2_OFF" "$declared" "$phrase" >&2
  else
    return 0
  fi
  say_err "        pinned:      " "$old"
  say_err "        candidate:   " "$new"
  if [ "$actual" = backward ]; then
    echo "        the commits between are being un-approved" >&2
  else
    echo "        the pinned line of history is being abandoned" >&2
  fi
  say_cmd "        declare it to proceed: pinned review --$actual " "$p"
  return 1
}

# One listing header in the two shapes this script uses: the root ceremony
# rules its sections off, the pre-sudo preview labels them.
# $1 = style (rule|label), $2 = the header text.
_ancestry_hdr() {
  if [ "$1" = label ]; then
    printf '%s%s:%s\n' "$C_B" "$2" "$C_OFF"
  else
    printf '%s--- %s ---%s\n' "$C_B" "$2" "$C_OFF"
  fi
}

# The commits a move covers. Every listing reads chronologically -- the
# headers, not the order, carry the move's direction. `<pin>..<candidate>`
# is EMPTY for a candidate that sits behind the pin, and a review that says
# nothing about what it is about to un-approve is worse than no review; a
# diverged move has two ranges and no single one of them is the story.
# $1 = class, $2 = pinned rev, $3 = candidate rev, $4 = merge base (may be
# empty), $5 = header style, $6 = line prefix, $7 = "messages" to print the
# commit message bodies (passed straight through to print_commit_range).
# Each listing closes with its own rule (print_commit_range prints it), so
# nothing the caller prints next can be mistaken for a row.
print_ancestry_listing() {
  local cls="$1" old="$2" new="$3" mb="$4" style="${5:-rule}" pre="${6:-}" msg="${7:-}"
  case "$cls" in
    backward)
      _ancestry_hdr "$style" "commits being un-approved"
      print_commit_range "$new" "$old" "$pre" "$msg" || true ;;
    diverged)
      if [ -z "$mb" ]; then
        _ancestry_hdr "$style" "no common ancestor in this checkout -- no range to list"
        return 0
      fi
      _ancestry_hdr "$style" "commits being un-approved (leaving the pinned line)"
      print_commit_range "$mb" "$old" "$pre" "$msg" || true
      echo
      _ancestry_hdr "$style" "commits arriving on the new line"
      print_commit_range "$mb" "$new" "$pre" "$msg" || true ;;
    *)
      _ancestry_hdr "$style" "commits since last approval"
      print_commit_range "$old" "$new" "$pre" "$msg" || true ;;
  esac
}

# The floor in one call: classify and gate. Used by both evidence branches
# of the ceremony and by the pre-sudo preview, so all three refuse the same
# shapes with the same words. It prints nothing for a move it lets through:
# the alarm for a declared backward or diverged move is a verdict, and a
# verdict prints after the last third-party text on its screen
# (ancestry_verdict), not here, above the listing it is about.
#
# Leaves the class in $ancestry_cls and, for a diverged candidate, the merge
# base in $ancestry_mb -- the inspect_slot convention (the caller declares
# them local). Returns 1 when the ceremony must not proceed.
# $1 = repo path, $2 = pinned rev ('' = first approval), $3 = candidate rev,
# $4 = declared class ('' = none).
ancestry_floor() {
  local repo="$1"
  ancestry_cls="" ancestry_mb=""
  if [ -z "$2" ]; then
    # A first approval classifies nothing: there is no pin for a
    # relationship to hold against, so a declaration describes nothing.
    [ -z "$4" ] || {
      echo "first approval: there is no pin for --$4 to move from" >&2
      return 1
    }
    return 0
  fi
  ancestry_cls="$(ancestry_class "$repo" "$2" "$3")"
  ancestry_gate "$ancestry_cls" "$4" "$2" "$3" "$repo" || return 1
  case "$ancestry_cls" in
    diverged)
      # Tolerated failure: two revs with no common ancestor in this
      # checkout still have a class, and the alarm says so in words.
      ancestry_mb="$(sgit merge-base "$2" "$3" 2>/dev/null || true)" ;;
  esac
}

# The lattice's verdict, where a verdict belongs: after the last third-party
# text of the screen, below its closing rule, directly above the question it
# informs -- under the rows that question decides about. The alarm for a
# backward or diverged move, nothing for any other; with `lead`, one blank
# line before it (the preview, where no rows precede it). Reads the class
# and merge base ancestry_floor left.
ancestry_verdict() { # <pinned rev> <candidate rev> [lead]
  case "${ancestry_cls:-}" in
    backward|diverged)
      [ -z "${3:-}" ] || echo
      print_ancestry_alarm "$ancestry_cls" "$1" "$2" "${ancestry_mb:-}" ;;
  esac
}

# The plural suffix for a counted noun ("1 commit", "2 commits"). Defined up
# here because the pre-sudo elevation arm runs before later definitions.
plural_s() { [ "$1" = 1 ] || printf s; }

# URL-encode % and / so a path becomes an unambiguous flat slot name;
# decode reverses it (%2F first, then %25 -- the reverse order would
# corrupt paths containing literal "%2F").
# Slot names are percent-encoded absolute paths. Encode every byte outside
# [A-Za-z0-9._-] rather than just % and /: a slot name is a DIRECTORY name,
# and an unescaped shell or glob metacharacter in one is a hazard waiting for
# a caller that forgets a quote. A project at /Users/x/foo[1], or the very
# real /Library/Application Support/..., would otherwise land literally in
# the name -- the space merely looked ugly in error output, but the bracket
# would have made `for f in "$d"/pin.*`-style globs match the wrong slot, or
# nothing at all. An allowlist is the only version of this that stays correct
# as call sites change.
#
# Paths built only of safe bytes and "/" encode exactly as before, so slots
# created by the previous rule keep their names and need no migration.
# LC_ALL=C so the walk is over BYTES: a UTF-8 path encodes one byte at a
# time and round-trips exactly, instead of depending on the locale's idea of
# a character.
#
# Deliberately NO Unicode normalization here, and do not add any. Byte-exact
# keying is what keeps distinct files distinct: on a normalization-SENSITIVE
# filesystem (case-sensitive APFS, or ext4 on the NixOS side) the NFC and NFD
# spellings of a name are two different files, and folding them to one key
# would hand one file's pin to the other. Where two spellings really are one
# file -- the normalization-insensitive default macOS volume -- canon_path
# has already resolved it: readlink -f returns the spelling the filesystem
# stores, whichever spelling it was given, and every recorded key goes
# through it (review --file refuses a path that is not a regular file). The
# filesystem is the authority on whether two names are one file; this
# function must not second-guess it.
encode() {
  printf '%s' "$1" | LC_ALL=C awk '
    BEGIN { for (i = 1; i < 256; i++) ord[sprintf("%c", i)] = i }
    {
      out = ""
      for (i = 1; i <= length($0); i++) {
        c = substr($0, i, 1)
        if (c ~ /^[A-Za-z0-9._-]$/) out = out c
        else out = out sprintf("%%%02X", ord[c])
      }
      printf "%s", out
    }'
}
decode() {
  printf '%s' "$1" | LC_ALL=C awk '
    function unhex(h,   digits, v, j) {
      digits = "0123456789ABCDEF"; v = 0
      for (j = 1; j <= 2; j++) v = v * 16 + index(digits, toupper(substr(h, j, 1))) - 1
      return v
    }
    {
      out = ""; n = length($0)
      for (i = 1; i <= n; i++) {
        c = substr($0, i, 1)
        if (c == "%" && i + 2 <= n && substr($0, i + 1, 2) ~ /^[0-9A-Fa-f][0-9A-Fa-f]$/) {
          out = out sprintf("%c", unhex(substr($0, i + 1, 2))); i += 2
        } else out = out c
      }
      printf "%s", out
    }'
}
# A slot path for a human's eye: each percent escape dimmed, so the repo
# path reads through the encoding (`%2FUsers%2Fjooize` shows as the path
# with faint separators). An escape that decodes to a control byte (%00-%1F,
# %7F) is red instead: no path a human meant has one, and a path carrying
# one is the kind of thing this display exists to make visible. Display only
# -- the bytes are the slot's, so a copied line still names the directory;
# off a tty every color is empty and the path prints plain. Nothing here can
# emit a control byte: the encoder admits only [A-Za-z0-9._-] and %XX, and
# the substitutions insert only this script's own color constants.
show_slot() {
  printf '%s' "$1" | sed \
    -e "s/%[2-6][0-9A-Fa-f]/${C_DIM}&${C_OFF}/g" \
    -e "s/%7[0-9A-Ea-e]/${C_DIM}&${C_OFF}/g" \
    -e "s/%[89A-Fa-f][0-9A-Fa-f]/${C_DIM}&${C_OFF}/g" \
    -e "s/%[01][0-9A-Fa-f]/${C_RED}&${C_OFF}/g" \
    -e "s/%7[Ff]/${C_RED}&${C_OFF}/g"
}

# A verdict about two values whose length this script does not choose: the
# first ends the verdict's row, and the second continues on the line under
# it, `→` hanging in the gutter so it starts in the first one's column.
# Neither value is ever followed by the other on one line. The hang counts
# `→` as one column, as Ghostty draws it; where it draws two, the second
# value lands one column right, which misleads nothing.
#
#   ✓ declared: v1.2
#             → /var/db/pinned/<user>/slots/<enc>/release
print_verdict_to() { # <SGR> <verdict> <value> <target>
  printf '%s✓ %s:%s %s\n' "$1" "$2" "$C_OFF" "$3"
  printf '%*s%s→%s %s\n' "$(( ${#2} + 2 ))" '' "$C_DIM" "$C_OFF" "$4"
}
# The same continuation under a labeled row (the 12-column gutter every
# ceremony block uses): a row's value that moves to another value whose
# length this script does not choose either.
print_row_to() { # <target>
  printf '          %s→%s %s\n' "$C_DIM" "$C_OFF" "$1"
}

# ---- slot storage ----------------------------------------------------------
# Layout: $PINNED_ROOT/<user>/ holds exactly two wrapper dirs --
#   slots/<encoded-path>/   one root-owned dir per pinned path
#   policy/                 allowed_signers + ignorable.json
#
# The wrapper dirs are the MOUNT MENU: a lane mounts its own slot dirs and
# policy/ read-only, never <user>/ itself, which would disclose every
# pinned path name. Two rules shaped this layout, and both are the reason
# a flat <user>/ignorable.json + <user>/allowed_signers was rejected:
#
#   * DIRECTORIES ARE MOUNTED, NEVER FILES. Every write here is an atomic
#     rename over a staged temp file, so the name gets a NEW inode -- and a
#     bind-mounted (or virtiofs-shared) FILE pins the inode it was mounted
#     from, which means a guest would keep reading the pre-ceremony bytes
#     forever. Sharing the enclosing dir re-reads the name every time.
#   * SELECTIVE DISCLOSURE. One dir per disclosure class: policy says what
#     MAY be trusted (small, boring, safe to expose to a lane), slots say
#     WHAT IS pinned (the list of paths is itself information). Loose files
#     directly under <user>/ would force a lane that needs the policy to
#     mount the slot list with it.

# The per-user tier an invocation operates on: the human behind sudo for
# root ceremonies, the invoking user otherwise.
tier_user() {
  if [ "$EUID" -eq 0 ] && [ -n "${SUDO_USER:-}" ]; then
    printf '%s\n' "$SUDO_USER"
  else
    id -un
  fi
}

# One group name on every platform, after the owning tool (the
# _<user>-locked convention; underscore is both Apple's system-account
# prefix and Debian policy's). One literal spelling matters: absence
# fails CLOSED to root-only 0700, so a misported per-platform name would
# silently degrade, never error.
pin_group() { printf '_%s-pinned' "$1"; }

group_exists() {
  if command -v getent >/dev/null 2>&1; then
    getent group "$1" >/dev/null 2>&1
  else
    dscacheutil -q group -a name "$1" 2>/dev/null | grep -q '^name:'
  fi
}

slot_dir_for()   { printf '%s/%s/slots/%s\n' "$PINNED_ROOT" "$1" "$(encode "$2")"; }
policy_dir_for() { printf '%s/%s/policy\n' "$PINNED_ROOT" "$1"; }

# Create/re-assert the per-user subtree (root only). The group is
# CONSUMED, never created -- the system configuration provisions it;
# absent means root-only 0700, privacy over availability, and the first
# root-side ceremony after the group appears re-asserts 0750 tree-wide.
# Sets TREE_GRP/TREE_DMODE/TREE_FMODE for subsequent slot writes.
ensure_tree() {
  local u="$1" udir grp
  udir="$PINNED_ROOT/$u"
  grp="$(pin_group "$u")"
  install -d -m 755 -o root -g wheel "$PINNED_ROOT"
  if group_exists "$grp"; then
    TREE_GRP="$grp" TREE_DMODE=750 TREE_FMODE=640
  else
    printf '%swarning: group %s does not exist, so this tier stays root-only (0700) until it does: %s%s\n' \
      "$C2_YEL" "$grp" "$udir" "$C2_OFF" >&2
    TREE_GRP=wheel TREE_DMODE=700 TREE_FMODE=600
  fi
  install -d -m "$TREE_DMODE" -o root -g "$TREE_GRP" \
    "$udir" "$udir/slots" "$udir/policy"
  # SELF-HEAL: allowed_signers used to live in <user>/signers/. It is
  # policy -- what MAY be trusted -- so it belongs with the rest of the
  # policy class, in the one dir a lane can be handed without also being
  # handed the slot list. Moved here rather than by a migration script,
  # because ensure_tree already runs at the start of every root ceremony
  # and is the one place that owns this tree's shape. Loud: a trust file
  # changing location is not a detail to discover later. (The per-slot
  # override stays at slots/<enc>/signers/ -- slot contents are one
  # disclosure class and ride the slot's own mount.)
  local old_signers="$udir/signers" moved=0
  if [ -f "$old_signers/allowed_signers" ]; then
    if [ -e "$udir/policy/allowed_signers" ]; then
      printf '%swarning: two allowed_signers files exist, and the policy one is the one that is read%s\n' \
        "$C2_YEL" "$C2_OFF" >&2
      printf '%s         old:     %s/allowed_signers%s\n' "$C2_YEL" "$old_signers" "$C2_OFF" >&2
      printf '%s         policy:  %s/policy/allowed_signers%s\n' "$C2_YEL" "$udir" "$C2_OFF" >&2
      printf '%s         inspect them, and remove the old file by hand%s\n' "$C2_YEL" "$C2_OFF" >&2
    else
      mv -f "$old_signers/allowed_signers" "$udir/policy/allowed_signers"
      # The move as a transition: the new path continues under the old one,
      # `→` hanging in the gutter (print_verdict_to's shape).
      printf '%snote: moved allowed_signers into the policy dir:%s %s/allowed_signers\n' \
        "$C2_YEL" "$C2_OFF" "$old_signers" >&2
      printf '%47s%s→%s %s/policy/allowed_signers\n' '' "$C2_DIM" "$C2_OFF" "$udir" >&2
      moved=1
    fi
  fi
  if [ -d "$old_signers" ]; then
    # Only an EMPTY leftover goes; anything still in there is unexplained
    # state that a trust tool must not delete on a hunch.
    if rmdir "$old_signers" 2>/dev/null; then
      # The removal continues the move-note only when THIS run printed one.
      # An earlier run's move leaves the empty dir behind, and an indented
      # continuation under nothing reads as a lost line.
      if [ "$moved" -eq 1 ]; then
        printf '%s      removed the now-empty %s%s\n' "$C2_YEL" "$old_signers" "$C2_OFF" >&2
      else
        printf '%snote: removed the now-empty legacy dir %s%s\n' "$C2_YEL" "$old_signers" "$C2_OFF" >&2
      fi
    else
      printf '%swarning: not empty, so left in place (nothing reads it any more): %s%s\n' \
        "$C2_YEL" "$old_signers" "$C2_OFF" >&2
    fi
  fi
  # SELF-HEAL: the declared release name used to be the slot's `tag`
  # record; it is `release` now (the record names the declaration, and
  # `tag` names git's object everywhere else in this tool). One-shot, in
  # the one place that owns this tree's shape, so the first root ceremony
  # after an upgrade converts every slot and no reader ever consults the
  # old name. rename(2) is atomic: there is no moment where a slot holds
  # neither record, so an interrupted pass loses no declaration and the
  # next ceremony finishes the job. A slot holding BOTH names is
  # unexplained state -- two declarations that may disagree -- and a trust
  # tool does not pick one on a hunch: every survivor is named, and the
  # ceremony refuses until a hand has removed the old file.
  local d old_decl survivors=0
  for d in "$udir"/slots/*/; do
    d="${d%/}"
    old_decl="$d/tag"
    [ -f "$old_decl" ] || continue
    if [ -e "$d/release" ]; then
      error "a slot holds both a tag and a release record, and release is the one that is read: " "$d"
      say_cmd "        inspect both, remove the old one by hand, and re-run: rm " "$old_decl"
      survivors=$((survivors + 1))
      continue
    fi
    mv -f "$old_decl" "$d/release"
    printf '%snote: renamed the declared release name record:%s %s\n' "$C2_YEL" "$C2_OFF" "$old_decl" >&2
    printf '%46s%s→%s %s/release\n' '' "$C2_DIM" "$C2_OFF" "$d" >&2
  done
  [ "$survivors" -eq 0 ] || exit 1
  # Deterministic sweep so a group arriving (or leaving) heals the whole
  # tree, not just paths the current ceremony touches.
  chown -R "root:$TREE_GRP" "$udir"
  if [ "$TREE_DMODE" = 750 ]; then
    chmod -R u=rwX,g=rX,o= "$udir"
  else
    chmod -R u=rwX,g=,o= "$udir"
  fi
}

# Classify a slot directory. Sets slot_state (none|rev|pin|tombstone),
# slot_file, slot_kind (git / sha256 / ... -- the declared verifier).
# Structure rule: EXACTLY ONE of rev.<vcs> / pin.<algo> / tombstone;
# more is a malformed slot and every consumer refuses fail-closed.
inspect_slot() {
  local d="$1" f n=0
  slot_state=none slot_file="" slot_kind=""
  [ -d "$d" ] || return 0
  for f in "$d"/rev.* "$d"/pin.* "$d"/tombstone; do
    [ -e "$f" ] || continue
    n=$((n + 1)); slot_file="$f"
    case "$f" in
      */tombstone) slot_state=tombstone; slot_kind="" ;;
      */rev.*)     slot_state=rev;  slot_kind="${f##*/rev.}" ;;
      */pin.*)     slot_state=pin;  slot_kind="${f##*/pin.}" ;;
    esac
  done
  if [ "$n" -gt 1 ]; then
    slot_state=malformed; slot_file=""; slot_kind=""
    error "a malformed slot, holding more than one of rev.*/pin.*/tombstone: " "$d"
    return 1
  fi
  return 0
}

# Write a slot's state file atomically and enforce exactly-one state:
# stage inside the slot dir, remove competing state files, rename into
# place. The transient stateless moment reads as "no slot" -- a verify
# racing the rename refuses, i.e. fails closed. Callers run ensure_tree
# first (it sets TREE_*).
write_slot_state() {
  local d="$1" name="$2" content="$3" tmp f
  install -d -m "$TREE_DMODE" -o root -g "$TREE_GRP" "$d"
  tmp="$(mktemp "$d/.stage.XXXXXX")"
  printf '%s\n' "$content" >"$tmp"
  chown "root:$TREE_GRP" "$tmp"
  chmod "$TREE_FMODE" "$tmp"
  for f in "$d"/rev.* "$d"/pin.* "$d"/tombstone; do
    [ -e "$f" ] || continue
    [ "$f" = "$d/$name" ] || rm -f "$f"
  done
  mv -f "$tmp" "$d/$name"
}

# THE SLOT-NAME INVARIANT, stated once, here:
#
#     slot directory name == encode(the path the record names)
#
# Every record -- rev.<vcs> and pin.<algo> alike -- is `<hex>  <path>`, and
# the directory holding it is that path's encoding. The name is not
# decoration: `pinned list` decodes it to report which path a pin covers
# ("slot names never leave this function: consumers get decoded paths"), and
# slot_dir_for finds a record by it. The two are one fact spelled twice, and
# they drift apart in exactly one way: on a case-insensitive volume a
# respelled path encodes to a name the filesystem resolves straight back to
# the directory still wearing the old spelling, so the record can say
# StaticDrop while every listing says staticdrop -- or, once the ceremony has
# re-stated the record, the record says StaticDrop while the directory still
# wears staticdrop. This function reports the directory half of that gap;
# read_record reports the record half (return 2). The review ceremonies are
# the maintenance arm (logged as `respell`): they rename the directory and
# re-state the record at entry. `list` and `status` name a violation wherever
# they find one, so drift is visible in a listing, not only at the next
# ceremony. Nothing else may reason about slot names.
#
# Deliberately NARROW: it only ever reports a directory the filesystem ALREADY
# aliases onto this slot, in the same parent. A different parent, or a name
# that does not already resolve here, is a different slot -- rekey's job,
# under rekey's own ceremony. Nothing here decides that two names are one
# file; it asks the filesystem what it already decided.
# COMPARE LIKE WITH LIKE. readlink -f canonicalizes the WHOLE path, not just
# the last component, and on macOS the state tree lives under /var, which is a
# symlink to /private/var. So the resolved path and the asked-about one differ
# in their PREFIX for every slot on the machine, always -- an unconditional
# `real != want` reads that as a respelling, and a raw parent comparison then
# throws it away, which is why this repair was dead on the platform it was
# written for (the harness missed it only because it builds its fixture root
# with `pwd -P`). Canonicalize BOTH parents, then let the BASENAME alone
# decide: it is the only component this function is about.
#
# The echoed path keeps the CALLER's prefix and takes only the on-disk
# basename, because the caller renames with it (`mv -f "$actual" "$slot"`) and
# a mv between two spellings of one directory across two spellings of one
# parent is not a rename anybody should have to reason about.
slot_name_actual() { # $1 = canonical slot dir; echoes the on-disk spelling, else nothing
  local want="$1" real want_parent real_parent
  [ -d "$want" ] || return 0
  real="$(readlink -f "$want" 2>/dev/null)" || return 0
  [ -n "$real" ] || return 0
  [ "${real##*/}" != "${want##*/}" ] || return 0
  want_parent="$(readlink -f "${want%/*}" 2>/dev/null)" || return 0
  real_parent="${real%/*}"
  [ -n "$want_parent" ] && [ "$want_parent" = "$real_parent" ] || return 0
  printf '%s/%s\n' "${want%/*}" "${real##*/}"
}

# The ANNOTATION writers (tag / ignored.json / approved) -- and, with the
# same discipline, the policy files. Same atomic stage-chown-chmod-rename
# and the same ownership as the state file, but annotations take no part in
# the exactly-one-state rule, so nothing is removed here. The target dir
# always exists by the time these run (the state write creates the slot
# root-owned; ensure_tree creates policy/), which is why neither re-asserts
# it.
#   write_note       content from a string (one trailing newline added)
#   write_slot_copy  content copied from a file, byte for byte
write_note() {
  local d="$1" name="$2" tmp
  tmp="$(mktemp "$d/.stage.XXXXXX")"
  printf '%s\n' "$3" >"$tmp"
  chown "root:$TREE_GRP" "$tmp"
  chmod "$TREE_FMODE" "$tmp"
  mv -f "$tmp" "$d/$name"
}
write_slot_copy() {
  local d="$1" name="$2" src="$3" tmp
  tmp="$(mktemp "$d/.stage.XXXXXX")"
  cat -- "$src" >"$tmp"
  chown "root:$TREE_GRP" "$tmp"
  chmod "$TREE_FMODE" "$tmp"
  mv -f "$tmp" "$d/$name"
}

# Drop a slot's ignored-key DECLARATION, in any declared format -- including
# one this version does not recognize, which is why the glob and not a fixed
# name. Called wherever the declaration is re-stated without keys: the file
# ceremony re-states it every time, exactly like `release`.
clear_ignore_decl() { rm -f "$1"/ignored.*; }

# Declaration AND stored witness -- everything the ceremony re-states. The
# file ceremony calls this on the extras it is not carrying, and the two
# places where a FILE record stops existing call it wholesale: a repo
# approval taking the slot over, and a tombstone (retired content has no
# bytes worth custody, and no keys left to tolerate).
clear_slot_ignore() { clear_ignore_decl "$1"; rm -f "$1/approved"; }

# ---- hash algorithms (file pins) -------------------------------------------
# Labels are EXACT function names -- the shipped --algo vocabulary and the
# pin.<algo> filename suffixes; verbatim lookup tokens, never parsed on
# "-". Digest LENGTH alone fixes the digest size, not the algorithm
# (sha256, sha512/256, blake2b-256 and blake3 all emit 64 hex), hence a
# declared label per record -- and declare-then-validate makes length a
# checkable invariant: a wrong-length digest is a malformed record,
# refused before anything is hashed. Unknown labels refuse.

algo_hash_cmd() {
  case "$1" in
    sha256)      echo "shasum -a 256" ;;
    sha384)      echo "shasum -a 384" ;;
    sha512)      echo "shasum -a 512" ;;
    sha512256)   echo "shasum -a 512256" ;;
    blake2b-256) echo "b2sum -l 256" ;;
    blake2b-384) echo "b2sum -l 384" ;;
    blake2b-512) echo "b2sum -l 512" ;;
    blake3)      echo "b3sum --no-names" ;;
    *) return 1 ;;
  esac
}

algo_hex_len() {
  case "$1" in
    sha256|sha512256|blake2b-256|blake3) echo 64 ;;
    sha384|blake2b-384)                  echo 96 ;;
    sha512|blake2b-512)                  echo 128 ;;
    *) return 1 ;;
  esac
}

# Fail closed when the declared function's tool is absent from the
# trusted PATH -- availability is checked here, never encoded in help.
require_hasher() {
  case "$1" in
    blake3)
      command -v b3sum >/dev/null 2>&1 || {
        error "$1 declared, but the trusted PATH has no b3sum: " "$PATH"
        echo "        install b3sum system-wide (a user-writable one would defeat the gate)" >&2
        return 1
      } ;;
    blake2b-*)
      command -v b2sum >/dev/null 2>&1 || {
        error "$1 declared, but the trusted PATH has no b2sum: " "$PATH"
        echo "        install GNU coreutils system-wide (a user-writable b2sum would defeat the gate)" >&2
        return 1
      } ;;
  esac
}

hash_file() {
  # $1 = algo label, $2 = file. Echoes the digest; equals what the
  # stock tool (shasum/b2sum/b3sum) reports for the same file, so every
  # record can be cross-checked with ordinary tools.
  local cmd out
  cmd="$(algo_hash_cmd "$1")" || return 1
  require_hasher "$1" || return 1
  out="$($cmd "$2")" || return 1
  printf '%s\n' "${out%% *}"
}

# Canonicalize a path that need not exist (BSD readlink -f demands
# existence): resolve the nearest EXISTING ancestor, then re-append the
# missing tail literally.
#
# Walking up rather than stopping at the immediate parent is load-bearing.
# A path is absent whether one component is missing or five, and the verdict
# for an absent path belongs to its SLOT -- no slot -> 10, live pin -> 20,
# tombstone -> 0. Erroring out because the parent dir happens to be gone
# made those states unreachable for an entire subtree: verify returned a
# generic failure that callers must treat as "pinned itself broke" (the shim
# hard-refuses on it, fail-closed), so a project that simply never had a
# .claude-devcontainer/ could not launch. Tombstone was worse -- it refuses
# a path that still exists, so the one case tombstones are FOR, a directory
# removed wholesale, was the one case it could not name.
#
# Only the missing tail is appended literally, and that is safe precisely
# because it does not exist: there are no symlinks left to resolve below
# the deepest real ancestor. `..` in the tail is the exception -- it would
# have to traverse a directory that isn't there, so there is no honest
# answer and it refuses.
canon_path() {
  local p="$1" d b tail=""
  if [ -e "$p" ]; then
    readlink -f "$p"
    return
  fi
  d="$p"
  while :; do
    b="$(basename "$d")"; d="$(dirname "$d")"
    case "$b" in
      ..) error "cannot resolve a .. below a missing directory: " "$p"; return 1 ;;
      .)  : ;;
      *)  tail="$b${tail:+/}$tail" ;;
    esac
    # dirname bottoms out at / (or . for a relative path), both of which
    # exist, so this terminates.
    [ -e "$d" ] && break
  done
  d="$(readlink -f "$d" 2>/dev/null)" \
    || { error "cannot resolve: " "$p"; return 1; }
  printf '%s/%s\n' "${d%/}" "$tail"
}

# Private scratch for frozen copies; removed on exit. freeze_file is THE
# single read of a subject file -- display, diff, hash and emit all
# derive from the frozen copy, never a second look at the live path
# (TOCTOU closure). Sets FROZEN_COPY.
workdir="" FREEZE_N=0
# Never-failing: under set -e a failing EXIT trap OVERRIDES the script's
# exit status (a bare `[ -n ... ] && ...` here turned verify's success
# into exit 1 -- live-fired in the build harness).
cleanup_workdir() { [ -z "$workdir" ] || rm -rf "$workdir"; }
trap cleanup_workdir EXIT
freeze_file() {
  [ -n "$workdir" ] || workdir="$(mktemp -d)"
  FREEZE_N=$((FREEZE_N + 1))
  FROZEN_COPY="$workdir/frozen.$FREEZE_N"
  cat -- "$1" >"$FROZEN_COPY"
}

resolve_repo() {
  [ $# -ge 1 ] || usage
  repo="$(readlink -f "$1")"
  [ -n "$repo" ] && [ -d "$repo" ] || { say_err "not a directory: " "$1"; exit 1; }
  # Let git's own stderr through -- swallowing it turned a safe.directory
  # refusal into a misleading "not a git work tree".
  sgit rev-parse --is-inside-work-tree >/dev/null \
    || { say_err "not a usable git work tree (git's own error is above): " "$repo"; exit 1; }
  # A repo pin names a commit of the WHOLE repo -- there is no per-subdir
  # trust semantic, so a slot keyed on a subdirectory could only mislead:
  # deploy matches flake inputs by repo root, and a root slot plus a subdir
  # slot could pin one repo at two revs. Refuse rather than silently re-key
  # to the root: a trust ceremony names its object.
  local top
  top="$(sgit rev-parse --show-toplevel)" || exit 1
  if [ "$repo" != "$(readlink -f "$top")" ]; then
    say_err "not the work-tree root: " "$repo"
    say_err "       a pin names the whole repo; name its root: " "$top"
    exit 1
  fi
  default_slot="$(slot_dir_for "$(tier_user)" "$repo")"
}

# Declared-name grammar for the slot's `release` record, deliberately
# narrower than git's own ref rules: the name is spliced into sed
# expressions and flake URLs at deploy time, so only [A-Za-z0-9._/+-]
# survives -- validated fail-closed on WRITE and on READ (the record
# declares; an undeclared shape refuses).
validate_release_name() {
  case "$1" in
    ''|-*|/*|*/|*..*|*.lock|*.lock/*) return 1 ;;
    *[!A-Za-z0-9._/+-]*) return 1 ;;
  esac
  return 0
}

# ---- ignored keys (verify-side tolerance) ----------------------------------
#
# A file slot may declare `ignored.<format>`: keys whose later drift verify
# tolerates. ONE format ships -- `ignored.json`, a JSON array of jq key
# paths:
#     [["model"],["effortLevel"],["statusLine","command"]]
# The SUFFIX is the declaration, exactly like rev.<vcs> and pin.<algo>: the
# record says which grammar its content is written in, and an unrecognized
# suffix (ignored.toml, ignored.yaml, ...) REFUSES rather than being
# guessed at -- which is also the extension point, should another format
# ever be worth implementing.
#
# WHY REAL JSON, and not the dotted lines this started as: the .json suffix
# has to be truthful, jq's delpaths takes exactly this shape (so the
# comparison consumes the record with no translation step in between), and
# a JSON object key may contain ANY character -- dots, spaces, parentheses
# ("Bash(git status:*)" is a real settings key). A dotted line cannot spell
# those; an array of strings spells all of them. GENERALITY LIVES IN THE
# STORAGE, CONVENIENCE IN THE HUMAN SURFACE: the CLI still takes
# --ignore-json-key model (or a.b.c) and every display joins paths back
# with dots, and dot-splitting happens ONLY at that surface.
#
# The pin stays byte-exact -- the declaration changes only what VERIFY does
# with a mismatch, and only when it can prove the difference is confined to
# those keys. KEYS ONLY -- no array subscripts -- because an index is a
# position, not a name, and a tolerated position would silently move with
# an insertion.

# The CLI's dotted convenience grammar, and ONLY that: [A-Za-z0-9_.-] with
# no leading, trailing or doubled dot. It bounds what may be typed, never
# what may be stored -- a key outside it is spelled by writing the path
# array, not by loosening this. Validated fail-closed before any dot-split.
validate_ignore_key() {
  case "$1" in
    ''|.*|*.|*..*) return 1 ;;
    *[!A-Za-z0-9_.-]*) return 1 ;;
  esac
  return 0
}

# jq is what makes every JSON-shaped rung of the ladder readable at all;
# without it there is no honest answer, only a guess. One refusal, one
# remediation, everywhere. $1 = what needed it, for the message.
require_jq() {
  command -v jq >/dev/null 2>&1 && return 0
  error "no jq in the trusted PATH: " "$PATH"
  say_err "        needed for: " "$1"
  echo "        install jq system-wide (a user-writable one could falsify the comparison)" >&2
  return 1
}

# One dotted key -> one jq path array: "statusLine.command" ->
# ["statusLine","command"]. Interpolating the segments raw is safe ONLY
# because validate_ignore_key has already excluded quotes, backslashes and
# every other byte that would need escaping -- validate first, build second.
ign_key_path_json() {
  printf '%s' "$1" | LC_ALL=C awk '
    {
      n = split($0, seg, "."); p = ""
      for (j = 1; j <= n; j++) p = p (j > 1 ? "," : "") "\"" seg[j] "\""
      printf "[%s]", p
    }'
}

# The space-separated dotted list the CLI collected -> the JSON array of
# paths jq's delpaths/getpath want, which is also exactly what the slot
# records:
#   "model effortLevel statusLine.command"
#     -> [["model"],["effortLevel"],["statusLine","command"]]
ign_paths_json() {
  printf '%s\n' "$1" | LC_ALL=C awk '
    {
      out = ""
      for (i = 1; i <= NF; i++) {
        n = split($i, seg, ".")
        p = ""
        for (j = 1; j <= n; j++) p = p (j > 1 ? "," : "") "\"" seg[j] "\""
        out = out (i > 1 ? "," : "") "[" p "]"
      }
      printf "[%s]\n", out
    }'
}

# A JSON array of paths -> the dotted, comma-separated form humans read.
# Display only: a key containing a dot renders ambiguously here and is
# still stored, compared and enforced exactly.
ign_display() {
  printf '%s' "$1" | jq -r 'map(join(".")) | join(", ")'
}

# Read + validate a slot's ignored-key declaration into IGN_PATHS (the
# canonical compact JSON array -- what delpaths is handed, and what a
# declaration is compared against). Exit status is three-valued, because
# "nothing declared" and "declared but unusable" are different answers:
#   0  a valid ignored.json; IGN_PATHS holds its paths
#   1  no ignored.* at all -- the feature is simply not declared here
#   2  a declaration that cannot be honored (unknown format, more than
#      one, not root-owned, empty, no jq, or content outside the shape).
#      Loud, and every caller falls back to the STRICTER verdict.
IGN_PATHS=""
read_ignored_paths() {
  local d="$1" f found="" fmt
  IGN_PATHS=""
  for f in "$d"/ignored.*; do
    [ -e "$f" ] || continue
    if [ -n "$found" ]; then
      refused "the slot declares more than one ignored.<format>, so all of them are refused: $d"
      return 2
    fi
    found="$f"
  done
  [ -n "$found" ] || return 1
  fmt="${found##*/ignored.}"
  case "$fmt" in
    json) ;;
    *)
      refused "an unsupported ignored-key format: $found"
      echo "        (the shipped format is ignored.json -- a JSON array of key paths)" >&2
      return 2 ;;
  esac
  verify_record_file "$found" || return 2
  require_jq "reading $found" || return 2
  if ! jq -e 'type == "array"
              and all(.[]; type == "array" and length > 0
                           and all(.[]; type == "string"))' \
       <"$found" >/dev/null 2>&1; then
    refused "outside the ignored-key shape: $found"
    echo '        the shape is a JSON array of nonempty arrays of strings, e.g. [["model"],["statusLine","command"]]' >&2
    return 2
  fi
  [ "$(jq 'length' <"$found")" -gt 0 ] || {
    refused "it declares no keys, and an empty declaration tolerates nothing: $found"
    return 2
  }
  IGN_PATHS="$(jq -c . <"$found")" || return 2
  return 0
}

# Does this slot declare ignored keys at all (in any format)? Cheap
# existence test, used to decide whether the tolerance path is even in
# play before spending anything on it.
slot_declares_ignore() {
  local f
  for f in "$1"/ignored.*; do
    [ -e "$f" ] && return 0
  done
  return 1
}

# THE RESTATEMENT FLOOR, the tag rule's guard. Every ceremony re-states a
# slot's extras, so a flag left off drops what the slot keeps: its
# ignored-key declaration, its stored copy. Dropping is the strict
# direction, but it is still a decision, and a missing flag is too easy to
# make it by accident (the drop surfaces only at the next drift, as a
# review nobody expected). So an extra the slot holds today must be stated
# either way: kept (--ignore-json-key, --store) or dropped by name
# (--ignore-none, --no-store). An unstated one refuses the WHOLE ceremony
# before anything is shown, so nothing is recorded and no gate is answered
# for a review that has to run again anyway. The pre-sudo side runs the
# same check to save the authentication; the root side is the authority.
#
# restate_gaps prints the gap lines for ONE slot (nothing when there is
# none). $1 slot dir, $2 1 if this --file states its keys either way,
# $3 1 if it states custody either way.
restate_gaps() {
  local slot="$1" ign_stated="$2" cust_stated="$3" keys flags
  [ -d "$slot" ] || return 0
  if [ "$ign_stated" -eq 0 ] && slot_declares_ignore "$slot"; then
    if read_ignored_paths "$slot" 2>/dev/null \
       && keys="$(ign_display "$IGN_PATHS")" \
       && flags="$(printf '%s' "$IGN_PATHS" | jq -r 'map("--ignore-json-key " + join(".")) | join(" ")')"; then
      echo "          ignored keys: $keys"
      echo "            keep: $flags"
    else
      echo "          ignored keys: the declaration is unreadable"
      echo "            keep: --ignore-json-key KEY for each key to keep"
    fi
    echo "            drop: --ignore-none"
  fi
  if [ "$cust_stated" -eq 0 ] && [ -e "$slot/approved" ]; then
    echo "          stored copy"
    echo "            keep: --store"
    echo "            drop: --no-store"
  fi
}

# The batch half: $1 tier, then the review's own argv (for the paste-ready
# --keep line). The files come in rf_files; per file, rf_ign_stated and
# rf_cust_stated say whether it states its keys and its custody either way,
# and rf_typed whether it typed any of those flags at all. A path that does
# not canonicalize is skipped here: the ceremony refuses it on its own.
#
# When no file with a gap typed any of those flags, the refusal ends with
# the same command plus --keep after each such --file: the one-word way to
# say "as it is". A file that typed some of them gets only its keep/drop
# lines, because --keep would ADD the kept keys to the ones it typed.
restate_floor() {
  local tier="$1" i=0 p one body="" gap_idx=" " suggest=1 a fi=-1 line tok
  shift
  while [ "$i" -lt "${#rf_files[@]}" ]; do
    if p="$(canon_path "${rf_files[$i]}" 2>/dev/null)"; then
      one="$(restate_gaps "$(slot_dir_for "$tier" "$p")" "${rf_ign_stated[$i]}" "${rf_cust_stated[$i]}")"
      if [ -n "$one" ]; then
        untrusted_var p "$p" "" 2
        body="$body        $p$NL$one$NL"
        gap_idx="$gap_idx$i "
        [ "${rf_typed[$i]}" -eq 0 ] || suggest=0
      fi
    fi
    i=$((i + 1))
  done
  [ -n "$body" ] || return 0
  printf '\n%s✗ refused:%s this review would drop what a slot keeps today\n' "$C2_RED$C2_B" "$C2_OFF" >&2
  printf '%s' "$body" >&2
  if [ "$suggest" -eq 1 ] && [ "$#" -gt 0 ]; then
    line="pinned review"
    while [ "$#" -gt 0 ]; do
      a="$1"; shift
      elevation_token tok "$a" "" 2
      line="$line $tok"
      if [ "$a" = "--file" ] && [ "$#" -gt 0 ]; then
        fi=$((fi + 1))
        elevation_token tok "$1" "" 2
        line="$line $tok"; shift
        case "$gap_idx" in *" $fi "*) line="$line --keep" ;; esac
      fi
    done
    echo "        to keep everything as it is:" >&2
    echo "          $line" >&2
  fi
  echo "        state keep or drop for each, then run the review again; nothing recorded" >&2
  return 1
}

# ---- the ignorable policy (machine tier, user tier) ------------------------
#
# What a slot MAY declare, root-owned and separate from the declaration
# itself. Two tiers, both arrays of entries:
#     [{"path":["model"],"under":"/Users/x/.config"},{"path":["effortLevel"]}]
# "under" is optional and means EVERYWHERE when omitted; when present it is
# an absolute prefix matched at a component boundary, so /a/b covers /a/b
# and /a/b/c and never /a/bb -- the same rule `list --under` uses.
#
# The EFFECTIVE policy is the intersection: a user entry counts only if the
# machine tier has the same path with a scope that covers it (no machine
# tier at all = no machine constraint, so the user tier stands alone). An
# absent or empty user tier grants NOTHING -- the fail-closed direction --
# and an unreadable tier of either kind grants nothing either.

# The shared jq preamble: the two coverage rules live in exactly one place,
# so the review-side check, the verify-side check and the intersection can
# never drift apart. norm() folds a trailing slash and spells the root as
# "" (so "" + "/" prefixes every absolute path).
POLICY_JQ='
  def norm($p): if $p == null then null elif $p == "/" then "" else ($p | rtrimstr("/")) end;
  def covers_path($scope; $target):
    norm($scope) as $s
    | if $s == null then true
      else ($target == $s or ($target | startswith($s + "/")))
      end;
  def covers_scope($mscope; $uscope):
    norm($mscope) as $m | norm($uscope) as $u
    | if $m == null then true
      elif $u == null then false
      else ($u == $m or ($u | startswith($m + "/")))
      end;
'

# The shape a policy file must have. Unknown object keys are REFUSED, not
# skipped: a key this version does not understand could be a NARROWING
# constraint written by a newer one, and ignoring it would silently widen
# the grant.
POLICY_VALID='
  type == "array" and all(.[];
    type == "object"
    and ((keys - ["path", "under"]) | length) == 0
    and has("path")
    and (.path | type == "array" and length > 0 and all(.[]; type == "string"))
    and (if has("under")
         then (.under | type == "string" and startswith("/")
               and (. == "/" or (endswith("/") | not))
               and (contains("//") | not))
         else true end))
'

# Read + validate ONE tier into POLICY_JSON. Three-valued like the slot
# declaration: 0 valid, 1 absent, 2 present but unusable (loud).
POLICY_JSON=""
read_policy_file() {
  local f="$1" label="$2" gone=0
  POLICY_JSON=""
  # A tier this process cannot see is not an absent tier: a hidden machine
  # policy read as absent would drop its constraint on the user tier.
  path_gone "$f" || gone=$?
  case "$gone" in
    0) return 1 ;;
    2) refused "cannot tell whether the $label exists: $f"; return 2 ;;
  esac
  [ -f "$f" ] || { refused "the $label is not a regular file: $f"; return 2; }
  verify_record_file "$f" || return 2
  verify_ancestry "$f" || return 2
  require_jq "reading $f" || return 2
  jq -e "$POLICY_VALID" <"$f" >/dev/null 2>&1 || {
    refused "the $label is not a valid ignorable policy: $f"
    echo '        (a JSON array of {"path":["a","b"],"under":"/abs/prefix"};' >&2
    echo '        "under" is optional and means everywhere; no other keys)' >&2
    return 2
  }
  POLICY_JSON="$(jq -c . <"$f")" || return 2
  return 0
}

# Load both tiers and their intersection for tier user $1:
#   POL_MACHINE  the machine tier, "" when there is none
#   POL_USER     the user tier ([] when absent)
#   POL_EFF      what review and verify actually check against
# Returns 1, loudly, when a tier that EXISTS cannot be read: an unreadable
# policy grants nothing rather than everything.
POL_MACHINE="" POL_USER="[]" POL_EFF="[]"
load_policy() {
  local u="$1" rc=0
  POL_MACHINE="" POL_USER="[]" POL_EFF="[]"
  read_policy_file "$PINNED_MACHINE_POLICY" "machine policy" || rc=$?
  case "$rc" in
    0) POL_MACHINE="$POLICY_JSON" ;;
    1) ;;
    *) return 1 ;;
  esac
  rc=0
  read_policy_file "$(policy_dir_for "$u")/ignorable.json" "user policy" || rc=$?
  case "$rc" in
    0) POL_USER="$POLICY_JSON" ;;
    1) return 0 ;;
    *) return 1 ;;
  esac
  if [ -z "$POL_MACHINE" ]; then
    POL_EFF="$POL_USER"
  else
    POL_EFF="$(jq -c -n --argjson m "$POL_MACHINE" --argjson u "$POL_USER" \
      "$POLICY_JQ"'[ $u[] as $e
                     | select(any($m[]; .path == $e.path and covers_scope(.under; $e.under)))
                     | $e ]')" || return 1
  fi
  return 0
}

# How many of the declared paths $2 does the effective policy $1 NOT grant
# for the path $3? Counted structurally (never by counting output lines: a
# key may contain a newline), because this number is a trust decision.
policy_ungranted_count() {
  jq -n --argjson e "$1" --argjson d "$2" --arg f "$3" \
    "$POLICY_JQ"'[ $d[] as $p
                   | select([ $e[] | select(.path == $p and covers_path(.under; $f)) ] | length == 0) ]
                 | length'
}

# The same set, dotted, one per line -- for the human-readable refusal.
policy_ungranted() {
  jq -r -n --argjson e "$1" --argjson d "$2" --arg f "$3" \
    "$POLICY_JQ"'$d[] as $p
                 | select([ $e[] | select(.path == $p and covers_path(.under; $f)) ] | length == 0)
                 | ($p | join("."))'
}

# Per-key grant PROVENANCE for the ceremony display: "<dotted><TAB><scope>",
# where the scope is "*" for a grant that holds everywhere, "-" for no
# grant at all, and otherwise the prefix it is scoped to. When several
# entries cover the path, the NARROWEST is reported: that is the one worth
# reading, since it says how far the tolerance actually reaches.
policy_grants() {
  jq -r -n --argjson e "$1" --argjson d "$2" --arg f "$3" \
    "$POLICY_JQ"'$d[] as $p
                 | [ $e[] | select(.path == $p and covers_path(.under; $f)) | (.under // "") ] as $m
                 | ($p | join(".")) + "\t"
                   + (if ($m | length) == 0 then "-"
                      else ($m | sort_by(length) | last | if . == "" then "*" else . end)
                      end)'
}

# The ladder rung the ceremony enforces: may THIS ceremony declare THESE
# keys for THIS path? A refusal that does not say what to run is a refusal
# a human routes around, so it names the exact grant command per key.
policy_check_declaration() { # $1 effective policy  $2 declared paths  $3 abs path
  local n names k
  n="$(policy_ungranted_count "$1" "$2" "$3")" || return 1
  # A count that is not a number is a check that did not happen, which is
  # NOT the same as a check that passed.
  case "$n" in
    0) return 0 ;;
    ''|*[!0-9]*)
      refused "the ignorable policy check did not complete; declaring nothing"
      return 1 ;;
  esac
  names="$(policy_ungranted "$1" "$2" "$3")"
  refused "the ignorable policy does not grant these keys for this file: " "$3"
  while IFS= read -r k; do
    [ -z "$k" ] || say_err "          " "$k"
  done <<EOF
$names
EOF
  echo "        grant them first -- each is its own root ceremony:" >&2
  local k_disp under_disp wq
  shq wq "$(dirname "$3")"
  untrusted_var under_disp "$wq" "" 2
  while IFS= read -r k; do
    [ -n "$k" ] || continue
    shq wq "$k"
    untrusted_var k_disp "$wq" "" 2
    printf '          sudo pinned ignorable add %s --under %s\n' "$k_disp" "$under_disp" >&2
  done <<EOF
$names
EOF
  echo "        (omit --under to grant a key everywhere; pinned ignorable list shows both tiers)" >&2
  return 1
}

# May these bytes be PROJECTED (parsed, keys deleted, re-serialized) as a
# stand-in for themselves? Three refusals, all of them parser-differential
# hazards -- a "yes" here is what lets verify answer 5 instead of 11, so
# each one fails closed. $1 = file, $2 = which side, for the note.
#
#   NUL bytes: jq accepts a trailing NUL and treats the file as one
#   document; other JSON parsers do not. The difference would be invisible
#   to a structural comparison, so it must not reach one.
#
#   Exactly one document: jq reads a CONCATENATED STREAM of values, every
#   other parser reads one value and stops. A two-document file is a
#   disagreement, not a document.
#
#   DUPLICATE OBJECT KEYS: jq keeps the LAST occurrence, JavaScript's
#   JSON.parse keeps the last, Python's json keeps the last, but Go's
#   encoding/json and several others differ, and the file's actual
#   consumer is not this tool's to assume. Uncertainty -> abort.
#
# The duplicate test, measured on jq-1.7.1 (2026-07-30):
#   `jq --stream` emits one event per value occurrence, so a duplicated
#   key emits BOTH occurrences ({"a":1,"a":2} -> [["a"],1] / [["a"],2] /
#   [["a"]]), while re-serializing through jq (`jq -c .`) collapses them
#   to the last. Comparing the two event COUNTS therefore detects a
#   duplicate anywhere at any depth -- including duplicates whose values
#   are themselves objects, where the leaf PATHS differ and a path-multiset
#   comparison would miss them ({"a":{"x":1},"a":{"y":2}} -> 5 events raw,
#   3 canonical). Verified against duplicates of every value shape
#   (scalar/object/array/empty-object, nested, inside arrays, byte-identical
#   values) and against duplicate-free documents carrying big integers,
#   1e1000, 1.0, escapes, astral-plane strings, empty containers and
#   five-deep nesting -- counts equal in every duplicate-free case, strictly
#   greater in every duplicated one. It cannot false-negative: every dropped
#   occurrence costs at least one event (even `{}` emits one).
json_projectable() {
  local f="$1" side="$2" n_raw n_canon
  if [ "$(LC_ALL=C tr -d '\000' <"$f" | wc -c)" -ne "$(wc -c <"$f")" ]; then
    say_err "note: it holds NUL bytes, so it is not comparable as JSON (the byte-exact verdict stands): " "$side"
    return 1
  fi
  if [ "$(jq -s 'length' <"$f" 2>/dev/null)" != 1 ]; then
    say_err "note: not exactly one JSON document (the byte-exact verdict stands): " "$side"
    return 1
  fi
  n_raw="$(jq --stream -c . <"$f" 2>/dev/null | wc -l)"
  n_canon="$(jq -c . <"$f" 2>/dev/null | jq --stream -c . 2>/dev/null | wc -l)"
  if [ "$n_raw" -lt 1 ] || [ "$n_raw" -ne "$n_canon" ]; then
    refused "duplicate object keys, and parsers disagree on which one wins: " "$side"
    echo "        so no structural comparison of it can be trusted (the byte-exact verdict stands)" >&2
    return 1
  fi
  return 0
}

# The tolerance path itself: is the live content the approved content with
# only the declared keys changed? Prints the per-key drift report and the
# verdict line on success (stdout, the machine contract); every failure
# returns 1 so the caller falls back to the byte-exact refusal.
#   $1 slot  $2 algo label  $3 recorded digest  $4 live (frozen) copy
#   $5 caller --baseline (may be empty)  $6 the path, for the verdict line
ignored_keys_match() {
  local slot="$1" label="$2" rec_digest="$3" live="$4" base="$5" path="$6"
  local approved="" paths pa pb rc=0 ungranted
  command -v jq >/dev/null 2>&1 || {
    say_err "note: the slot declares ignored keys, but the trusted PATH has no jq: " "$PATH"
    echo "      slot:  $slot" >&2
    echo "      the byte-exact verdict stands (install jq system-wide to enable the comparison)" >&2
    return 1
  }
  read_ignored_paths "$slot" || rc=$?
  [ "$rc" -eq 0 ] || return 1
  # THE LADDER AT USE TIME: a recorded key is tolerated only while the
  # effective policy still grants it FOR THIS PATH. Checked here, not only
  # at the ceremony, so narrowing the policy bites at the very next verify
  # -- no re-ceremony, no stale grant surviving in a slot nobody revisits.
  # An unreadable policy grants nothing and lands right back at 11.
  if ! load_policy "$(tier_user)"; then
    echo "note: the ignorable policy cannot be read; the byte-exact verdict stands" >&2
    return 1
  fi
  local n_ungranted
  n_ungranted="$(policy_ungranted_count "$POL_EFF" "$IGN_PATHS" "$path")" || n_ungranted=""
  case "$n_ungranted" in
    0) ;;
    ''|*[!0-9]*)
      # A count that is not a number is a check that did not happen.
      echo "note: the ignorable policy check did not complete; the byte-exact verdict stands" >&2
      return 1 ;;
    *)
      ungranted="$(policy_ungranted "$POL_EFF" "$IGN_PATHS" "$path" | tr '\n' ' ')"
      say_err "note: the slot records ignored key$(plural_s "$n_ungranted") the policy no longer grants here: " "$slot"
      say_err "      keys:  " "${ungranted% }"
      echo "      the byte-exact verdict stands; re-approve, or grant them: pinned ignorable add" >&2
      return 1 ;;
  esac
  # THE WITNESS. Root custody first: the slot's own copy has already been
  # re-hashed against the record (the slot invariant in do_verify). A caller
  # baseline is the same kind of evidence arriving by a different road, so it
  # proves itself here instead, by the same self-verifying trick -- neither
  # storage location nor custody is what makes a witness usable, the re-hash
  # is. Custody is preferred only because it cannot be withheld or swapped
  # between calls.
  if [ -f "$slot/approved" ]; then
    approved="$slot/approved"
  elif [ -n "$base" ]; then
    if [ ! -f "$base" ]; then
      say_err "note: the --baseline is not a readable file (the byte-exact verdict stands): " "$base"
      return 1
    fi
    if [ "$(hash_file "$label" "$base")" != "$rec_digest" ]; then
      say_err "note: the --baseline does not re-hash to the approved record (the byte-exact verdict stands): " "$base"
      return 1
    fi
    approved="$base"
  else
    echo "note: the slot declares ignored keys but holds no approved copy, and no --baseline was given: $slot" >&2
    echo "      there is no witness to compare against (the byte-exact verdict stands; pass" >&2
    echo "      verify --baseline COPY, or re-approve with --store)" >&2
    return 1
  fi
  json_projectable "$approved" "the approved bytes" || return 1
  json_projectable "$live" "$path" || return 1
  # The record IS the delpaths argument -- no translation step between what
  # the slot declares and what the comparison deletes.
  paths="$IGN_PATHS"
  # Project and canonicalize IDENTICALLY on both sides (-S sorts keys, -c
  # compacts), then compare bytes: key order and whitespace are not what
  # this comparison is about, the remaining VALUES are.
  pa="$(jq -S -c --argjson p "$paths" 'delpaths($p)' <"$approved" 2>/dev/null)" || return 1
  pb="$(jq -S -c --argjson p "$paths" 'delpaths($p)' <"$live" 2>/dev/null)" || return 1
  if [ -z "$pa" ] || [ "$pa" != "$pb" ]; then
    say_err "note: differences remain outside the declared ignored keys: " "$(ign_display "$paths")"
    return 1
  fi
  # Report which declared keys actually moved -- the caller's whole reason
  # to care. A key whose value is unchanged is not reported; a key missing
  # on one side and present on the other IS a difference. getpath refuses
  # to index a non-object, so both reads are guarded.
  jq -n -r --argjson p "$paths" \
     --slurpfile a "$approved" --slurpfile b "$live" '
    $p[] as $path
    | (try ($a[0] | getpath($path)) catch "unreadable") as $va
    | (try ($b[0] | getpath($path)) catch "unreadable") as $vb
    | if $va == $vb then empty else ($path | join(".")) end
  ' 2>/dev/null | while IFS= read -r line; do
    [ -n "$line" ] && printf 'ignored-drift: %s\n' "$line"
  done
  printf '%s~ matches modulo declared ignored keys:%s %s\n' "$C_YEL" "$C_OFF" "$path"
  return 0
}

# ASCII-only case fold, used SOLELY to describe a mismatch (never to decide
# one): it lets the message below separate "the path was respelled" from
# "this record is corrupt". Trust decisions stay byte-exact -- see the
# no-folding rule above encode(), which this must never be recruited into
# violating.
ascii_fold() { printf '%s' "$1" | LC_ALL=C tr 'A-Z' 'a-z'; }

# ONE RECORD GRAMMAR. A slot's state file, whichever kind, is one line:
#
#     <hex>  <path>
#
# the digest or revision, TWO spaces, the path the record covers -- exactly
# the line `shasum -c` reads, so a pin record is also a check file. The
# filename declares what the hex is (pin.sha256, rev.git), and validation is
# exact per declaration: declare-then-validate makes the length a checkable
# invariant, so a wrong-length digest is a malformed record, never a
# short digest of some other function. A line with no separator is malformed
# too: the path field is part of the record, and a record that does not name
# its path cannot be checked against the slot it sits in (see THE SLOT-NAME
# INVARIANT above slot_name_actual).
#
# ONE READER for every verb that answers about a record, repo or file, so
# verify, cat, status, list and the ceremonies can never drift apart on what
# a valid record is. Sets REC_LABEL / REC_DIGEST / REC_PATH.
#
# TWO refusal codes, because they are two different states and only one of
# them has a way out: return 1 is corruption, return 2 is a well-formed
# record naming another path -- which on a case-insensitive volume is what a
# case-only rename leaves behind, since both spellings encode onto ONE slot
# directory. Callers that only test nonzero keep refusing both. REC_DIGEST
# and REC_PATH are set on 2 (the record IS readable; it names another path),
# never on 1.
#
# The record file's OWNERSHIP is deliberately NOT checked here: it is
# verify_record_file's job, and callers answer differently for a violated
# invariant (see do_cat's contract), so it stays at the call site.
read_record() { # $1 = state file, $2 = declared label, $3 = accepted hex lengths, $4 = the path asked about
  local f="$1" lens="$3" line rec_path n ok=0
  REC_LABEL="$2" REC_DIGEST="" REC_PATH=""
  IFS= read -r line <"$f" || line=""
  case "$line" in
    *'  '*) ;;
    *)
      error "a malformed record, naming no path (expected '<hex>  <path>'): " "$f"
      return 1 ;;
  esac
  rec_path="${line#*  }"
  line="${line%%  *}"
  case "$line" in
    *[!0-9a-f]*|'')
      error "a corrupt record: " "$f"
      return 1 ;;
  esac
  for n in $lens; do [ "${#line}" -eq "$n" ] && ok=1; done
  [ "$ok" -eq 1 ] || {
    error "a malformed record, its digest length ${#line} not $REC_LABEL's (${lens// / or } hex): " "$f"
    return 1
  }
  REC_DIGEST="$line" REC_PATH="$rec_path"
  [ "$rec_path" = "$4" ] || {
    # A record naming another path is NOT corrupt: it was correct when it was
    # written and the path has been respelled since. Say which it is, because
    # the two have different exits -- corruption is hand-repair territory, a
    # respelling is a re-approval away.
    if [ "$(ascii_fold "$rec_path")" = "$(ascii_fold "$4")" ]; then
      error "the record names another spelling of the path, whose case changed on disk: " "$f"
      say_err "        record names:  " "$rec_path"
      say_err "        path:          " "$4"
    else
      error "a malformed record, naming another path: " "$f"
      say_err "        record names:  " "$rec_path"
      say_err "        path:          " "$4"
    fi
    return 2
  }
}

# The file-record reader: read_record under the declared algorithm's hex
# length. Refuses an undeclared algorithm before reading a byte. Also sets
# REC_HEXLEN for callers that hash the live file against the record.
read_pin_record() { # $1 = state file, $2 = declared label, $3 = the path asked about
  algo_hash_cmd "$2" >/dev/null 2>&1 || {
    error "a record that declares an unknown algorithm, refused: " "$1"
    return 1
  }
  REC_HEXLEN="$(algo_hex_len "$2")"
  read_record "$1" "$2" "$REC_HEXLEN" "$3"
}

# The repo-record reader: echoes the slot's pinned rev, or nothing for no
# slot / no state, and sets REC_DIGEST / REC_PATH like read_pin_record. The
# slot DECLARES the VCS in the filename (rev.git); validation is exact per
# declaration -- rev.git is exactly 40 or 64 hex, git's two object formats
# -- and an undeclared/unknown rev.<vcs> refuses outright. Also refuses
# tombstoned, file-pin and malformed slots: the caller asked for a repo rev,
# and anything else answering would be a lie.
#
# Return codes are read_record's: 0 (the rev is echoed; empty for no state),
# 1 (nothing echoed), 2 (the rev IS echoed -- the record names another
# spelling of this path, and the ceremony that re-states it needs the rev it
# is re-stating). `x="$(read_rev ...)" || exit 1` refuses both, as before.
read_rev() { # $1 = slot dir, $2 = the path asked about
  local d="$1" rc=0
  REC_LABEL="" REC_DIGEST="" REC_PATH=""
  inspect_slot "$d" || return 1
  case "$slot_state" in
    none) return 0 ;;
    rev)  ;;
    tombstone)
      error "a tombstoned slot (retired content), which a new approval would reinstate: " "$d"
      return 1 ;;
    pin)
      error "the slot holds a file pin, not a repo rev: " "$d"
      return 1 ;;
  esac
  case "$slot_kind" in
    git) ;;
    *)
      error "a record that declares an unsupported VCS, refused: " "$slot_file"
      return 1 ;;
  esac
  verify_record_file "$slot_file" || return 1
  read_record "$slot_file" rev.git "40 64" "$2" || rc=$?
  [ "$rc" -ne 1 ] || return 1
  printf '%s\n' "$REC_DIGEST"
  return "$rc"
}

# ---- setup -----------------------------------------------------------------

do_setup() {
  require_root setup

  local assume_yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes) assume_yes=1; shift ;;
      *)     usage ;;
    esac
  done

  # Interactive confirm for direct-root invocation (sudo ./pinned setup);
  # the unprivileged path already confirmed pre-elevation and passed --yes.
  if [ "$assume_yes" -ne 1 ]; then
    setup_plan "$inv"
    local answer
    printf '%srun this setup? [%sy%s/%sN%s]%s ' "$C_B" "$C_BLU" "$C_OFF$C_B" "$C_BLU" "$C_OFF$C_B" "$C_OFF"
    drain_tty
    read -r answer </dev/tty
    case "$answer" in
      y|Y|yes) ;;
      *) echo "aborted; nothing installed"; exit 2 ;;
    esac
  fi

  # 1. Self-install; verify every ancestor of INSTALL_TARGET first.
  local self target target_dir
  self="$(readlink -f "$0")"
  target="$INSTALL_TARGET"
  target_dir="$(dirname "$target")"
  install -d -m 755 -o root -g wheel "$target_dir"
  verify_ancestry "$target" || exit 1
  verify_root_owned_path "$target_dir" || exit 1
  if [ "$self" != "$target" ]; then
    install -m 755 -o root -g wheel "$self" "$target"
    echo "installed: $target"
  else
    echo "binary already at $target"
  fi
  # The bytes at $target are final now, so this is the file the digest below
  # will pin -- and the one whose shebang decides which interpreter sudo
  # hands root. Checked here, before the grant exists: refusing costs the
  # human a reinstall, granting would cost them the interpreter.
  verify_interpreter_pin "$target" || exit 1

  # 2. Pin tree for the invoking user
  ensure_tree "$inv"
  echo "pin tree: $PINNED_ROOT/$inv"

  # 3. Sudoers entry with binary-digest pin (validated before installing).
  #    sudo recomputes the binary's SHA-256 at every invocation and refuses
  #    silently on mismatch -- integrity check lives in sudo, not in us.
  local sudoers_target sudoers_line digest tmp
  sudoers_target=/etc/sudoers.d/pinned
  digest="$(shasum -a 256 "$target" | awk '{print $1}')"
  sudoers_line="$inv ALL=(root) sha256:$digest ${target}"
  if [ -f "$sudoers_target" ] && grep -qF "$sudoers_line" "$sudoers_target"; then
    echo "sudoers digest current: $sudoers_target"
  else
    tmp="$(mktemp)"
    printf '%s\n' "$sudoers_line" >"$tmp"
    if visudo -c -f "$tmp" >/dev/null 2>&1; then
      install -m 440 -o root -g wheel "$tmp" "$sudoers_target"
      echo "wrote sudoers entry with digest: $sudoers_target"
      echo "  digest: sha256:$digest"
    else
      echo "sudoers validation failed; not installing" >&2
      rm -f "$tmp"
      exit 1
    fi
    rm -f "$tmp"
  fi

  log_action setup
  echo
  echo "setup complete"
  # A suggestion block (a command the human may type later) keeps its own
  # label, a sentence -- never `next:`, the label gates used to wear.
  echo
  echo "To approve a first repo, run:"
  echo
  echo "  sudo pinned review REPO"
}

if [ "$action" = "setup" ]; then
  do_setup "$@"
  exit 0
fi

# Re-verify INSTALL_TARGET itself and its ancestry on every invocation
# (catches a later "chown -R \$USER /usr/local" undoing the install-path
# guarantees).
if [ -f "$INSTALL_TARGET" ]; then
  verify_root_owned_path "$INSTALL_TARGET" || exit 1
  verify_ancestry "$INSTALL_TARGET" || exit 1
fi

# The program token of a displayed command line (the pre-sudo elevation
# lines), drawn the way sudowhat draws its execute: row, so the two lines
# read alike on one screen: the directory's first segment bold cyan (where
# the path is rooted -- /run, /nix and /usr against /Users), the rest of the
# directory plain, the basename bold blue (the program the human sets
# running). A bare name has no directory and is bold blue whole. Scoped to
# the program token: arguments stay plain. Into the variable $1, each part
# escaped in its own color (the path is bytes this script did not choose).
# Called directly, so a failing escaper ends the process (untrusted_var).
prog_disp() { # <var> <program-path-or-name>
  local _pd_dir _pd_first _pd_rest _pd_base
  case "$2" in
    */*)
      _pd_dir="${2%/*}/"
      _pd_first="${_pd_dir#/}"
      _pd_first="${_pd_first%%/*}"
      case "$_pd_dir" in /*) _pd_first="/$_pd_first" ;; esac
      _pd_rest="${_pd_dir#"$_pd_first"}"
      untrusted_var _pd_first "$_pd_first" "$C_CYN$C_B"
      untrusted_var _pd_rest "$_pd_rest"
      untrusted_var _pd_base "${2##*/}" "$C_BLU"
      printf -v "$1" '%s%s%s%s%s%s%s' "$C_CYN$C_B" "$_pd_first" "$C_OFF" "$_pd_rest" \
        "$C_BLU" "$_pd_base" "$C_OFF" ;;
    *)
      untrusted_var _pd_base "$2" "$C_BLU"
      printf -v "$1" '%s%s%s' "$C_BLU" "$_pd_base" "$C_OFF" ;;
  esac
}

# One token of a displayed command line, quoted and escaped into the variable
# $1. Quoting: shq, so a path with a space stays one copyable argument that
# bash, zsh and fish read back as the same bytes. Escaping: a hidden character
# in an argument shows as its escape on the line the human authenticates,
# never raw. $3 is the color the token prints in, resumed after each escape;
# $4 = 2 for stderr. The quoting runs in this shell (printf -v), not a
# command substitution, so a token's trailing newline is not stripped.
elevation_token() { # <var> <token> [resume-SGR] [stream]
  local _et_q
  shq _et_q "$2"
  untrusted_var "$1" "$_et_q" "${3:-}" "${4:-1}"
}

# The exact argv sudo is about to run, one flag-group per line so a long verb
# (a review with many --file/--baseline pairs) reads as a list instead of a
# wrapped wall. Line 1 is `sudo -- <prog> <act>` plus any leading positionals
# (repo/path, which these verbs place before options); each --flag then gets
# its own continuation line, carrying the value that follows it when the next
# token is not itself a flag, with flag names padded to a common column so the
# values align.
#
# INDENT. Continuations sit at 4, two past the caller's own 2-space indent:
# a plain hanging indent that aligns with nothing on line 1. The obvious
# alternative -- 7, putting --file under sudo's `--` -- was rejected: that
# `--` is sudo's end-of-options marker, not a flag of this program, and a
# column that starts with it claims the flag list begins one item earlier
# than it does. (6, the old value, aligned with neither and read as an
# off-by-one near-miss of exactly that column.)
#
# GROUPING. --ignore-json-key is scoped POSITIONALLY to the --file it follows
# (arg parsing refuses one that precedes any --file), and a flat list of
# continuation lines renders that scope invisible -- "which file do the
# ignores apply to" is unanswerable from the display of a command the human
# is about to authenticate. So for a verb with a group-opening flag, the
# flags subordinate to it indent one step further. Extra leading whitespace
# after a backslash continuation is nothing to the shell, so the block stays
# pasteable; a blank line between groups would NOT be, which is why the
# separation is indentation.
#
# Role color as sudowhat's execute: row renders commands -- sudo bold, the
# program through prog_disp, flags bold blue, verb and values plain (paths
# included) -- plus one refinement: a
# --baseline value is a slot-digest path nobody typed (machine-derived), so it
# renders dim to keep the eye on the --file path being approved. The color
# codes go into the DISPLAY string only; the exec sites build argv from the
# variables, never from this. Continuation lines carry a trailing ` \` so the
# whole block stays pasteable.
#
# EVERY TOKEN IS ESCAPED (elevation_token, prog_disp): the program path, the
# leading positionals, each flag and each value are bytes the caller chose,
# and a hidden character in one must show as its escape on the line the
# human authenticates. The flag column is padded by the escaped width, the
# width the reader sees. The block lands in the variable $1, built in this
# shell, so a failing escaper ends the process before a partial line prints.
elevation_cmd_disp() { # var elev action args...
  local _ecd_var="$1" elev="$2" act="$3"
  shift 3
  local fl=() fv=() lead="" seen=0 tok val fw=0 tok_w tok_d
  while [ "$#" -gt 0 ]; do
    tok="$1"; shift
    case "$tok" in
      -*)
        seen=1
        val=""
        if [ "$#" -gt 0 ]; then
          case "$1" in
            -*) ;;                 # next is a flag -> this one takes no value
            *)  val="$1"; shift ;;
          esac
        fi
        fl+=("$tok"); fv+=("$val")
        untrusted_var tok_w "$tok" "" 0
        [ "${#tok_w}" -gt "$fw" ] && fw="${#tok_w}"
        ;;
      *)
        if [ "$seen" -eq 0 ]; then
          elevation_token tok_d "$tok"
          lead="${lead:+$lead }$tok_d"
        else
          fl+=(""); fv+=("$tok")     # stray positional after a flag: own line
        fi
        ;;
    esac
  done

  local prog
  prog_disp prog "$elev"
  local out="${C_B}sudo${C_OFF} -- ${prog} ${act}${lead:+ $lead}"
  # The flag that opens a group for this verb, if any. review is the one verb
  # that takes repeated per-subject groups (--file, then that file's
  # --baseline and --ignore-json-key); every other verb has a flat flag list
  # and leaves this empty, so the indent below never moves for them. Flags
  # BEFORE the first group opener (--store, --yes) are ceremony-wide and
  # correctly stay at base indent.
  local group="" grouped=0 ind
  if [ "$act" = "review" ]; then group="--file"; fi
  # The two indents must not split the value column in two: a group-opening
  # row pads its flag 2 wider, exactly absorbing the step its subordinates
  # take, so every value on the block lands in the same place whichever level
  # its flag sits at. Without grouping there is one level and one width.
  local n="${#fl[@]}" i=0 name name_w name_d padded vcol pw
  while [ "$i" -lt "$n" ]; do
    name="${fl[$i]}"
    pw="$fw"
    if [ -n "$group" ] && [ "$name" = "$group" ]; then
      grouped=1
      ind="    "
      pw=$((fw + 2))
    elif [ "$grouped" -eq 1 ]; then
      ind="      "
    else
      ind="    "
      if [ -n "$group" ]; then pw=$((fw + 2)); fi
    fi
    # Pad OUTSIDE the color so values align: %-*s would count escape bytes.
    untrusted_var name_w "$name" "" 0
    untrusted_var name_d "$name" "$C_BLU"
    printf -v padded '%*s' "$((pw - ${#name_w}))" ''
    [ -z "$name" ] || padded="${C_BLU}${name_d}${C_OFF}${padded}"
    if [ -n "${fv[$i]}" ]; then
      case "$name" in
        --baseline|--baseline-store) vcol="$C_DIM" ;;
        *)          vcol="" ;;
      esac
      elevation_token tok_d "${fv[$i]}" "$vcol"
      out="$out \\"$'\n'"${ind}${padded}  ${vcol}${tok_d}${vcol:+$C_OFF}"
    else
      # No value: emit the bare flag. Padding it would leave trailing blanks
      # before the ` \`, which survive a copy-paste and read as a truncated
      # value on the line the human is auditing.
      out="$out \\"$'\n'"${ind}${C_BLU}${name_d}${C_OFF}"
    fi
    i=$((i + 1))
  done
  printf -v "$_ecd_var" '%s' "$out"
}

# The last line before sudo: what the authentication buys, and a pause to
# leave. No question mark -- y/N is the root side's register, and this gate
# takes no decision away from it; it only announces the root-owned section
# that Enter opens (sudowhat's disclosure, the verify code, the
# authentication sheet), so nothing full-screen arrives unannounced.
#
# One helper for every self-elevating verb: the gate is a security pause,
# and a pause spelled once per site would drift into as many behaviors.
#
# Off-tty there is nobody to answer, so it REFUSES rather than skip the
# checkpoint -- silently proceeding when stdin is redirected would make
# detaching the tty the way around the gate. --yes is the explicit,
# auditable opt-out, and it rides in the argv the display already showed.
# (sudo needs a tty for its own prompt a few lines later anyway, so a
# refusal here just beats a more cryptic failure there.)
#
# The hint names the key you TYPE. It used to name Ctrl-C, which is a
# different reflex from every other gate here and is not an answer the gate
# can log; `n` is, and a typed n now stops as it reads.
#
# <what-stays-unchanged> is the decline line's second half, and each caller
# passes the phrase that is TRUE for the verb it is about to elevate -- the
# same words that verb's own root-side confirm prints, so one decline reads
# as one event on both sides of the seam. Compound verbs (a review AND a
# rebuild) claim neither half and say `nothing ran`.
# 0 when --yes can answer every question this verb asks: the command line
# holds what they decide. The record verbs always; signer only with --key,
# since a --file key is content read after the command was approved.
yes_answers_all() { # argv...
  local a
  case "$action" in
    tombstone|rekey|declare|ignorable) return 0 ;;
    signer)
      for a in "$@"; do [ "$a" = "--file" ] && return 1; done
      return 0 ;;
  esac
  return 1
}

# The contract line before sudo for a record-writing verb: what the root
# side will show, and whether it asks. $1 = the object (record, key, grant).
contract_line() { # <object> argv...
  local obj="$1" a yes=0
  shift
  for a in "$@"; do [ "$a" = "--yes" ] && yes=1; done
  if [ "$yes" -eq 1 ]; then
    printf '%sAs root, the ceremony shows the %s and writes it: --yes answered its\nconfirmation in advance, so it does not ask.%s\n\n' \
      "$C_YEL$C_B" "$obj" "$C_OFF"
  else
    printf '%sAs root, the ceremony shows the %s and confirms -- nothing is written\nuntil you answer y after it.%s\n\n' \
      "$C_YEL$C_B" "$obj" "$C_OFF"
  fi
}

elevation_gate() { # <what-the-root-side-does> <what-stays-unchanged> argv...
  local what="$1" stays="$2" a line
  shift 2
  for a in "$@"; do
    [ "$a" = "--yes" ] && return 0
  done
  if [ ! -t 0 ]; then
    if yes_answers_all "$@"; then
      error "no tty for confirmation -- pass --yes to answer it in advance"
    else
      error "no tty for confirmation -- run it in a terminal"
    fi
    exit 2
  fi
  # Bold carries only the decision (through the `;`); the mechanics that
  # follow are plain, so the weight has something to contrast against. Every
  # key the human types is bold blue -- the same role an option flag wears in
  # a rendered command line, because both are things handed to the program.
  # C_OFF clears dim as well as the key color, so the dim tail is re-opened
  # after each key.
  printf -v line '%s%s as root;%s %sEnter%s run %s· %s%sn%s%s stop%s ' \
    "$C_B" "$what" "$C_OFF" "$C_BLU" "$C_OFF" \
    "$C_DIM" "$C_OFF" "$C_BLU" "$C_OFF" "$C_DIM" "$C_OFF"
  if ! gate_answer "$line"; then
    printf '%sstopped; %s%s\n' "$C_YEL" "$stays" "$C_OFF"
    exit 2
  fi
  # THE PROCESS SEAM. The gate line's own newline is the user's Enter echo,
  # so this blank is the one separator between pinned and the root-owned
  # section: after the exec, sudo (and sudowhat's block, where installed)
  # starts flush.
  printf '\n'
}

# Root-requiring actions self-elevate: re-exec the INSTALLED (root-owned,
# digest-pinned) binary under sudo so the elevated code is never a copy the
# invoker could have modified. Pre-install (setup from a checkout) falls
# back to this script's own path. Sits after the helper definitions so the
# review preview below can reuse them.
#
# --yes answers every question a verb asks, so it exists only where the
# command line holds what those questions decide (yes_answers_all): the
# record verbs, signer with --key, and setup, whose plan is confirmed before
# sudo. A review's y/N follows a diff, so review has none (--words is its
# command-line form). It is refused before sudo, so it costs nothing.
case "$action" in
  review|setup|tombstone|rekey|declare)
    if [ "$EUID" -ne 0 ]; then
      if [ "$action" = review ]; then
        for a in "$@"; do [ "$a" = "--yes" ] && usage; done
      fi
      # tombstone without exactly its <path> can only ever reach usage --
      # fail here, before authentication costs a sudo prompt. (--yes
      # answers the y/N and is not the path.)
      if [ "$action" = "tombstone" ]; then
        ts_paths=0
        for a in "$@"; do [ "$a" = "--yes" ] || ts_paths=$((ts_paths + 1)); done
        [ "$ts_paths" -eq 1 ] || usage
      fi
      # rekey: two paths that differ, and an old path that is really gone --
      # every one of those is checkable free, so none of them costs an
      # authentication. The peek below is orientation only; the root side
      # re-reads the slot and stays the authority.
      if [ "$action" = "rekey" ]; then
        # Two positionals in order.
        rk_old_arg="" rk_new_arg=""
        for a in "$@"; do
          if [ "$a" = "--yes" ]; then :
          elif [ -z "$rk_old_arg" ]; then rk_old_arg="$a"
          elif [ -z "$rk_new_arg" ]; then rk_new_arg="$a"
          else usage; fi
        done
        [ -n "$rk_new_arg" ] || usage
        rk_old="$(canon_path "$rk_old_arg")" || exit 1
        rk_new="$(canon_path "$rk_new_arg")" || exit 1
        if [ "$rk_old" = "$rk_new" ]; then
          refused "old and new name the same path: " "$rk_old"
          exit 1
        fi
        rk_gone=0; path_gone "$rk_old" || rk_gone=$?
        if [ "$rk_gone" -eq 2 ]; then
          refused "cannot tell whether the old path still exists, and a rekey follows only a move that happened: " "$rk_old"
          exit 1
        fi
        if [ "$rk_gone" -eq 1 ]; then
          refused "the old path still exists, and you rekey a record whose content has already moved: " "$rk_old"
          say_err "        move the content first, or review the new path instead: " "$rk_new"
          exit 1
        fi
        # The root side's rows, in its order: each path ends its row, the
        # old one's state a fixed-set word in a column before it, and the
        # paths escaped -- they are bytes anyone could have chosen.
        untrusted_var rk_old_disp "$rk_old"
        untrusted_var rk_new_disp "$rk_new" "$C_CYN"
        printf '%sold:%s        gone  %s\n' "$C_B" "$C_OFF" "$rk_old_disp"
        printf '%snew:%s              %s%s%s\n' "$C_B" "$C_OFF" "$C_CYN" "$rk_new_disp" "$C_OFF"
        rk_slot="$(slot_dir_for "$(tier_user)" "$rk_old")"
        # Nothing is CONCLUDED from what this peek cannot see: the tier is
        # root-only until the group exists, so an absent-looking slot may
        # simply be one this user cannot traverse. Hence one honest line for
        # both, and no refusal built on it.
        if [ -d "$rk_slot" ] && inspect_slot "$rk_slot" 2>/dev/null \
           && [ "$slot_state" != none ]; then
          case "$slot_state" in
            rev) rk_kind="  ${C_DIM}(repo record)${C_OFF}" ;;
            pin) rk_kind="  ${C_DIM}(file record)${C_OFF}" ;;
            *)   rk_kind="" ;;
          esac
          printf '%srecord:%s     %s%s%s%s\n' "$C_B" "$C_OFF" \
            "$C_CYN" "${slot_file##*/}" "$C_OFF" "$rk_kind"
          printf '%sslot:%s       %s\n' "$C_B" "$C_OFF" "$(show_slot "$rk_slot")"
        else
          printf '%srecord:%s     %s(none visible from here; the root side reads it and answers)%s\n' \
            "$C_B" "$C_OFF" "$C_DIM" "$C_OFF"
        fi
        echo
      fi
      # declare: an argv that can only ever reach a root-side argument error
      # fails here, before authentication costs a sudo prompt (the
      # tombstone/rekey precedent): the repo present and a directory, exactly
      # one of --release <name> / --no-release, and the name inside the
      # declared-name grammar. The root side re-checks every one of these
      # and stays the authority.
      if [ "$action" = "declare" ]; then
        dc_repo="" dc_tag="" dc_remove=0 dc_want=0
        for a in "$@"; do
          if [ "$dc_want" -eq 1 ]; then dc_tag="$a"; dc_want=0; continue; fi
          case "$a" in
            --release) dc_want=1 ;;
            --no-release) dc_remove=1 ;;
            --yes) ;;
            -*) usage ;;
            *)
              [ -z "$dc_repo" ] || usage
              dc_repo="$a" ;;
          esac
        done
        [ "$dc_want" -eq 0 ] || { echo "--release needs a name" >&2; exit 1; }
        [ -n "$dc_repo" ] || usage
        [ -d "$dc_repo" ] || { say_err "not a directory: " "$dc_repo"; exit 1; }
        if [ -n "$dc_tag" ] && [ "$dc_remove" -eq 1 ]; then usage; fi
        if [ -z "$dc_tag" ] && [ "$dc_remove" -eq 0 ]; then usage; fi
        if [ -n "$dc_tag" ] && ! validate_release_name "$dc_tag"; then
          untrusted_var dc_disp "$dc_tag" "" 2
          error "a release name outside the declared-name grammar [A-Za-z0-9._/+-]: $dc_disp"
          exit 1
        fi
      fi
      # setup: show the plan and confirm BEFORE sudo, so reading what it
      # will do never costs an authentication.
      if [ "$action" = "setup" ]; then
        want_yes=0
        for a in "$@"; do [ "$a" = "--yes" ] && want_yes=1; done
        if [ "$want_yes" -eq 0 ]; then
          setup_plan "$(id -un)"
          printf '%srun this setup? [%sy%s/%sN%s]%s ' "$C_B" "$C_BLU" "$C_OFF$C_B" "$C_BLU" "$C_OFF$C_B" "$C_OFF"
          drain_tty
          read -r answer </dev/tty
          case "$answer" in
            y|Y|yes) ;;
            *) echo "aborted; nothing installed"; exit 2 ;;
          esac
          set -- --yes "$@"
        fi
      fi
      # review: an unprivileged PREVIEW of what authenticating will let
      # you review, so the sudo prompt never arrives context-free. This is
      # orientation only -- the authoritative review re-derives everything
      # from the object store as root, after sudo.
      if [ "$action" = "review" ]; then
        preview_repos=() preview_tag="" skip_next=0 want_tag=0 file_mode=0 have_ev=0
        preview_step=0 preview_trust=0 preview_signed=0 preview_decl=""
        preview_words="" want_words=0 preview_commits="" want_commits=0 want_file=0
        # Empty or the word the listing reads, like preview_decl's class.
        preview_msg=""
        # Counted here rather than re-derived at the gate: the gate promises a
        # number, and the only honest source for it is the argv it is about to
        # hand to sudo. (Repos get their own count below -- the ones already at
        # their pin are skipped, so the argv count would overstate the round.)
        preview_files=0 preview_todo=0
        for a in "$@"; do
          if [ "$want_tag" -eq 1 ]; then preview_tag="$a"; want_tag=0; continue; fi
          if [ "$want_words" -eq 1 ]; then preview_words="$a"; want_words=0; continue; fi
          if [ "$want_commits" -eq 1 ]; then preview_commits="$a"; want_commits=0; continue; fi
          # A --file path heads the ceremony's diff as its label, so one
          # holding a line feed is refused here, before authentication, as
          # the root side refuses it (see its --file arm).
          if [ "$want_file" -eq 1 ]; then
            case "$a" in
              *"$NL"*) refused "a path holding a line feed cannot head a diff: " "$a"; exit 1 ;;
            esac
            want_file=0; continue
          fi
          if [ "$skip_next" -eq 1 ]; then skip_next=0; continue; fi
          case "$a" in
            --signed-tag) have_ev=1; preview_signed=1; skip_next=1 ;;
            # Evidence, and the one review that runs with no terminal: the
            # words on this argv are its answer (below).
            --words) have_ev=1; want_words=1 ;;
            # The size of what --words approves, in the dialog beside them.
            --commits)
              [ -z "$preview_commits" ] || { echo "--commits may be given once" >&2; exit 1; }
              want_commits=1 ;;
            --file) file_mode=1; preview_files=$((preview_files + 1)); want_file=1 ;;
            --baseline|--baseline-store|--algo) skip_next=1 ;;
            --tag) have_ev=1; want_tag=1 ;;
            --trust) have_ev=1; preview_trust=1 ;;
            # A bare flag, not evidence -- it says HOW the review is read,
            # not why the commit is trusted. It still binds to one repo.
            --step) preview_step=1 ;;
            # A reading aid too, and the loosest of them: it binds to no
            # repo and combines with everything the review can be.
            --messages) preview_msg=messages ;;
            # Not evidence either: an ancestry DECLARATION says which way
            # the pin is being moved. It binds to one repo like the rest.
            --backward|--diverged)
              case "$preview_decl" in
                ''|"${a#--}") preview_decl="${a#--}" ;;
                *) echo "--backward and --diverged declare different relationships; give one" >&2
                   exit 1 ;;
              esac ;;
            -*) ;;
            *) preview_repos+=("$a") ;;
          esac
        done
        # A bare review -- no repo, no --file -- can only ever reach
        # usage; fail here, before authentication costs a sudo prompt.
        if [ "${#preview_repos[@]}" -eq 0 ] && [ "$file_mode" -eq 0 ]; then usage; fi
        # --step's refusals, mirrored pre-sudo. The root side re-checks every
        # one of these (it is the authority); refusing here only saves the
        # wasted authentication.
        if [ "$preview_step" -eq 1 ]; then
          if [ "$file_mode" -eq 1 ]; then
            echo "--file is its own ceremony; --step does not combine with it" >&2
            exit 1
          fi
          if [ "$preview_trust" -eq 1 ]; then
            echo "--step is a per-commit review walk; --trust skips review" >&2
            exit 1
          fi
          if [ "$preview_signed" -eq 1 ]; then
            echo "--step is a per-commit review walk; signature evidence has no per-commit reading" >&2
            exit 1
          fi
          if [ -n "$preview_decl" ]; then
            echo "--step walks the commits between the pin and the endpoint, which only exist going forward;" >&2
            echo "review --$preview_decl without --step: the whole-delta diff shows what actually changes" >&2
            exit 1
          fi
        fi
        # --messages has exactly one refusal, mirrored here for the same
        # reason: a file ceremony lists no commits, so the flag would
        # silently do nothing.
        if [ -n "$preview_msg" ] && [ "$file_mode" -eq 1 ]; then
          echo "--file is its own ceremony; --messages does not combine with it" >&2
          exit 1
        fi
        # The ancestry declarations' own refusals, mirrored pre-sudo like
        # --step's. (The classification itself happens per repo below, where
        # the pin is read.)
        if [ -n "$preview_decl" ]; then
          if [ "$file_mode" -eq 1 ]; then
            echo "--file is its own ceremony; the ancestry declarations do not combine with it" >&2
            exit 1
          fi
          if [ "$preview_trust" -eq 1 ]; then
            echo "--trust vouches for a first approval; there is no pin to move --$preview_decl from" >&2
            exit 1
          fi
        fi
        # Selector and evidence flags name ONE commit of ONE repo, and the
        # step walk is one interactive read of one repo; a batch they cannot
        # bind to dies here, pre-sudo (the root side re-checks).
        if [ "${#preview_repos[@]}" -gt 1 ] \
          && { [ "$have_ev" -eq 1 ] || [ "$preview_step" -eq 1 ] || [ -n "$preview_decl" ]; }; then
          echo "--tag, --signed-tag, --trust, --words, --step and the ancestry declarations bind to one repo; review multiple repos plain" >&2
          exit 1
        fi
        # --words' refusals, mirrored like --step's; the root side re-checks
        # every one, and the move's direction once it reads the pin.
        if [ "$want_words" -eq 1 ]; then
          echo "--words needs the six words, joined by hyphens" >&2
          exit 1
        fi
        if [ "$want_commits" -eq 1 ]; then
          echo "--commits needs the number of commits the words approve" >&2
          exit 1
        fi
        if [ -n "$preview_commits" ] && [ -z "$preview_words" ]; then
          echo "--commits goes with --words: it states how many commits the words approve" >&2
          exit 1
        fi
        if [ -n "$preview_words" ]; then
          if ! valid_words_arg "$preview_words"; then
            echo "--words takes six words from the list, joined by hyphens: w1-w2-w3-w4-w5-w6" >&2
            exit 1
          fi
          if [ -z "$preview_commits" ]; then
            echo "--words needs --commits N, the number of commits since the pin it approves" >&2
            exit 1
          fi
          if ! valid_commits_arg "$preview_commits"; then
            echo "--commits takes a count of one or more, e.g. --commits 3" >&2
            exit 1
          fi
          if [ "$file_mode" -eq 1 ]; then
            echo "--file is its own ceremony; --words does not combine with it" >&2
            exit 1
          fi
          if [ "$preview_trust" -eq 1 ] || [ "$preview_signed" -eq 1 ]; then
            echo "--words is its own evidence; it does not combine with --trust or --signed-tag" >&2
            exit 1
          fi
          if [ "$preview_step" -eq 1 ]; then
            echo "--step reads every commit; --words approves without reading" >&2
            exit 1
          fi
          if [ -n "$preview_decl" ]; then
            echo "--words approves a forward move only; review --$preview_decl without it" >&2
            exit 1
          fi
        fi
        # The restatement floor, mirrored like --step's refusals: a review
        # that leaves a kept extra unstated would refuse root-side, so it
        # refuses here before costing the authentication. A slot this side
        # cannot read simply passes; the root side re-checks every file.
        if [ "$file_mode" -eq 1 ]; then
          rf_files=() rf_ign_stated=() rf_cust_stated=() rf_typed=() rf_keys=() rf_keep=()
          skip_next=0 skip_next_file=0 want_key=0
          for a in "$@"; do
            if [ "$skip_next" -eq 1 ]; then
              if [ "$skip_next_file" -eq 1 ]; then
                rf_files+=("$a"); rf_ign_stated+=(0); rf_cust_stated+=(0); rf_typed+=(0)
                rf_keys+=(""); rf_keep+=(0)
              fi
              if [ "$want_key" -eq 1 ] && [ "${#rf_files[@]}" -gt 0 ]; then
                last=$((${#rf_files[@]} - 1))
                rf_keys[last]="${rf_keys[last]:+${rf_keys[last]} }$a"
              fi
              skip_next=0; want_key=0; continue
            fi
            skip_next_file=0
            last=$((${#rf_files[@]} - 1))
            case "$a" in
              --file) skip_next=1; skip_next_file=1 ;;
              --ignore-json-key|--ignore-none)
                [ "$last" -lt 0 ] || { rf_ign_stated[last]=1; rf_typed[last]=1; }
                [ "$a" = "--ignore-none" ] || { skip_next=1; want_key=1; } ;;
              --store|--no-store)
                [ "$last" -lt 0 ] || { rf_cust_stated[last]=1; rf_typed[last]=1; } ;;
              --keep)
                [ "$last" -lt 0 ] || { rf_ign_stated[last]=1; rf_cust_stated[last]=1; rf_keep[last]=1; } ;;
              --baseline|--baseline-store|--algo) skip_next=1 ;;
            esac
          done
          restate_floor "$(tier_user)" "$@" || exit 1
          # The ladder rung for kept keys, mirrored the same way: a key the
          # slot declares but the policy no longer grants would refuse
          # root-side. Anything this side cannot read passes to the root
          # side, which checks every file again.
          pv_tier="$(tier_user)" pv_i=0
          if command -v jq >/dev/null 2>&1 && load_policy "$pv_tier" 2>/dev/null; then
            while [ "$pv_i" -lt "${#rf_files[@]}" ]; do
              if [ "${rf_keep[$pv_i]}" -eq 1 ] \
                 && pv_p="$(canon_path "${rf_files[$pv_i]}" 2>/dev/null)" \
                 && pv_slot="$(slot_dir_for "$pv_tier" "$pv_p")" \
                 && slot_declares_ignore "$pv_slot" \
                 && read_ignored_paths "$pv_slot" 2>/dev/null; then
                pv_typed="[]"
                [ -z "${rf_keys[$pv_i]}" ] || pv_typed="$(ign_paths_json "${rf_keys[$pv_i]}")"
                if pv_json="$(jq -c -n --argjson a "$IGN_PATHS" --argjson b "$pv_typed" '$a + ($b - $a)' 2>/dev/null)" \
                   && ! policy_check_declaration "$POL_EFF" "$pv_json" "$pv_p"; then
                  echo "        a kept key lost its grant: list the keys to keep without --keep, or --ignore-none" >&2
                  exit 1
                fi
              fi
              pv_i=$((pv_i + 1))
            done
          fi
        fi
        if [ "${#preview_repos[@]}" -gt 0 ] && [ "$file_mode" -eq 0 ]; then
          # One preview per repo; sequential root-side ceremonies follow,
          # sharing the single authentication below.
          # The already-pinned verdicts are held until every listing is
          # out (preview_after): a verdict prints after the last
          # third-party text on the screen, and a later repo's listing is
          # third-party text.
          all_pinned=1 first_prev=1 preview_after="" preview_disp=""
          for preview_repo in "${preview_repos[@]}"; do
            resolve_repo "$preview_repo"
            # A bad --tag name dies HERE, pre-sudo -- failing early is the
            # point of the preview.
            if [ -n "$preview_tag" ]; then
              preview_head="$(sgit rev-parse "refs/tags/${preview_tag}"'^{commit}')"
            else
              preview_head="$(sgit rev-parse 'HEAD^{commit}')"
            fi
            # Errors silenced: the tree may be root-only pre-group, and the
            # root-side re-derivation is authoritative anyway. Only a refusal
            # (1) reads as "no pin"; a record naming a former spelling of
            # this path (2) still yields the pin, plus the fact that the slot
            # is stale for this spelling.
            preview_rc=0
            preview_pin="$(read_rev "$default_slot" "$repo" 2>/dev/null)" || preview_rc=$?
            [ "$preview_rc" -ne 1 ] || preview_pin=""
            # A stepped walk needs a pin to step FROM. (An unreadable slot
            # reads as "no pin" here because the read above is silenced; the
            # root side answers such a slot with its own, accurate refusal.)
            if [ "$preview_step" -eq 1 ] && [ -z "$preview_pin" ]; then
              echo "first approval reviews the full tree; review without --step" >&2
              exit 1
            fi
            if [ -n "$preview_words" ] && [ -z "$preview_pin" ]; then
              echo "a first approval reads the full tree; --words approves a forward move from a pin only" >&2
              exit 1
            fi
            # Same short-circuit the privileged side would take -- but here it
            # costs no authentication. The pin is root-owned; HEAD is the
            # repo the caller is looking at.
            #
            # EXCEPT when the slot is stale for this spelling of the path --
            # its record names a former spelling, or its directory still
            # wears one (THE SLOT-NAME INVARIANT, above slot_name_actual).
            # The repair is root's (the ceremony makes it at entry), so this
            # repo still needs its ceremony even at its pin -- skipping here
            # would leave a record and a listing that disagree about which
            # path this pin covers, with no verb that ever fixes it.
            if [ -n "$preview_pin" ] && [ "$preview_pin" = "$preview_head" ]; then
              untrusted_var preview_disp "$repo"
              preview_after="$preview_after${C_GRN}already pinned:${C_OFF} ${C_DIM}${preview_head}${C_OFF}  ${preview_disp}$NL"
              if [ "$preview_rc" -eq 2 ]; then
                preview_after="$preview_after${C_YEL}note: the record names a former spelling of this path; the ceremony re-states it${C_OFF}$NL"
                all_pinned=0
                preview_todo=$((preview_todo + 1))
              elif [ -n "$(slot_name_actual "$default_slot")" ]; then
                preview_after="$preview_after${C_YEL}note: the slot directory wears a former spelling of this path; the ceremony renames it${C_OFF}$NL"
                all_pinned=0
                preview_todo=$((preview_todo + 1))
              fi
              continue
            fi
            all_pinned=0
            preview_todo=$((preview_todo + 1))
            [ "$first_prev" -eq 1 ] || echo
            first_prev=0
            # THE ANCESTRY FLOOR, mirrored: an undeclared backward or
            # diverged move is refused HERE, so it never costs an
            # authentication, and a declared one gets its alarm before the
            # sudo prompt rather than after it. Classification is free
            # unprivileged -- the pin is world-readable in the tier and the
            # commit graph is the caller's own checkout. The root side
            # re-derives all of it and stays the authority.
            #
            # An unreadable slot read as "no pin" above simply classifies
            # nothing here; the root side answers such a slot accurately.
            ancestry_floor "$repo" "$preview_pin" "$preview_head" "$preview_decl" || exit 1
            print_repo_row "$C_B"
            if [ -n "$preview_tag" ]; then
              untrusted_var tag_disp "$preview_tag"
              printf '%stag:%s        %s\n' "$C_B" "$C_OFF" "$tag_disp"
              subject_var subj "$preview_head" "$C_DIM"
              printf '%scandidate:%s  %s%s%s  %s%s%s\n' "$C_B" "$C_OFF" "$C_CYN" "$preview_head" "$C_OFF" \
                "$C_DIM" "$subj" "$C_OFF"
            else
              subject_var subj "$preview_head" "$C_DIM"
              printf '%sgit HEAD:%s   %s%s%s  %s%s%s\n' "$C_B" "$C_OFF" "$C_CYN" "$preview_head" "$C_OFF" \
                "$C_DIM" "$subj" "$C_OFF"
            fi
            if [ -n "$preview_pin" ]; then
              printf '%spinned:%s     %s%s%s\n' "$C_B" "$C_OFF" "$C_CYN" "$preview_pin" "$C_OFF"
              if [ -n "$ancestry_mb" ]; then
                printf '%sancestor:%s   %s%s%s\n' "$C_B" "$C_OFF" "$C_CYN" "$ancestry_mb" "$C_OFF"
              fi
              if [ "$preview_pin" != "$preview_head" ]; then
                echo
                print_ancestry_listing "$ancestry_cls" "$preview_pin" "$preview_head" \
                  "$ancestry_mb" label '  ' "$preview_msg"
                # --commits, mirrored: the count is free to take here, over
                # the same range the listing just printed. The root side
                # counts again against its own read of the pin.
                if [ -n "$preview_words" ]; then
                  preview_n="$(sgit rev-list --count "${preview_pin}..${preview_head}")"
                  if [ "$preview_n" != "$preview_commits" ]; then
                    echo
                    refuse_commits_count "$preview_n" "$preview_commits"
                    exit 1
                  fi
                fi
                if [ "$preview_step" -eq 1 ]; then
                  # Counted with the walk's OWN enumeration, so the number
                  # promised here is the number of confirmations that arrive.
                  preview_steps="$(sgit log --reverse --first-parent --format=%H \
                    "${preview_pin}..${preview_head}" | wc -l | tr -d ' ')"
                  printf '  %sstepping: %s commit%s, oldest first, one confirmation each%s\n' \
                    "$C_DIM" "$preview_steps" "$(plural_s "$preview_steps")" "$C_OFF"
                fi
                # A declared backward or diverged move's alarm, below the
                # listing it is about (one repo only: declarations bind to
                # one), before the sudo prompt.
                ancestry_verdict "$preview_pin" "$preview_head" lead
              fi
            else
              printf '%spinned:%s     (none -- first approval)\n' "$C_B" "$C_OFF"
            fi
          done
          if [ -n "$preview_after" ]; then
            [ "$first_prev" -eq 1 ] || echo
            printf '%s' "$preview_after"
          fi
          # Every named repo is already at its pin: the whole invocation
          # is a no-op, and it costs no authentication to say so.
          if [ "$all_pinned" -eq 1 ]; then
            printf '%s(nothing to approve; no authentication needed)%s\n' "$C_DIM" "$C_OFF"
            exit 0
          fi
          echo
        fi
        # The sudo dialog shows this argv and the directory it runs in, in a
        # few hundred characters. So the repo goes by the full path the
        # preview resolved (the one repo --words binds to), and the exec
        # below runs from / -- the root side never reads the directory.
        if [ -n "$preview_words" ]; then
          words_argv=() skip_next=0
          for a in "$@"; do
            if [ "$skip_next" -eq 1 ]; then words_argv+=("$a"); skip_next=0; continue; fi
            case "$a" in
              --tag|--words|--commits) words_argv+=("$a"); skip_next=1 ;;
              -*) words_argv+=("$a") ;;
              *) words_argv+=("$repo") ;;
            esac
          done
          set -- "${words_argv[@]}"
        fi
      fi
      elev="$INSTALL_TARGET"
      if [ -x "$elev" ]; then
        # Refuse to hand sudo a target that is not root-owned end to end.
        # Not hypothetical: old Homebrew left /usr/local user-owned on
        # many Intel Macs, which would make the "installed" copy exactly
        # as swappable as the checkout.
        verify_root_owned_path "$elev" || exit 1
        verify_ancestry "$elev" || exit 1
      else
        # Pre-install fallback: the checkout copy is USER-WRITABLE, so
        # running it as root is only safe in the bootstrap window right
        # after a hand-read. Never silent: warn and confirm. (setup is
        # exempt -- installing the just-read checkout is its whole job.)
        elev="$(readlink -f "$0")"
        if [ "$action" != "setup" ]; then
          # The question block: the warning and the safer route (advice),
          # the copy the question is about on its row, the consequence, the
          # question -- which names its object by that row's label.
          printf '%swarning: pinned is not installed at %s%s\n' "$C_YEL$C_B" "$INSTALL_TARGET" "$C_OFF"
          printf '%s  Safer: stage with trusted tooling, read the root-owned copy,%s\n' "$C_YEL" "$C_OFF"
          printf '%s  promote it, rerun (README: "Bootstrap without executing%s\n' "$C_YEL" "$C_OFF"
          printf '%s  unverified code"):%s\n' "$C_YEL" "$C_OFF"
          printf '    sudo /usr/bin/install -d -o root -g wheel -m 755 %s\n' "$(dirname "$INSTALL_TARGET")"
          printf '    sudo /usr/bin/install -o root -g wheel -m 444 \\\n'
          printf '      %s %s-unverified\n' "$elev" "$INSTALL_TARGET"
          printf '    less %s-unverified\n' "$INSTALL_TARGET"
          printf '    sudo mv %s-unverified %s\n' "$INSTALL_TARGET" "$INSTALL_TARGET"
          printf '    sudo chmod 755 %s\n' "$INSTALL_TARGET"
          untrusted_var elev_disp "$elev"
          printf '%scopy:%s       %s\n' "$C_B" "$C_OFF" "$elev_disp"
          printf '%sThis copy is user-writable, and it runs as root: run it only if you have just%s\n' "$C_YEL" "$C_OFF"
          printf '%sread this exact file and trust your user-space not to have swapped it since.%s\n' "$C_YEL" "$C_OFF"
          printf '%srun this copy? [%sy%s/%sN%s]%s ' "$C_B" "$C_BLU" "$C_OFF$C_B" "$C_BLU" "$C_OFF$C_B" "$C_OFF"
          drain_tty
          read -r answer </dev/tty
          case "$answer" in
            y|Y|yes) ;;
            *) echo "aborted; nothing ran" ; exit 2 ;;
          esac
        fi
      fi
      # Say what the authentication buys BEFORE sudo asks for it: the
      # contract, then the exact command, then the gate. There is no prose
      # header over the command any more -- the argv already begins with
      # `sudo` and the gate already says "as root (sudo)", so a third
      # statement of the same fact was the redundant one. The ownership and
      # digest details that used to follow said nothing the checks just above
      # had not already enforced.
      #
      # THIS COMMAND LINE IS THE PRE-AUTH DISCLOSURE, and on a host without
      # sudowhat it is the ONLY one: nothing root-side reprints the argv
      # before the authentication sheet. It is printed unconditionally for
      # that reason -- never conditioned on some other tool being installed,
      # which would make its absence a lie by omission.
      #
      # THE CONTRACT LINE BELONGS TO WHOEVER ORIENTED. It says "the preview
      # above", so it is printed by the process that printed that preview:
      # pinned, for the repo verbs, whose preview is a few lines up. A
      # `review --file` has no preview of its own -- the launcher that
      # measured the files printed the index and owns the sentence there --
      # so pinned saying it too would either double the launcher's line, or
      # point at nothing at all on a direct invocation.
      if [ "$action" = "review" ] && [ "$elev" = "$INSTALL_TARGET" ]; then
        if [ -n "${preview_words:-}" ]; then
          printf '%sThe preview above was orientation only. As root, pinned compares the\n' "$C_DIM"
          printf 'words and the count with the commit it resolves and approves on a match.%s\n\n' "$C_OFF"
        elif [ "${file_mode:-0}" -eq 0 ]; then
          printf '%sThe preview above was orientation only. The sudo ceremony re-derives\n' "$C_DIM"
          printf 'everything it displays, and nothing is pinned until you confirm there.%s\n\n' "$C_OFF"
        fi
        elevation_cmd_disp elev_cmd "$elev" "$action" "$@"
        printf '  %s\n\n' "$elev_cmd"
        # What the gate counts is what the root side will actually do: the
        # files named on the command line, or the repos that survived the
        # preview's already-pinned skip. --words has no gate here: its caller
        # has no terminal, and the words on this argv answer in advance.
        if [ -n "${preview_words:-}" ]; then
          :
        elif [ "${file_mode:-0}" -eq 1 ]; then
          elevation_gate "review $preview_files file$(plural_s "$preview_files")" "record unchanged" "$@"
        else
          elevation_gate "review $preview_todo repo$(plural_s "$preview_todo")" "pin unchanged" "$@"
        fi
      fi
      # tombstone, rekey and declare: the same handoff shape as
      # signer/ignorable. Their root sides show the record and take the
      # y/N, so the contract line says that; the command and the gate
      # follow, because a record verb is still a trust mutation and its
      # argv is still the pre-auth disclosure (rekey's preview above is
      # orientation, like review's).
      if { [ "$action" = "tombstone" ] || [ "$action" = "rekey" ] || [ "$action" = "declare" ]; } \
        && [ "$elev" = "$INSTALL_TARGET" ]; then
        # Under --yes the root side asks nothing (see do_tombstone), so the
        # contract line must not promise a y/N. Neither line names sudo's
        # authentication as the consent: whether sudo asks is the system's
        # policy, and a cached credential asks nothing.
        contract_line record "$@"
        elevation_cmd_disp elev_cmd "$elev" "$action" "$@"
        printf '  %s\n\n' "$elev_cmd"
        if [ "$action" = "tombstone" ]; then
          elevation_gate "tombstone the record" "slot unchanged" "$@"
        elif [ "$action" = "rekey" ]; then
          elevation_gate "re-key the record" "both slots unchanged" "$@"
        elif [ "$dc_remove" -eq 1 ]; then
          elevation_gate "clear the declaration" "record unchanged" "$@"
        else
          elevation_gate "declare the release name" "record unchanged" "$@"
        fi
      fi
      # --words: from /, so the directory sudo reports is not one the root
      # side would ever read. Whether sudo asks is the system's policy.
      if [ -n "${preview_words:-}" ]; then
        cd /
        exec sudo -- "$elev" "$action" "$@"
      fi
      exec sudo -- "$elev" "$action" "$@"
    fi
    ;;
  signer|ignorable)
    # add/remove write root-owned files; list stays unprivileged. One arm
    # for both verbs: they share the sub-verb shape, and the exec below
    # re-execs whichever $action asked for it.
    case "${1:-}" in
      add|remove)
        if [ "$EUID" -ne 0 ]; then
          # --yes with a --file key is refused here like the root side does.
          if [ "$action" = signer ] && ! yes_answers_all "$@"; then
            for a in "$@"; do
              [ "$a" = "--yes" ] && { echo "--yes takes the key on the command line: --key 'LINE', not --file" >&2; exit 1; }
            done
          fi
          # Argv that can only ever reach a root-side argument error fails
          # HERE, before authentication costs a sudo prompt -- the same
          # contract as review's preview. Grammar and content stay
          # root-side; presence of the ceremony's object is checkable free.
          if [ "$action" = "signer" ]; then
            has_key=0 skip_next=0
            for a in "$@"; do
              if [ "$skip_next" -eq 1 ]; then skip_next=0; continue; fi
              case "$a" in
                --file|--key) has_key=1; skip_next=1 ;;
                --repo|--principal) skip_next=1 ;;
              esac
            done
            if [ "$has_key" -eq 0 ]; then
              echo "signer $1 needs the key: --file PUBKEY or --key 'LINE'" >&2
              exit 1
            fi
          else
            ign_key="" skip_next=0 first=1
            for a in "$@"; do
              if [ "$first" -eq 1 ]; then first=0; continue; fi
              if [ "$skip_next" -eq 1 ]; then skip_next=0; continue; fi
              case "$a" in
                --under) skip_next=1 ;;
                -*) ;;
                *) ign_key="$a" ;;
              esac
            done
            if [ -z "$ign_key" ]; then
              echo "ignorable $1 needs a key, e.g. model or statusLine.command" >&2
              exit 1
            fi
          fi
          elev="$INSTALL_TARGET"
          if [ -x "$elev" ]; then
            verify_root_owned_path "$elev" || exit 1
            verify_ancestry "$elev" || exit 1
          else
            elev="$(readlink -f "$0")"
            # The review arm's question block, without its safer route.
            printf '%swarning: pinned is not installed at %s%s\n' "$C_YEL" "$INSTALL_TARGET" "$C_OFF"
            untrusted_var elev_disp "$elev"
            printf '%scopy:%s       %s\n' "$C_B" "$C_OFF" "$elev_disp"
            printf '%sThis copy is user-writable, and it runs as root: run it only right after a hand-read.%s\n' \
              "$C_YEL" "$C_OFF"
            printf '%srun this copy? [%sy%s/%sN%s]%s ' "$C_B" "$C_BLU" "$C_OFF$C_B" "$C_BLU" "$C_OFF$C_B" "$C_OFF"
            drain_tty
            read -r answer </dev/tty
            case "$answer" in
              y|Y|yes) ;;
              *) echo "aborted; nothing ran"; exit 2 ;;
            esac
          fi
          # The pre-sudo handoff review gives, in the same shape and the
          # same order: what the authentication buys, the exact command,
          # the gate. No prose header over the command -- see the long
          # comment at review's arm for why that line went away. The root
          # side stays authoritative -- it displays the object and
          # confirms before writing.
          if [ "$elev" = "$INSTALL_TARGET" ]; then
            contract_line "$([ "$action" = signer ] && echo "key" || echo "grant")" "$@"
            elevation_cmd_disp elev_cmd "$elev" "$action" "$@"
            printf '  %s\n\n' "$elev_cmd"
            # The verb reads off the sub-verb: what root does with the key or
            # the grant, in the words the ceremony itself uses.
            case "$action $1" in
              "signer add")       elevation_gate "record the key" "signers unchanged" "$@" ;;
              "signer remove")    elevation_gate "remove the key" "signers unchanged" "$@" ;;
              "ignorable add")    elevation_gate "record the grant" "policy unchanged" "$@" ;;
              "ignorable remove") elevation_gate "withdraw the grant" "policy unchanged" "$@" ;;
            esac
          fi
          exec sudo -- "$elev" "$action" "$@"
        fi
        ;;
    esac
    ;;
esac

# ---- review ------------------------------------------------------------------

do_approve() {
  require_root review

  # Orthogonal surface: --tag selects WHICH commit (default HEAD) and, once
  # slots record names, what deploy declares; the evidence flags say WHY it
  # is trusted (--signed-tag verifies, --trust vouches, default is content
  # review). --signed-tag may repeat: threshold multisig. Every named tag
  # must verify against the allowed signers AND name the same commit, or
  # nothing is pinned. k-of-n is the caller demanding whichever k tags they
  # trust.
  local trust=0 repo_args sel_tag="" tag_args files file_base file_ign file_ign_none file_store file_keep file_algo=sha256 algo_given=0
  local ign_given=0 keep_given=0 last step=0 decl_class="" baseline_store=""
  # Empty or the word print_commit_range reads, like decl_class: every
  # listing site passes it through untouched, so there is no 0/1 to
  # translate on the way down.
  local msg_mode=""
  # The six words of the commit being approved, hyphen-joined (approve by
  # words, above commit_words). Empty: the review reads, as always.
  local words_arg="" commits_arg=""
  # The argv as given, for the restatement floor's paste-ready line.
  local review_argv
  review_argv=("$@")
  repo_args=(); tag_args=(); files=(); file_base=(); file_ign=(); file_ign_none=(); file_store=(); file_keep=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --signed-tag) tag_args+=("$2"); shift 2 ;;
      --tag)
        [ -z "$sel_tag" ] || { echo "--tag may be given once (it selects the commit)" >&2; exit 1; }
        sel_tag="$2"; shift 2 ;;
      --trust)      trust=1; shift ;;
      # A READING AID for a large delta, never the norm: walk the commits
      # since the pin oldest-first, one diff and one confirmation each, and
      # advance the pin at every yes -- so stopping midway still leaves a
      # coherent, deployable record. The single whole-delta diff stays the
      # default.
      #
      # KNOWN COMPOSITION RISK: an attacker can split mayhem across commits
      # that each read innocently. Per-commit reading covers the same total
      # lines but fragments the attention that would notice the seam, which
      # is why the walk always closes with a whole-run summary (the
      # aggregate diffstat over everything approved in one sitting).
      --step)       step=1; shift ;;
      # ANOTHER READING AID, and nothing else: it says how much of each
      # commit message the listing shows, never which commit is trusted or
      # why. So it binds to no repo, combines with every other flag, and
      # rides through --step's walk as well.
      --messages)   msg_mode=messages; shift ;;
      # EVIDENCE, like --trust and --signed-tag: whoever made the commit
      # names its words, and a match approves without the diff. Given once.
      --words)
        [ $# -ge 2 ] || { echo "--words needs the six words, joined by hyphens" >&2; exit 1; }
        [ -z "$words_arg" ] || { echo "--words may be given once" >&2; exit 1; }
        valid_words_arg "$2" \
          || { echo "--words takes six words from the list, joined by hyphens: w1-w2-w3-w4-w5-w6" >&2; exit 1; }
        words_arg="$2"; shift 2 ;;
      # How many commits the words approve, stated where the sudo dialog
      # shows it beside them. Required with --words, and only with it.
      --commits)
        [ $# -ge 2 ] || { echo "--commits needs the number of commits the words approve" >&2; exit 1; }
        [ -z "$commits_arg" ] || { echo "--commits may be given once" >&2; exit 1; }
        valid_commits_arg "$2" \
          || { echo "--commits takes a count of one or more, e.g. --commits 3" >&2; exit 1; }
        commits_arg="$2"; shift 2 ;;
      # The ancestry DECLARATIONS: what the human believes they are
      # approving. Reality must conform (ancestry_gate) or the ceremony
      # refuses -- these widen nothing on their own, they only unlock a
      # ceremony the floor would otherwise refuse.
      --backward|--diverged)
        case "$decl_class" in
          ''|"${1#--}") decl_class="${1#--}" ;;
          *) echo "--backward and --diverged declare different relationships; give one" >&2
             exit 1 ;;
        esac
        shift ;;
      --file)
        [ $# -ge 2 ] || { echo "--file needs a path" >&2; exit 1; }
        # The path heads the ceremony's diff as its label (approved: and
        # candidate:), and a line feed there would let the path's own text
        # pose as diff structure: refused before anything is read, as the
        # diff verb refuses it. The preview refuses the same pre-sudo.
        case "$2" in
          *"$NL"*) refused "a path holding a line feed cannot head a diff: " "$2"; exit 1 ;;
        esac
        files+=("$2"); file_base+=(""); file_ign+=(""); file_ign_none+=(0); file_store+=(""); file_keep+=(0); shift 2 ;;
      --baseline)
        [ $# -ge 2 ] || { echo "--baseline needs a path" >&2; exit 1; }
        [ "${#files[@]}" -gt 0 ] \
          || { echo "--baseline must follow the --file it belongs to" >&2; exit 1; }
        [ -z "${file_base[$((${#files[@]} - 1))]}" ] \
          || { echo "one --baseline per --file" >&2; exit 1; }
        file_base[$((${#files[@]} - 1))]="$2"; shift 2 ;;
      --ignore-json-key)
        # Repeatable, and attaches to the preceding --file exactly like
        # --baseline: WHICH keys may drift is a per-path declaration. The
        # flag names its FORMAT because the slot file does (ignored.json);
        # another format would be another flag, never a guess. The dotted
        # spelling is the CLI's convenience form; the slot stores the jq
        # path array it converts to.
        [ $# -ge 2 ] || { echo "--ignore-json-key needs a key" >&2; exit 1; }
        [ "${#files[@]}" -gt 0 ] \
          || { echo "--ignore-json-key must follow the --file it belongs to" >&2; exit 1; }
        validate_ignore_key "$2" || {
          untrusted_var key_disp "$2" "" 2
          error "an ignored key outside the key grammar: $key_disp"
          echo "        the grammar is dotted [A-Za-z0-9_.-], no leading, trailing or doubled dot, no array subscripts" >&2
          exit 1
        }
        last=$((${#files[@]} - 1))
        [ "${file_ign_none[last]}" -eq 0 ] \
          || { echo "--ignore-none and --ignore-json-key state different declarations for one --file; give one" >&2; exit 1; }
        file_ign[last]="${file_ign[last]:+${file_ign[last]} }$2"
        ign_given=1; shift 2 ;;
      # The other half of stating the declaration (see restate_gaps): this
      # --file keeps NO ignored keys, said on purpose. Without it, a review
      # of a slot that declares keys today refuses rather than clear them.
      --ignore-none)
        [ "${#files[@]}" -gt 0 ] \
          || { echo "--ignore-none must follow the --file it belongs to" >&2; exit 1; }
        last=$((${#files[@]} - 1))
        [ -z "${file_ign[last]}" ] \
          || { echo "--ignore-none and --ignore-json-key state different declarations for one --file; give one" >&2; exit 1; }
        [ "${file_keep[last]}" -eq 0 ] \
          || { echo "--ignore-none and --keep state different declarations for one --file; give one" >&2; exit 1; }
        file_ign_none[last]=1; shift ;;
      # Keep what this --file's slot holds today: its ignored keys (any
      # --ignore-json-key on the same --file ADDS to them) and its stored
      # copy (unless --store or --no-store says otherwise). Expanded root-side
      # from the slot about to be written, so nothing can move in between;
      # the ceremony still shows every key before its y/N, marked as kept.
      --keep)
        [ "${#files[@]}" -gt 0 ] \
          || { echo "--keep must follow the --file it belongs to" >&2; exit 1; }
        last=$((${#files[@]} - 1))
        [ "${file_ign_none[last]}" -eq 0 ] \
          || { echo "--ignore-none and --keep state different declarations for one --file; give one" >&2; exit 1; }
        file_keep[last]=1; keep_given=1; shift ;;
      # Custody, per --file like the ignored keys: custody is a fact about
      # one slot, and the command display draws each --file's flags grouped
      # under it, so a per-file choice is readable off the command line.
      # FREELY COMBINABLE -- custody serves the ignored-key comparison, but
      # also archives exactly what was approved and feeds the next
      # ceremony's diff, so it means something on a file that declares
      # nothing. --no-store is its other half: keep no copy, said on purpose
      # (without one of them, a slot that keeps a copy today refuses; see
      # restate_gaps).
      --store|--no-store)
        [ "${#files[@]}" -gt 0 ] \
          || { echo "$1 must follow the --file it belongs to" >&2; exit 1; }
        last=$((${#files[@]} - 1))
        [ -z "${file_store[last]}" ] \
          || { echo "--store and --no-store state different custody for one --file; give one" >&2; exit 1; }
        if [ "$1" = "--store" ]; then file_store[last]=1; else file_store[last]=0; fi
        shift ;;
      # The ceremony-wide witness directory: a --file that brings no
      # --baseline of its own looks for the approved bytes to diff against
      # at <dir>/<slot name>/<prior digest>. Both name parts are pinned's own
      # facts, so the caller names one directory it keeps, never a digest,
      # and the sudo line carries one recognizable path instead of one
      # machine-derived path per file. Evidence like --baseline, never
      # authority: a copy is used only if it re-hashes to the record.
      --baseline-store)
        [ $# -ge 2 ] || { echo "--baseline-store needs a directory" >&2; exit 1; }
        baseline_store="$2"; shift 2 ;;
      --algo)
        [ $# -ge 2 ] || { echo "--algo needs a value" >&2; exit 1; }
        file_algo="$2"; algo_given=1; shift 2 ;;
      -*)           usage ;;
      *)            repo_args+=("$1"); shift ;;
    esac
  done
  # The file-pin ceremony is its own mode: repo selectors, evidence flags
  # and the repo walk say nothing about file content.
  if [ "${#files[@]}" -gt 0 ]; then
    if [ "${#repo_args[@]}" -gt 0 ] || [ -n "$sel_tag" ] || [ "$trust" -eq 1 ] \
      || [ "${#tag_args[@]}" -gt 0 ] || [ "$step" -eq 1 ] || [ -n "$decl_class" ] \
      || [ -n "$msg_mode" ] || [ -n "$words_arg" ] || [ -n "$commits_arg" ]; then
      echo "--file is its own ceremony; repo arguments, evidence flags, --step, --messages and the ancestry declarations do not combine with it" >&2
      exit 1
    fi
    do_approve_files
    return
  fi
  [ "$algo_given" -eq 0 ] || { echo "--algo applies to the --file ceremony only" >&2; exit 1; }
  [ -z "$baseline_store" ] || { echo "--baseline-store applies to the --file ceremony only" >&2; exit 1; }
  [ "${#repo_args[@]}" -ge 1 ] || usage
  case "$sel_tag" in
    -*) say_err "invalid tag name: " "$sel_tag"; exit 1 ;;
  esac
  # A vouch adds nothing to a signature gate; refuse the no-op combination
  # rather than silently ignoring one flag.
  if [ "$trust" -eq 1 ] && [ "${#tag_args[@]}" -gt 0 ]; then
    echo "--trust adds nothing to a signature-gated review; drop one" >&2
    exit 1
  fi
  # --step's refusals (the preview refuses the same set pre-sudo; these are
  # the authoritative re-checks). Each is a combination whose meaning is not
  # "walk the commits": evidence flags say the content is not being read at
  # all. --tag is NOT refused -- it is a selector, and the walk simply ends
  # at the commit it names instead of HEAD.
  if [ "$step" -eq 1 ]; then
    if [ "$trust" -eq 1 ]; then
      echo "--step is a per-commit review walk; --trust skips review" >&2
      exit 1
    fi
    if [ "${#tag_args[@]}" -gt 0 ]; then
      echo "--step is a per-commit review walk; signature evidence has no per-commit reading" >&2
      exit 1
    fi
    # The walk is a FORWARD reading by construction: it replays the commits
    # between the pin and the endpoint, oldest first. There are no such
    # commits to replay when the endpoint sits behind or beside the pin.
    if [ -n "$decl_class" ]; then
      echo "--step walks the commits between the pin and the endpoint, which only exist going forward;" >&2
      echo "review --$decl_class without --step: the whole-delta diff shows what actually changes" >&2
      exit 1
    fi
  fi
  # A vouch is a first-approval-only escape from reading the tree; there is
  # no pin for it to move away from, so it can never meet a declaration.
  if [ "$trust" -eq 1 ] && [ -n "$decl_class" ]; then
    echo "--trust vouches for a first approval; there is no pin to move --$decl_class from" >&2
    exit 1
  fi
  # --words approves a forward move without reading it. Every flag that
  # means something else refuses it: another kind of evidence, a reading
  # walk, or a declared move that is not forward. (The pre-sudo half
  # refuses the same set; these are the authoritative re-checks. The move's
  # direction itself is checked per repo, once the pin is read.)
  if [ -n "$commits_arg" ] && [ -z "$words_arg" ]; then
    echo "--commits goes with --words: it states how many commits the words approve" >&2
    exit 1
  fi
  if [ -n "$words_arg" ]; then
    if [ -z "$commits_arg" ]; then
      echo "--words needs --commits N, the number of commits since the pin it approves" >&2
      exit 1
    fi
    if [ "$trust" -eq 1 ] || [ "${#tag_args[@]}" -gt 0 ]; then
      echo "--words is its own evidence; it does not combine with --trust or --signed-tag" >&2
      exit 1
    fi
    if [ "$step" -eq 1 ]; then
      echo "--step reads every commit; --words approves without reading" >&2
      exit 1
    fi
    if [ -n "$decl_class" ]; then
      echo "--words approves a forward move only; review --$decl_class without it" >&2
      exit 1
    fi
  fi
  # Selector and evidence flags name ONE commit of ONE repo, and the step
  # walk is one interactive read of one repo; a multi-repo batch is plain
  # review approvals only (the pre-sudo preview refuses the same
  # combination -- this is the authoritative re-check).
  if [ "${#repo_args[@]}" -gt 1 ] \
    && { [ -n "$sel_tag" ] || [ "$trust" -eq 1 ] || [ "${#tag_args[@]}" -gt 0 ] || [ "$step" -eq 1 ] \
      || [ -n "$decl_class" ] || [ -n "$words_arg" ]; }; then
    echo "--tag, --signed-tag, --trust, --words, --step and the ancestry declarations bind to one repo; review multiple repos plain" >&2
    exit 1
  fi

  # Create the pin tree BEFORE the ancestry checks -- review must work on
  # machines that never ran setup (declarative installs); ensure_tree also
  # re-asserts ownership and modes on an existing tree.
  ensure_tree "$inv"

  # Sequential ceremonies over the named repos, one sudo authentication for
  # the batch (the file ceremony's shape): each repo is displayed and
  # confirmed on its own, a decline skips ONLY that repo, and a hard error
  # aborts the batch loudly. With one repo the contract is unchanged:
  # already-pinned exits 0, a decline exits 2.
  local multi=0 n_approved=0 n_declined=0 n_already=0 repo_arg
  [ "${#repo_args[@]}" -le 1 ] || multi=1
  for repo_arg in "${repo_args[@]}"; do
    resolve_repo "$repo_arg"
    local slot="$default_slot"
    if [ -n "$sel_tag" ]; then
      sgit check-ref-format "refs/tags/$sel_tag" \
        || { say_err "invalid tag name: " "$sel_tag"; exit 1; }
      # An explicitly selected tag is also the DECLARED name; refuse
      # upfront if it cannot be declared (the fallback declaration from a
      # signed tag merely degrades to rev-only, but an explicit request
      # that cannot be honored must not half-succeed).
      validate_release_name "$sel_tag" || {
        untrusted_var tag_disp "$sel_tag" "" 2
        error "a release name outside the declared-name grammar [A-Za-z0-9._/+-]: $tag_disp"
        exit 1
      }
    fi

    # The record must live under a root-owned ancestry or the machine gate
    # is only as strong as the weakest writable dir on the way there.
    # Walk from the deepest component that EXISTS, exactly like the file
    # ceremony below: a first-ever approval has not created the slot yet
    # (write_slot_state creates it root-owned when it records), and walking
    # through the not-yet-existing dir read an empty owner as "not root" --
    # refusing every brand-new repo with a chown remediation for a directory
    # that did not exist.
    if [ -d "$slot" ]; then
      verify_ancestry "$slot/rev.git" || exit 1
    else
      verify_ancestry "$slot" || exit 1
    fi

    local hash old_hash diff_out step_rc ancestry_cls ancestry_mb rec_rc=0 rec_stale subj tag_disp
    # Uncaptured, so REC_DIGEST / REC_PATH survive: a record naming a former
    # spelling of this path (2) is readable and repaired below, every other
    # refusal (1) stays a refusal -- re-read unsilenced so it says why.
    read_rev "$slot" "$repo" >/dev/null 2>&1 || rec_rc=$?
    [ "$rec_rc" -ne 1 ] || read_rev "$slot" "$repo" >/dev/null || exit 1
    old_hash="$REC_DIGEST" rec_stale="$REC_PATH"
    # The walk steps FROM a pin; there is no such thing as a first commit of
    # a tree that already exists. (The preview refuses this pre-sudo too --
    # this is the authoritative re-check.)
    if [ "$step" -eq 1 ] && [ -z "$old_hash" ]; then
      echo "first approval reviews the full tree; review without --step" >&2
      exit 1
    fi

    ceremony_banner

    # A slot stale for this spelling of the repo's path -- its directory
    # still wearing a former spelling, or its record still naming one -- is
    # repaired at ENTRY, not behind the y/N (THE SLOT-NAME INVARIANT, above
    # slot_name_actual). Renaming a name the filesystem already resolves
    # here, or re-stating the same rev for the spelling the caller just
    # canonicalized to, changes no trust -- the same class as ensure_tree
    # re-asserting modes. The gate below guards record CONTENT (which rev);
    # this restores an invariant, and it must not hide behind the
    # already-pinned short-circuit the way the file ceremony's stale record
    # once hid behind "already approved". One `respell` log line per
    # repaired slot, whichever half (or both) it was.
    slot_respell="$(slot_name_actual "$slot")"
    if [ -n "$slot_respell" ]; then
      mv -f "$slot_respell" "$slot"
      print_verdict_to "$C_GRN$C_B" "slot renamed" \
        "$C_CYN${slot_respell##*/}$C_OFF" "$C_CYN${slot##*/}$C_OFF"
    fi
    if [ "$rec_rc" -eq 2 ]; then
      write_slot_state "$slot" rev.git "$old_hash  $repo"
      local rs_from rs_to
      untrusted_var rs_from "$rec_stale" "$C_CYN"
      untrusted_var rs_to "$repo" "$C_CYN"
      print_verdict_to "$C_GRN$C_B" "record re-stated, same rev" \
        "$C_CYN$rs_from$C_OFF" "$C_CYN$rs_to$C_OFF"
    fi
    if [ -n "$slot_respell" ] || [ "$rec_rc" -eq 2 ]; then
      log_action respell "$repo" "$old_hash" ok
    fi

    if [ "${#tag_args[@]}" -gt 0 ]; then
      # Signature gate: verify normally-signed release tags (git tag -s;
      # nothing pinned-specific in the repo) against ROOT-OWNED allowed
      # signers, then pin the commit they name. This is the second-machine
      # bootstrap: clone anywhere, install the signer key once, approve the tag.
      local t
      for t in "${tag_args[@]}"; do
        case "$t" in
          -*) say_err "invalid tag name: " "$t"; exit 1 ;;
        esac
      done
      # Per-slot signers take precedence; the user-tier file is the
      # fallback. A key trusted to vouch for one repo shouldn't implicitly
      # vouch for every repo on the machine; keep machine-wide keys in the
      # user-tier file deliberately.
      local signers="$slot/signers/allowed_signers"
      [ -f "$signers" ] || signers="$(policy_dir_for "$inv")/allowed_signers"
      if [ ! -f "$signers" ]; then
        error "no allowed signers for this repo"
        echo "  install the signer's public key with the signer ceremony:" >&2
        say_cmd "    per-repo: pinned signer add --file PUBKEY --principal ID --repo " "$repo"
        echo "    user:     pinned signer add --file PUBKEY --principal ID" >&2
        echo "  obtain the key out of band (printed card, password manager," >&2
        echo "  existing trusted machine) -- never from this repo." >&2
        exit 1
      fi
      verify_root_owned_path "$PINNED_ROOT" || exit 1
      verify_record_file "$signers" || exit 1
      # Every tag must verify AND name the same commit -- all-or-nothing;
      # a single failure leaves the pin unchanged.
      #
      # git's own verdict ("Good ... signature for ...") is CAPTURED, not
      # let through: a verdict prints after the last third-party text on the
      # screen, and the listing of the commits the signature covers comes
      # below this point. A refusal has nothing after it, so it shows git's
      # words at once; a success keeps them for the verdict block above the
      # question (vt_said, one entry per tag).
      local t_hash vt_out vt_line vt_disp t_disp
      local -a vt_said=()
      hash=""
      for t in "${tag_args[@]}"; do
        if ! vt_out="$(sgit -c gpg.ssh.allowedSignersFile="$signers" verify-tag "$t" 2>&1)"; then
          while IFS= read -r vt_line; do
            [ -n "$vt_line" ] || continue
            untrusted_var vt_disp "$vt_line" "" 2
            printf '%s\n' "$vt_disp" >&2
          done <<<"$vt_out"
          error "signature verification failed, pin unchanged: " "$t"
          log_action approve "$repo" "$t" verify-failed
          exit 1
        fi
        vt_said+=("$vt_out")
        t_hash="$(sgit rev-parse "refs/tags/${t}"'^{commit}')"
        if [ -z "$hash" ]; then
          hash="$t_hash"
        elif [ "$hash" != "$t_hash" ]; then
          error "tags disagree (at $t_hash, not $hash), pin unchanged: " "$t"
          log_action approve "$repo" "$t" tags-disagree
          exit 1
        fi
      done
      # An unsigned --tag selector (e.g. the clean release name) joins the
      # agreement rule: it must name the commit the signed set verified.
      if [ -n "$sel_tag" ]; then
        t_hash="$(sgit rev-parse "refs/tags/${sel_tag}"'^{commit}')"
        if [ "$t_hash" != "$hash" ]; then
          error "tags disagree (at $t_hash, not $hash), pin unchanged: " "$sel_tag"
          log_action approve "$repo" "$sel_tag" tags-disagree
          exit 1
        fi
      fi
      if [ -n "$old_hash" ] && [ "$old_hash" = "$hash" ]; then
        printf '%salready pinned: %s%s\n' "$C_GRN" "$hash" "$C_OFF"
        if [ "$multi" -eq 1 ]; then n_already=$((n_already + 1)); continue; fi
        exit 0
      fi
      # THE ANCESTRY FLOOR, before a byte of display. A signature proves WHO
      # vouched, never WHICH WAY the pin is moving, so a replayed signed
      # release of an older version is exactly the shape the floor exists to
      # catch -- and a deliberate, declared downgrade to a signed release is
      # the legitimate manual override it exists to allow.
      ancestry_floor "$repo" "$old_hash" "$hash" "$decl_class" || exit 1
      subject_var subj "$hash" "$C_DIM"
      print_repo_row "$C_DIM"
      printf '%ssigners:%s    %s\n' "$C_DIM" "$C_OFF" "$signers"
      printf '%scandidate:%s  %s%s%s  %s%s%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$hash" "$C_OFF" \
        "$C_DIM" "$subj" "$C_OFF"
      if [ -n "$old_hash" ]; then
        printf '%spinned:%s     %s%s%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$old_hash" "$C_OFF"
        if [ -n "$ancestry_mb" ]; then
          printf '%sancestor:%s   %s%s%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$ancestry_mb" "$C_OFF"
        fi
        # Free orientation on any machine with the clone (that is, every
        # machine review runs on); the signature stays the gate.
        echo
        print_ancestry_listing "$ancestry_cls" "$old_hash" "$hash" "$ancestry_mb" \
          rule '' "$msg_mode"
      fi
      # THE VERDICTS, below the listing's closing rule and directly above
      # the question, under the rows it decides about: the lattice's alarm,
      # then each signature with git's own words under it, then the
      # agreement. Nothing third-party follows. The rows repeat only over
      # a listing; a first approval's identity block is still on screen,
      # its `candidate:` row the one the question names.
      if [ -n "$old_hash" ]; then
        echo
        print_candidate_rows "$hash"
      fi
      ancestry_verdict "$old_hash" "$hash"
      local vi=0
      for t in "${tag_args[@]}"; do
        untrusted_var t_disp "$t"
        printf '%s✓ signature verified:%s %s\n' "$C_GRN$C_B" "$C_OFF" "$t_disp"
        # git's words are a sentence about the verdict: a dim line under it,
        # in its value column.
        while IFS= read -r vt_line; do
          [ -n "$vt_line" ] || continue
          untrusted_var vt_disp "$vt_line" "$C_DIM"
          printf '                      %s%s%s\n' "$C_DIM" "$vt_disp" "$C_OFF"
        done <<<"${vt_said[$vi]}"
        vi=$((vi + 1))
      done
      if [ -n "$sel_tag" ]; then
        untrusted_var t_disp "$sel_tag"
        printf '%s✓ names the verified commit (unsigned):%s %s\n' "$C_GRN$C_B" "$C_OFF" "$t_disp"
      fi
      [ "${#tag_args[@]}" -le 1 ] \
        || printf '%s✓ %d/%d tags agree on the candidate%s\n' "$C_GRN$C_B" "${#tag_args[@]}" "${#tag_args[@]}" "$C_OFF"
    else
      # Human gate: read the diff since the last pin from the object store,
      # at HEAD or at the --tag selector's commit.
      if [ -n "$sel_tag" ]; then
        hash="$(sgit rev-parse "refs/tags/${sel_tag}"'^{commit}')"
      else
        hash="$(sgit rev-parse 'HEAD^{commit}')"
      fi

      if ! sgit_diff --quiet 2>/dev/null || ! sgit_diff --cached --quiet 2>/dev/null; then
        echo "note: work tree is dirty; only committed content at $hash is being approved" >&2
      fi

      if [ -n "$old_hash" ] && [ "$old_hash" = "$hash" ]; then
        printf '%salready pinned: %s%s\n' "$C_GRN" "$hash" "$C_OFF"
        if [ "$multi" -eq 1 ]; then n_already=$((n_already + 1)); continue; fi
        exit 0
      fi

      # THE ANCESTRY FLOOR, before a byte of display: a diff renders a
      # backward move as an honest set of changes, which is exactly why the
      # direction has to be established first -- the diff cannot say whether
      # trust is being extended or withdrawn.
      ancestry_floor "$repo" "$old_hash" "$hash" "$decl_class" || exit 1

      # Approve by words: only a forward move from an existing pin, and
      # refused before a byte of display -- like the floor, the move's shape
      # decides first. The comparison waits until the commit and the listing
      # are on screen, so a refusal is read against what it refused.
      local by_words=0
      if [ -n "$words_arg" ]; then
        if [ -z "$old_hash" ]; then
          echo "a first approval reads the full tree; --words approves a forward move from a pin only" >&2
          exit 1
        fi
        if [ "$ancestry_cls" != forward ]; then
          echo "--words approves a forward move only; this is a $ancestry_cls move" >&2
          exit 1
        fi
      fi

      print_repo_row "$C_DIM"
      if [ -n "$sel_tag" ]; then
        untrusted_var tag_disp "$sel_tag"
        printf '%stag:%s        %s\n' "$C_DIM" "$C_OFF" "$tag_disp"
        subject_var subj "$hash" "$C_DIM"
        printf '%scandidate:%s  %s%s%s  %s%s%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$hash" "$C_OFF" \
          "$C_DIM" "$subj" "$C_OFF"
      else
        subject_var subj "$hash" "$C_DIM"
        printf '%sgit HEAD:%s   %s%s%s  %s%s%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$hash" "$C_OFF" \
          "$C_DIM" "$subj" "$C_OFF"
      fi
      if [ -n "$old_hash" ]; then
        printf '%spinned:%s     %s%s%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$old_hash" "$C_OFF"
        if [ -n "$ancestry_mb" ]; then
          printf '%sancestor:%s   %s%s%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$ancestry_mb" "$C_OFF"
        fi
        echo
        print_ancestry_listing "$ancestry_cls" "$old_hash" "$hash" "$ancestry_mb" \
          rule '' "$msg_mode"
        if [ "$step" -eq 1 ]; then
          # The walk replaces this whole-delta diff AND the single
          # confirmation below with one of each per commit, and owns the
          # invocation's exit status from here (it binds to one repo, so
          # there is no batch left to fall through to).
          step_rc=0
          approve_step_walk "$slot" "$old_hash" "$hash" || step_rc=$?
          exit "$step_rc"
        fi
        echo
        if [ -n "$words_arg" ]; then
          # Approve by words: all six, derived here from the commit this
          # ceremony resolved, against the six the sudo dialog showed. A
          # mismatch never says which words differ or prints the right
          # ones -- a caller that retried with them would be approving what
          # it did not make.
          local want
          want="$(commit_words "$hash")"
          if [ "${want// /-}" != "$words_arg" ]; then
            error "the words do not match $hash; pin unchanged"
            say_cmd "  review it the usual way: pinned review " "$repo"
            log_action approve "$repo" "$hash" words-mismatch
            exit 1
          fi
          # The count the dialog showed beside the words, against the range
          # this ceremony just listed. The words bind the commit; the count
          # binds how much of the history behind it the approval covers.
          # Both are checked before either row prints: rows are the record
          # of an action that goes ahead, and a refusal prints none.
          local n_since
          n_since="$(sgit rev-list --count "${old_hash}..${hash}")"
          if [ "$n_since" != "$commits_arg" ]; then
            refuse_commits_count "$n_since" "$commits_arg"
            say_cmd "  review it the usual way: pinned review " "$repo"
            log_action approve "$repo" "$hash" commits-mismatch
            exit 1
          fi
          # The rows the y/N would have stood under, as the record of what
          # the words on the command line answered.
          print_candidate_rows "$hash"
          print_words_row "$want"
          printf '%scommits:%s    %s since the pin\n' "$C_DIM" "$C_OFF" "$n_since"
          by_words=1
        else
          # The gate before the pager: in a batch the next repo's diff would
          # otherwise open unannounced, with no statement of whose bytes or
          # how much is about to fill the screen. Enter (or y) opens the diff;
          # `n` is the one other answer, and it is fail-closed -- decline
          # without looking, pin unchanged (logged as skip, counted as
          # declined). End of input takes the same path, for the same reason.
          #
          # The parenthesis states the delta's size, over the SAME ranges the
          # listing headings just above name: a forward move counts what
          # arrives, a backward one counts what it un-approves (its forward
          # range is empty, and a move that reads as "0 commits" states the
          # opposite of what it does), a diverged one counts both sides of the
          # merge base. Two revs with no common ancestor have no range at all:
          # `pin..candidate` is then the candidate's WHOLE history (a rewrite
          # of 400 commits reads as "400 commits" when three are new), so
          # there the size is the diff's own, in files and lines, colored
          # the way the file-pin gate colors its magnitude.
          local n_range n_undo gate_line gate_size totals t_n t_files t_add t_del
          totals="$(diff_totals "$old_hash" "$hash")"
          if [ "$ancestry_cls" = diverged ] && [ -z "$ancestry_mb" ]; then
            read -r t_n t_files t_add t_del <<<"$totals"
            gate_size="no shared history; $t_n $t_files ${C_GRN}${t_add}${C_OFF} ${C_RED}${t_del}${C_OFF}"
          elif [ "$ancestry_cls" = backward ]; then
            n_undo="$(sgit rev-list --count "${hash}..${old_hash}")"
            gate_size="$n_undo commit$(plural_s "$n_undo") un-approved"
          elif [ "$ancestry_cls" = diverged ]; then
            n_undo="$(sgit rev-list --count "${ancestry_mb}..${old_hash}")"
            n_range="$(sgit rev-list --count "${ancestry_mb}..${hash}")"
            gate_size="$n_undo commit$(plural_s "$n_undo") un-approved, $n_range arriving"
          else
            n_range="$(sgit rev-list --count "${old_hash}..${hash}")"
            gate_size="$n_range commit$(plural_s "$n_range")"
          fi
          print_range_rows "$old_hash" "$hash" "$gate_size"
          printf -v gate_line '%sreview this range;%s %sEnter%s open %s· %s%sn%s%s skip%s ' \
            "$C_B" "$C_OFF" "$C_BLU" "$C_OFF" \
            "$C_DIM" "$C_OFF" "$C_BLU" "$C_OFF" "$C_DIM" "$C_OFF"
          if ! gate_answer "$gate_line"; then
            printf '%sskipped; pin unchanged%s\n' "$C_YEL" "$C_OFF"
            log_action approve "$repo" "$hash" skip
            if [ "$multi" -eq 1 ]; then n_declined=$((n_declined + 1)); continue; fi
            exit 2
          fi
          # The section rule holds no value: the range is on its row above.
          printf '%s--- diff (from object store) ---%s\n' "$C_B" "$C_OFF"
          # Capture first so a git failure aborts (set -e) BEFORE anything is
          # shown as reviewable; then page. Early pager quit (SIGPIPE) is the
          # reviewer's own act -- the diff itself already succeeded.
          diff_out="$(sgit_diff "$old_hash" "$hash")"
          untrusted_page color_diff <<<"$diff_out"
          print_end_rule diff "$totals"
          # The rows the question decides about, then the lattice's alarm
          # (nothing for a forward move), directly above the question.
          echo
          print_candidate_rows "$hash"
          ancestry_verdict "$old_hash" "$hash"
        fi
      elif [ "$trust" -eq 1 ]; then
        # The identity block above is the question's rows (nothing stands
        # between them), so the alarm follows it flush.
        printf '%spinned:%s     (none)\n' "$C_DIM" "$C_OFF"
        printf '%s!!! FIRST APPROVAL WITH --trust !!!%s\n' "$C_RED$C_B" "$C_OFF"
        printf '%s!!! The full tree at %s is being approved without review. !!!%s\n' "$C_RED$C_B" "$hash" "$C_OFF"
        printf '%s!!! Everything already in this repo becomes trusted as-is. !!!%s\n' "$C_RED$C_B" "$C_OFF"
      else
        printf '%spinned:%s     (none -- first approval: full tree review)\n' "$C_DIM" "$C_OFF"
        # Same gate as the whole-delta pager (skip included); no range
        # exists yet. It stands directly under the identity block, which
        # holds what it decides about.
        local gate_line
        printf -v gate_line '%sreview the full tree;%s %sEnter%s open %s· %s%sn%s%s skip%s ' \
          "$C_B" "$C_OFF" "$C_BLU" "$C_OFF" \
          "$C_DIM" "$C_OFF" "$C_BLU" "$C_OFF" "$C_DIM" "$C_OFF"
        if ! gate_answer "$gate_line"; then
          printf '%sskipped; pin unchanged%s\n' "$C_YEL" "$C_OFF"
          log_action approve "$repo" "$hash" skip
          if [ "$multi" -eq 1 ]; then n_declined=$((n_declined + 1)); continue; fi
          exit 2
        fi
        printf '%s--- full tree (diff from empty) ---%s\n' "$C_B" "$C_OFF"
        # 4b825d... is git's well-known empty tree; this shows every approved byte.
        local totals
        diff_out="$(sgit_diff 4b825dc642cb6eb9a060e54bf8d69288fbee4904 "$hash")"
        totals="$(diff_totals 4b825dc642cb6eb9a060e54bf8d69288fbee4904 "$hash")"
        untrusted_page color_diff <<<"$diff_out"
        print_end_rule diff "$totals"
        echo
        print_candidate_rows "$hash"
      fi
    fi
    # Approved by words: the words and the count on the command line were
    # the answer, and this ceremony just matched both. There is no terminal
    # to ask (the caller runs without one), and a y/N here would only repeat
    # that consent. Every other branch above ends on the rows this question
    # decides about, and on its verdicts.
    if [ "${by_words:-0}" -eq 0 ]; then
      local answer
      printf '%sapprove this candidate? [%sy%s/%sN%s]%s ' "$C_B" \
        "$C_BLU" "$C_OFF$C_B" "$C_BLU" "$C_OFF$C_B" "$C_OFF"
      drain_tty
      read -r answer </dev/tty
      case "$answer" in
        y|Y|yes) ;;
        *)
          printf '%saborted; pin unchanged%s\n' "$C_YEL" "$C_OFF"
          log_action approve "$repo" "$hash" abort
          if [ "$multi" -eq 1 ]; then n_declined=$((n_declined + 1)); continue; fi
          exit 2
          ;;
      esac
    fi

    write_slot_state "$slot" rev.git "$hash  $repo"
    # A repo pin has no JSON keys to tolerate: taking the slot over from a
    # file pin drops any ignored-key declaration with it.
    clear_slot_ignore "$slot"
    # Say so. The --file ceremony has always confirmed each record; the repo
    # ceremony printed nothing unless a tag happened to be declared, so a plain
    # approve answered `y` and returned to the prompt in silence -- which reads
    # exactly like a no-op in the one place a user most needs to know a record
    # was written.
    printf '%s✓ approved %s%s%s%s:%s %s\n' "$C_GRN$C_B" "$C_OFF$C_CYN" "$hash" "$C_OFF" "$C_GRN$C_B" "$C_OFF" \
      "$(show_slot "$slot")/rev.git"
    # The declared release name (optional `release` record, repo slots
    # only): deploy syncs the input's ref= to it after cross-checking the
    # live tag still names the pinned rev. The --tag selector is the
    # declared name; with only --signed-tag evidence the first signed name
    # is the fallback; a plain review with no tag CLEARS any prior
    # declaration (no declaration -> rev-only sync, a supported shape).
    local decl_tag="$sel_tag"
    if [ -z "$decl_tag" ] && [ "${#tag_args[@]}" -gt 0 ]; then
      decl_tag="${tag_args[0]}"
    fi
    if [ -n "$decl_tag" ]; then
      if ! validate_release_name "$decl_tag"; then
        untrusted_var tag_disp "$decl_tag" "$C_YEL"
        printf '%snote: the slot stays rev-only; this release name is outside the declared-name grammar [A-Za-z0-9._/+-]: %s%s\n' \
          "$C_YEL" "$tag_disp" "$C_OFF"
        rm -f "$slot/release"
      else
        write_note "$slot" release "$decl_tag"
        print_verdict_to "$C_GRN" declared "$decl_tag" "$(show_slot "$slot")/release"
      fi
    else
      rm -f "$slot/release"
    fi
    if [ "${by_words:-0}" -eq 1 ]; then
      log_action approve "$repo" "$hash" words
    else
      log_action approve "$repo" "$hash"
    fi
    n_approved=$((n_approved + 1))
  done

  if [ "$multi" -eq 1 ]; then
    echo
    print_batch_summary "$n_approved" "$n_declined" "$n_already"
  fi
}

# The batch summary line: counts only, dim. Called once per review batch.
print_batch_summary() {
  printf '%s%s approved, %s declined, %s already pinned%s\n' \
    "$C_DIM" "$1" "$2" "$3" "$C_OFF"
}

# The --step walk: the commits since the pin, oldest first, one diff and one
# confirmation each, with the pin ADVANCING at every yes. Every checkpoint is
# therefore a coherent, deployable record -- stopping midway rests the pin at
# the last approved commit, and resuming later is an ordinary approve over
# whatever remains. A decline STOPS the walk instead of skipping the commit:
# trust is a tree state, so approving commit N would silently carry N-1's
# changes in with it.
#
# Reached only from the review branch of do_approve, which has already refused
# every combination the walk cannot mean (a first approval, --trust,
# --signed-tag, several repos). It owns the invocation's exit
# status: 0 if the pin advanced at all -- a later decline does not undo an
# earlier yes -- and 2 if nothing changed, the single-repo decline contract.
#
# A --tag selector moves the ENDPOINT: the walk runs from the pin to the
# commit the tag names, and the name is declared only when that commit is
# actually approved (do_approve validated the name upfront; $sel_tag is its
# local, visible here by dynamic scope). A walk that stops early leaves the
# slot rev-only and says so -- a declaration for a rev the pin never reached
# would make deploy sync ref= to a tag that disagrees with the pin.
#
# --messages reaches the walk's own listings the same way ($msg_mode, another
# do_approve local seen by dynamic scope): it says how much of a commit
# message is shown, which is as true of a step as of the whole delta.
#
# $1 = slot, $2 = the currently pinned rev, $3 = the walk's endpoint (HEAD
# or the --tag selector's commit).
approve_step_walk() {
  local slot="$1" old_hash="$2" hash="$3"
  local line c k m prev approved=0 answer diff_out rem totals log_out gate_line
  local -a commits=()

  # Captured first so a git failure aborts (set -e) before the walk claims to
  # know how many commits there are. --first-parent because that is the line
  # of history the pin travels along; a merge's second parent arrives as part
  # of the merge commit's own diff.
  log_out="$(sgit log --reverse --first-parent --format=%H "${old_hash}..${hash}")"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    commits+=("$line")
  done <<EOF
$log_out
EOF
  m="${#commits[@]}"
  # No commits between two DIFFERENT revs means the pin is not behind HEAD:
  # rewritten, reversed or diverged history. The whole-delta diff renders that
  # situation honestly (it shows the removal); a walk over an empty list would
  # simply say nothing, which is the one thing a review must never do.
  # The ancestry floor refuses those endpoints before the walk is even
  # entered, so this is the belt to its braces -- it stays because a walk
  # that found nothing to show must never continue on that basis.
  if [ "$m" -eq 0 ]; then
    error "no commits from the pin to ${hash:0:10} -- the pin is not behind HEAD"
    echo "        (reversed or diverged history); review --backward or --diverged" >&2
    echo "        without --step: the whole-delta diff shows what actually changes" >&2
    return 1
  fi

  k=0
  prev="$old_hash"
  while [ "$k" -lt "$m" ]; do
    c="${commits[$k]}"
    k=$((k + 1))
    echo
    printf '%s--- step %s/%s ---%s\n' "$C_B" "$k" "$m" "$C_OFF"
    print_commit_range "$prev" "$c" '' "$msg_mode" || true
    echo
    # Same gate as the whole-delta pager; a step is always one commit.
    # `n` here stops the walk, exactly as a decline at the confirm does:
    # commits advance linearly, so there is no "skip this one and review
    # the next" -- the pin can never move past an unreviewed commit.
    print_range_rows "$prev" "$c" "1 commit"
    printf -v gate_line '%sreview this range;%s %sEnter%s open %s· %s%sn%s%s skip%s ' \
      "$C_B" "$C_OFF" "$C_BLU" "$C_OFF" \
      "$C_DIM" "$C_OFF" "$C_BLU" "$C_OFF" "$C_DIM" "$C_OFF"
    if ! gate_answer "$gate_line"; then
      printf '%sskipped; the walk stops here%s\n' "$C_YEL" "$C_OFF"
      log_action approve "$repo" "$c" skip
      break
    fi
    # Capture first so a git failure aborts (set -e) BEFORE anything is shown
    # as reviewable; then page. Early pager quit (SIGPIPE) is the reviewer's
    # own act -- the diff itself already succeeded.
    diff_out="$(sgit_diff "$prev" "$c")"
    totals="$(diff_totals "$prev" "$c")"
    untrusted_page color_diff <<<"$diff_out"
    print_end_rule diff "$totals"
    echo
    print_candidate_rows "$c"
    printf '%sapprove this candidate? [%sy%s/%sN%s]%s ' "$C_B" \
      "$C_BLU" "$C_OFF$C_B" "$C_BLU" "$C_OFF$C_B" "$C_OFF"
    drain_tty
    read -r answer </dev/tty
    case "$answer" in
      y|Y|yes) ;;
      *)
        printf '%sdeclined; the walk stops here%s\n' "$C_YEL" "$C_OFF"
        log_action approve "$repo" "$c" abort
        break ;;
    esac
    write_slot_state "$slot" rev.git "$c  $repo"
    # A repo pin has no JSON keys to tolerate: taking the slot over from a
    # file pin drops any ignored-key declaration with it.
    clear_slot_ignore "$slot"
    # A mid-walk yes is a plain review, so it CLEARS any declared
    # release name; the declaration is written back only if this yes is the
    # --tag selector's own commit -- the walk arriving at the name it was
    # asked to walk to.
    rm -f "$slot/release"
    log_action approve "$repo" "$c"
    printf '%s✓ pin advanced:%s %s%s%s\n' "$C_GRN$C_B" "$C_OFF" "$C_CYN" "$c" "$C_OFF"
    if [ -n "$sel_tag" ] && [ "$c" = "$hash" ]; then
      write_note "$slot" release "$sel_tag"
      print_verdict_to "$C_GRN" declared "$sel_tag" "$(show_slot "$slot")/release"
    fi
    prev="$c"
    approved=$((approved + 1))
  done

  echo
  printf '%s--- step summary ---%s\n' "$C_B" "$C_OFF"
  if [ "$approved" -eq 0 ]; then
    printf '%sapproved 0 of %s commit%s; pin unchanged at%s %s%.10s%s\n' \
      "$C_DIM" "$m" "$(plural_s "$m")" "$C_OFF" "$C_CYN" "$old_hash" "$C_OFF"
  else
    # The run's commits first, closed by their rule; the outcome after it,
    # where a verdict belongs (nothing third-party follows it).
    print_commit_range "$old_hash" "$prev" '' "$msg_mode" || true
    printf '%sapproved %s of %s commit%s; pin:%s %s%.10s%s %s→%s %s%.10s%s\n' \
      "$C_DIM" "$approved" "$m" "$(plural_s "$m")" "$C_OFF" "$C_CYN" "$old_hash" "$C_OFF" \
      "$C_DIM" "$C_OFF" "$C_CYN" "$prev" "$C_OFF"
    # THE COMPOSITION-RISK MITIGATION. Reading one commit at a time covers the
    # same total lines as one whole-delta diff, but it fragments the attention
    # that would notice mayhem split across individually innocent commits.
    # This is what the whole sitting amounted to, in one line, after the fact.
    totals="$(diff_totals "$old_hash" "$prev")"
    printf '%stotal:%s %s\n' "$C_DIM" "$C_OFF" "$totals"
  fi
  rem=$((m - approved))
  if [ "$rem" -gt 0 ]; then
    printf '%sremaining: %s commit%s%s %s(%.10s..%.10s)%s\n' \
      "$C_DIM" "$rem" "$(plural_s "$rem")" "$C_OFF" "$C_CYN" "$prev" "$hash" "$C_OFF"
    [ -z "$sel_tag" ] \
      || printf '%sthe slot stays rev-only; the walk did not reach the declared name %s%s\n' \
           "$C_DIM" "$sel_tag" "$C_OFF"
  fi
  [ "$approved" -ge 1 ] || return 2
}

# The file-pin ceremony (the claude-trust-append port). The CEREMONY is
# the only recording path -- there is deliberately NO hash argument and
# no handoff form: a displayless handoff would preserve exactly the
# vulnerable path it replaces (a weak-environment caller feeding an
# opaque hash for root to record sight-unseen). The one display happens
# HERE, root-side, after sudo's env_reset, resting only on root-owned
# code -- a caller's own review (the shim's structural diff) is pre-sudo
# ORIENTATION, and what the record binds to is what THIS display showed:
# the hash is taken from the displayed frozen buffer, so record == seen
# by construction, and a post-freeze swap simply mismatches at the next
# verify. Multiple --file paths share one authentication (sequential
# display + confirm per file, each confirmed one recorded) -- under the
# timestamp_timeout=0 sudoers stance anything else costs one password
# per file. WHICH files get measured is the calling policy's business
# (the shim's declared set); pinned is the capability and approves any
# path -- the old appender's basename allowlist dies here.
do_approve_files() {
  algo_hash_cmd "$file_algo" >/dev/null || {
    say_err "unsupported algorithm (use sha256, sha384, sha512, blake2b-256/384/512, blake3): " "$file_algo"
    exit 1
  }
  require_hasher "$file_algo" || exit 1
  ensure_tree "$inv"

  local i=0 n="${#files[@]}" f base path slot line new_digest old_digest old_label
  local base_ok recorded=0 declined=0 failed=0 answer state_note nl
  local ign ign_json old_ign old_bad had_copy copy_bad cur_copy ign_note cust_from cust_to cust_val decl_changed
  local cust_changed n_lines gate_line same_bytes
  local keep store kept_ign cust_src ign_marks ign_new ign_old ign_lead imark ikey itail gr_list
  local path_disp path_plain note_disp notes_out
  local gk gscope gwhere gr_keys gr_pairs gr_scope gr_mixed

  # The ignorable policy, read ONCE for the whole ceremony: every --file in
  # it is checked against the same effective policy, and a policy that
  # cannot be read stops the ceremony rather than approving without one.
  # Only when something is actually declared -- a ceremony that declares
  # nothing has no rung to check.
  if [ "$ign_given" -eq 1 ] || [ "$keep_given" -eq 1 ]; then
    require_jq "--ignore-json-key" || exit 1
    load_policy "$inv" || exit 1
  fi

  ceremony_banner

  # THE RESTATEMENT FLOOR (restate_gaps), over the whole batch before any
  # file is shown.
  rf_files=("${files[@]}"); rf_ign_stated=(); rf_cust_stated=(); rf_typed=()
  while [ "$i" -lt "$n" ]; do
    if [ -n "${file_ign[$i]}" ] || [ "${file_ign_none[$i]}" -eq 1 ] || [ "${file_keep[$i]}" -eq 1 ]; then
      rf_ign_stated+=(1)
    else
      rf_ign_stated+=(0)
    fi
    if [ -n "${file_store[$i]}" ] || [ "${file_keep[$i]}" -eq 1 ]; then
      rf_cust_stated+=(1)
    else
      rf_cust_stated+=(0)
    fi
    if [ -n "${file_ign[$i]}" ] || [ "${file_ign_none[$i]}" -eq 1 ] || [ -n "${file_store[$i]}" ]; then
      rf_typed+=(1)
    else
      rf_typed+=(0)
    fi
    i=$((i + 1))
  done
  i=0
  restate_floor "$inv" ${review_argv[@]+"${review_argv[@]}"} || exit 1

  while [ "$i" -lt "$n" ]; do
    f="${files[$i]}"; base="${file_base[$i]}"; ign="${file_ign[$i]}"
    keep="${file_keep[$i]}"; store="${file_store[$i]}"; i=$((i + 1))
    [ "$i" -eq 1 ] || echo
    path="$(canon_path "$f")" || { failed=$((failed + 1)); continue; }
    case "$path" in
      *"$NL"*)
        error "refusing a path containing a newline (records are one line per pin)"
        failed=$((failed + 1)); continue ;;
    esac
    if [ ! -f "$path" ]; then
      error "not a regular file: " "$path"
      say_cmd "        a pinned file that is gone is retired with: pinned tombstone " "$path"
      failed=$((failed + 1)); continue
    fi
    slot="$(slot_dir_for "$inv" "$path")"
    # Ancestry is checked from the deepest component that EXISTS. Checking
    # from the pin file unconditionally meant the walk included $slot, which
    # a first-ever approval has not created yet -- stat failed, the empty
    # owner read as "not root", and every previously unpinned path was
    # refused with a chown/chmod remediation for a directory that did not
    # exist. write_slot_state creates the slot root-owned when it records,
    # so there is nothing to distrust until then; an existing slot is still
    # walked in full.
    if [ -d "$slot" ]; then
      verify_ancestry "$slot/pin.$file_algo" || exit 1
    else
      verify_ancestry "$slot" || exit 1
    fi

    # THE LADDER'S CEREMONY RUNG: a key may be declared here only if the
    # effective policy grants it FOR THIS PATH. Refused per file, before
    # anything is displayed or recorded, and loudly -- semantics are
    # UNIFORM, because pinned cannot tell a human's argv from a calling
    # tool's, so "the human typed it" can never be the reason to allow it.
    #
    # --keep reads the slot's own declaration first and adds the typed keys
    # to it, so the rung checks exactly the set this approval would record:
    # a kept key the policy no longer grants refuses here too.
    ign_json="" kept_ign=""
    if [ "$keep" -eq 1 ] && slot_declares_ignore "$slot"; then
      if read_ignored_paths "$slot" 2>/dev/null; then
        kept_ign="$IGN_PATHS"
      else
        refused "--keep cannot keep the ignored keys, since their declaration is unreadable: " "$path"
        echo "        list the keys to keep without --keep, or drop them with --ignore-none" >&2
        failed=$((failed + 1)); continue
      fi
    fi
    if [ -n "$ign" ]; then
      ign_json="$(ign_paths_json "$ign")"
    fi
    if [ -n "$kept_ign" ]; then
      ign_json="$(jq -c -n --argjson a "$kept_ign" --argjson b "${ign_json:-[]}" '$a + ($b - $a)')" || exit 1
    fi
    if [ -n "$ign_json" ]; then
      if ! policy_check_declaration "$POL_EFF" "$ign_json" "$path"; then
        [ -z "$kept_ign" ] \
          || echo "        a kept key lost its grant: list the keys to keep without --keep, or --ignore-none" >&2
        failed=$((failed + 1)); continue
      fi
    fi

    old_digest="" old_label="" state_note="" ign_note="" cust_from="" decl_changed=0
    old_ign=""; old_bad=0; had_copy=0; copy_bad=0; path_restated=0; slot_note=""
    # Asked before the record is read, because a stale directory name is
    # state this ceremony repairs whether or not the record itself is stale.
    slot_respell="$(slot_name_actual "$slot")"
    if [ -n "$slot_respell" ]; then
      slot_note="this approval renames the slot directory, which wears another spelling: ${slot_respell##*/}"
    fi
    if slot_declares_ignore "$slot"; then
      # Quiet read: a broken declaration is reported by the note below and
      # replaced by this ceremony, so read_ignored_paths' own refusal text
      # would only be noise here.
      if read_ignored_paths "$slot" 2>/dev/null; then
        old_ign="$IGN_PATHS"
      else
        old_bad=1
      fi
    fi
    [ -e "$slot/approved" ] && had_copy=1
    # Custody for THIS file: what it typed, else what --keep keeps, else none.
    cust_src="--store"
    if [ -z "$store" ]; then
      if [ "$keep" -eq 1 ]; then store="$had_copy"; cust_src="--keep"; else store=0; fi
    fi
    if ! inspect_slot "$slot" 2>/dev/null; then
      # Malformed is unreadable state, not unapproachable state: the
      # ceremony is exactly the act that may reassert it. Loudly.
      state_note="malformed slot -- this approval resets it"
    else
      case "$slot_state" in
        pin)
          verify_record_file "$slot_file" || exit 1
          # THE ONE READER, restored. Reading the record raw here is what made
          # a stale spelling invisible to this ceremony: the digest matched,
          # the declaration matched, and the short-circuit below answered
          # "already approved" without ever re-stating the path -- leaving the
          # one state verify refuses with no ceremony that clears it.
          rec_rc=0
          read_pin_record "$slot_file" "$slot_kind" "$path" || rec_rc=$?
          case "$rec_rc" in
            0) old_digest="$REC_DIGEST"; old_label="$REC_LABEL" ;;
            2) old_digest="$REC_DIGEST"; old_label="$REC_LABEL"
               path_restated=1
               state_note="this approval re-states the record, which names another path: $REC_PATH" ;;
            *) state_note="the slot's record is unreadable -- this approval replaces it" ;;
          esac ;;
        tombstone)
          IFS= read -r line <"$slot_file" || line=""
          state_note="approving reinstates this path, which a tombstone retired: $line" ;;
        rev)
          state_note="slot held a repo pin -- this approval resets it to a file pin" ;;
      esac
    fi

    # Freeze ONCE; display, diff, hash and record all derive from the
    # frozen copy (record == displayed buffer, by construction).
    freeze_file "$path" || { error "cannot read: " "$path"; failed=$((failed + 1)); continue; }
    local fro="$FROZEN_COPY"
    new_digest="$(hash_file "$file_algo" "$fro")" || exit 1

    # THE TAG RULE, over every extra a slot can hold: the ceremony re-states
    # ALL of them EVERY time, so a review carrying no --ignore clears the
    # declaration and one carrying no --store drops the stored witness.
    # Identical bytes are therefore a no-op only when the declaration AND the
    # custody state are identical too -- otherwise the human still has a
    # narrowing, a widening, or a disclosure change to confirm.
    if [ "$old_bad" -eq 1 ]; then
      decl_changed=1
      ign_note="the slot's ignored-key declaration is unreadable -- this approval replaces it"
    elif [ "$ign_json" != "$old_ign" ]; then
      # The change itself is drawn on the ignored row (`<from> → <to>`), the
      # way custody draws its own: one fact, said once, where it is decided.
      decl_changed=1
    fi
    # A stored witness that does not re-hash to its own record is incoherent
    # slot state, and the ceremony is the documented way out of it (verify
    # says so by name), so it must not be short-circuited away. Same
    # treatment as an unreadable declaration, one hash to find out.
    if [ "$had_copy" -eq 1 ] && [ -n "$old_digest" ]; then
      cur_copy=""
      [ -f "$slot/approved" ] \
        && cur_copy="$(hash_file "$old_label" "$slot/approved" 2>/dev/null || true)"
      [ "$cur_copy" = "$old_digest" ] || copy_bad=1
    fi

    # A custody change is stated on the custody line itself, as the state it
    # leaves (cust_from) and an arrow to the new one, rather than in a note
    # above: one fact, said once, where it is decided. Gated on there BEING a
    # prior record -- on a first approval nothing is changing, custody is
    # simply being chosen.
    if [ -n "$old_digest" ] && [ "$had_copy" -ne "$store" ]; then
      decl_changed=1
      if [ "$store" -eq 1 ]; then
        cust_from="none"
      else
        cust_from="kept in the slot"
      fi
    elif [ "$store" -eq 1 ] && [ "$copy_bad" -eq 1 ]; then
      decl_changed=1
      cust_from="mismatched copy"
    fi

    # Identical bytes are not enough to skip when the RECORD names another
    # path: re-stating that binding is the whole point of this pass, and it
    # is the one repair for a slot verify refuses.
    if [ -n "$old_digest" ] && [ "$old_label" = "$file_algo" ] && [ "$new_digest" = "$old_digest" ] \
       && [ "$decl_changed" -eq 0 ] && [ "$path_restated" -eq 0 ] && [ -z "$slot_respell" ]; then
      untrusted_var path_plain "$path"
      printf '%salready approved:%s %s\n' "$C_GRN" "$C_OFF" "$path_plain"
      continue
    fi

    # The path as the `file:` rows draw it (the identity row, and the row
    # over the question after a body), escaped in the subject color.
    untrusted_var path_disp "$path" "$C_B$C_MAG"
    # THE NOTES are this ceremony's judgment of the slot (malformed, a
    # record naming another path, a tombstone, a stale directory name, a
    # witness that does not re-hash), so they print where a verdict
    # belongs: after the content's closing rule, directly above the
    # question -- never above third-party text a soft wrap could make pose
    # as one. Collected here, printed there. A note about a value ends on
    # it.
    notes_out=""
    for note_disp in "$state_note" "$ign_note" "$slot_note"; do
      [ -n "$note_disp" ] || continue
      untrusted_var note_disp "$note_disp" "$C_YEL"
      notes_out="$notes_out${C_B}note:${C_OFF}       ${C_YEL}${note_disp}${C_OFF}$NL"
    done

    # WHICH item of the batch this is, before its identity block: a ceremony
    # that asks several questions in a row has to say where in the row you
    # are. A single --file is not a batch (same rule as the summary tail),
    # and the counter counts INVOCATION position, so a skipped or
    # short-circuited file simply leaves a gap -- honest about what it is.
    [ "$n" -le 1 ] || printf '%s[%s/%s]%s\n' "$C_DIM" "$i" "$n" "$C_OFF"
    printf '%sfile:%s       %s%s%s\n' "$C_B" "$C_OFF" "$C_B$C_MAG" "$path_disp" "$C_OFF"
    if [ -n "$old_digest" ]; then
      printf '%sapproved:%s   %s%s%s  %s(%s)%s\n' "$C_B" "$C_OFF" "$C_CYN" "$old_digest" "$C_OFF" "$C_DIM" "$old_label" "$C_OFF"
    else
      printf '%sapproved:%s   (none -- first approval)\n' "$C_B" "$C_OFF"
    fi
    # Identical bytes say so on the candidate row, so nobody has to compare
    # 64 characters by eye; the diff below is skipped for them.
    same_bytes=0
    if [ -n "$old_digest" ] && [ "$old_label" = "$file_algo" ] && [ "$new_digest" = "$old_digest" ]; then
      same_bytes=1
      printf '%s%s:%s     %s%s%s  %s✓ unchanged%s\n' "$C_B" "$file_algo" "$C_OFF" "$C_CYN" "$new_digest" "$C_OFF" "$C_GRN" "$C_OFF"
    else
      printf '%s%s:%s     %s%s%s\n' "$C_B" "$file_algo" "$C_OFF" "$C_CYN" "$new_digest" "$C_OFF"
    fi
    # The declaration, stated before the confirm and not after it: answering
    # y approves the CONTENT and the tolerance in one act, so the tolerance
    # has to be on screen while the question is being asked.
    # THE IGNORED KEYS, one per row in the attention color: they are the one
    # row that loosens the byte-exact pin. Against a prior record, a change
    # is marked in the gutter the way a diff marks lines -- a green `+` and
    # bold for a key this approval adds, a red `-` and dim for one it drops,
    # no mark for one it keeps -- so a long list still reads at a glance.
    #
    # GRANT PROVENANCE: the display audits the ladder, so the rung that
    # permits each key, and how far it reaches, is on screen while the
    # question is asked. One shared scope is said once below the list; mixed
    # scopes ride at the end of each row. Every listed key that stays is
    # granted (an ungranted one never reaches this display).
    ign_marks=0
    if [ "$old_bad" -eq 0 ] && [ -n "$old_digest" ] && [ "$ign_json" != "$old_ign" ]; then
      ign_marks=1
    fi
    if [ -n "$ign_json" ] || [ "$ign_marks" -eq 1 ]; then
      ign_new="${ign_json:-[]}" ign_old="${ign_json:-[]}"
      [ "$ign_marks" -eq 0 ] || ign_old="${old_ign:-[]}"
      gr_list="" gr_scope="" gr_mixed=0
      if [ -n "$ign_json" ]; then
        while IFS="$TAB" read -r gk gscope; do
          [ -n "$gk" ] || continue
          case "$gscope" in
            '*') gwhere="everywhere" ;;
            *)   gwhere="under $gscope" ;;
          esac
          if [ -z "$gr_list" ]; then
            gr_scope="$gwhere"
          elif [ "$gr_scope" != "$gwhere" ]; then
            gr_mixed=1
          fi
          gr_list="$gr_list$gk$TAB$gwhere$NL"
        done <<EOF
$(policy_grants "$POL_EFF" "$ign_json" "$path")
EOF
      fi
      # A key's own scope, when the scopes are mixed, names a value of its
      # own (a path), so it is a dim line under the key's row, in the value
      # column -- never text after the key.
      ign_lead="${C_B}ignored:${C_OFF}  "
      while IFS="$TAB" read -r imark ikey; do
        [ -n "$ikey" ] || continue
        itail=""
        if [ "$gr_mixed" -eq 1 ] && [ "$imark" != "-" ]; then
          itail="$(printf '%s' "$gr_list" | awk -F "$TAB" -v k="$ikey" '$1 == k { print $2; exit }')"
        fi
        case "$imark" in
          +) printf '%s%s+%s %s%s%s\n' "$ign_lead" "$C_GRN" "$C_OFF" "$C_B$C_YEL" "$ikey" "$C_OFF" ;;
          -) printf '%s%s-%s %s%s%s\n' "$ign_lead" "$C_RED" "$C_OFF" "$C_DIM" "$ikey" "$C_OFF" ;;
          *) printf '%s  %s%s%s\n' "$ign_lead" "$C_YEL" "$ikey" "$C_OFF" ;;
        esac
        [ -z "$itail" ] || printf '            %s%s%s\n' "$C_DIM" "$itail" "$C_OFF"
        ign_lead="          "
      done <<EOF
$(jq -r -n --argjson o "$ign_old" --argjson n "$ign_new" '
    ($o[] as $k | [(if any($n[]; . == $k) then " " else "-" end), ($k | join("."))]),
    ($n[] as $k | select(any($o[]; . == $k) | not) | ["+", ($k | join("."))])
    | @tsv')
EOF
      if [ -z "$ign_json" ]; then
        printf '            %s(every key returns to byte-exact)%s\n' "$C_DIM" "$C_OFF"
      else
        if [ -n "$kept_ign" ]; then
          printf '            %s(--keep · these keys may drift without re-approval)%s\n' "$C_DIM" "$C_OFF"
        else
          printf '            %s(these keys may drift without re-approval)%s\n' "$C_DIM" "$C_OFF"
        fi
        # The grant, and the machine tier that constrains the whole set:
        # each ends on its own path, so each is a line of its own.
        if [ -n "$gr_list" ] && [ "$gr_mixed" -eq 0 ]; then
          printf '            %sgranted by user policy, %s%s\n' "$C_DIM" "$gr_scope" "$C_OFF"
        elif [ -n "$gr_list" ]; then
          printf '            %sgranted by user policy, scope per key%s\n' "$C_DIM" "$C_OFF"
        fi
        [ -z "$gr_list" ] || [ -z "$POL_MACHINE" ] \
          || printf '            %swithin the machine policy at %s%s\n' "$C_DIM" "$PINNED_MACHINE_POLICY" "$C_OFF"
      fi
    fi
    # CUSTODY, stated in both directions and always -- not only when it is
    # changing. What the slot will hold after this y is part of what is being
    # approved, and "no copy is kept" is as much a decision as keeping one.
    # But STATING it is one line; EXPLAINING it is a paragraph, and a
    # paragraph re-read at every launch stops being read at all. The
    # explanation is therefore spent where it buys something: when this
    # approval is choosing custody for the first time (no prior record), when
    # it flips the stored-copy state, or when it repairs a stored copy that
    # does not re-hash to its record -- exactly the cases the ceremony treats
    # as a custody DECISION rather than a restatement. A change is drawn as
    # `<from> → <to>` in the attention color, the only custody text that is.
    cust_changed=0
    if [ -z "$old_digest" ] || [ "$had_copy" -ne "$store" ] || [ -n "$cust_from" ]; then
      cust_changed=1
    fi
    cust_to="kept in the slot"
    [ "$store" -eq 1 ] || cust_to="none"
    if [ -n "$cust_from" ]; then
      cust_val="${C_YEL}${cust_from} → ${cust_to}${C_OFF}"
    else
      cust_val="$cust_to"
    fi
    if [ "$store" -eq 1 ]; then
      printf '%scustody:%s    %s  %s(%s · pinned cat serves these bytes)%s\n' \
        "$C_B" "$C_OFF" "$cust_val" "$C_DIM" "$cust_src" "$C_OFF"
      if [ "$cust_changed" -eq 1 ]; then
        printf '            %sA copy of these bytes is kept beside the record as the%s\n' "$C_DIM" "$C_OFF"
        printf '            %switness: what the ignored-key comparison reads, and what%s\n' "$C_DIM" "$C_OFF"
        printf '            %spinned cat serves. It is readable by anything that mounts%s\n' "$C_DIM" "$C_OFF"
        printf '            %sthe slot.%s\n' "$C_DIM" "$C_OFF"
      fi
    else
      printf '%scustody:%s    %s  %s(no copy at rest · pinned cat has nothing to serve)%s\n' \
        "$C_B" "$C_OFF" "$cust_val" "$C_DIM" "$C_OFF"
      if [ "$cust_changed" -eq 1 ]; then
        printf '            %sNo copy is kept at rest: the slot records the digest and%s\n' "$C_DIM" "$C_OFF"
        printf '            %sdiscloses nothing more, so pinned cat has nothing to serve.%s\n' "$C_DIM" "$C_OFF"
        printf '            %sA consumer that wants the ignored-key comparison brings its%s\n' "$C_DIM" "$C_OFF"
        printf '            %sown witness (verify --baseline). Any copy this slot holds%s\n' "$C_DIM" "$C_OFF"
        printf '            %stoday is dropped by this approval.%s\n' "$C_DIM" "$C_OFF"
      fi
    fi
    echo

    # IDENTICAL BYTES show nothing to read: the sha256 row already says
    # `✓ unchanged`, and this review exists only for what the rows above
    # mark as changing (the declaration, custody, the record's path). A
    # gate over an empty diff would open nothing, so there is none.
    if [ "$same_bytes" -eq 0 ]; then
      # Diff only against a VERIFIED baseline: the candidate must re-hash
      # to the prior recorded digest (the self-verifying trust-cache
      # trick, root-side). Anything else degrades to the full view --
      # never to a diff against unverified bytes.
      #
      # THE WITNESS, in verify's order: the slot's own copy first (custody
      # cannot be withheld or swapped between calls), then the copy this
      # --file brought as --baseline, then the ceremony's --baseline-store
      # entry for this slot and the prior digest. Neither storage location
      # nor custody is what makes a witness usable, the re-hash is, so the
      # first candidate that re-hashes wins and a wrong or forged one can
      # only widen the display to the full file.
      base_ok=0 base_tried=0
      if [ -n "$old_digest" ]; then
        for cand in "$slot/approved" "$base" \
                    "${baseline_store:+$baseline_store/$(encode "$path")/$old_digest}"; do
          [ -n "$cand" ] && [ -f "$cand" ] || continue
          base_tried=1
          freeze_file "$cand" 2>/dev/null || continue
          [ "$(hash_file "$old_label" "$FROZEN_COPY")" = "$old_digest" ] || continue
          base_ok=1
          break
        done
      fi
      if [ "$base_ok" -eq 1 ]; then
        # The diff, its size and its keys block, from the two frozen
        # buffers (baseline = $FROZEN_COPY, candidate = $fro), through the
        # one file-diff path the diff verb shares (file_diff_capture).
        # --label names the two sides by role and by the subject path, the
        # path the header already showed.
        file_diff_capture "$FROZEN_COPY" "$fro" "approved: $path" "candidate: $path" || {
          error "cannot diff the candidate against the approved baseline: " "$path"
          failed=$((failed + 1))
          continue
        }
      fi
      # THE GATE BEFORE THE PAGER, as the repo ceremony has it (see
      # file_diff_gate). `n` declines without looking -- record unchanged,
      # logged as skip, counted as declined. Approving without the bytes
      # stays impossible.
      if [ "$base_ok" -eq 1 ]; then
        # The file: row is the identity block's, just above; only the
        # change is new.
        file_diff_change_row
        if ! file_diff_gate "review this change"; then
          printf '%sskipped; record unchanged%s\n' "$C_YEL" "$C_OFF"
          log_action approve-file "$path" "$new_digest" skip
          declined=$((declined + 1))
          continue
        fi
        file_diff_show "diff vs the approved baseline (exactly the bytes being approved)"
      else
        if [ "$base_tried" -eq 1 ]; then
          notes_out="$notes_out${C_B}note:${C_OFF}       ${C_YEL}the baseline does not re-hash to the approved record, so the full file was shown${C_OFF}$NL"
        fi
        # Counted with wc, not awk: the frozen buffer can hold any bytes at
        # all, and a line count must not be the thing that refuses a binary.
        # A file whose last line has no terminator still counts as a line.
        nl=''
        [ "$(tail -c1 -- "$fro" | wc -l)" -eq 1 ] && nl=1
        n_lines="$(LC_ALL=C wc -l <"$fro" | tr -d ' ')"
        [ -n "$nl" ] || [ ! -s "$fro" ] || n_lines=$((n_lines + 1))
        printf '%schange:%s     %s%s line%s%s\n' "$C_B" "$C_OFF" \
          "$C_CYN" "$n_lines" "$(plural_s "$n_lines")" "$C_OFF"
        printf -v gate_line '%sreview this file;%s %sEnter%s open %s· %s%sn%s%s skip%s ' \
          "$C_B" "$C_OFF" "$C_BLU" "$C_OFF" \
          "$C_DIM" "$C_OFF" "$C_BLU" "$C_OFF" "$C_DIM" "$C_OFF"
        if ! gate_answer "$gate_line"; then
          printf '%sskipped; record unchanged%s\n' "$C_YEL" "$C_OFF"
          log_action approve-file "$path" "$new_digest" skip
          declined=$((declined + 1))
          continue
        fi
        # Escaped first, then syntax color where the suffix names a
        # highlighter and highlight_ok admits the content; the digest above
        # came from the file, not from this stream, and a highlighter only
        # inserts SGR codes between the bytes it is given. Rendered before
        # the section rule, which states the line endings when they are
        # CRLF: the one fact about the text that is drawn as layout.
        hl="$(highlighter_for "$path")"
        highlight_ok "$hl" <"$fro" || hl=""
        untrusted_render doc "$hl" <"$fro"
        # The section rule holds no value: the path is on the file: row.
        printf '%s--- exactly the bytes being approved%s ---%s\n' "$C_B" \
          "${UT_CRLF:+ (CRLF line endings)}" "$C_OFF"
        untrusted_show
        print_end_rule file "$n_lines line$(plural_s "$n_lines")"
      fi
      echo
    fi

    # The question block: the rows it decides about (the path, and the
    # digest the record will bind), the notes, then the question, with
    # nothing third-party between them. The rows repeat only over a body
    # (the diff or the file); identical bytes showed none, so the identity
    # block above is still the question's rows.
    if [ "$same_bytes" -eq 0 ]; then
      printf '%sfile:%s       %s%s%s\n' "$C_B" "$C_OFF" "$C_B$C_MAG" "$path_disp" "$C_OFF"
      printf '%s%s:%s     %s%s%s\n' "$C_B" "$file_algo" "$C_OFF" "$C_CYN" "$new_digest" "$C_OFF"
    fi
    printf '%s' "$notes_out"
    printf '%sapprove this file? [%sy%s/%sN%s]%s ' "$C_B" \
      "$C_BLU" "$C_OFF$C_B" "$C_BLU" "$C_OFF$C_B" "$C_OFF"
    drain_tty
    read -r answer </dev/tty
    case "$answer" in
      y|Y|yes)
        # BEFORE the record is written, so the record lands in the directory
        # whose name already decodes back to the path it names -- no window
        # in which a listing and a record disagree. Its own log line: a
        # structural change nobody asked for must be auditable after the
        # fact, not only visible to whoever was watching the screen.
        if [ -n "$slot_respell" ]; then
          mv -f "$slot_respell" "$slot"
          log_action respell "$path" "" ok
          print_verdict_to "$C_GRN$C_B" "slot renamed" \
            "$C_CYN${slot_respell##*/}$C_OFF" "$C_CYN${slot##*/}$C_OFF"
        fi
        write_slot_state "$slot" "pin.$file_algo" "$new_digest  $path"
        # The stored witness is the frozen buffer this ceremony displayed and
        # hashed -- the same single read the record binds to, so custody can
        # never hold bytes the human did not see. A root-owned copy beside
        # the digest is also the one baseline nothing unprivileged can forge;
        # everything else has to prove itself at every use.
        if [ "$store" -eq 1 ]; then
          write_slot_copy "$slot" approved "$fro"
          printf '%s✓ approved %s%s%s%s:%s %s\n' "$C_GRN$C_B" "$C_OFF$C_CYN" "$new_digest" "$C_OFF" \
            "$C_GRN$C_B" "$C_OFF" "$(show_slot "$slot")/pin.$file_algo"
          printf '%s✓ approved copy kept:%s %s\n' "$C_GRN$C_B" "$C_OFF" "$(show_slot "$slot")/approved"
        else
          rm -f "$slot/approved"
          printf '%s✓ approved %s%s%s%s:%s %s\n' "$C_GRN$C_B" "$C_OFF$C_CYN" "$new_digest" "$C_OFF" \
            "$C_GRN$C_B" "$C_OFF" "$(show_slot "$slot")/pin.$file_algo"
          # Losing custody is a state change worth naming after the fact too:
          # a consumer reading through the slot stops being served here.
          if [ "$had_copy" -eq 1 ]; then
            printf '%snote: the stored approved copy was dropped -- re-approve with --store to keep one%s\n' \
              "$C_YEL" "$C_OFF"
          fi
        fi
        # The declaration is re-stated from THIS ceremony every time, so the
        # absence of --ignore is itself a declaration: it clears the keys.
        # Clearing first also means a slot never ends up holding two declared
        # formats.
        clear_ignore_decl "$slot"
        if [ -n "$ign_json" ]; then
          write_note "$slot" ignored.json "$ign_json"
          print_verdict_to "$C_GRN$C_B" ignoring \
            "$C_YEL$(ign_display "$ign_json")$C_OFF" "$(show_slot "$slot")/ignored.json"
        fi
        log_action approve-file "$path" "$new_digest"
        recorded=$((recorded + 1))
        ;;
      *)
        printf '%sdeclined; record unchanged%s\n' "$C_YEL" "$C_OFF"
        log_action approve-file "$path" "$new_digest" abort
        declined=$((declined + 1))
        ;;
    esac
  done

  if [ "$n" -gt 1 ] || [ "$failed" -gt 0 ]; then
    echo
    printf '%s%s recorded, %s declined, %s failed%s\n' "$C_DIM" "$recorded" "$declined" "$failed" "$C_OFF"
  fi
  [ "$failed" -eq 0 ] || exit 1
}

# ---- tombstone -------------------------------------------------------------

# Retire a pinned path that is GONE. The tombstone is sentinel SLOT
# CONTENT, never slot deletion: pin+missing refuses (restore or
# tombstone), tombstone+absent passes silently, tombstone+present
# refuses -- retired content resurrected must not read as merely new.
# Content is one ISO-stamped ASCII line; only its EXISTENCE carries the
# semantics, the line is forensics.
do_tombstone() {
  require_root tombstone
  # --yes answers both gates (see yes_answers_all). A tombstone's whole
  # decision is one path, on the command line, and what the y/N would add
  # is checked here by machine: the path must be gone (path_gone, so a
  # hidden one refuses) and the slot must hold a record.
  local a path_arg="" yes=0
  for a in "$@"; do
    [ "$a" = "--yes" ] && { yes=1; continue; }
    [ -z "$path_arg" ] || usage
    path_arg="$a"
  done
  [ -n "$path_arg" ] || usage
  local path slot answer line gone=0 path_disp line_disp
  path="$(canon_path "$path_arg")" || exit 1
  path_gone "$path" || gone=$?
  if [ "$gone" -eq 2 ]; then
    refused "cannot tell whether this path still exists, and you tombstone only what's gone: " "$path"
    exit 1
  fi
  if [ "$gone" -eq 1 ]; then
    refused "this path still exists, and you tombstone what's gone, not what's live: " "$path"
    echo "        (retire the content first, or review the current content instead)" >&2
    exit 1
  fi
  ensure_tree "$inv"
  slot="$(slot_dir_for "$inv" "$path")"
  inspect_slot "$slot" 2>/dev/null || slot_state=malformed
  # The path is the caller's own bytes, escaped for every row it is on.
  untrusted_var path_disp "$path" "$C_CYN"
  case "$slot_state" in
    none)
      say_err "no slot: never approved, so there is nothing to tombstone: " "$path"
      exit 1 ;;
    tombstone)
      IFS= read -r line <"$slot_file" || line=""
      untrusted_var line_disp "$line" "$C_DIM"
      printf 'already tombstoned: %s%s%s\n' "$C_CYN" "$path_disp" "$C_OFF"
      printf '%stombstone:%s  %s%s%s\n' "$C_DIM" "$C_OFF" "$C_DIM" "$line_disp" "$C_OFF"
      exit 0 ;;
  esac
  # The rows the question decides about (see print_candidate_rows). Each
  # value is a path, so it ends its row; what state it is in is a word from
  # a fixed set, a column before it padded to the longest word shown.
  local qw=4
  [ "${#slot_state}" -le "$qw" ] || qw="${#slot_state}"
  printf '%spath:%s       %-*s  %s%s%s\n' "$C_B" "$C_OFF" "$qw" gone "$C_CYN" "$path_disp" "$C_OFF"
  printf '%sslot:%s       %-*s  %s\n' "$C_B" "$C_OFF" "$qw" "$slot_state" "$(show_slot "$slot")"
  if [ "$yes" -eq 0 ]; then
    printf '%sverify then refuses this path until it is re-approved.%s\n' "$C_DIM" "$C_OFF"
    printf '%stombstone this path? [%sy%s/%sN%s]%s ' "$C_B" \
      "$C_BLU" "$C_OFF$C_B" "$C_BLU" "$C_OFF$C_B" "$C_OFF"
    drain_tty
    read -r answer </dev/tty
    case "$answer" in
      y|Y|yes) ;;
      *) echo "aborted; slot unchanged"; log_action tombstone "$path" "" abort; exit 2 ;;
    esac
  fi
  write_slot_state "$slot" tombstone "$(date -u +%Y-%m-%dT%H:%M:%SZ) retired by $inv"
  rm -f "$slot/release"   # a declared release name has no meaning on a tombstone
  clear_slot_ignore "$slot"   # nor do tolerated keys, or a copy of what is gone
  printf '%s✓ tombstoned:%s %s%s%s\n' "$C_GRN$C_B" "$C_OFF" "$C_CYN" "$path_disp" "$C_OFF"
  log_action tombstone "$path"
}

# ---- rekey -----------------------------------------------------------------

# Hand verify's own diagnosis through, saying whose record and whose bytes it
# was about -- verify names the path whose SLOT it read (the old one), which
# without this line reads as a verdict about the wrong file.
rekey_verify_said() { # $1 old  $2 new  $3 captured output
  local rv_old rv_new
  untrusted_var rv_old "$1" "$C2_DIM" 2
  untrusted_var rv_new "$2" "$C2_DIM" 2
  printf '%sverify, on the record for the old path and the bytes now at the new one:%s\n' \
    "$C2_DIM" "$C2_OFF" >&2
  printf '%s  old:  %s%s\n' "$C2_DIM" "$rv_old" "$C2_OFF" >&2
  printf '%s  new:  %s%s\n' "$C2_DIM" "$rv_new" "$C2_OFF" >&2
  cat -- "$3" >&2
}

# Re-key a record to the path its content has MOVED to. A path is a record's
# identity, so a moved repo or file orphans its slot, and re-approving costs a
# full first-approval ceremony -- a review of everything, when nothing
# changed but the name.
#
# WHY THIS NEVER WIDENS TRUST. The record travels VERBATIM: same rev, same
# digest, same declarations. The one new claim is "this path", and even that
# is not taken on the human's word -- the machine checks that the content now
# at <new> is exactly what the record already names (a work tree whose object
# store holds the pinned rev; a file that re-hashes to the pinned digest,
# byte-exact or drifting only in keys the slot already declares ignored). So
# the ceremony asks about precisely what it displays, and no answer to it can
# make any bytes trusted that were not trusted a moment before. Everything
# ambiguous fails closed: an old path that still exists, a tombstoned or
# malformed old slot, and any state at the new slot all refuse rather than
# merge.
#
# The old slot is TOMBSTONED, never deleted: something reappearing at a
# formerly-trusted path must fail closed, and tombstone+present refuses where
# a missing slot would merely re-prompt.
do_rekey() {
  require_root rekey
  local subj
  # --yes answers the y/N below: both paths are on the command line, and
  # the content at the new one is matched to the record by machine.
  local a old_arg="" new_arg="" yes=0
  for a in "$@"; do
    if [ "$a" = "--yes" ]; then yes=1
    elif [ -z "$old_arg" ]; then old_arg="$a"
    elif [ -z "$new_arg" ]; then new_arg="$a"
    else usage; fi
  done
  [ -n "$new_arg" ] || usage
  local old new old_slot new_slot target what answer line f e
  local state kind src rev digest label tag="" ign_show="" drifted="" travels=""
  local vrc=0 irc=0 vout
  old="$(canon_path "$old_arg")" || exit 1
  new="$(canon_path "$new_arg")" || exit 1
  if [ "$old" = "$new" ]; then
    refused "old and new name the same path: " "$old"
    exit 1
  fi
  case "$new" in
    *"$NL"*)
      error "refusing a path containing a newline (records are one line per pin)"
      exit 1 ;;
  esac

  ensure_tree "$inv"
  old_slot="$(slot_dir_for "$inv" "$old")"
  new_slot="$(slot_dir_for "$inv" "$new")"

  inspect_slot "$old_slot" || {
    say_err "       a malformed record cannot be moved; fix the slot by hand, or review the new path: " "$new"
    exit 1
  }
  case "$slot_state" in
    none)
      say_err "no slot: never approved, so there is no record to re-key: " "$old"
      say_err "       review the new path instead: " "$new"
      exit 1 ;;
    tombstone)
      IFS= read -r line <"$slot_file" || line=""
      refused "this path is tombstoned: " "$old"
      say_err "        " "$line"
      echo "        a tombstone marks the old path's own history; it does not travel --" >&2
      say_err "        review the new path instead: " "$new"
      exit 1 ;;
  esac
  state="$slot_state" kind="$slot_kind" src="$slot_file"
  verify_ancestry "$src" || exit 1

  # rekey FOLLOWS a move that already happened. While the old path is still
  # there the premise is simply false, and two live paths would be claiming
  # one record.
  local old_gone=0
  path_gone "$old" || old_gone=$?
  if [ "$old_gone" -eq 2 ]; then
    refused "cannot tell whether this path still exists, and a rekey follows only a move that happened: " "$old"
    exit 1
  fi
  if [ "$old_gone" -eq 1 ]; then
    refused "this path still exists, and you rekey a record whose content has already moved: " "$old"
    say_err "        move the content first, or review the new path instead: " "$new"
    exit 1
  fi

  # RECORDS DO NOT MERGE. Anything already at the new slot -- a live record,
  # a tombstone, or the signer data `signer add --repo` leaves in an
  # otherwise state-free slot -- is state a human decided on, and absorbing
  # it silently is exactly the quiet widening this tool exists to refuse.
  if [ -d "$new_slot" ]; then
    inspect_slot "$new_slot" || exit 1
    if [ "$slot_state" != none ]; then
      refused "the new path already has a record ($slot_state), and records do not merge: " "$new"
      say_err "        tombstone or review the new path explicitly: " "$new"
      exit 1
    fi
    if [ -e "$new_slot/signers" ]; then
      refused "the new slot holds per-slot signer data (signers/allowed_signers): $new_slot"
      echo "        moving a record onto it would silently place this content under those" >&2
      echo "        signers; reconcile them by hand, then re-run" >&2
      exit 1
    fi
    for e in "$new_slot"/* "$new_slot"/.[!.]*; do
      if [ -e "$e" ]; then
        refused "the new slot already holds a file, and records do not merge: $e"
        echo "        inspect the slot and clear it by hand, then re-run" >&2
        exit 1
      fi
    done
  fi
  case "$state" in
    rev) target="rev.$kind"; what=rev ;;
    *)   target="pin.$kind"; what=digest ;;
  esac
  # Same shape as review: walk from the state file when the slot exists,
  # from the slot itself when this write is about to create it.
  if [ -d "$new_slot" ]; then
    verify_ancestry "$new_slot/$target" || exit 1
  else
    verify_ancestry "$new_slot" || exit 1
  fi

  # CONFORMANCE -- the security core. The record is not re-decided here; the
  # content at the new path has to answer to it.
  case "$state" in
    rev)
      [ "$kind" = git ] \
        || { error "a record that declares an unsupported VCS, refused: " "$src"; exit 1; }
      rev="$(read_rev "$old_slot" "$old")" || exit 1
      [ -n "$rev" ] || { error "a malformed record, holding no rev: " "$src"; exit 1; }
      [ -d "$new" ] || {
        refused "a repo record moves to a work tree, and this is not a directory: " "$new"
        exit 1
      }
      # resolve_repo is the contract every repo verb resolves through: a
      # usable work tree, named at its ROOT. It sets $repo, which the sgit
      # below runs against.
      resolve_repo "$new"
      # A record names a commit, so the repository that answers to it is the
      # one whose object store HOLDS that commit. A work tree that does not
      # is a different repository wearing the new name.
      sgit cat-file -e "${rev}^{commit}" 2>/dev/null || {
        refused "this work tree's object store does not hold the pinned rev: " "$new"
        say_err "        this is not the repository the record names, whose rev is " "$rev"
        exit 1
      }
      ;;
    pin)
      verify_record_file "$src" || exit 1
      read_pin_record "$src" "$kind" "$old" || exit 1
      label="$REC_LABEL"; digest="$REC_DIGEST"
      [ -f "$new" ] || {
        refused "a file record moves to a file, and this is not a regular file: " "$new"
        exit 1
      }
      freeze_file "$new" || { error "cannot read: " "$new"; exit 1; }
      # THE CHECK IS VERIFY ITSELF -- the gate's own verdict, run against the
      # OLD slot's record with the NEW path's frozen bytes. Reusing it is what
      # keeps rekey from holding a private opinion about what "matches" means: 0
      # is byte-exact, 5 is drift confined to keys the slot already declares
      # ignored (and the policy still grants), and every other answer refuses.
      # The owner/mode invariant is the one part this cannot exercise -- verify
      # checks it on the original path, which is by definition gone here -- so
      # it stays what it always was, a per-use question the next verify at the
      # new path answers (30), never something a record carries.
      vout="$workdir/rekey-verify"
      vrc=0
      (do_verify --frozen "$FROZEN_COPY" "$old") >"$vout" 2>&1 || vrc=$?
      case "$vrc" in
        0) ;;
        5)
          while IFS= read -r line; do
            case "$line" in
              ignored-drift:*) drifted="${drifted:+$drifted, }${line#ignored-drift: }" ;;
            esac
          done <"$vout" ;;
        11)
          rekey_verify_said "$old" "$new" "$vout"
          refused "the content at the new path is not what the old path's record names"
          say_err "        a rekey carries the record verbatim; review the new path instead: " "$new"
          exit 1 ;;
        *)
          rekey_verify_said "$old" "$new" "$vout"
          error "the old path's record could not be checked against the new path (verify exit $vrc)"
          exit 1 ;;
      esac
      ;;
  esac

  # The annotations that travel. The release name is re-read through the same
  # declared-name grammar every other reader applies -- a name this version
  # would refuse must not ride along unexamined.
  if [ -f "$old_slot/release" ]; then
    verify_record_file "$old_slot/release" || exit 1
    IFS= read -r tag <"$old_slot/release" || tag=""
    if [ -n "$tag" ] && ! validate_release_name "$tag"; then
      untrusted_var tag_disp "$tag" "" 2
      error "a release record outside the declared-name grammar [A-Za-z0-9._/+-]: " "$old_slot/release"
      echo "        name:  $tag_disp" >&2
      say_cmd "        clear it by hand, then re-run: rm " "$old_slot/release"
      exit 1
    fi
  fi
  if slot_declares_ignore "$old_slot"; then
    irc=0
    read_ignored_paths "$old_slot" 2>/dev/null || irc=$?
    if [ "$irc" -eq 0 ]; then
      ign_show="$(ign_display "$IGN_PATHS")"
    else
      ign_show="(declaration unreadable; carried verbatim)"
    fi
  fi

  # THE QUESTION BLOCK: the rows it decides about, the verdict on the new
  # path's bytes, the consequence, the question (see print_candidate_rows).
  # Both paths are the caller's own bytes, escaped for every row they are
  # on; each ends its row, and the old one's state is a fixed-set word in a
  # column before it.
  local old_disp new_disp kind_word t_line
  untrusted_var old_disp "$old"
  untrusted_var new_disp "$new" "$C_CYN"
  printf '%sold:%s        gone  %s\n' "$C_B" "$C_OFF" "$old_disp"
  printf '%snew:%s              %s%s%s\n' "$C_B" "$C_OFF" "$C_CYN" "$new_disp" "$C_OFF"
  case "$state" in
    rev) kind_word="repo record" ;;
    *)   kind_word="file record" ;;
  esac
  printf '%srecord:%s     %s%s%s  %s(%s)%s\n' "$C_B" "$C_OFF" "$C_CYN" "$target" "$C_OFF" \
    "$C_DIM" "$kind_word" "$C_OFF"
  printf '%sslot:%s       %s\n' "$C_B" "$C_OFF" "$old_slot"
  print_row_to "$new_slot"
  case "$state" in
    rev)
      subject_var subj "$rev" "$C_DIM"
      printf '%srev:%s        %s%s%s  %s%s%s\n' "$C_B" "$C_OFF" "$C_CYN" "$rev" "$C_OFF" \
        "$C_DIM" "$subj" "$C_OFF" ;;
    pin)
      printf '%sdigest:%s     %s%s%s  %s(%s)%s\n' "$C_B" "$C_OFF" "$C_CYN" "$digest" "$C_OFF" \
        "$C_DIM" "$label" "$C_OFF" ;;
  esac
  # What travels with the record: a list whose length this script does not
  # choose, so one item per line, each ending on its value.
  [ -z "$tag" ] || travels="tag $tag"
  [ -z "$ign_show" ] || travels="${travels:+$travels$NL}ignored keys: $ign_show"
  [ ! -f "$old_slot/approved" ] || travels="${travels:+$travels$NL}the approved copy"
  [ ! -f "$old_slot/signers/allowed_signers" ] \
    || travels="${travels:+$travels$NL}per-slot allowed_signers"
  if [ -n "$travels" ]; then
    local t_lead="${C_B}travels:${C_OFF}    "
    while IFS= read -r t_line; do
      untrusted_var t_line "$t_line"
      printf '%s%s\n' "$t_lead" "$t_line"
      t_lead="            "
    done <<<"$travels"
  else
    printf '%stravels:%s    %s(the record only -- no annotations)%s\n' "$C_B" "$C_OFF" "$C_DIM" "$C_OFF"
  fi
  # The verdict on the new path's bytes, after the rows it is about.
  if [ -n "$drifted" ]; then
    printf '%snote:%s       %sthe file at the new path is not byte-identical: %s%s\n' \
      "$C_B" "$C_OFF" "$C_YEL" "$drifted" "$C_OFF"
    printf '            %sthe difference is confined to keys this slot already declares%s\n' \
      "$C_DIM" "$C_OFF"
    printf '            %signored, so the record still names this content (verify: 5).%s\n' \
      "$C_DIM" "$C_OFF"
  fi
  # The consequence, directly above the question. The rows are still on
  # screen just above, so none repeats.
  printf '%sConsumers will now trust this content at the new path.%s\n' "$C_B" "$C_OFF"
  printf '%sThe record itself does not change -- same %s, same declarations; only the\n' \
    "$C_DIM" "$what"
  printf 'path it answers to does. The old path, now gone, is tombstoned by this move,\n'
  printf 'so anything reappearing there refuses until it is approved on its own.%s\n' "$C_OFF"
  if [ "$yes" -eq 0 ]; then
    printf '%srekey this record? [%sy%s/%sN%s]%s ' "$C_B" \
      "$C_BLU" "$C_OFF$C_B" "$C_BLU" "$C_OFF$C_B" "$C_OFF"
    drain_tty
    read -r answer </dev/tty
    case "$answer" in
      y|Y|yes) ;;
      *) echo "aborted; both slots unchanged"; log_action mv "$old" "$new" abort; exit 2 ;;
    esac
  fi

  # WRITE ORDER: the new record first, so there is never a moment when this
  # content has no live record at all. A crash between the two writes leaves
  # the old record live beside the new one -- two paths, one rev or digest,
  # both verifying -- which is the safe failure: nothing is trusted that was
  # not trusted before, and re-running finishes the job.
  # Either kind, the record names the LIVE path (for a file record that is
  # what makes `shasum -c` work on it), so the path field is the one
  # byte-sequence that must be rewritten: rev or digest preserved, path
  # re-named, two-space separator kept.
  case "$state" in
    rev) write_slot_state "$new_slot" "$target" "$rev  $new" ;;
    pin) write_slot_state "$new_slot" "$target" "$digest  $new" ;;
  esac
  [ -z "$tag" ] || write_note "$new_slot" release "$tag"
  # By suffix, not by name: a declared format this version does not
  # recognize still belongs to the record and still travels with it.
  for f in "$old_slot"/ignored.*; do
    [ -e "$f" ] || continue
    write_slot_copy "$new_slot" "${f##*/}" "$f"
  done
  [ ! -f "$old_slot/approved" ] || write_slot_copy "$new_slot" approved "$old_slot/approved"
  if [ -f "$old_slot/signers/allowed_signers" ]; then
    install -d -m "$TREE_DMODE" -o root -g "$TREE_GRP" "$new_slot/signers"
    write_slot_copy "$new_slot/signers" allowed_signers "$old_slot/signers/allowed_signers"
  fi
  # What moved (the rev or digest, a fixed width) and where its record now
  # lives, which ends the row; the paths are on the rows above.
  case "$state" in
    rev) printf '%s✓ re-keyed %s%s%s%s:%s %s\n' "$C_GRN$C_B" "$C_OFF$C_CYN" "$rev" "$C_OFF" "$C_GRN$C_B" "$C_OFF" "$new_slot/$target" ;;
    pin) printf '%s✓ re-keyed %s%s%s%s:%s %s\n' "$C_GRN$C_B" "$C_OFF$C_CYN" "$digest" "$C_OFF" "$C_GRN$C_B" "$C_OFF" "$new_slot/$target" ;;
  esac

  write_slot_state "$old_slot" tombstone "$(date -u +%Y-%m-%dT%H:%M:%SZ) moved to $new by $inv"
  rm -f "$old_slot/release"      # the declared name left with the record
  clear_slot_ignore "$old_slot"  # as did the tolerated keys and the copy
  if [ -f "$old_slot/signers/allowed_signers" ]; then
    rm -f "$old_slot/signers/allowed_signers"
    # Only an EMPTY leftover goes -- anything still in there is unexplained
    # state a trust tool must not delete on a hunch (ensure_tree's rule).
    rmdir "$old_slot/signers" 2>/dev/null \
      || printf '%swarning: not empty, left in place: %s%s\n' \
           "$C2_YEL" "$old_slot/signers" "$C2_OFF" >&2
  fi
  printf '%s✓ tombstoned:%s %s\n' "$C_GRN$C_B" "$C_OFF" "$old_disp"
  log_action mv "$old" "$new"
}

# ---- declare ---------------------------------------------------------------

# Name the release a pinned rev ALREADY is. The declaration is the slot's
# `release` record: the release name deploy syncs the input's ref= to,
# after cross-checking that the live tag still names the approved rev. A
# review that MOVES the pin already writes it (--tag, --signed-tag), and a
# plain review clears it; this verb is how a slot that is already pinned
# gains a declaration -- or gives one up -- without waiting for the next
# release.
#
# DECLARATIVE: --release <name> and --no-release each state a desired end
# state, and success means the slot now matches it. A slot already in the
# requested state is a success with an explicit no-change line, exit 0, on
# BOTH sides -- a provisioning script re-running `declare` must not fail.
# Fail-closed governs refusing a state that cannot be VERIFIED, not a state
# already achieved. The no-op still costs the sudo prompt: the pre-sudo side
# validates argv only and never reads root-owned slot state.
#
# THE INVARIANT: a declaration may only name a tag that already resolves to
# the slot's pinned rev -- deploy's own cross-check, run at declaration
# time, so declare can never write a record deploy would refuse. Everything
# that makes this ceremony lighter than an approval follows from it. It
# cannot change what is built: the rev is the trust decision and declare
# never touches it -- ref= only tells nix where to fetch a rev it verifies
# anyway, so a wrong ref is a fetch failure, never a different build. It
# cannot invent provenance: "this rev is also known as <name>" is checked,
# not taken. And a name that moves later fails closed, because deploy
# re-runs the same check on every sync.
#
# Signatures are deliberately OUT OF SCOPE: declare never verifies one and
# never requires one, so unsigned annotated and lightweight tags work. The
# tag carries no authority here beyond "this name currently points at the
# already-approved commit", which is checked directly. Repos that sign keep
# the stronger path they already have: review --signed-tag writes the
# declaration as a side effect, and a deployer may offer it automatically.
do_declare() {
  require_root declare
  local subj
  # --yes answers the y/N below: the repo and the name are on the command
  # line, and that the name resolves to the pinned rev is checked by machine.
  local a repo_arg="" name="" remove=0 want=0 yes=0
  for a in "$@"; do
    if [ "$want" -eq 1 ]; then name="$a"; want=0; continue; fi
    case "$a" in
      --release) want=1 ;;
      --no-release) remove=1 ;;
      --yes) yes=1 ;;
      -*) usage ;;
      *)
        [ -z "$repo_arg" ] || usage
        repo_arg="$a" ;;
    esac
  done
  [ "$want" -eq 0 ] || { echo "--release needs a name" >&2; exit 1; }
  [ -n "$repo_arg" ] || usage
  # Exactly one of the two: a name to declare, or the cleared state.
  if [ -n "$name" ] && [ "$remove" -eq 1 ]; then usage; fi
  if [ -z "$name" ] && [ "$remove" -eq 0 ]; then usage; fi
  # The declared-name grammar, before the name can reach a sed expression
  # or a flake URL -- enforced on write here and on read in deploy.
  if [ -n "$name" ] && ! validate_release_name "$name"; then
    local name_disp
    untrusted_var name_disp "$name" "" 2
    error "a release name outside the declared-name grammar [A-Za-z0-9._/+-]: $name_disp"
    exit 1
  fi

  resolve_repo "$repo_arg"
  local slot="$default_slot"
  # ensure_tree BEFORE the record is read (the approve precedent): it owns
  # this tree's shape, and its self-heal is what moves a legacy record into
  # the name read below. write_note also consumes the TREE_* it sets.
  ensure_tree "$inv"
  # Same shape as review: walk from the record when the slot exists,
  # from the slot itself when there is nothing there yet.
  if [ -d "$slot" ]; then
    verify_ancestry "$slot/release" || exit 1
  else
    verify_ancestry "$slot" || exit 1
  fi

  local rev
  rev="$(read_rev "$slot" "$repo")" || exit 1
  [ -n "$rev" ] || {
    say_cmd "nothing is pinned here; review it first: pinned review " "$repo"
    exit 1
  }

  local old_tag=""
  if [ -f "$slot/release" ]; then
    verify_record_file "$slot/release" || exit 1
    IFS= read -r old_tag <"$slot/release" || old_tag=""
  fi

  local t_hash="" answer
  if [ "$remove" -eq 1 ]; then
    # The requested state already holds -- mirrors `already declared:`.
    if [ -z "$old_tag" ]; then
      printf '%salready rev-only%s\n' "$C_GRN" "$C_OFF"
      exit 0
    fi
  else
    # THE INVARIANT, via sgit (scrubbed env, no user git config, no
    # hooks): the name must already resolve to the pinned rev.
    t_hash="$(sgit rev-parse -q --verify "refs/tags/${name}"'^{commit}' 2>/dev/null || true)"
    if [ -z "$t_hash" ]; then
      printf '%s✗ refused:%s this checkout has no such tag: %s\n' \
        "$C2_RED$C2_B" "$C2_OFF" "$name" >&2
      exit 1
    fi
    if [ "$t_hash" != "$rev" ]; then
      printf '%s✗ refused:%s the tag names %.10s, not the pinned %.10s: %s\n' \
        "$C2_RED$C2_B" "$C2_OFF" "$t_hash" "$rev" "$name" >&2
      exit 1
    fi
    if [ "$old_tag" = "$name" ]; then
      printf '%salready declared:%s %s\n' "$C_GRN" "$C_OFF" "$name"
      exit 0
    fi
  fi

  print_repo_row "$C_B"
  printf '%sslot:%s       %s\n' "$C_B" "$C_OFF" "$(show_slot "$slot")"
  subject_var subj "$rev" "$C_DIM" 'commit not in repo!'
  printf '%spinned:%s     %s%s%s  %s%s%s\n' "$C_B" "$C_OFF" "$C_CYN" "$rev" "$C_OFF" \
    "$C_DIM" "$subj" "$C_OFF"
  # The declaration as it stands and as it would be: a transition of a
  # release name, whose length is the release's, so the new name continues
  # on the line under the old one. The release: row's label is the noun
  # the question names. The name on record is re-read from the slot, so it
  # is escaped like any value this script did not write in this run.
  local old_disp
  untrusted_var old_disp "${old_tag:-(none)}" "$C_DIM"
  printf '%srelease:%s    %s%s%s\n' "$C_B" "$C_OFF" "$C_DIM" "$old_disp" "$C_OFF"
  if [ "$remove" -eq 1 ]; then
    print_row_to "(none)"
    printf "%sdeploy:%s     %sthe input's ref= stops being managed; it keeps whatever it says now%s\n" \
      "$C_B" "$C_OFF" "$C_DIM" "$C_OFF"
    [ "$yes" -eq 1 ] || printf '%sclear this release? [%sy%s/%sN%s]%s ' "$C_B" "$C_BLU" "$C_OFF$C_B" "$C_BLU" "$C_OFF$C_B" "$C_OFF"
  else
    print_row_to "$C_CYN$C_B$name$C_OFF"
    # The deploy: row is the point of the whole ceremony -- the effect on
    # the root anchor, which is the only thing the declaration changes. It
    # prints the ref string and NOTHING about any flake's current contents,
    # deliberately: deploy picks its own file (--flake), so a row rendered
    # off the default flake would be a confident claim about a file that
    # may not be the one edited. declare states what it causes; deploy
    # states what it found.
    printf '%sdeploy:%s     %sref=refs/tags/%s%s\n' "$C_B" "$C_OFF" "$C_CYN" "$name" "$C_OFF"
    # The invariant's verdict, checked above: the tag resolves to exactly
    # the pinned rev, so the row needs no second hash. Then the consequence,
    # on its own lines directly above the question.
    printf '%s✓ the tag names the pinned rev%s\n' "$C_GRN" "$C_OFF"
    printf "%sDeploy then syncs this input's ref= to that name, and refuses if the live\n" "$C_DIM"
    printf 'tag ever stops naming the pinned rev.%s\n' "$C_OFF"
    [ "$yes" -eq 1 ] || printf '%sdeclare this release? [%sy%s/%sN%s]%s ' "$C_B" "$C_BLU" "$C_OFF$C_B" "$C_BLU" "$C_OFF$C_B" "$C_OFF"
  fi
  if [ "$yes" -eq 0 ]; then
    drain_tty
    read -r answer </dev/tty
    case "$answer" in
      y|Y|yes) ;;
      *)
        printf '%saborted; record unchanged%s\n' "$C_YEL" "$C_OFF"
        log_action declare "$repo" "${name:-$old_tag}" abort
        exit 2 ;;
    esac
  fi

  if [ "$remove" -eq 1 ]; then
    rm -f "$slot/release"
    # The name that was cleared ends the verdict; what the slot is now is a
    # sentence, on a dim line under it in the value column.
    untrusted_var old_disp "$old_tag"
    printf '%s✓ cleared:%s %s\n' "$C_GRN$C_B" "$C_OFF" "$old_disp"
    printf '           %sthe slot is rev-only%s\n' "$C_DIM" "$C_OFF"
    log_action declare "$repo" "$old_tag"
  else
    write_note "$slot" release "$name"
    print_verdict_to "$C_GRN$C_B" declared "$name" "$(show_slot "$slot")/release"
    log_action declare "$repo" "$name"
  fi
}

# ---- verify ----------------------------------------------------------------

# The consumer verdict for file pins -- replaces every consumer's
# private copy of the state table (writer/reader split: review records,
# verify answers). Exit contract, a stable API:
#   0   state matches the record (pin + match, or tombstone + absent)
#   5   the bytes differ, but ONLY in keys the slot declared ignored (see
#       ignored.<format> above) AND the ignorable policy still grants every
#       one of those keys for this path -- and the differing keys are named on
#       stdout, one `ignored-drift: <key>` line each
#   10  no slot for this path
#   11  hash mismatch
#   13  tombstoned but the path is present (retired content resurrected)
#   20  live pin but the file is missing
#   30  mode/ownership invariant violated
# The decade is the consumer's action class, and it is ONE taxonomy across
# the verbs that answer about a record (verify here, cat below): teens
# "review fixes it", twenties "restore or tombstone", thirties "invariant".
# 12, 14 and 15 are RETIRED and never reused; 16 belongs to cat ("no stored
# witness"). A new code takes the next free number in its class.
#
# THE NUMBERING RULE, settled: renumber WHOLESALE when coherence demands it
# (as the sweep into decade classes did) and never backfill a retired slot
# piecemeal. A retired number is a number some deployed consumer still
# remembers; handing it a new meaning makes a running gate misread a verdict
# it thinks it understands, silently, until the next deploy catches up. A
# wholesale renumber is loud and lands with its consumers.
#
# Anything structural (malformed slot, unknown algorithm, wrong recorded
# path, unreadable tier) is a hard error: exit 1, fail closed. The
# common gate stays `if pinned verify <path>; then`.
#
# Four forms; the slot key is ALWAYS the original <path>:
#   verify <path>                 gate/report: freeze internally, verdict only
#   verify --emit <path>          freeze, verify, print the VERIFIED bytes on
#                                 stdout; NOTHING on nonzero exit. The "verify
#                                 and emit the SAME bytes" shape as one call.
#                                 BYTE-EXACT ONLY: --emit never answers 5,
#                                 because bytes that merely match modulo
#                                 ignored keys are not the verified bytes.
#   verify --frozen <copy> <path> caller-frozen bytes against <path>'s record,
#                                 for callers that must hold bytes before a
#                                 verdict exists; digest from the copy, the
#                                 mode invariant still checks the original.
#   verify --baseline <copy> <path>
#                                 a CALLER-BROUGHT WITNESS for the ignored-key
#                                 comparison, for a slot that keeps none of
#                                 its own (review --store is what keeps one).
#                                 A permanent interface, not a shim: custody
#                                 is opt-in, so a caller that held the last
#                                 approved bytes is an ordinary case. The copy
#                                 must re-hash to the record or it is ignored;
#                                 a forged one can only ever make verify
#                                 STRICTER (the projection then differs).
# Consumer rule: PARSE content -> --emit or --frozen; gate/display only
# -> bare form (the verdict refers to one coherent frozen moment; a
# caller's later live read is the caller's race).
do_verify() {
  local emit=0 frozen="" baseline="" path=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --emit) emit=1; shift ;;
      --frozen)
        [ $# -ge 2 ] || { echo "--frozen needs the copy's path" >&2; exit 1; }
        frozen="$2"; shift 2 ;;
      --baseline)
        [ $# -ge 2 ] || { echo "--baseline needs the copy's path" >&2; exit 1; }
        baseline="$2"; shift 2 ;;
      -*) say_err "unknown verify option: " "$1"; usage ;;
      *)  [ -z "$path" ] || { echo "verify takes one path" >&2; usage; }
          path="$1"; shift ;;
    esac
  done
  [ -n "$path" ] || usage
  if [ "$emit" -eq 1 ] && [ -n "$frozen" ]; then
    echo "--emit and --frozen are exclusive" >&2
    exit 1
  fi
  path="$(canon_path "$path")" || exit 1

  local tier slot
  tier="$(tier_user)"
  slot="$(slot_dir_for "$tier" "$path")"
  if [ ! -d "$slot" ]; then
    # Distinguish "no slot" from "cannot see the slots": an unreadable
    # tier must never read as unapproved.
    if [ -d "$PINNED_ROOT/$tier" ] && [ ! -r "$PINNED_ROOT/$tier" ]; then
      error "cannot read the tier (are you in group $(pin_group "$tier")?): " "$PINNED_ROOT/$tier"
      exit 1
    fi
    say_err "no slot: " "$path"
    exit 10
  fi
  inspect_slot "$slot" || exit 1
  local line
  case "$slot_state" in
    none)
      say_err "no slot: " "$path"
      exit 10 ;;
    rev)
      error "a repo slot (rev.$slot_kind), and verify covers file pins (use status): " "$path"
      exit 1 ;;
    tombstone)
      verify_record_file "$slot_file" || exit 1
      local ts_gone=0
      path_gone "$path" || ts_gone=$?
      if [ "$ts_gone" -eq 2 ]; then
        error "cannot tell whether a tombstoned path is still absent, so it does not pass: " "$path"
        exit 1
      fi
      if [ "$ts_gone" -eq 1 ]; then
        IFS= read -r line <"$slot_file" || line=""
        refused "tombstoned but present, retired content resurrected: " "$path"
        say_err "        " "$line"
        exit 13
      fi
      exit 0 ;;
    pin) ;;
  esac

  verify_record_file "$slot_file" || exit 1
  # A record naming another spelling of this path (rc 2) still REFUSES --
  # nothing here decides that two names are one file. What changes is that
  # the refusal names the way out and carries its own code in the review
  # decade, so a gate can offer the remediation instead of a dead end.
  # 17, not 14: 12/14/15 are the pre-decade numbers, retired and never
  # reused (16 is cat's). Corruption (rc 1) keeps exit 1: it has no
  # ceremony that fixes it.
  local rec_rc=0
  read_pin_record "$slot_file" "$slot_kind" "$path" || rec_rc=$?
  if [ "$rec_rc" -eq 2 ]; then
    echo "        re-approve to re-state the record for this path:" >&2
    say_cmd "        pinned review --file " "$path"
    exit 17
  fi
  [ "$rec_rc" -eq 0 ] || exit 1
  local label="$REC_LABEL" rec_digest="$REC_DIGEST"

  # SLOT INVARIANT, checked before anything about the live file: if the
  # slot keeps an `approved` copy, that copy MUST re-hash to the record it
  # sits beside. Authenticating a witness before use is the rule everywhere
  # -- what makes this a hard error rather than a quietly declined witness is
  # WHERE these bytes are: root custody, which nothing unprivileged can have
  # written. Bytes that are both root-owned and not the approved bytes are
  # incoherent state, not weak evidence. Checked eagerly (even when the live
  # file matches byte for byte) because a slot either holds coherent state or
  # it does not, and the moment to say so is the next time anyone looks.
  if [ -e "$slot/approved" ]; then
    [ -f "$slot/approved" ] || {
      error "a malformed slot, its approved copy not a regular file: " "$slot/approved"
      exit 1
    }
    verify_record_file "$slot/approved" || exit 1
    local copy_digest
    copy_digest="$(hash_file "$label" "$slot/approved")" || exit 1
    [ "$copy_digest" = "$rec_digest" ] || {
      error "a malformed slot, its approved copy not re-hashing to its own record: " "$slot/approved"
      echo "  record $label:  $rec_digest" >&2
      echo "  copy   $label:  $copy_digest" >&2
      say_cmd "  re-approve the path to reset the slot: pinned review --file " "$path"
      exit 1
    }
  fi

  # Order: existence (20), then the mode invariant (30), then content
  # (11). With --frozen the copy evidences existence -- absence was the
  # caller's to catch at its freeze -- so 20 cannot arise there.
  local subject
  if [ -n "$frozen" ]; then
    [ -f "$frozen" ] || { error "frozen copy is not a readable file: " "$frozen"; exit 1; }
    subject="$frozen"
  else
    local gone=0
    path_gone "$path" || gone=$?
    if [ "$gone" -eq 2 ]; then
      error "cannot tell whether this path exists, so it is not read as missing: " "$path"
      exit 1
    fi
    if [ "$gone" -eq 0 ]; then
      refused "pinned but missing: " "$path"
      say_cmd "        restore it, or retire it: pinned tombstone " "$path"
      exit 20
    fi
    [ -f "$path" ] || { error "not a regular file: " "$path"; exit 1; }
  fi
  # The invariant, always on the ORIGINAL path: owned by the tier user OR
  # root, and not group- or world-writable. Deliberately not a pinned VALUE
  # (A7): verification is per-use and content-addressed, so a rewrite through
  # a loosened mode is caught by the hash check at the next use, and
  # against a process running AS the user the mode is irrelevant (the
  # owner can chmod back). The absolute invariant needs no per-slot
  # storage and never churns. Root ownership is admitted because it is
  # STRICTLY STRONGER than tier ownership -- the tier user cannot rewrite a
  # root-owned file at all -- and root-owned configs are exactly the files a
  # user most wants pinned (e.g. a managed settings floor: root-owned by
  # design as the raceless anchor, yet still worth a content record so a
  # root-side change re-enters review). The root-only owners baked into
  # PINNED_ROOT_ONLY_OWNERS are admitted for exactly that reason and no
  # other: nothing a user can act as owns them either, so their files are
  # as unwritable to the tier user as root's. That list is a compile-time
  # constant, never the environment and never a run-time file, because a
  # widening of this invariant must come from the build that also created
  # the account. The decision itself is owner_admitted, up in the library
  # half, so it can be driven directly; only the wording of the refusal
  # lives here, where the path and the tier are in hand.
  if [ -e "$path" ]; then
    local owner mode o
    owner="$(stat_owner "$path")"
    o="${owner%%:*}"
    if ! owner_admitted "$o" "$tier"; then
      if [ -n "$PINNED_ROOT_ONLY_OWNERS" ]; then
        refused "owned by $o, expected $tier, root, or a root-only owner ($PINNED_ROOT_ONLY_OWNERS): " "$path"
      else
        refused "owned by $o, expected $tier (or root): " "$path"
      fi
      exit 30
    fi
    mode="$(stat_mode "$path")"
    case "$mode" in
      *[2367]?|*[2367])
        refused "mode $mode (group/other-writable): " "$path"
        say_cmd "        fix: chmod go-w " "$path"
        exit 30 ;;
    esac
  fi

  if [ -z "$frozen" ]; then
    freeze_file "$path" || { error "cannot read: " "$path"; exit 1; }
    subject="$FROZEN_COPY"
  fi
  local live_digest
  live_digest="$(hash_file "$label" "$subject")" || exit 1
  if [ "$live_digest" != "$rec_digest" ]; then
    # The byte-exact answer is 11. A slot that declares ignored keys gets
    # one chance to prove the difference is confined to them; anything that
    # cannot be proven -- no declaration, no last-approved bytes, no jq, an
    # unparseable or ambiguous side, a difference elsewhere -- lands right
    # back here. --emit is excluded on purpose: what it prints must be the
    # verified bytes, and these are not.
    if [ "$emit" -eq 0 ] && slot_declares_ignore "$slot" \
       && ignored_keys_match "$slot" "$label" "$rec_digest" "$subject" "$baseline" "$path"; then
      exit 5
    fi
    refused "does not match its approved record: " "$path"
    echo "  approved $label:  $rec_digest" >&2
    echo "  live     $label:  $live_digest" >&2
    exit 11
  fi
  if [ "$emit" -eq 1 ]; then
    cat -- "$subject"
  else
    printf '%s✓ verified:%s %s\n' "$C_GRN" "$C_OFF" "$path"
  fi
}

# ---- cat -------------------------------------------------------------------

# CUSTODY'S VERIFIED READER. The moment a slot keeps an `approved` witness it
# becomes a place to read approved bytes from, and something WILL read that
# file directly -- which is exactly what must not happen, because nothing
# outside pinned interprets slot contents. So custody ships with the reader
# that authenticates before it serves: cat re-hashes the stored witness
# against the record and only then emits it.
#
# Unprivileged, and writes nothing: slot dirs are group-readable by the tier
# user, so a reader has nothing to elevate for. Root ownership of the slot
# buys that the bytes cannot have been written by anything unprivileged; the
# re-hash is what proves they are the APPROVED bytes.
#
# Exit contract, the same decade taxonomy verify uses:
#   0   the witness re-hashed to the record; its bytes are on stdout
#   1   error -- including a MALFORMED SLOT (a witness that does not re-hash,
#       more than one state file), the class verify hard-errors on too
#   10  no record for this path
#   13  tombstoned
#   16  the record is valid but the slot keeps NO witness (remediation:
#       pinned review --file <path> --store)
#   20  the record is live but the FILE is missing
#   30  a slot ownership/mode invariant is violated
# NOTHING reaches stdout in any failure case: a consumer piping cat into a
# parser gets the approved bytes or an empty stream, never a fragment and
# never an error message.
#
# 30 WHERE VERIFY SAYS 1, on the same slot-ownership check: for a GATE, a
# record it cannot trust is a structural failure of the tool; for a READER it
# is the same class of thing as a wrong-owner live file -- an invariant to
# fix with chown/chmod, not a record to re-approve. The LIVE file's mode is
# not checked at all here, because cat does not serve the live file; only its
# existence is consulted, below.
#
# 20 BEFORE 16, deliberately: a deleted file signals retirement, and custody
# must not go on serving a removed file's content to consumers that never
# notice it is gone -- restore it, or tombstone it. Answering 16 first would
# also name a remediation that cannot run, since review --file refuses a
# path that is not there.
#
# SERVES DESPITE DRIFT, deliberately: a consumer pointed straight at the
# slot's `approved` file reads the approved bytes regardless of what the live
# file says today, and cat is that same access with verification added --
# refusing here would only push such consumers back to the raw file. On this
# rung the approved bytes ARE the authoritative content; the live file is the
# editing surface, waiting for its next ceremony. A consumer that cares
# whether the two agree calls verify. One job per verb.
do_cat() {
  [ $# -eq 1 ] || { echo "cat takes one path" >&2; usage; }
  local path tier slot line
  tier="$(tier_user)"
  path="$(canon_path "$1")" || exit 1
  slot="$(slot_dir_for "$tier" "$path")"
  if [ ! -d "$slot" ]; then
    # Distinguish "no slot" from "cannot see the slots", exactly as verify
    # does: an unreadable tier must never read as unapproved.
    if [ -d "$PINNED_ROOT/$tier" ] && [ ! -r "$PINNED_ROOT/$tier" ]; then
      error "cannot read the tier (are you in group $(pin_group "$tier")?): " "$PINNED_ROOT/$tier"
      exit 1
    fi
    say_err "no slot: " "$path"
    exit 10
  fi
  inspect_slot "$slot" || exit 1
  case "$slot_state" in
    none)
      say_err "no slot: " "$path"
      exit 10 ;;
    rev)
      # Custody is a FILE-pin concept. A repo slot records a rev, and the
      # content behind that rev already lives in git, addressable by it --
      # there is nothing for pinned to hold a second copy of.
      error "a repo slot (rev.$slot_kind), and cat serves file pins: " "$path"
      echo "        a repo's content lives in git: read the approved rev from the slot (or a" >&2
      echo "        root-owned symlink at it), then ask git for the file:" >&2
      say_cmd "          pinned slot " "$path"
      say_err "          git show REV:FILE, run in: " "$path"
      exit 1 ;;
    tombstone)
      IFS= read -r line <"$slot_file" || line=""
      refused "tombstoned, so there is no approved content to serve: " "$path"
      say_err "        " "$line"
      exit 13 ;;
  esac

  verify_record_file "$slot_file" || exit 30
  read_pin_record "$slot_file" "$slot_kind" "$path" || exit 1

  local gone=0
  path_gone "$path" || gone=$?
  if [ "$gone" -eq 2 ]; then
    error "cannot tell whether this path exists, so it is not read as missing: " "$path"
    exit 1
  fi
  if [ "$gone" -eq 0 ]; then
    refused "pinned but missing, and custody does not serve a removed file: " "$path"
    say_cmd "        restore it, or retire it: pinned tombstone " "$path"
    exit 20
  fi
  [ -f "$path" ] || { error "not a regular file: " "$path"; exit 1; }

  if [ ! -e "$slot/approved" ]; then
    refused "the slot keeps no approved copy, so there is nothing to serve: $slot"
    shq path_disp "$path"
    untrusted_var path_disp "$path_disp" "" 2
    printf '        custody is opt-in: pinned review --file %s --store\n' "$path_disp" >&2
    exit 16
  fi
  [ -f "$slot/approved" ] || {
    error "a malformed slot, its approved copy not a regular file: " "$slot/approved"
    exit 1
  }
  verify_record_file "$slot/approved" || exit 30
  local copy_digest
  copy_digest="$(hash_file "$REC_LABEL" "$slot/approved")" || exit 1
  [ "$copy_digest" = "$REC_DIGEST" ] || {
    error "a malformed slot, its approved copy not re-hashing to its own record: " "$slot/approved"
    echo "  record $REC_LABEL:  $REC_DIGEST" >&2
    echo "  copy   $REC_LABEL:  $copy_digest" >&2
    shq path_disp "$path"
    untrusted_var path_disp "$path_disp" "" 2
    printf '  re-approve the path to reset the slot: pinned review --file %s --store\n' "$path_disp" >&2
    exit 1
  }
  # Only now, and raw. The bytes are the deliverable, so nothing decorates
  # them -- and nothing else has been written to this stream to decorate.
  cat -- "$slot/approved"
}

# ---- rev -------------------------------------------------------------------

# The repo counterpart of cat: the verified reader of a repo slot's record,
# for a consumer that drives something FROM the pin (the flake sync) and
# must never open a slot file itself. It answers about the RECORD only --
# the checkout gates nothing, and a record whose checkout is gone still
# answers (that is status's warning, not this verb's refusal). --release
# swaps the rev for the declared release name, read under the same
# declared-name grammar deploy reads it with; whether the LIVE tag still
# names the pin is the deployer's cross-check, made at the moment it
# matters, never a fact the record can hold.
#
# Stdout carries exactly one line, only on 0, so a caller captures it
# blind and branches on the code. Every refusal is on stderr under the
# decade classes verify and cat share (EXIT STATUS): 10 no slot, 13
# tombstoned, 16 no declaration (--release only: rev-only is a supported
# shape, and a code says so where an empty line could be spliced into a
# URL), 17 the record names another spelling of the path, 30 the record's
# own ownership/mode invariant, 1 corrupt, malformed or the wrong kind.
do_rev() {
  local release=0 path="" a
  for a in "$@"; do
    case "$a" in
      --release) release=1 ;;
      -*) say_err "unknown rev option: " "$a"; usage ;;
      *)  [ -z "$path" ] || { echo "rev takes one repo path" >&2; usage; }
          path="$a" ;;
    esac
  done
  [ -n "$path" ] || usage
  local tier slot line rc=0
  tier="$(tier_user)"
  path="$(canon_path "$path")" || exit 1
  slot="$(slot_dir_for "$tier" "$path")"
  if [ ! -d "$slot" ]; then
    # Distinguish "no slot" from "cannot see the slots", exactly as verify
    # does: an unreadable tier must never read as unapproved.
    if [ -d "$PINNED_ROOT/$tier" ] && [ ! -r "$PINNED_ROOT/$tier" ]; then
      error "cannot read the tier (are you in group $(pin_group "$tier")?): " "$PINNED_ROOT/$tier"
      exit 1
    fi
    say_err "no slot: " "$path"
    exit 10
  fi
  inspect_slot "$slot" || exit 1
  case "$slot_state" in
    none)
      say_err "no slot: " "$path"
      exit 10 ;;
    pin)
      error "a file slot (pin.$slot_kind), and rev serves repo pins (verify or cat answer for a file): " "$path"
      exit 1 ;;
    tombstone)
      IFS= read -r line <"$slot_file" || line=""
      refused "tombstoned, so there is no approved rev to serve: " "$path"
      say_err "        " "$line"
      exit 13 ;;
    rev) ;;
  esac

  # 30 before the record is parsed, cat's order: a record nothing
  # unprivileged could have rewritten is the precondition for reading it.
  verify_record_file "$slot_file" || exit 30
  # read_rev re-verifies (cheap) and ECHOES the digest on rc 2 -- the
  # ceremony that re-states a respelled record needs it. A consumer must
  # not get it, so the capture is dropped on anything but 0.
  local rev
  rev="$(read_rev "$slot" "$path")" || rc=$?
  if [ "$rc" -eq 2 ]; then
    echo "        re-approve to re-state the record for this path:" >&2
    say_cmd "        pinned review " "$path"
    exit 17
  fi
  [ "$rc" -eq 0 ] || exit 1
  if [ "$release" -eq 0 ]; then
    printf '%s\n' "$rev"
    return 0
  fi

  if [ ! -e "$slot/release" ]; then
    refused "the slot declares no release name, so it is rev-only: $slot"
    say_cmd "        one is added by: pinned declare --release NAME " "$path"
    exit 16
  fi
  [ -f "$slot/release" ] || {
    error "a malformed slot, its release record not a regular file: " "$slot/release"
    exit 1
  }
  verify_record_file "$slot/release" || exit 30
  local name
  IFS= read -r name <"$slot/release" || name=""
  validate_release_name "$name" || {
    error "a release record that declares an invalid release name, refused: " "$slot/release"
    exit 1
  }
  printf '%s\n' "$name"
}

# ---- words -----------------------------------------------------------------

# What the commit's author puts in a reply: the full id, the commits since
# the pin, and the words the review will show for that commit. Unprivileged
# and read-only, through sgit like everything else. It takes the rev
# explicitly and never defaults to HEAD: the author names the id their own
# commit printed, so a commit planted on top since then shows up as a
# different HEAD here and as different words at the review.
do_words() {
  [ $# -eq 2 ] || usage
  resolve_repo "$1"
  local rev="$2" hash head_hash old_hash rec_rc=0 cls="" subj
  case "$rev" in -*|'') say_err "invalid rev: " "$rev"; exit 1 ;; esac
  hash="$(sgit rev-parse -q --verify "${rev}^{commit}")" \
    || { say_err "not a commit in this repo: " "$rev"; exit 1; }
  read_rev "$default_slot" "$repo" >/dev/null 2>&1 || rec_rc=$?
  [ "$rec_rc" -ne 1 ] || read_rev "$default_slot" "$repo" >/dev/null || exit 1
  old_hash="$REC_DIGEST"
  head_hash="$(sgit rev-parse 'HEAD^{commit}')"
  [ -z "$old_hash" ] || cls="$(ancestry_class "$repo" "$old_hash" "$hash")"
  # A release tag is reviewed with --tag, which resolves the tag, not HEAD.
  local tag_opt="" wq
  if sgit show-ref -q --verify "refs/tags/$rev" 2>/dev/null; then
    shq wq "$rev"
    tag_opt=" --tag $wq"
  fi

  print_repo_row "$C_DIM"
  subject_var subj "$hash" "$C_DIM"
  printf '%scommit:%s     %s%s%s  %s%s%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$hash" "$C_OFF" \
    "$C_DIM" "$subj" "$C_OFF"
  if [ -z "$tag_opt" ] && [ "$head_hash" != "$hash" ]; then
    printf '%sgit HEAD:%s   %s%s%s  %s✗ not this commit; a review of HEAD would refuse these words%s\n' \
      "$C_DIM" "$C_OFF" "$C_CYN" "$head_hash" "$C_OFF" "$C_YEL" "$C_OFF"
  fi
  if [ -z "$old_hash" ]; then
    printf '%spinned:%s     (none)\n' "$C_DIM" "$C_OFF"
  else
    printf '%spinned:%s     %s%s%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$old_hash" "$C_OFF"
  fi
  # The words only where the review takes them; anywhere else the review
  # reads, and words in a reply would be words nobody can check. The command
  # that approves by them follows when the review would resolve this same
  # commit: a release tag selects it with --tag (which also declares the
  # name), anything else only while it is HEAD.
  local w
  case "$cls" in
    forward)
      w="$(commit_words "$hash")"
      print_words_row "$w"
      if [ -n "$tag_opt" ] || [ "$head_hash" = "$hash" ]; then
        # Each word quoted (shq), then the whole line escaped: the repo path
        # and the tag are names someone else chose.
        shq wq "$repo"
        untrusted_var wq "pinned review $wq$tag_opt --words ${w// /-} --commits $(sgit rev-list --count "${old_hash}..${hash}")"
        printf '%sapprove:%s    %s\n' "$C_DIM" "$C_OFF" "$wq"
      fi
      ;;
    '')       printf '%swords:%s      (none: a first approval reads the full tree)\n' "$C_DIM" "$C_OFF" ;;
    equal)    printf '%swords:%s      (none: already pinned)\n' "$C_DIM" "$C_OFF" ;;
    *)        printf '%swords:%s      (none: a %s move is read, not accepted by words)\n' \
                "$C_DIM" "$C_OFF" "$cls" ;;
  esac
  if [ "$cls" = forward ]; then
    echo
    print_ancestry_listing forward "$old_hash" "$hash" "" rule ''
  fi
}

# ---- status ----------------------------------------------------------------

do_status() {
  local subj
  inv="$(tier_user)"  # not id -un: correct tier under sudo (root has none)
  [ $# -ge 1 ] || usage
  # A directory is a repo; anything else (present or not) is a file pin.
  if [ ! -d "$1" ]; then
    do_status_file "$1"
    return
  fi
  resolve_repo "$@"
  local slot="$default_slot" hash head_hash ahead rec_rc=0 slot_respell
  # Uncaptured, so REC_PATH survives: status is the repo's answer surface
  # (verify covers file pins only), so a record naming a former spelling of
  # this path is REPORTED here, not refused -- the one refusal that stays
  # is corruption, re-read unsilenced so it says why.
  read_rev "$slot" "$repo" >/dev/null 2>&1 || rec_rc=$?
  [ "$rec_rc" -ne 1 ] || read_rev "$slot" "$repo" >/dev/null || exit 1
  hash="$REC_DIGEST"
  head_hash="$(sgit rev-parse 'HEAD^{commit}')"

  print_repo_row "$C_DIM"
  printf '%sslot:%s       %s\n' "$C_DIM" "$C_OFF" "$(show_slot "$slot")"
  # THE SLOT-NAME INVARIANT (above slot_name_actual), both halves: a record
  # naming another spelling, a directory wearing one. Either is repaired by
  # a review, and either is invisible until something says so. The verdict
  # leads its row and the spelling it is about ends it.
  if [ "$rec_rc" -eq 2 ]; then
    local rp_disp
    untrusted_var rp_disp "$REC_PATH" "$C_YEL"
    printf '%srecord:%s     %s✗ names another spelling, review re-states it: %s%s\n' \
      "$C_DIM" "$C_OFF" "$C_YEL" "$rp_disp" "$C_OFF"
  fi
  slot_respell="$(slot_name_actual "$slot")"
  if [ -n "$slot_respell" ]; then
    printf '%sslot name:%s  %s✗ still another spelling, review renames it: %s%s\n' \
      "$C_DIM" "$C_OFF" "$C_YEL" "${slot_respell##*/}" "$C_OFF"
  fi
  if [ -z "$hash" ]; then
    printf '%spinned:%s     (none)\n' "$C_DIM" "$C_OFF"
  else
    subject_var subj "$hash" "$C_DIM" 'commit not in repo!'
    printf '%spinned:%s     %s%s%s  %s%s%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$hash" "$C_OFF" \
      "$C_DIM" "$subj" "$C_OFF"
    # The declared release name, in its three states: declared and live
    # (deploy syncs ref= to it), rev-only, or stale -- the third is the
    # early warning for a state that otherwise surfaces as a failed
    # deploy. Without this row the declaration is invisible to every
    # reader, which is how a slot silently stays rev-only.
    local decl_tag="" decl_live
    if [ -f "$slot/release" ]; then IFS= read -r decl_tag <"$slot/release" || decl_tag=""; fi
    if [ -z "$decl_tag" ]; then
      printf '%srelease:%s    (none)  %s(rev-only; deploy leaves ref= alone)%s\n' \
        "$C_DIM" "$C_OFF" "$C_DIM" "$C_OFF"
    elif ! validate_release_name "$decl_tag"; then
      printf '%srelease:%s    %s✗ outside the declared-name grammar -- deploy will refuse%s\n' \
        "$C_DIM" "$C_OFF" "$C_RED$C_B" "$C_OFF"
    else
      decl_live="$(sgit rev-parse -q --verify "refs/tags/${decl_tag}"'^{commit}' 2>/dev/null || true)"
      # The name ends its row. A status list keeps one row per fact, and a
      # detail line goes under a row only for a state that is not normal:
      # a live declaration is the normal one (deploy syncs ref= to it), so
      # it is the row alone; a stale one says what deploy will do about it.
      if [ "$decl_live" = "$hash" ]; then
        printf '%srelease:%s    %s%s%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$decl_tag" "$C_OFF"
      elif [ -z "$decl_live" ]; then
        printf '%srelease:%s    %s\n' "$C_DIM" "$C_OFF" "$decl_tag"
        printf '            %s✗ the live tag is missing from this checkout -- deploy will refuse%s\n' \
          "$C_RED$C_B" "$C_OFF"
      else
        printf '%srelease:%s    %s\n' "$C_DIM" "$C_OFF" "$decl_tag"
        printf '            %s✗ the live tag names %.10s, not the pin -- deploy will refuse%s\n' \
          "$C_RED$C_B" "$decl_live" "$C_OFF"
      fi
    fi
  fi
  subject_var subj "$head_hash" "$C_DIM"
  printf '%sgit HEAD:%s   %s%s%s  %s%s%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$head_hash" "$C_OFF" \
    "$C_DIM" "$subj" "$C_OFF"
  if [ -n "$hash" ] && [ "$hash" = "$head_hash" ]; then
    printf '%sstate:%s      %s✓ HEAD is approved%s\n' "$C_DIM" "$C_OFF" "$C_GRN" "$C_OFF"
  elif [ -n "$hash" ]; then
    ahead="$(sgit rev-list --count "${hash}..${head_hash}" 2>/dev/null || echo '?')"
    printf '%sstate:%s      %s✗ HEAD is not approved (%s commit%s ahead of pin)%s\n' "$C_DIM" "$C_OFF" \
      "$C_RED" "$ahead" "$(plural_s "$ahead")" "$C_OFF"
  else
    printf '%sstate:%s      %s✗ never approved%s\n' "$C_DIM" "$C_OFF" "$C_RED" "$C_OFF"
  fi
  # Availability, not trust: the pin means what it means regardless of the
  # checkout (content-addressed), but a rev the object store no longer
  # holds cannot be RE-FETCHED -- surface that here instead of as a nix
  # error mid-rebuild. (nix may still deploy from its store cache.)
  if [ -n "$hash" ] && ! sgit cat-file -e "${hash}^{commit}" 2>/dev/null; then
    printf '%swarning: the pinned rev is missing from this checkout (rewritten history or gc?) --%s\n' "$C_RED$C_B" "$C_OFF"
    printf '%s         a deploy that needs to re-fetch it will fail; restore the commit or re-approve%s\n' "$C_RED$C_B" "$C_OFF"
  fi
  if ! sgit_diff --quiet 2>/dev/null || ! sgit_diff --cached --quiet 2>/dev/null; then
    printf '%swarning: work tree is dirty (uncommitted changes are never approved)%s\n' "$C_YEL" "$C_OFF"
  fi
}

# File-pin status: the record, and the live path's verdict against it.
# The verdict is verify's own (subshell), so status can never disagree
# with the gate.
do_status_file() {
  local path slot rc line path_disp
  path="$(canon_path "$1")" || exit 1
  slot="$(slot_dir_for "$inv" "$path")"
  untrusted_var path_disp "$path"
  printf '%sfile:%s       %s\n' "$C_DIM" "$C_OFF" "$path_disp"
  printf '%sslot:%s       %s\n' "$C_DIM" "$C_OFF" "$(show_slot "$slot")"
  if ! inspect_slot "$slot" 2>/dev/null; then
    printf '%sstate:%s      %s✗ malformed slot -- inspect it by hand%s\n' "$C_DIM" "$C_OFF" "$C_RED$C_B" "$C_OFF"
    exit 1
  fi
  case "$slot_state" in
    none)
      printf '%spinned:%s     (none)\n' "$C_DIM" "$C_OFF"
      printf '%sstate:%s      %s✗ never approved%s\n' "$C_DIM" "$C_OFF" "$C_RED" "$C_OFF"
      return ;;
    rev)
      # The record line names a path, so it ends its row and the reason
      # goes under it.
      IFS= read -r line <"$slot_file" || line=""
      untrusted_var line "$line" "$C_CYN"
      printf '%spinned:%s     %s%s%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$line" "$C_OFF"
      printf '            %s(rev.%s -- a repo pin at a non-directory path)%s\n' "$C_YEL" "$slot_kind" "$C_OFF"
      return ;;
    tombstone)
      IFS= read -r line <"$slot_file" || line=""
      untrusted_var line "$line" "$C_DIM"
      printf '%spinned:%s     tombstoned\n' "$C_DIM" "$C_OFF"
      printf '            %s%s%s\n' "$C_DIM" "$line" "$C_OFF"
      local ts_gone=0
      path_gone "$path" 2>/dev/null || ts_gone=$?
      case "$ts_gone" in
        0) printf '%sstate:%s      %s✓ tombstoned and absent%s\n' "$C_DIM" "$C_OFF" "$C_GRN" "$C_OFF" ;;
        1) printf '%sstate:%s      %s✗ tombstoned but present (retired content resurrected)%s\n' \
             "$C_DIM" "$C_OFF" "$C_RED$C_B" "$C_OFF" ;;
        *) printf '%sstate:%s      %s✗ tombstoned, cannot tell whether still absent%s\n' \
             "$C_DIM" "$C_OFF" "$C_RED$C_B" "$C_OFF" ;;
      esac
      return ;;
    pin)
      IFS= read -r line <"$slot_file" || line=""
      printf '%spinned:%s     %s%s%s  %s(%s)%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "${line%%  *}" "$C_OFF" \
        "$C_DIM" "$slot_kind" "$C_OFF"
      # The slot's extras, when it has them: WHICH keys may drift is part
      # of what this record says, so it belongs in the record's report.
      if slot_declares_ignore "$slot"; then
        if read_ignored_paths "$slot" 2>/dev/null; then
          printf '%signored:%s    %s%s%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$(ign_display "$IGN_PATHS")" "$C_OFF"
        else
          printf '%signored:%s    %s✗ unusable declaration (re-approve to reset)%s\n' \
            "$C_DIM" "$C_OFF" "$C_YEL" "$C_OFF"
        fi
      fi
      # Custody is reported for EVERY file record, declaration or not --
      # same rule as list: a byte-exact slot with (or without) a copy is
      # a fact about the record, not about its ignore declaration.
      if [ -e "$slot/approved" ]; then
        printf '%scustody:%s    approved bytes kept in the slot (pinned cat serves them)\n' "$C_DIM" "$C_OFF"
      else
        printf '%scustody:%s    none  %s(a consumer brings its own witness: verify --baseline, or re-approve with --store)%s\n' \
          "$C_DIM" "$C_OFF" "$C_DIM" "$C_OFF"
      fi
      rc=0; (do_verify "$path" >/dev/null 2>&1) || rc=$?
      case "$rc" in
        0)  printf '%sstate:%s      %s✓ live file matches the record%s\n' "$C_DIM" "$C_OFF" "$C_GRN" "$C_OFF" ;;
        5)  printf '%sstate:%s      %s~ live file matches except in the ignored keys%s\n' "$C_DIM" "$C_OFF" "$C_YEL" "$C_OFF" ;;
        11) printf '%sstate:%s      %s✗ live file differs from the record%s\n' "$C_DIM" "$C_OFF" "$C_RED$C_B" "$C_OFF" ;;
        20) printf '%sstate:%s      %s✗ pinned but missing (restore, or tombstone)%s\n' "$C_DIM" "$C_OFF" "$C_RED" "$C_OFF" ;;
        30) printf '%sstate:%s      %s✗ mode/ownership invariant violated%s\n' "$C_DIM" "$C_OFF" "$C_RED" "$C_OFF" ;;
        *)  printf '%sstate:%s      %s✗ verify error (exit %s)%s\n' "$C_DIM" "$C_OFF" "$C_RED" "$rc" "$C_OFF" ;;
      esac ;;
  esac
}

# ---- sign ------------------------------------------------------------------

do_sign() {
  # Export the pin as a normal signed release tag -- NO re-read anywhere in
  # the path. The hash comes from the root-owned pin file and is passed to
  # git explicitly, so "what gets signed" is exactly "what was approved";
  # a compromised environment can neither alter the hash nor this binary.
  # Runs as the plain user: signing needs the user's SSH agent (1Password),
  # which sudo strips. The agent popup is blind (shows key use, not
  # content) -- the binding to content is this code path, plus the rule
  # that an unprompted popup is always denied.
  [ "$EUID" -ne 0 ] || { echo "run sign without sudo (it needs your SSH agent)" >&2; exit 1; }
  inv="$(id -un)"
  [ $# -eq 2 ] || usage
  local tag_name="$2" tag_disp
  case "$tag_name" in
    -*) say_err "invalid tag name: " "$tag_name"; exit 1 ;;
  esac
  resolve_repo "$1"
  sgit check-ref-format "refs/tags/$tag_name" \
    || { say_err "invalid tag name: " "$tag_name"; exit 1; }

  local hash
  hash="$(read_rev "$default_slot" "$repo")" || exit 1
  [ -n "$hash" ] || { say_cmd "nothing is pinned here; review it first: pinned review " "$repo"; exit 1; }

  # An existing tag may be signed IF it already points at the pinned rev
  # (e.g. an unsigned release tag being promoted). Pointing anywhere else
  # is refused: sign never moves what a tag means. Note -f replaces any
  # previous signature on the tag; co-signers use distinct tag names.
  local force=""
  if sgit rev-parse -q --verify "refs/tags/${tag_name}" >/dev/null 2>&1; then
    local existing
    existing="$(sgit rev-parse "refs/tags/${tag_name}"'^{commit}')"
    if [ "$existing" != "$hash" ]; then
      error "the tag exists at $existing, not the pinned $hash: " "$tag_name"
      echo "        refusing to move it -- pick another name, or review that rev first" >&2
      exit 1
    fi
    untrusted_var tag_disp "$tag_name"
    printf 'note: the tag already points at the pinned rev; re-signing it in place: %s\n' "$tag_disp"
    force="-f"
  fi

  # User git config deliberately in play here: it supplies user.signingkey
  # and gpg.format=ssh. An attacker rewriting those can only produce a
  # signature by the WRONG key, which allowed_signers verification rejects
  # -- fail closed. The absolute git binary and the explicit hash are what
  # matter; `git tag` runs no hooks and builtins can't be alias-shadowed.
  if [ -n "$force" ]; then
    git -C "$repo" --no-pager tag -s -f -m "signed by $inv via pinned" "$tag_name" "$hash"
  else
    git -C "$repo" --no-pager tag -s -m "signed by $inv via pinned" "$tag_name" "$hash"
  fi
  # The pinned hash is a field and may sit mid-line; the tag name ends it,
  # escaped: a ref name may hold a character that draws nothing.
  untrusted_var tag_disp "$tag_name"
  printf '%s✓ signed at %s%.10s%s%s:%s %s\n' "$C_GRN$C_B" "$C_OFF$C_CYN" "$hash" "$C_OFF" "$C_GRN$C_B" "$C_OFF" "$tag_disp"
  # The command a consumer runs to approve by the signature: review takes
  # the repo first, so the hint names this checkout, each word quoted and
  # the line escaped.
  local verify_cmd
  shq_line verify_cmd pinned review "$repo" --signed-tag "$tag_name"
  untrusted_var verify_cmd "$verify_cmd" "$C_DIM"
  printf '%s  consumers verify it against their allowed_signers: %s%s\n' "$C_DIM" "$verify_cmd" "$C_OFF"
  log_action sign "$repo" "$hash"
}

# ---- list ------------------------------------------------------------------

# Two views of one walk, both fed by list_entry, so they cannot disagree
# about a slot:
#
#   (default)       an index for people: a repos section (live state, short
#                   hash, name) and a files section grouped under their
#                   folders, then the counts and the review line for repos
#                   past their pin
#   --format json   the stable interface for programs (LIST_JSON below)
#
# Every field of one pin is `status`'s job, not a third view here.
#
# The text view is for reading and promises no grammar; a program reads
# the JSON. Live state (does the file or HEAD still match the record?) is
# computed for the text views and for --stale, never for a plain JSON
# listing: it costs a verify per file and a few git calls per repo, and a
# consumer reading records has no use for it. It is display, not a trust
# decision -- every gate runs its own `pinned verify`.

# One entry's facts, read once and shared by every output format, so the
# text listing and the JSON document can never disagree about a slot. Sets
# the L_* globals for the slot dir $1, decoded to the path $2; returns 1 when
# the slot holds nothing live (no state, or a tombstone) and is not listed.
# A field that does not apply stays empty. L_PROBLEMS is a space-separated
# list of the codes `--format json` documents:
#   slot-malformed           more than one state file; nothing else is read
#   record-corrupt           no readable digest or revision
#   record-names-other-path  L_RECPATH holds the path the record names
#   release-unusable         a release declaration outside the grammar
#   ignored-unusable         an ignored-key declaration that cannot be honored
list_entry() { # slot-dir  path
  local d="$1" path="$2" line rec_rc
  L_TYPE="" L_KIND="" L_DIGEST="" L_RECPATH="" L_RELEASE=""
  L_IGNORED="" L_CUSTODY="" L_PROBLEMS=""
  if ! inspect_slot "$d" 2>/dev/null; then
    L_PROBLEMS=slot-malformed
    return 0
  fi
  # THE SLOT-NAME INVARIANT (above slot_name_actual), reported per entry
  # so drift is visible in a listing and not only at the next ceremony: a
  # record naming another path than this directory encodes is a problem.
  # (The other half -- a directory the volume aliases onto a former
  # spelling of the LIVE path -- is invisible here by construction: this
  # loop walks on-disk names and never asks about a live path; status and
  # review, which are asked about one, report it.)
  case "$slot_state" in
    none|tombstone) return 1 ;;
    rev)
      L_TYPE=repo L_KIND="$slot_kind"
      rec_rc=0
      read_rev "$d" "$path" >/dev/null 2>&1 || rec_rc=$?
      if [ "$rec_rc" -eq 1 ] || [ -z "$REC_DIGEST" ]; then
        L_PROBLEMS=record-corrupt
        return 0
      fi
      L_DIGEST="$REC_DIGEST"
      [ "$rec_rc" -ne 2 ] || { L_RECPATH="$REC_PATH"; L_PROBLEMS=record-names-other-path; }
      # The declared release name -- absent for a rev-only slot, exactly
      # like the ignored declaration on file entries.
      if [ -f "$d/release" ]; then
        IFS= read -r line <"$d/release" || line=""
        if [ -n "$line" ] && validate_release_name "$line"; then
          L_RELEASE="$line"
        else
          L_PROBLEMS="${L_PROBLEMS:+$L_PROBLEMS }release-unusable"
        fi
      fi ;;
    pin)
      L_TYPE=file L_KIND="$slot_kind"
      IFS= read -r line <"$slot_file" || line=""
      case "${line%%  *}" in
        *[!0-9a-f]*|'') L_PROBLEMS=record-corrupt; return 0 ;;
      esac
      # Full digest, never an abbreviation: the one thing a reader copies
      # out of this listing is the digest they are about to paste into a
      # verify or compare against a `show`.
      L_DIGEST="${line%%  *}"
      [ "${line#*  }" = "$path" ] || { L_RECPATH="${line#*  }"; L_PROBLEMS=record-names-other-path; }
      if slot_declares_ignore "$d"; then
        if read_ignored_paths "$d" 2>/dev/null; then
          L_IGNORED="$IGN_PATHS"
        else
          L_PROBLEMS="${L_PROBLEMS:+$L_PROBLEMS }ignored-unusable"
        fi
      fi
      # Custody is stated on EVERY well-formed file entry, present or
      # absent: a consumer reading through the slot (pinned cat, a
      # baseline-free verify) is served by one and refused by the other,
      # and a silence that means "byte-exact, no copy" is a silence
      # somebody has to stat the slot to resolve.
      if [ -e "$d/approved" ]; then L_CUSTODY=kept; else L_CUSTODY=none; fi ;;
  esac
  return 0
}

list_has_problem() { # code
  case " $L_PROBLEMS " in *" $1 "*) return 0 ;; esac
  return 1
}


# The JSON record for the entry list_entry just read: its nine fields as
# NUL-terminated strings, in LIST_JSON's order. NUL is the one byte no path
# and no field can hold, so nothing here needs escaping; jq does the JSON.
list_json_entry() { # path
  printf '%s\0' "$1" "$L_TYPE" "$L_KIND" "$L_DIGEST" "$L_RECPATH" \
    "$L_RELEASE" "$L_IGNORED" "$L_CUSTODY" "$L_PROBLEMS"
}

# `list --format json`: the stable machine form, schema 1. One document,
# never colored:
#   {"schema": 1, "pins": [ENTRY, ...]}
# Every ENTRY carries all nine keys; a key that does not apply is null:
#   path         the decoded absolute path
#   type         "repo" | "file" (null: slot-malformed)
#   kind         the declared kind: "git", "sha256", ...
#   digest       the full hex digest or revision (null: no readable record)
#   record_path  the path the record names, when it is not `path`
#   release      a repo's declared release name
#   ignored      a file's ignored-key declaration, as stored: [["a","b"],...]
#   custody      a file's custody: "kept" | "none"
#   problems     list_entry's codes, [] for a sound entry
# Paths are JSON strings, so a path that is not valid UTF-8 is not
# represented byte for byte (macOS volumes refuse such names).
LIST_JSON='
  def nz: if . == "" then null else . end;
  split("\u0000") | .[:-1] as $f
  | {schema: 1,
     pins: [range(0; $f | length; 9) as $i | $f[$i:$i + 9]
            | {path: .[0], type: (.[1] | nz), kind: (.[2] | nz),
               digest: (.[3] | nz), record_path: (.[4] | nz),
               release: (.[5] | nz),
               ignored: (.[6] | if . == "" then null else fromjson end),
               custody: (.[7] | nz),
               problems: (.[8] | if . == "" then [] else split(" ") end)}]}'


# A path as a person reads it: $HOME as ~. Still the raw bytes -- a path is
# bytes anyone could have chosen, so every caller escapes it (untrusted_var)
# at the moment it prints, in the color it prints in. Display only: never
# compared, hashed or handed to a program.
list_tilde() { # path
  local p="$1"
  if [ -n "${HOME:-}" ] && [ "$HOME" != / ]; then
    case "$p" in
      "$HOME")   p="~" ;;
      "$HOME"/*) p="~${p#"$HOME"}" ;;
    esac
  fi
  printf '%s' "$p"
}

# The live state of the entry list_entry just read, into LV_CLASS (ok, part,
# gone, bad) and LV_MSG, the words after the glyph. LV_PAST=1 marks a repo
# whose HEAD descends from the pin: the default view names those in its
# review line. A file's state is verify's own exit (in a subshell, as status
# does), so the listing can never disagree with the gate. A repo's comes from
# sgit, the scrubbed git every reading verb uses.
list_live() { # path
  local path="$1" rc head n repo gone
  LV_CLASS="" LV_MSG="" LV_PAST=0
  if list_has_problem slot-malformed; then LV_CLASS=bad LV_MSG="malformed slot"; return 0; fi
  if list_has_problem record-corrupt; then LV_CLASS=bad LV_MSG="corrupt record"; return 0; fi
  if [ "$L_TYPE" = file ]; then
    rc=0; (do_verify "$path" >/dev/null 2>&1) || rc=$?
    case "$rc" in
      0)  LV_CLASS=ok   LV_MSG=current ;;
      5)  LV_CLASS=part LV_MSG="changed in ignored keys" ;;
      11) LV_CLASS=part LV_MSG="changed since approval" ;;
      17) LV_CLASS=part LV_MSG="record names another path" ;;
      20) LV_CLASS=gone LV_MSG=gone ;;
      30) LV_CLASS=bad  LV_MSG="owner or mode not trusted" ;;
      *)  LV_CLASS=bad  LV_MSG="verify failed (exit $rc)" ;;
    esac
    # verify's 1 is every error; name the one a sandboxed caller meets.
    if [ "$rc" -eq 1 ]; then
      gone=0; path_gone "$path" 2>/dev/null || gone=$?
      [ "$gone" -ne 2 ] || LV_MSG="cannot read"
    fi
    return 0
  fi
  gone=0; path_gone "$path" 2>/dev/null || gone=$?
  case "$gone" in
    0) LV_CLASS=gone LV_MSG=gone; return 0 ;;
    2) LV_CLASS=bad LV_MSG="cannot read"; return 0 ;;
  esac
  if list_has_problem record-names-other-path; then
    LV_CLASS=part LV_MSG="record names another path"
    return 0
  fi
  repo="$path"   # sgit runs git -C "$repo"
  if ! head="$(sgit rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null)"; then
    LV_CLASS=bad LV_MSG="not a readable git work tree"
    return 0
  fi
  if [ "$head" = "$L_DIGEST" ]; then
    LV_CLASS=ok LV_MSG=current
  elif ! sgit cat-file -e "${L_DIGEST}^{commit}" 2>/dev/null; then
    LV_CLASS=part LV_MSG="pin missing from this checkout"
  elif sgit merge-base --is-ancestor "$L_DIGEST" "$head" 2>/dev/null; then
    n="$(sgit rev-list --count "${L_DIGEST}..${head}" 2>/dev/null || echo '?')"
    LV_CLASS=part LV_MSG="$n commit$(plural_s "$n") past the pin" LV_PAST=1
  elif sgit merge-base --is-ancestor "$head" "$L_DIGEST" 2>/dev/null; then
    LV_CLASS=part LV_MSG="behind the pin"
  else
    LV_CLASS=part LV_MSG="diverged from the pin"
  fi
  return 0
}

# A live state as it prints: the color and glyph its class takes, then the
# words. `∅` is dim: an absence is neither good nor bad.
list_mark() { # class  message
  case "$1" in
    ok)   printf '%s✓ %s%s' "$C_GRN" "$2" "$C_OFF" ;;
    part) printf '%s∂ %s%s' "$C_YEL" "$2" "$C_OFF" ;;
    gone) printf '%s∅ %s%s' "$C_DIM" "$2" "$C_OFF" ;;
    *)    printf '%s✗ %s%s' "$C_RED$C_B" "$2" "$C_OFF" ;;
  esac
}

# A live state padded to the width of the widest word in its section ($3),
# so whatever follows starts in one column. The padding is counted on the
# bare word, outside the color, with the glyph as one column: true of the
# check, cross and empty-set glyphs everywhere and of the partial glyph in
# Ghostty; where that one draws two columns (East Asian widths), its row's
# later fields sit one column right of its reason line, and nothing is cut.
list_mark_pad() { # class  word  width
  local n=$(( $3 - ${#2} ))
  list_mark "$1" "$2"
  [ "$n" -le 0 ] || printf '%*s' "$n" ''
}

# The word a row shows for a live state's class, into the variable $1: the
# counts line's own vocabulary, so a row and the tally below it agree.
list_word() { # var  class
  case "$2" in
    ok)   printf -v "$1" '%s' current ;;
    part) printf -v "$1" '%s' changed ;;
    gone) printf -v "$1" '%s' gone ;;
    *)    printf -v "$1" '%s' broken ;;
  esac
}

# A row's reason, dim on a line of its own directly under it, starting in
# the column of the row's second field ($3): only when the state says more
# than its word, so a current or gone row stays one line.
list_reason() { # message  word  column
  [ "$1" != "$2" ] || return 0
  printf '%*s%s%s%s\n' "$3" '' "$C_DIM" "$1" "$C_OFF"
}

# Pad by characters, not bytes: printf's %-Ns counts bytes, so a name with
# an accented letter would push its row's state column out.
list_pad() { # text  width
  local n=$(( $2 - ${#1} ))
  printf '%s' "$1"
  [ "$n" -le 0 ] || printf '%*s' "$n" ''
}

# A path as a word in a command line to copy, into the variable $1: the ~
# form when it is plain, else the absolute path in single quotes, which
# bash, zsh and fish all read. Escaped like any other path, so a hidden
# character shows as an escape here too: a command that cannot be pasted
# faithfully says so rather than carrying an invisible byte along.
list_cmd_word() { # var  path
  local d LC_ALL=C
  d="$(list_tilde "$2")"
  case "$d" in
    *[!A-Za-z0-9._/~+@:,=-]*|'') d="'$(printf '%s' "$2" | sed "s/'/'\\\\''/g")'" ;;
  esac
  untrusted_var "$1" "$d"
}

# The indices of one of list_walk's arrays, ordered by displayed path (case
# folded, as a reader scans), one per line: slot directories sort by their
# encoded names, which is not the order a reader scans in.
list_order() { # count  array-name
  local i v
  for (( i = 0; i < $1; i++ )); do
    eval "v=\"\${$2[$i]}\""
    printf '%s\t%d\n' "$v" "$i"
  done | LC_ALL=C sort -f | while IFS="$TAB" read -r v i; do printf '%d\n' "$i"; done
}

# The default view, from the arrays list_walk filled: repos, files grouped
# under their folders, counts, and the review line. Each row reads in the
# order a reader scans it -- the live state first, as the counts line's word
# for it (current, changed, gone, broken) padded to the widest word the
# section shows, then a repo's short hash, and the name LAST, never padded:
# a name is as long as whoever chose it made it, so it ends its row and
# soft-wraps there rather than pushing a column out. A state that says more
# than its word ("2 commits past the pin", "owner or mode not trusted") says
# it on a reason line under its row, so one long state widens no column.
#
#   <check> current  d221ac6  locked
#   <part>  changed  d526136  claude-code-hardening
#                    2 commits past the pin
list_short() {
  local i j n vw b name top rel dirs tops k nm w
  local -a rw=() fw=()
  local n_ok=0 n_part=0 n_gone=0 n_bad=0 past="" sep="" word
  local -a names=() tdirs=() ro=() fo=()
  while IFS= read -r i; do ro[${#ro[@]}]="$i"; done < <(list_order "$RP_N" RP_DISP)
  while IFS= read -r i; do fo[${#fo[@]}]="$i"; done < <(list_order "$FP_N" FP_DISP)
  for (( i = 0; i < RP_N; i++ )); do
    case "${RP_CLASS[$i]}" in ok) n_ok=$((n_ok+1)) ;; part) n_part=$((n_part+1)) ;; gone) n_gone=$((n_gone+1)) ;; *) n_bad=$((n_bad+1)) ;; esac
  done
  for (( i = 0; i < FP_N; i++ )); do
    case "${FP_CLASS[$i]}" in ok) n_ok=$((n_ok+1)) ;; part) n_part=$((n_part+1)) ;; gone) n_gone=$((n_gone+1)) ;; *) n_bad=$((n_bad+1)) ;; esac
  done

  if [ "$RP_N" -gt 0 ]; then
    # A repo is named by its folder; two repos sharing one name get their
    # parent folder too.
    vw=0
    for (( i = 0; i < RP_N; i++ )); do
      b="${RP_DISP[$i]##*/}"
      for (( j = 0; j < RP_N; j++ )); do
        [ "$j" -ne "$i" ] || continue
        if [ "${RP_DISP[$j]##*/}" = "$b" ]; then
          name="${RP_DISP[$i]%/*}"; b="${name##*/}/$b"; break
        fi
      done
      names[$i]="$b"
      list_word w "${RP_CLASS[$i]}"; rw[$i]="$w"
      [ "${#w}" -le "$vw" ] || vw="${#w}"
    done
    printf '%srepos%s  %s%d%s\n' "$C_B" "$C_OFF" "$C_DIM" "$RP_N" "$C_OFF"
    for i in "${ro[@]}"; do
      untrusted_var nm "${names[$i]}" "$C_CYN"
      printf '  %s  %s%s%s  ' "$(list_mark_pad "${RP_CLASS[$i]}" "${rw[$i]}" "$vw")" \
        "$C_DIM" "$(list_pad "${RP_HASH[$i]:0:7}" 7)" "$C_OFF"
      printf '%s%s%s\n' "$C_CYN" "$nm" "$C_OFF"
      list_reason "${RP_MSG[$i]}" "${rw[$i]}" $(( vw + 6 ))
      if [ "${RP_PAST[$i]}" -ne 0 ]; then
        list_cmd_word word "${RP_PATH[$i]}"
        past="$past $word"
      fi
    done
    sep=1
  fi

  if [ "$FP_N" -gt 0 ]; then
    # Folders: each file's own folder, folded into any listed folder above
    # it, so ~/p/.claude-lane and ~/p/.claude/settings.local.json read as
    # one project rather than two folders.
    dirs=""
    for (( i = 0; i < FP_N; i++ )); do
      dirs="$dirs${FP_DISP[$i]%/*}$NL"
    done
    while IFS= read -r top; do
      [ -n "$top" ] || continue
      k=0
      while IFS= read -r b; do
        [ -n "$b" ] && [ "$b" != "$top" ] || continue
        case "$top" in "$b"/*) k=1; break ;; esac
      done <<<"$dirs"
      [ "$k" -eq 1 ] || tdirs[${#tdirs[@]}]="$top"
    done < <(printf '%s' "$dirs" | LC_ALL=C sort -f | uniq)
    [ -z "$sep" ] || printf '\n'
    printf '%sfiles%s  %s%d in %d folder%s%s\n' "$C_B" "$C_OFF" "$C_DIM" "$FP_N" \
      "${#tdirs[@]}" "$(plural_s "${#tdirs[@]}")" "$C_OFF"
    vw=0
    for (( i = 0; i < FP_N; i++ )); do
      list_word w "${FP_CLASS[$i]}"; fw[$i]="$w"
      [ "${#w}" -le "$vw" ] || vw="${#w}"
    done
    for top in "${tdirs[@]}"; do
      untrusted_var nm "$top" "$C_B$C_CYN"
      printf '  %s%s%s\n' "$C_B$C_CYN" "$nm" "$C_OFF"
      for i in "${fo[@]}"; do
        case "${FP_DISP[$i]}" in "$top"/*) ;; *) continue ;; esac
        rel="${FP_DISP[$i]#"$top"/}"
        untrusted_var nm "$rel"
        printf '    %s  %s\n' "$(list_mark_pad "${FP_CLASS[$i]}" "${fw[$i]}" "$vw")" "$nm"
        list_reason "${FP_MSG[$i]}" "${fw[$i]}" $(( vw + 8 ))
      done
    done
    sep=1
  fi

  # Counts: every nonzero state, the dim dot between them. A listing that is
  # all one state still says so.
  local -a parts=()
  [ "$n_ok" -eq 0 ] || parts[${#parts[@]}]="$n_ok current"
  [ "$n_part" -eq 0 ] || parts[${#parts[@]}]="$C_YEL$n_part changed$C_OFF"
  [ "$n_gone" -eq 0 ] || parts[${#parts[@]}]="$C_DIM$n_gone gone$C_OFF"
  [ "$n_bad" -eq 0 ] || parts[${#parts[@]}]="$C_RED$C_B$n_bad broken$C_OFF"
  printf '\n%s' "${parts[0]}"
  for (( i = 1; i < ${#parts[@]}; i++ )); do
    printf ' %s·%s %s' "$C_DIM" "$C_OFF" "${parts[$i]}"
  done
  printf '\n'
  if [ -n "$past" ]; then
    printf '\n%sReview the repos past their pin:%s\n' "$C_DIM" "$C_OFF"
    printf '  %spinned%s review%s\n' "$C_BLU" "$C_OFF" "$past"
  fi
}

do_list() {
  # Every live (non-tombstoned) pin in the invoking user's tier.
  # Unprivileged -- reading needs membership in the tier's group. Slot
  # names never leave this function: consumers get decoded paths.
  inv="$(tier_user)"  # not id -un: correct tier under sudo (root has none)
  local format=text
  LW_UNDER="" LW_REPOS=0 LW_FILES=0 LW_STALE=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --under)
        [ $# -ge 2 ] || { echo "--under needs a directory" >&2; exit 1; }
        LW_UNDER="$2"; shift 2 ;;
      --format)
        [ $# -ge 2 ] || { echo "--format needs a name: text or json" >&2; exit 1; }
        format="$2"; shift 2 ;;
      --repos) LW_REPOS=1; shift ;;
      --files) LW_FILES=1; shift ;;
      --stale) LW_STALE=1; shift ;;
      *) say_err "unknown list option: " "$1"; usage ;;
    esac
  done
  case "$format" in
    text) ;;
    json) require_jq "list --format json" || exit 1 ;;
    *) say_err "unknown list format (text or json): " "$format"; exit 1 ;;
  esac
  # Neither type flag, or both, shows both.
  if [ "$LW_REPOS" -eq 1 ] && [ "$LW_FILES" -eq 1 ]; then LW_REPOS=0 LW_FILES=0; fi
  if [ -n "$LW_UNDER" ]; then
    # Matching is on DECODED paths at a component boundary (--under /a/b
    # matches /a/b/c, never /a/bc), so normalize to an absolute path
    # with no trailing slash.
    case "$LW_UNDER" in
      /*) ;;
      *) LW_UNDER="$(pwd -P)/$LW_UNDER" ;;
    esac
    [ -d "$LW_UNDER" ] && LW_UNDER="$(readlink -f "$LW_UNDER")"
    while [ "${LW_UNDER%/}" != "$LW_UNDER" ]; do LW_UNDER="${LW_UNDER%/}"; done
    [ -n "$LW_UNDER" ] || LW_UNDER=/
  fi
  if [ "$format" = json ]; then LW_VIEW=json; else LW_VIEW=short; fi

  local sroot="$PINNED_ROOT/$inv/slots"
  # No tree yet is an empty listing, not an error: a consumer asking "which
  # pins lie under here" gets the true answer, none, and keeps the nonzero
  # exit for a listing it could not read.
  if [ ! -d "$sroot" ]; then
    if [ "$LW_VIEW" = json ]; then printf '' | jq -Rs "$LIST_JSON"; else echo "No pins yet."; fi
    return 0
  fi
  [ -r "$sroot" ] || {
    error "cannot read the slots (are you in group $(pin_group "$inv")?): " "$sroot"
    exit 1
  }
  RP_N=0 FP_N=0 LW_SEEN=0 LW_FOUND=0
  if [ "$LW_VIEW" = json ]; then
    list_walk "$sroot" | jq -Rs "$LIST_JSON"
    return 0
  fi
  list_walk "$sroot"
  if [ "$LW_FOUND" -eq 0 ]; then
    if [ "$LW_STALE" -eq 1 ] && [ "$LW_SEEN" -gt 0 ]; then
      printf '%s✓ Every pin is current.%s\n' "$C_GRN" "$C_OFF"
    elif [ "$LW_SEEN" -eq 0 ] && [ -z "$LW_UNDER" ] && [ "$LW_REPOS$LW_FILES" = 00 ]; then
      echo "No pins yet."
    else
      echo "No pins match."
    fi
    return 0
  fi
  list_short
}

# One pass over the slots, filtered by the LW_* options. The JSON view
# streams list_json_entry records; -v prints each block as it goes; the
# default view fills the RP_* and FP_* arrays list_short renders. Live
# state is computed only where it is shown or filtered on.
list_walk() { # slots-dir
  local d path
  for d in "$1"/*/; do
    d="${d%/}"
    [ -e "$d" ] || continue
    path="$(decode "${d##*/}")"
    # `--under /` names every path; the boundary pattern below would
    # spell it `//*` and match none.
    if [ -n "$LW_UNDER" ] && [ "$LW_UNDER" != / ]; then
      case "$path" in
        "$LW_UNDER"|"$LW_UNDER"/*) ;;
        *) continue ;;
      esac
    fi
    list_entry "$d" "$path" || continue
    # A malformed slot has no type, so it shows under either type filter.
    [ "$LW_REPOS" -eq 0 ] || [ "$L_TYPE" != file ] || continue
    [ "$LW_FILES" -eq 0 ] || [ "$L_TYPE" != repo ] || continue
    LW_SEEN=$((LW_SEEN + 1))
    if [ "$LW_VIEW" != json ] || [ "$LW_STALE" -eq 1 ]; then
      list_live "$path"
      [ "$LW_STALE" -eq 0 ] || [ "$LV_CLASS" != ok ] || continue
    fi
    case "$LW_VIEW" in
      json) list_json_entry "$path" ;;
      short)
        if [ "$L_TYPE" = repo ]; then
          RP_PATH[$RP_N]="$path" RP_DISP[$RP_N]="$(list_tilde "$path")"
          RP_HASH[$RP_N]="$L_DIGEST"
          RP_CLASS[$RP_N]="$LV_CLASS" RP_MSG[$RP_N]="$LV_MSG" RP_PAST[$RP_N]="$LV_PAST"
          RP_N=$((RP_N + 1))
        else
          FP_DISP[$FP_N]="$(list_tilde "$path")"
          FP_CLASS[$FP_N]="$LV_CLASS" FP_MSG[$FP_N]="$LV_MSG"
          FP_N=$((FP_N + 1))
        fi ;;
    esac
    LW_FOUND=$((LW_FOUND + 1))
  done
  return 0
}

# ---- show ------------------------------------------------------------------

# Trusted display of a file OUTSIDE any repo, for hash-gated consumers (e.g. a
# hook wired in a content-gated settings file: the wrapper reads once, hashes
# what it read, and executes only on match). Show is the REHEARSAL: it
# records nothing -- `review --file` is the ceremony that does, and
# `verify --emit` is the programmatic read. Humans review, machines verify;
# the record happens only in the review ceremony. A DIRECTORY argument
# takes the repo branch below (do_show_repo) instead; the file ceremony
# here is untouched by it.
#
# The security-relevant act is the READ, not the hash. Hashing is trivial;
# what earns trust is that the bytes shown to you and the bytes hashed are the
# SAME single read -- never two reads of a file an attacker can swap between
# them. So: one read into memory, display those bytes, hash those bytes.
#
# Runs unprivileged (nothing to elevate -- it writes nothing). Root ownership
# of this binary is what protects the ceremony itself: a user-writable display
# script could show you innocent bytes and hash malicious ones, and unlike a
# falsified display that lie would SURVIVE (you would paste a hash that
# genuinely matches the malicious file). A lying display fails closed; a lying
# ceremony fails open. That asymmetry is why this lives here.
do_show() {
  # $algo carries a default, so given-ness needs its own marker; $length has
  # none yet at this point (its default is applied further down), so emptiness
  # is its marker. Both are read by the repo branch, which refuses them.
  local algo=sha256 file="" a length="" algo_given=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --algo|-a)
        [ $# -ge 2 ] || { echo "--algo needs a value" >&2; exit 1; }
        algo="$2"; algo_given=1; shift 2 ;;
      --length|-l)
        [ $# -ge 2 ] || { echo "--length needs a value (bits)" >&2; exit 1; }
        length="$2"; shift 2 ;;
      --) shift; break ;;
      -*) say_err "unknown option: " "$1"; usage ;;
      *)  [ -z "$file" ] || { echo "show takes one file or repo" >&2; usage; }
          file="$1"; shift ;;
    esac
  done
  [ -n "$file" ] || [ $# -eq 0 ] || { file="$1"; shift; }
  [ -n "$file" ] || usage

  # A directory is a repo, the same shape test status uses; anything else --
  # present or not -- stays with the file ceremony below. A directory that is
  # not a usable git work tree is resolve_repo's refusal, not this dispatch's.
  if [ -d "$file" ]; then
    [ "$algo_given" -eq 0 ] && [ -z "$length" ] \
      || { echo "--algo/--length apply to the file display" >&2; exit 1; }
    do_show_repo "$file"
    return
  fi

  # Only algorithms whose collision resistance still carries a trust decision.
  # The floor is 256 bits of OUTPUT (~128-bit collision resistance), applied by
  # output length rather than by family -- so sha512/256 is in and sha512/224 is
  # out, exactly like sha224, despite both being SHA-512 underneath. sha1/md5
  # are refused outright: this hash IS the gate, and a chosen-prefix collision
  # would let the bytes you reviewed and the bytes that execute differ.
  #
  # Post-quantum: nothing to do here. Grover only square-roots preimage search
  # and quantum collision search does not beat classical in practice, so a
  # 256-bit hash stays adequate; PQ pressure is on SIGNATURES, not digests.
  # 384/512 are available if you want margin anyway.
  #
  # Adding another function (blake2/blake3 below are the template) means one
  # case arm here plus one hash_cmd branch below. The constraint is not the
  # algorithm, it is the BINARY: whatever computes the digest decides whether
  # the gate passes, so it must resolve inside the trusted PATH pinned at the
  # top of this file. That is also why there is no --hasher flag taking a
  # path -- it would let the caller nominate an attacker-writable verifier.
  #
  # Values are each algorithm's standard name, one rule across families.
  # BLAKE2 kept per-length names (RFC 7693 era), so those carry a suffix;
  # BLAKE3 is one function whose standard digest is 256-bit, longer output
  # being the same function as an XOF -- that is what --length is for, and
  # why blake3 takes no suffix. sha512/256 and unsuffixed blake2b (= -512,
  # its standard default) are accepted, not advertised. $algo normalizes to
  # what the hasher's -a/-l flag wants.
  local algo_name
  case "$algo" in
    sha256)              algo_name="sha"; algo=256 ;;
    sha384)              algo_name="sha"; algo=384 ;;
    sha512)              algo_name="sha"; algo=512 ;;
    sha512/256)          algo_name="sha"; algo=512256 ;;
    blake2b-256)         algo_name="blake2"; algo=256 ;;
    blake2b-384)         algo_name="blake2"; algo=384 ;;
    blake2b-512|blake2b) algo_name="blake2"; algo=512 ;;
    blake3)              algo_name="blake3" ;;
    md5|sha1|MD5|SHA1)
      echo "refusing $algo: collision-vulnerable, and this hash is the gate" >&2
      exit 1 ;;
    sha224|sha512/224|blake2b-224)
      echo "refusing $algo: 224-bit output is below the 256-bit floor for a trust decision" >&2
      exit 1 ;;
    blake2s|blake2s-*)
      echo "unsupported: b2sum computes BLAKE2b only; blake2b-256 gives the same 256-bit output" >&2
      exit 1 ;;
    *)
      say_err "unsupported algorithm (use sha256, sha384, sha512, blake2b-256/384/512, blake3): " "$algo"
      exit 1 ;;
  esac

  # --length: blake3 only -- the XOF's output size, in BITS like every length
  # in the algorithm names. Everything else carries its length in the name.
  if [ -n "$length" ]; then
    [ "$algo_name" = blake3 ] || {
      echo "--length applies only to blake3 (other algorithms carry their length in the name)" >&2
      exit 1
    }
    case "$length" in
      ''|*[!0-9]*) echo "--length must be a whole number of bits" >&2; exit 1 ;;
    esac
    [ $((length % 8)) -eq 0 ] || { echo "--length must be a multiple of 8 bits" >&2; exit 1; }
    [ "$length" -ge 256 ] || {
      echo "refusing --length $length: below the 256-bit floor for a trust decision" >&2
      exit 1
    }
  else
    length=256
  fi

  # Resolve the hashing command; fail closed and say what to install. The
  # usage text lists every algorithm regardless of what this machine has:
  # help describes the interface and must not vary by host -- availability
  # is this check's job.
  case "$algo_name" in
    blake3)
      command -v b3sum >/dev/null 2>&1 || {
        say_err "blake3 requested, but the trusted PATH has no b3sum: " "$PATH"
        echo "       install b3sum system-wide (a user-writable one would defeat the gate)" >&2
        exit 1
      } ;;
    blake2)
      command -v b2sum >/dev/null 2>&1 || {
        say_err "blake2b requested, but the trusted PATH has no b2sum: " "$PATH"
        echo "       install GNU coreutils system-wide (a user-writable b2sum would defeat the gate)" >&2
        exit 1
      } ;;
  esac

  [ -f "$file" ] || { say_err "not a regular file: " "$file"; exit 1; }

  # NUL bytes cannot survive a shell variable, so the consumer wrapper could
  # never execute the file's literal bytes. Refuse rather than hash something
  # that differs from what any wrapper would run.
  if [ "$(LC_ALL=C tr -d '\000' <"$file" | wc -c)" -ne "$(wc -c <"$file")" ]; then
    echo "refusing: file contains NUL bytes (not shell-executable text)" >&2
    exit 1
  fi

  # THE single read. Everything below is derived from $content, never from a
  # second look at the file. The `; printf x` + `%x` idiom preserves trailing
  # newlines, which plain $(cat) strips -- so $content is the file's bytes
  # EXACTLY, and the digest below equals `shasum -a <algo> <file>`. Matching
  # the ordinary check matters: you can verify this tool with any other tool.
  local content hash nl
  content="$(cat -- "$file"; printf x)" || { say_err "cannot read: " "$file"; exit 1; }
  content="${content%x}"

  # The path stands on its row, escaped; the section rule holds no value.
  local file_disp n_lines
  untrusted_var file_disp "$file"
  # The guard, the escaper and the highlighter are all fed $content, not the
  # file, so the single-read rule holds; the digest below still comes from
  # $content too, never from the displayed stream. Rendered before the
  # section rule, which states the line endings when they are CRLF.
  hl="$(highlighter_for "$file")"
  highlight_ok "$hl" <<<"$content" || hl=""
  untrusted_render doc "$hl" < <(printf '%s' "$content")
  printf '%sfile:%s       %s\n' "$C_DIM" "$C_OFF" "$file_disp"
  printf '%s--- exactly the bytes being hashed%s ---%s\n' "$C_B" \
    "${UT_CRLF:+ (CRLF line endings)}" "$C_OFF"
  untrusted_show
  # The closing rule, so the digest below -- this display's verdict -- sits
  # after the last byte of the file and never beside it.
  nl=''
  [ "${content%"$NL"}" != "$content" ] && nl=1
  n_lines="$(printf '%s' "$content" | LC_ALL=C wc -l | tr -d ' ')"
  [ -n "$nl" ] || [ -z "$content" ] || n_lines=$((n_lines + 1))
  print_end_rule file "$n_lines line$(plural_s "$n_lines")"

  # Digest and the command that recomputes it, kept in lockstep: $hash_cmd is
  # emitted into the wrapper verbatim, so the two sides cannot drift.
  local hash hash_cmd label
  if [ "$algo_name" = blake3 ]; then
    hash_cmd="b3sum --no-names --length $((length / 8))"   # b3sum takes bytes
    if [ "$length" -eq 256 ]; then
      label="blake3"
    else
      label="blake3 (${length}-bit)"   # descriptive; there is no blake3-N name
    fi
  elif [ "$algo_name" = blake2 ]; then
    hash_cmd="b2sum -l $algo"
    label="blake2b-$algo"
  else
    hash_cmd="shasum -a $algo"
    case "$algo" in
      512256) label="sha512/256" ;;   # canonical name; -a takes the digit form
      *)      label="sha${algo}" ;;
    esac
  fi

  hash="$(printf '%s' "$content" | $hash_cmd)" || { echo "hashing failed" >&2; exit 1; }
  hash="${hash%% *}"
  [ -n "$hash" ] || { echo "hashing failed" >&2; exit 1; }

  echo
  printf '%s%s:%s  %s%s%s\n' "$C_B" "$label" "$C_OFF" "$C_CYN" "$hash" "$C_OFF"
  echo
  # Emit the consumer snippet, not just the hash: the wrapper must read and
  # hash exactly as this did, or the two sides drift and every launch refuses.
  # It opens by pinning PATH for the same reason this script does -- a hook
  # inherits the session's PATH, which legitimately contains user-writable
  # prefixes (~/.nix-profile, ~/.local/bin, /opt/homebrew/bin), so bare names
  # would otherwise resolve through directories an attacker can write. One
  # pinned PATH, then bare tools, exactly as above.
  printf '%sfail-closed wrapper (paste into the hash-gated settings file):%s\n' "$C_DIM" "$C_OFF"
  cat <<EOF
export PATH=$PATH; c=\$(cat $file; printf x); c=\${c%x}; h=\$(printf '%s' "\$c" | $hash_cmd); [ "\${h%% *}" = "$hash" ] && exec bash -c "\$c" || { echo 'hook hash mismatch -- refusing' >&2; exit 2; }
EOF
  log_action show "$file" "$hash"
}

# The repo half of show: re-display what the pin NAMES, through the same
# hardened path the review ceremony used. Once a repo is pinned, the only
# trusted re-read was for FILE pins (`cat` serves the stored witness); a repo's
# content could only be re-read through ambient git, whose display is
# falsifiable by repo-local diff drivers and textconv filters -- the whole
# reason sgit exists. It RECORDS NOTHING: show rehearses, review records.
#
# Unprivileged is correct here. Content-addressing carries the trust (the rev
# names the bytes, and the pin file it comes from is root-owned), and the
# root-owned installed binary means the display path itself cannot be swapped
# by a user-space attacker. There is nothing to write, so nothing to elevate.
do_show_repo() {
  resolve_repo "$1"
  local hash head_hash tag diff_out ahead subj
  hash="$(read_rev "$default_slot" "$repo")" || exit 1
  [ -n "$hash" ] || {
    say_cmd "nothing is pinned here, and show re-displays a pin; review it first: pinned review " "$repo"
    exit 1
  }
  # Availability up front: a rev the object store no longer holds (rewritten
  # history or gc) has nothing to display, and saying so beats a raw git error
  # arriving mid-header with part of a ceremony already on screen. cat-file -e
  # answers existence only -- the display itself goes through sgit_diff.
  sgit cat-file -e "${hash}^{commit}" 2>/dev/null || {
    error "the pinned rev $hash is missing from this checkout (rewritten history or gc?)"
    echo "        there is nothing to re-display; restore the commit or re-approve" >&2
    exit 1
  }

  print_repo_row "$C_DIM"
  subject_var subj "$hash" "$C_DIM"
  printf '%spinned:%s     %s%s%s  %s%s%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$hash" "$C_OFF" \
    "$C_DIM" "$subj" "$C_OFF"
  if [ -r "$default_slot/release" ]; then
    IFS= read -r tag <"$default_slot/release" || tag=""
    [ -z "$tag" ] \
      || printf '%srelease:%s    %s  %s(declared)%s\n' "$C_DIM" "$C_OFF" "$tag" "$C_DIM" "$C_OFF"
  fi

  # ORIENTATION ONLY -- where the checkout stands relative to the pin. The
  # display below is of the PIN, never of HEAD, so nothing here selects what
  # gets shown; it just keeps a reader from mistaking one for the other.
  head_hash="$(sgit rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null || true)"
  if [ -z "$head_hash" ]; then
    printf '%sthis checkout has no live HEAD%s\n' "$C_DIM" "$C_OFF"
  elif [ "$head_hash" = "$hash" ]; then
    printf '%slive HEAD is at the pin%s\n' "$C_DIM" "$C_OFF"
  elif sgit merge-base --is-ancestor "$hash" HEAD 2>/dev/null; then
    ahead="$(sgit rev-list --count "${hash}..HEAD")"
    printf '%slive HEAD is %s commit%s past the pin%s\n' "$C_DIM" \
      "$ahead" "$(plural_s "$ahead")" "$C_OFF"
  else
    printf '%slive HEAD does not descend from the pin%s\n' "$C_DIM" "$C_OFF"
  fi
  # No dirty-tree note: review carries one because it pins HEAD's commit while
  # the reviewer looks at a work tree that may hold more. This display comes
  # from the object store at a rev that is already fixed, so uncommitted
  # changes cannot alter a byte of it and saying otherwise would be noise.

  echo
  # The section rule holds no value: the rev is on the pinned: row above.
  printf '%s--- full tree (from object store) ---%s\n' "$C_B" "$C_OFF"
  # 4b825d... is git's well-known empty tree: the diff from it is every byte
  # the pin names, exactly what a first approval displays. Capture first so a
  # git failure aborts (set -e) BEFORE anything is shown as reviewable; then
  # page. Early pager quit (SIGPIPE) is the reader's own act.
  diff_out="$(sgit_diff 4b825dc642cb6eb9a060e54bf8d69288fbee4904 "$hash")"
  untrusted_page color_diff <<<"$diff_out"
  print_end_rule diff "$(diff_totals 4b825dc642cb6eb9a060e54bf8d69288fbee4904 "$hash")"

  # Syslog is audit history, not a record: the file half logs the same way,
  # and neither writes a slot.
  log_action show "$repo" "$hash"
}

# ---- diff ------------------------------------------------------------------

# The change from one file to another, shown exactly as review --file shows
# a file's change against its baseline -- the same capture, rows, gate,
# escaper, colorizer, pager and closing rule (the file diff above) -- for a
# caller that needs a trustworthy display of two files it already holds: a
# deployer showing an installed copy against a staged one, say, without a
# copy of this display of its own.
#
# IT TOUCHES NOTHING BUT THE TWO FILES. No sudo, no record, no slot, no
# policy, no audit log: it is not in the self-elevation list, it calls
# nothing that reads a slot, and it runs with whatever rights its caller
# has. Each file is read ONCE (freeze_file), and everything shown derives
# from those frozen copies, so a file that changes mid-display cannot make
# the diff, its size and its keys disagree.
#
# FAIL CLOSED: a missing file, one that is not a regular file, one that
# cannot be read, or a diff that cannot be made refuses with nothing shown,
# the path last. A path holding a line feed refuses too: it heads the diff
# as its label, and a line feed there would let the path's own text pose as
# diff structure. Exit 0 shown (or identical), 2 declined at the gate, 1
# refused.
do_diff() {
  local old="" new="" a want_paths=1 old_fro new_fro p gone
  for a in "$@"; do
    if [ "$want_paths" -eq 1 ]; then
      case "$a" in
        --) want_paths=2; continue ;;
        -?*) say_err "unknown option: " "$a"; usage ;;
      esac
    fi
    if [ -z "$old" ]; then old="$a"
    elif [ -z "$new" ]; then new="$a"
    else echo "diff takes two files" >&2; usage; fi
  done
  [ -n "$old" ] && [ -n "$new" ] || usage

  # Both paths are checked before either is read, so a refusal shows
  # nothing of the other file.
  for p in "$old" "$new"; do
    case "$p" in
      *"$NL"*) refused "a path holding a line feed cannot head a diff: " "$p"; exit 1 ;;
    esac
    gone=0
    path_gone "$p" || gone=$?
    case "$gone" in
      0) refused "no such file: " "$p"; exit 1 ;;
      2) refused "cannot read: " "$p"; exit 1 ;;
    esac
    [ -f "$p" ] || { refused "not a regular file: " "$p"; exit 1; }
    [ -r "$p" ] || { refused "cannot read: " "$p"; exit 1; }
  done
  freeze_file "$old" 2>/dev/null || { refused "cannot read: " "$old"; exit 1; }
  old_fro="$FROZEN_COPY"
  freeze_file "$new" 2>/dev/null || { refused "cannot read: " "$new"; exit 1; }
  new_fro="$FROZEN_COPY"

  if cmp -s -- "$old_fro" "$new_fro"; then
    echo "the two files are byte-identical; there is no diff to show"
    return 0
  fi
  file_diff_capture "$old_fro" "$new_fro" "old: $old" "new: $new" || {
    refused "cannot diff the two files"
    exit 1
  }

  # The rows the gate decides about: the two paths as given, then the
  # change. Each path ends its line, escaped.
  local old_disp new_disp
  untrusted_var old_disp "$old" "$C_CYN"
  untrusted_var new_disp "$new" "$C_CYN"
  printf '%sold:%s        %s%s%s\n' "$C_B" "$C_OFF" "$C_CYN" "$old_disp" "$C_OFF"
  printf '%snew:%s        %s%s%s\n' "$C_B" "$C_OFF" "$C_CYN" "$new_disp" "$C_OFF"
  file_diff_change_row
  # A caller across a process seam prints nothing of its own for a decline:
  # this line is the one record of it.
  if ! file_diff_gate "show the diff"; then
    printf '%sskipped; nothing shown%s\n' "$C_YEL" "$C_OFF"
    exit 2
  fi
  file_diff_show "diff from old to new"
}

# ---- slot ------------------------------------------------------------------

do_slot() {
  # Print the slot directory for ANY path -- repo, file, present or not.
  # This is the one place slot names are spelled: consumers (lane
  # launchers deciding what goes in the payload, root-owned symlinks)
  # must never reimplement the encoding, so the resolver has to answer
  # for the same paths verify does, including ones that do not exist yet.
  #
  #   sudo ln -s "$(pinned slot <repo>)" /etc/nix-darwin/pinned-rev
  #   d="$(pinned slot "$f")"; [ -d "$d" ] && tar -C / -c "${d#/}"
  #
  # A NAME RESOLVER, NOT AN EXISTENCE ORACLE: it never says whether the
  # path is pinned (that is verify) or whether the slot dir is there (the
  # caller's own -d). Canonicalization is canon_path's, the same one
  # verify keys its slot with -- one code path, so a repo and a file can
  # never encode differently -- which also inherits its refusal of a `..`
  # tail below a missing directory.
  [ $# -eq 1 ] || { echo "slot takes one path" >&2; usage; }
  local path tier
  # The tier verify would key the slot under, so `sudo pinned slot ...`
  # still answers for the human, not for root.
  tier="$(tier_user)"
  path="$(canon_path "$1")" || exit 1
  slot_dir_for "$tier" "$path"
}

# ---- signer ----------------------------------------------------------------

# Manage allowed_signers through a ceremony instead of hand-run sudo
# installs: fingerprint display, confirm, atomic root-owned write, syslog
# line. Input is EXPLICITLY FLAGGED, never sniffed -- a trust tool does
# not guess whether an operand is a path or key material (--file vs
# --key; public keys are not secret, so --key in argv is fine). A full
# allowed_signers line is taken as-is (it carries its principal); a bare
# public key needs --principal to construct one. THE PRINCIPAL IS THE
# LABEL, and it is load-bearing: ssh-keygen -Y matches it at
# verification, so it cannot drift into decoration.
#
# Storage: user tier = <user>/policy/allowed_signers (who may vouch is
# POLICY, and rides the policy dir a lane can be handed without the slot
# list); --repo writes the per-slot override at slots/<enc>/signers/,
# which stays with the slot because slot contents are one disclosure
# class. `signer add --repo` may create a slot dir holding only signers/ -- a legitimate
# pre-approve bootstrap, since review --signed-tag verifies AGAINST the
# signers; verify still answers "no slot" for such a dir. remove is
# first-class: key compromise response must not be the hand-edited path.
#
# Format is OpenSSH's SSHSIG allowed_signers, deliberately: the
# signature layer is git SSH signing end to end, stock ssh-keygen -Y
# verification, nothing pinned-specific anywhere. (# comment lines DO
# survive OpenSSH's parser -- measured 2026-07-29 with ssh-keygen -Y
# verify -- but this tool writes none.)

is_keytype() {
  case "$1" in
    ssh-ed25519|ssh-rsa|ssh-dss|rsa-sha2-256|rsa-sha2-512|ecdsa-sha2-*|sk-ssh-ed25519@openssh.com|sk-ecdsa-sha2-*) return 0 ;;
  esac
  return 1
}

key_fingerprint() {
  # $1 = keytype, $2 = base64 blob. Echoes ssh-keygen's fingerprint line.
  printf '%s %s\n' "$1" "$2" | ssh-keygen -lf /dev/stdin
}

do_signer() {
  [ $# -ge 1 ] || usage
  local sub="$1"; shift
  case "$sub" in add|remove|list|path) ;; *) usage ;; esac
  # path answers with a name and parses no key, so it needs no ssh-keygen.
  [ "$sub" = "path" ] || command -v ssh-keygen >/dev/null 2>&1 \
    || { error "no ssh-keygen in the trusted PATH: " "$PATH"; exit 1; }

  # --yes answers add/remove's y/N, and only with --key: the key line is
  # then on the command line. A --file key is content read after the
  # command was approved, so it keeps its y/N.
  local repo_arg="" keyfile="" keyline="" principal="" yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)
        [ $# -ge 2 ] || { echo "--repo needs a path" >&2; exit 1; }
        repo_arg="$2"; shift 2 ;;
      --yes) yes=1; shift ;;
      --file)
        [ $# -ge 2 ] || { echo "--file needs a path" >&2; exit 1; }
        keyfile="$2"; shift 2 ;;
      --key)
        [ $# -ge 2 ] || { echo "--key needs a line" >&2; exit 1; }
        keyline="$2"; shift 2 ;;
      --principal)
        [ $# -ge 2 ] || { echo "--principal needs an identity" >&2; exit 1; }
        principal="$2"; shift 2 ;;
      *) say_err "unknown signer option: " "$1"; usage ;;
    esac
  done

  # Resolve the target file. resolve_repo keys the slot to the ceremony
  # tier (SUDO_USER when elevated), same as review.
  local tier target
  tier="$(tier_user)"
  if [ -n "$repo_arg" ]; then
    resolve_repo "$repo_arg"
    target="$default_slot/signers/allowed_signers"
  else
    target="$(policy_dir_for "$tier")/allowed_signers"
  fi

  if [ "$sub" = "list" ]; then
    [ -z "$keyfile$keyline$principal" ] && [ "$yes" -eq 0 ] \
      || { echo "signer list takes only --repo" >&2; exit 1; }
    do_signer_list "$target"
    return
  fi
  # path: the file a signed tag of --repo verifies against, resolved the way
  # the ceremony resolves it -- the per-repo override when one EXISTS, else
  # the user tier's -- so a consumer that discovers signed releases (the
  # deployer's signed-release offer) never has to know where either lives. One
  # line on stdout, only when such a file exists; otherwise nothing and
  # exit 1: no signers is "nothing verifies", which the consumer reads as
  # no offer, and never as an error. Unprivileged, like list.
  if [ "$sub" = "path" ]; then
    [ -z "$keyfile$keyline$principal" ] && [ "$yes" -eq 0 ] \
      || { echo "signer path takes only --repo" >&2; exit 1; }
    if [ -n "$repo_arg" ] && [ ! -f "$target" ]; then
      target="$(policy_dir_for "$tier")/allowed_signers"
    fi
    if [ ! -f "$target" ]; then
      say_err "no signers file: " "$target"
      exit 1
    fi
    printf '%s\n' "$target"
    return
  fi
  require_root signer

  if [ -n "$keyfile" ] && [ -n "$keyline" ]; then
    echo "--file and --key are exclusive" >&2
    exit 1
  fi
  [ -n "$keyfile" ] || [ -n "$keyline" ] \
    || { echo "signer $sub needs --file PUBKEY or --key 'LINE'" >&2; exit 1; }
  if [ "$yes" -eq 1 ] && [ -n "$keyfile" ]; then
    echo "--yes takes the key on the command line: --key 'LINE', not --file" >&2
    exit 1
  fi
  local line
  if [ -n "$keyfile" ]; then
    [ -f "$keyfile" ] || { say_err "not a readable file: " "$keyfile"; exit 1; }
    IFS= read -r line <"$keyfile" || line=""
  else
    line="$keyline"
  fi
  case "$line" in
    ''|'#'*)
      error "no key material in the input"; exit 1 ;;
    *"$NL"*)
      error "one key per invocation (the input has multiple lines)"; exit 1 ;;
  esac

  # Classify: bare public key vs full allowed_signers line.
  local first keytype keyblob entry
  first="${line%% *}"
  if is_keytype "$first"; then
    keytype="$first"
    entry="${line#* }"; keyblob="${entry%% *}"
    if [ "$sub" = "add" ]; then
      [ -n "$principal" ] || {
        error "a bare public key needs --principal IDENTITY"
        echo "        (the principal is the label ssh-keygen -Y matches at verification)" >&2
        exit 1
      }
      case "$principal" in
        *[!A-Za-z0-9@._+-]*|'')
          error "principal must be non-empty [A-Za-z0-9@._+-]"; exit 1 ;;
      esac
      entry="$principal $keytype $keyblob"
    else
      entry=""   # remove matches by key blob; no line to construct
    fi
  else
    [ -z "$principal" ] \
      || { error "--principal only applies to a bare public key (this line already carries one)"; exit 1; }
    entry="$line"
    # Find the key material past the principal (and any options field).
    local words w i=0 ki=-1
    read -r -a words <<EOF
$line
EOF
    for w in "${words[@]}"; do
      if is_keytype "$w"; then ki="$i"; break; fi
      i=$((i + 1))
    done
    [ "$ki" -ge 1 ] || { error "no recognized key type in the line"; exit 1; }
    keytype="${words[$ki]}"
    keyblob="${words[$((ki + 1))]:-}"
    [ -n "$keyblob" ] || { error "key type with no key material"; exit 1; }
  fi

  local fp
  fp="$(key_fingerprint "$keytype" "$keyblob")" \
    || { error "ssh-keygen cannot parse this key"; exit 1; }

  local answer tmp tdir
  tdir="$(dirname "$target")"
  if [ "$sub" = "add" ]; then
    ensure_tree "$inv"
    if [ -n "$repo_arg" ]; then
      install -d -m "$TREE_DMODE" -o root -g "$TREE_GRP" "$default_slot" "$tdir"
    fi
    if [ -f "$target" ] && grep -qF "$keyblob" "$target"; then
      printf '%salready present%s (same key material): %s\n' "$C_GRN" "$C_OFF" "$target"
      exit 0
    fi
    # The question block: the advice, the rows (a 14-column gutter, the
    # widest label plus two), the consequence, the question -- which names
    # its object by the key: row's label. The line is the caller's bytes,
    # escaped.
    local entry_disp
    untrusted_var entry_disp "$entry"
    printf '%s(obtain the key out of band -- printed card, password manager, existing\ntrusted machine -- never from the repo it will vouch for.)%s\n' "$C_DIM" "$C_OFF"
    printf '%starget:%s       %s\n' "$C_B" "$C_OFF" "$target"
    printf '%skey:%s          %s\n' "$C_B" "$C_OFF" "$entry_disp"
    printf '%sfingerprint:%s  %s\n' "$C_B" "$C_OFF" "$fp"
    printf '%sThis key may then vouch for signed tags.%s\n' "$C_DIM" "$C_OFF"
    if [ "$yes" -eq 0 ]; then
      printf '%strust this key? [%sy%s/%sN%s]%s ' "$C_B" "$C_BLU" "$C_OFF$C_B" "$C_BLU" "$C_OFF$C_B" "$C_OFF"
      drain_tty
      read -r answer </dev/tty
      case "$answer" in
        y|Y|yes) ;;
        *) echo "aborted; signers unchanged"; log_action signer-add "$target" "" abort; exit 2 ;;
      esac
    fi
    tmp="$(mktemp "$tdir/.stage.XXXXXX")"
    { [ -f "$target" ] && cat "$target"; printf '%s\n' "$entry"; } >"$tmp"
    chown "root:$TREE_GRP" "$tmp"
    chmod "$TREE_FMODE" "$tmp"
    mv -f "$tmp" "$target"
    printf '%s✓ added:%s %s\n' "$C_GRN$C_B" "$C_OFF" "$fp"
    log_action signer-add "$target" "${fp##*SHA256:}"
  else
    [ -f "$target" ] || { say_err "no signers file: " "$target"; exit 1; }
    if ! grep -qF "$keyblob" "$target"; then
      say_err "key not present in the signers file: " "$target"
      exit 1
    fi
    ensure_tree "$inv"
    # The entries are lines of the signers file, which anyone who could
    # write a key into it wrote: escaped, one per line, stacked in the
    # value column under their entries: label.
    local e_lead e_line e_disp
    printf '%starget:%s       %s\n' "$C_B" "$C_OFF" "$target"
    e_lead="${C_B}entries:${C_OFF}      "
    while IFS= read -r e_line; do
      untrusted_var e_disp "$e_line"
      printf '%s%s\n' "$e_lead" "$e_disp"
      e_lead="              "
    done < <(grep -F "$keyblob" "$target")
    printf '%sfingerprint:%s  %s\n' "$C_B" "$C_OFF" "$fp"
    if [ "$yes" -eq 0 ]; then
      printf '%sremove these entries? [%sy%s/%sN%s]%s ' "$C_B" "$C_BLU" "$C_OFF$C_B" "$C_BLU" "$C_OFF$C_B" "$C_OFF"
      drain_tty
      read -r answer </dev/tty
      case "$answer" in
        y|Y|yes) ;;
        *) echo "aborted; signers unchanged"; log_action signer-remove "$target" "" abort; exit 2 ;;
      esac
    fi
    tmp="$(mktemp "$tdir/.stage.XXXXXX")"
    grep -vF "$keyblob" "$target" >"$tmp" || true   # empty result is fine: verifies nothing, fail closed
    chown "root:$TREE_GRP" "$tmp"
    chmod "$TREE_FMODE" "$tmp"
    mv -f "$tmp" "$target"
    printf '%s✓ removed:%s %s\n' "$C_GRN$C_B" "$C_OFF" "$fp"
    log_action signer-remove "$target" "${fp##*SHA256:}"
  fi
}

do_signer_list() {
  # Key types, fingerprints, principals: one row per key, the bounded
  # fields first and the principal (a name) last, escaped like every line
  # of the file. Unprivileged (group-read).
  local f="$1" line words ki i w found=0 disp
  [ -f "$f" ] || { echo "no signers file: $f"; return; }
  while IFS= read -r line; do
    case "$line" in ''|'#'*) continue ;; esac
    read -r -a words <<EOF
$line
EOF
    ki=-1; i=0
    for w in "${words[@]}"; do
      if is_keytype "$w"; then ki="$i"; break; fi
      i=$((i + 1))
    done
    if [ "$ki" -lt 1 ] || [ -z "${words[$((ki + 1))]:-}" ]; then
      untrusted_var disp "$line"
      printf '%s✗ unparseable%s  %s\n' "$C_RED$C_B" "$C_OFF" "$disp"
      found=1
      continue
    fi
    untrusted_var disp "${words[0]}" "$C_CYN"
    printf '%s  %s  %s%s%s\n' "${words[$ki]}" \
      "$(key_fingerprint "${words[$ki]}" "${words[$((ki + 1))]}" 2>/dev/null || echo 'fingerprint failed')" \
      "$C_CYN" "$disp" "$C_OFF"
    found=1
  done <"$f"
  [ "$found" -eq 1 ] || echo "(no signers)"
}

# ---- ignorable -------------------------------------------------------------

# The user tier of the ignorable policy, managed by the same kind of
# ceremony the signers get: display, confirm, atomic root-owned write,
# syslog line. Nothing here decides that a key IS ignored -- that stays the
# review ceremony's per-path declaration. This decides only what such a
# declaration is ALLOWED to say, which is why it is a separate root act:
# granting "model may drift under my settings dir" once is a decision worth
# making deliberately; re-confirming it at every settings edit is not.
#
# --under is the whole point of the scoping: a grant that reads "model,
# everywhere" would tolerate a `model` key in ANY pinned file on the
# machine, including one where it means something else entirely. The
# prefix matches at a component boundary, the same rule `list --under`
# uses, so /a/b covers /a/b/c and never /a/bb.
do_ignorable() {
  [ $# -ge 1 ] || usage
  local sub="$1"; shift
  case "$sub" in add|remove|list) ;; *) usage ;; esac

  # --yes answers add/remove's y/N: the key and the scope are on the
  # command line. A grant the machine policy would not let take effect
  # refuses under --yes, since its note is then read by nobody.
  local key="" under="" yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --under)
        [ $# -ge 2 ] || { echo "--under needs a directory" >&2; exit 1; }
        under="$2"; shift 2 ;;
      --yes) yes=1; shift ;;
      -*) say_err "unknown ignorable option: " "$1"; usage ;;
      *)  [ -z "$key" ] || { echo "ignorable $sub takes one key" >&2; usage; }
          key="$1"; shift ;;
    esac
  done
  require_jq "the ignorable policy" || exit 1

  local tier
  tier="$(tier_user)"
  if [ "$sub" = list ]; then
    [ -z "$key$under" ] && [ "$yes" -eq 0 ] \
      || { echo "ignorable list takes no arguments (it shows every entry of both tiers)" >&2; exit 1; }
    do_ignorable_list "$tier"
    return
  fi

  require_root ignorable
  [ -n "$key" ] || { echo "ignorable $sub needs a key, e.g. model or statusLine.command" >&2; exit 1; }
  validate_ignore_key "$key" || {
    untrusted_var key_disp "$key" "" 2
    error "a key outside the key grammar: $key_disp"
    echo "        the grammar is dotted [A-Za-z0-9_.-], no leading, trailing or doubled dot, no array subscripts" >&2
    exit 1
  }
  # Scope normalization, exactly as `list --under` does it: absolute,
  # symlinks resolved when the directory exists, no trailing slash. The
  # stored prefix has to be the spelling a canonicalized subject path
  # carries, or the grant would quietly never match anything.
  if [ -n "$under" ]; then
    case "$under" in
      /*) ;;
      *)  error "--under needs an absolute directory (a grant is not relative to a cwd)"
          exit 1 ;;
    esac
    [ -d "$under" ] && under="$(readlink -f "$under")"
    while [ "${under%/}" != "$under" ]; do under="${under%/}"; done
    [ -n "$under" ] || under=/
    case "$under" in
      *//*) error "--under must not contain an empty path component"; exit 1 ;;
    esac
  fi

  ensure_tree "$inv"
  local pf
  pf="$(policy_dir_for "$inv")/ignorable.json"
  load_policy "$inv" || exit 1

  local path_json dup scope_disp new_json answer covered=1
  path_json="$(ign_key_path_json "$key")"
  dup="$(jq -n --argjson e "$POL_USER" --argjson p "$path_json" --arg u "$under" \
    '[ $e[] | select(.path == $p and ((.under // "") == $u)) ] | length')"
  if [ -n "$under" ]; then scope_disp="under $under"; else scope_disp="everywhere"; fi
  local scope_err
  untrusted_var scope_err "$scope_disp" "" 2

  if [ "$sub" = add ]; then
    [ "$dup" -eq 0 ] || {
      # Two values, the key and its scope: each on a row of its own.
      refused "already granted"
      printf '        key:    %s\n        scope:  %s\n' "$key" "$scope_err" >&2
      echo "        a second identical entry would say nothing new; the entries are listed by: pinned ignorable list" >&2
      exit 1
    }
    new_json="$(jq -n --argjson e "$POL_USER" --argjson p "$path_json" --arg u "$under" \
      '$e + [ if $u == "" then {path: $p} else {path: $p, under: $u} end ]')" || exit 1
    if [ -n "$POL_MACHINE" ]; then
      covered="$(jq -n --argjson m "$POL_MACHINE" --argjson p "$path_json" --arg u "$under" \
        "$POLICY_JQ"'[ $m[]
                       | select(.path == $p
                                and covers_scope(.under; (if $u == "" then null else $u end))) ]
                     | length')" || exit 1
    fi
  else
    [ "$dup" -gt 0 ] || {
      refused "no such grant to withdraw"
      printf '        key:    %s\n        scope:  %s\n' "$key" "$scope_err" >&2
      echo "        remove takes the exact entry -- same key and same scope; the entries are" >&2
      echo "        listed by: pinned ignorable list" >&2
      exit 1
    }
    new_json="$(jq -n --argjson e "$POL_USER" --argjson p "$path_json" --arg u "$under" \
      '[ $e[] | select((.path == $p and ((.under // "") == $u)) | not) ]')" || exit 1
  fi

  # A grant the machine policy would not let take effect refuses under
  # --yes, before any row prints: rows are the record of an action that
  # goes ahead, and a refusal prints none.
  if [ "$sub" = add ] && [ "$covered" -eq 0 ] && [ "$yes" -eq 1 ]; then
    refused "the machine policy does not cover this scope: $PINNED_MACHINE_POLICY"
    printf '        key:    %s\n        scope:  %s\n' "$key" "$scope_err" >&2
    echo "        the grant would be recorded but not effective; widen the machine policy first," >&2
    echo "        or run it without --yes to record it anyway (see: pinned ignorable list)" >&2
    exit 1
  fi
  # The question block: the rows (a 13-column gutter, the widest label plus
  # two), the verdict on the machine tier, the consequence, the question --
  # which names its object by the key: row's label. The key and the scope
  # are the caller's own bytes: escaped, each on a row it ends.
  local key_disp json_disp scope_row
  untrusted_var key_disp "$key" "$C_CYN"
  untrusted_var json_disp "$path_json" "$C_DIM"
  untrusted_var scope_row "$scope_disp" "$C_CYN"
  printf '%starget:%s      %s\n' "$C_B" "$C_OFF" "$pf"
  printf '%skey:%s         %s%s%s\n' "$C_B" "$C_OFF" "$C_CYN" "$key_disp" "$C_OFF"
  printf '%sstored as:%s   %s%s%s\n' "$C_B" "$C_OFF" "$C_DIM" "$json_disp" "$C_OFF"
  printf '%sscope:%s       %s%s%s\n' "$C_B" "$C_OFF" "$C_CYN" "$scope_row" "$C_OFF"
  if [ "$sub" = add ]; then
    if [ "$covered" -eq 0 ]; then
      printf '%snote:%s        %sthe entry will be recorded but will not be effective, since the%s\n' \
        "$C_B" "$C_OFF" "$C_YEL" "$C_OFF"
      printf '             %smachine policy does not cover this scope: %s%s\n' \
        "$C_YEL" "$PINNED_MACHINE_POLICY" "$C_OFF"
    fi
    printf '%sReview --file may then declare this key ignored for paths in scope, and\n' "$C_DIM"
    printf 'verify answers 5 instead of 11 when only it drifts.%s\n' "$C_OFF"
  else
    printf '%sAny slot that records this key falls back to a byte-exact verdict (11) at\n' "$C_DIM"
    printf 'the very next verify, with no re-ceremony.%s\n' "$C_OFF"
  fi
  if [ "$yes" -eq 0 ]; then
    if [ "$sub" = add ]; then
      printf '%sgrant this key? [%sy%s/%sN%s]%s ' "$C_B" "$C_BLU" "$C_OFF$C_B" "$C_BLU" "$C_OFF$C_B" "$C_OFF"
    else
      printf '%swithdraw this key? [%sy%s/%sN%s]%s ' "$C_B" "$C_BLU" "$C_OFF$C_B" "$C_BLU" "$C_OFF$C_B" "$C_OFF"
    fi
    drain_tty
    read -r answer </dev/tty
    case "$answer" in
      y|Y|yes) ;;
      *) echo "aborted; policy unchanged"; log_action "ignorable-$sub" "$key" "" abort; exit 2 ;;
    esac
  fi
  write_note "$(policy_dir_for "$inv")" ignorable.json "$new_json"
  # The key ends the verdict; its scope names a value of its own, so it is
  # a dim line under the verdict, in its value column.
  untrusted_var scope_row "$scope_disp" "$C_DIM"
  if [ "$sub" = add ]; then
    printf '%s✓ granted:%s %s%s%s\n' "$C_GRN$C_B" "$C_OFF" "$C_CYN" "$key_disp" "$C_OFF"
    printf '           %s%s%s\n' "$C_DIM" "$scope_row" "$C_OFF"
  else
    printf '%s✓ withdrawn:%s %s%s%s\n' "$C_GRN$C_B" "$C_OFF" "$C_CYN" "$key_disp" "$C_OFF"
    printf '             %s%s%s\n' "$C_DIM" "$scope_row" "$C_OFF"
  fi
  log_action "ignorable-$sub" "$key" "${under:-everywhere}"
}

# One entry per line: dotted key, then the scope it is granted in.
policy_print_entries() { # $1 = a policy array
  local k sc
  if [ "$(printf '%s' "$1" | jq 'length')" -eq 0 ]; then
    printf '  %s(no entries)%s\n' "$C_DIM" "$C_OFF"
    return
  fi
  while IFS="$TAB" read -r k sc; do
    [ -n "$k" ] || continue
    case "$sc" in
      '*') printf '  %s%-24s%s everywhere\n' "$C_CYN" "$k" "$C_OFF" ;;
      *)   printf '  %s%-24s%s under %s\n' "$C_CYN" "$k" "$C_OFF" "$sc" ;;
    esac
  done <<EOF
$(printf '%s' "$1" | jq -r '.[] | (.path | join(".")) + "\t" + (.under // "*")')
EOF
}

# Both tiers AND the intersection, in one unprivileged command: "why was
# this key dropped" has to be answerable without reading two files by hand
# and doing the prefix arithmetic in your head.
do_ignorable_list() {
  local u="$1" pf mach_present=0 user_present=0
  pf="$(policy_dir_for "$u")/ignorable.json"
  [ -e "$PINNED_MACHINE_POLICY" ] && mach_present=1
  [ -e "$pf" ] && user_present=1
  load_policy "$u" || exit 1

  printf '%smachine tier:%s %s\n' "$C_B" "$C_OFF" "$PINNED_MACHINE_POLICY"
  if [ "$mach_present" -eq 0 ]; then
    printf '  %s(absent -- no machine constraint; the user tier stands alone)%s\n' "$C_DIM" "$C_OFF"
  else
    policy_print_entries "$POL_MACHINE"
  fi
  echo
  printf '%suser tier:%s    %s\n' "$C_B" "$C_OFF" "$pf"
  if [ "$user_present" -eq 0 ]; then
    printf '  %s(absent -- nothing is ignorable; every --ignore-json-key is refused)%s\n' "$C_DIM" "$C_OFF"
  else
    policy_print_entries "$POL_USER"
  fi
  echo
  printf '%seffective%s %s(machine intersect user -- what review and verify check)%s\n' \
    "$C_B" "$C_OFF" "$C_DIM" "$C_OFF"
  policy_print_entries "$POL_EFF"
}

case "$action" in
  review)    do_approve "$@" ;;
  tombstone) do_tombstone "$@" ;;
  rekey)     do_rekey "$@" ;;
  declare)   do_declare "$@" ;;
  verify)    do_verify "$@" ;;
  cat)       do_cat "$@" ;;
  rev)       do_rev "$@" ;;
  words)     do_words "$@" ;;
  sign)      do_sign "$@" ;;
  signer)    do_signer "$@" ;;
  ignorable) do_ignorable "$@" ;;
  status)    do_status "$@" ;;
  list)      do_list "$@" ;;
  slot)      do_slot "$@" ;;
  show)      do_show "$@" ;;
  diff)      do_diff "$@" ;;
  *)         usage ;;
esac
