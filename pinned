# <full commit id, lowercase hex> -> the six words, space-separated.
# Fails on anything shorter than a SHA-1 id or not plain hex: a short id is
# exactly what the words must never stand for.
commit_words() {
  local id="$1" acc=0 nbits=0 i=0 out=""
  case "$id" in ''|*[!0-9a-f]*) return 1 ;; esac
  [ "${#id}" -ge 40 ] || return 1
  if [ "${#PINNED_WORDS[@]}" -ne 2048 ]; then
    echo "pinned: internal error -- the word list holds ${#PINNED_WORDS[@]} words, not 2048" >&2
    return 1
  fi
  local n=0
  while [ "$n" -lt 6 ]; do
    acc=$(( (acc << 4) | 16#${id:i:1} ))
    nbits=$((nbits + 4)) i=$((i + 1))
    if [ "$nbits" -ge 11 ]; then
      nbits=$((nbits - 11))
      out="${out:+$out }${PINNED_WORDS[$(( (acc >> nbits) & 2047 ))]}"
      acc=$(( acc & ((1 << nbits) - 1) ))
      n=$((n + 1))
    fi
  done
  printf '%s\n' "$out"
}

# <six words> -> the `words:` row, two groups of three.
print_words_row() {
  local w i=0 row=""
  for w in $1; do
    i=$((i + 1))
    case "$i" in
      1) row="$w" ;;
      4) row="$row  $w" ;;
      *) row="$row $w" ;;
    esac
  done
  printf '%swords:%s      %s\n' "$C_DIM" "$C_OFF" "$row"
}

# <word> -> 0 when it is one word of the list, lowercase as the list is.
is_list_word() {
  case "$1" in ''|*[!a-z]*) return 1 ;; esac
  case " ${PINNED_WORDS[*]} " in *" $1 "*) return 0 ;; esac
  return 1
}

# <--words argument> -> 0 when it is six list words joined by single
# hyphens, the one spelling the root side compares against. Shape only:
# whether they are THIS commit's words is the root side's question.
valid_words_arg() {
  local w ws
  case "$1" in ''|-*|*-|*--*) return 1 ;; esac
  # IFS for the read alone: is_list_word joins the list on IFS.
  IFS=- read -r -a ws <<<"$1"
  [ "${#ws[@]}" -eq 6 ] || return 1
  for w in "${ws[@]}"; do
    is_list_word "$w" || return 1
  done
}

# <--commits argument> -> 0 when it is a count of one or more in plain
# decimal, no leading zero: the spelling the sudo dialog shows is the number
# the root side compares. Shape only, like valid_words_arg.
valid_commits_arg() {
  case "$1" in ''|0*|*[!0-9]*) return 1 ;; esac
  [ "${#1}" -le 6 ]
}

# The --commits refusal, one sentence for both sides of the seam.
# $1 = commits since the pin, $2 = the count --commits stated.
refuse_commits_count() {
  refused "the range since the pin holds $1 commit$(plural_s "$1"), not the $2 --commits states; pin unchanged"
}

