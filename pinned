#!/bin/bash
# pinned -- review-and-pin a git rev behind a human gate.
#
#   pinned review <repo> [--tag <t>] [--trust] [--backward|--diverged]
#                                              review diff since last pin -> approve -> pin
#                                              (--tag: at the tag's commit, not HEAD;
#                                              --trust: skip a FIRST approval's
#                                              full-tree review, loudly;
#                                              --backward/--diverged: declare a pin
#                                              move that is not forward over the
#                                              commit graph -- reality must conform)
#   pinned review <repo> --signed-tag <t> [--signed-tag ..] [--tag <t>]
#                                              verify each signed tag -> approve -> pin
#                                              (repeat --signed-tag = threshold
#                                              multisig: all must agree on one commit;
#                                              --tag: an unsigned name that must agree)
#   pinned review --file <path> ...          file-pin ceremony: frozen display
#                                             root-side -> confirm -> record hash
#                                             (--ignore-json-key <key>: keys
#                                             whose later drift needs no ceremony)
#   pinned verify <path>                      consumer verdict for file pins
#                                             (--emit / --frozen for parsers)
#   pinned cat <path>                         the approved bytes from root
#                                             custody, re-hashed against the
#                                             record before a byte is emitted
#   pinned tombstone <path>                   retire a pinned file that is GONE
#   pinned mv <old> <new>                     re-key a record to the path its
#                                             content MOVED to (rev/digest and
#                                             annotations travel verbatim; the
#                                             content at <new> must answer to
#                                             the record, and <old> is
#                                             tombstoned)
#   pinned sign <repo> <tag>                  signed release tag at the pinned hash
#   pinned signer add|list|remove             allowed-signers ceremony
#   pinned ignorable add|remove|list          which keys a ceremony may declare
#                                             ignored, and where (the policy)
#   pinned status <repo|file>                 record vs live state
#   pinned add <repo|url>                     checkout (clone if a url) ->
#                                             review -> declare the repo as
#                                             a git+file input of the system
#                                             flake (--input <name>,
#                                             --signed-tag <t> for the
#                                             signature gate); every part is
#                                             skipped when already satisfied
#   pinned deploy [--dry-run]                 sync flake inputs to approved revs, rebuild
#   pinned setup [--yes]                      provision sudoers digest pin; self-install
#
# review, add, setup, tombstone, mv, signer add/remove and ignorable
# add/remove self-elevate via sudo (re-exec of the installed root-owned
# binary); sign runs as the user because it needs the SSH agent.
#
# review runs root-owned code end to end: it resolves the rev to a hash, shows
# the diff from the OBJECT STORE (scrubbed env, no user git config, no pager,
# no hooks), and writes the approved hash to a root-owned pin file. Deploy
# tooling builds git+file://<repo>?rev=<hash> and nothing else. The hash never
# crosses a trust boundary in human hands.
#
# Signing exports the pin: sign creates a perfectly normal signed release
# tag (git tag -s, nothing pinned-specific in the repo), but the hash it
# signs comes from the root-owned pin file -- you read once at review;
# nothing is re-read at sign time, so there is nothing to MITM. review
# --signed-tag verifies such a tag against root-owned allowed signers
# (per-slot signers/allowed_signers first, the user tier's
# policy/allowed_signers as fallback; git's native format) -- that is the
# second-machine bootstrap: clone anywhere, install the signer key once
# (pinned signer add), approve the release. upgrade OFFERS that gate: a
# stale repo whose newer release verifies against the installed signers is
# routed to the signature ceremony instead of a review, and that ceremony's
# own y/N is the offer's acceptance.
#
# THE ANCESTRY LATTICE. Every ceremony that MOVES a pin first asks which
# way it is moving, over the commit graph and never by parsing a version
# string: equal (a no-op), forward (the candidate descends from the pin),
# backward (the candidate is an ancestor -- commits are being UN-approved)
# or diverged (neither -- the pinned line is being abandoned). Forward
# proceeds; backward and diverged refuse unless the human DECLARES them
# (--backward / --diverged), and a declaration that reality contradicts
# refuses too, naming the class that actually holds. Declared, never
# inferred. upgrade's automatic ceremonies never cover anything but forward
# repos; the lattice governs ceremonies only -- verify and deploy answer
# about a recorded pin and are untouched by it.
#
# Storage: /var/db/pinned/<user>/ -- two root-owned wrapper dirs:
#   slots/<encoded-path>/  one SLOT DIRECTORY per pinned path, holding
#                          exactly one of rev.<vcs> (repo pin), pin.<algo>
#                          (file pin) or tombstone, plus optional
#                          annotations (tag, ignored.<format>, approved,
#                          signers/allowed_signers)
#   policy/                what this tier is ALLOWED to record:
#                          allowed_signers (who may vouch) and
#                          ignorable.json (which keys a ceremony may
#                          declare ignored, and where)
# The root-owned record DECLARES (which VCS, which algorithm, which key
# format); the live world must CONFORM; anything undeclared REFUSES.
# Consumers that want a friendly path point a root-owned symlink at the
# slot dir, e.g.
#   ln -s "$(pinned slot /path/to/repo)" /etc/nix-darwin/pinned-rev
#
# THE RECORD AND ITS WITNESSES. Two kinds of thing live in a file slot, and
# keeping them apart is the whole model.
#
# The RECORD is what was approved: a digest (pin.<algo>) plus the ceremony's
# declarations (`ignored.json`, `tag`). Root-owned, one shape always, and the
# ONLY trust anchor -- nothing else in this tool authorizes anything.
#
# A WITNESS is any bytes that re-hash to the record's digest. Witnesses are
# EVIDENCE, never authority: every reader authenticates a witness against the
# record before using it, so where a witness was stored, and whose hands
# carried it there, cannot affect a verdict. Two arrive by different roads
# and are otherwise the same kind of thing: the slot's own `approved` copy
# (root custody, written when the ceremony was asked for it -- see --store)
# and a caller-brought copy (`verify --baseline <copy>`).
#
# A witness can only ever NARROW a comparison -- enable the ignored-key
# projection, feed the ceremony's baseline diff -- and never stand in for the
# live file: a pinned file that is MISSING is exit 20 no matter how many
# witnesses agree on what it used to say. A forged witness fails its re-hash,
# and the verdict falls back to the stricter one.
#
# IGNORED KEYS: a file slot may additionally declare `ignored.json` (a JSON
# array of jq key paths, e.g. [["model"],["statusLine","command"]]) --
# written ONLY by the review ceremony. The PIN stays byte-exact -- `shasum
# -c pin.sha256` still verifies -- and ignoring is a VERIFY-side tolerance:
# when the live bytes differ, verify may compare the live side against a
# witness with those keys projected out and answer 5 instead of 11. Every
# step of that path fails CLOSED to the stricter verdict.
#
# CUSTODY IS OPT-IN (--store). A stored witness serves three jobs -- the
# tolerant comparison, an archive of exactly what was approved, and the
# display of what changed -- but it also turns a slot that discloses one
# digest into one that discloses the file's whole CONTENT. Disclosure is
# bounded: the host tier is 0750 root:_<user>-pinned, and a lane receives a
# launch-time payload of only the slot dirs it is measured against, whose
# files the lane already reads through its own mounts. Bounded is not
# nothing, though, so it stays a per-slot human decision, re-stated by every
# ceremony exactly like `tag`: a review without --store DROPS a copy the
# slot holds today, loudly. `pinned cat` is custody's verified reader --
# consumers must never open a slot file directly.
#
# THE IGNORABLE LADDER. What a slot may declare is itself gated, by two
# root-owned policy tiers, and every rung is checked at review AND at
# verify -- narrowing the policy bites at the next verify, with no
# re-ceremony:
#
#   machine policy   >=  user policy      >=  slot declaration  >=  drift
#   /etc/pinned/         <user>/policy/       slots/<enc>/          tolerated
#   ignorable.json       ignorable.json       ignored.json          by verify
#
# The machine tier is OPTIONAL (absent = no machine constraint); the user
# tier is the operative allow-list (absent or empty = nothing is ignorable,
# fail closed). Both are arrays of {"path":[...],"under":"/abs/prefix"}
# entries whose "under" is optional and means everywhere when omitted.

# Pin PATH to root-owned directories only, before anything runs. This is the
# ONE place trust in command resolution is established: everything below calls
# tools by bare name, and this line is what makes that safe. Keeping it in a
# single auditable place beats scattering absolute paths, which only restate
# the same fact once per call site.
#
# Only the OS's own root-owned directories belong here. A packaging that
# installs pinned alongside its own root-owned toolchain (the nix module does)
# prepends its prefix by rewriting this line at build time -- the package
# manager knows its trusted prefix; this script does not guess at them. NOTE
# what must NEVER be added: ~/.nix-profile, ~/.local/bin, /opt/homebrew/bin and
# friends are user-writable, which is exactly why an inherited PATH cannot be
# trusted even from a session you trust.
#
# The shebang on line 1 is the same rule applied one step earlier, and it is
# why it names an interpreter absolutely instead of going through env: this
# script self-elevates by re-exec'ing itself under sudo, sudo passes the
# caller's PATH through to the root process (probed live 2026-08-06), and env
# would resolve root's interpreter from that PATH before a single line here
# runs -- the PATH pin below cannot defend a decision already made above it.
# /bin/bash is root-owned on stock macOS (SIP-sealed; version 3.2, which is
# this script's compatibility floor) and on stock Linux. A packaging that
# owns a root-owned prefix rewrites line 1 the same way it rewrites this
# one: the nix module points it at the store bash, because NixOS has no
# /bin/bash -- run a checkout there as `bash ./pinned`.
export PATH=/usr/bin:/bin:/usr/sbin:/sbin

set -euo pipefail

# Where this script installs itself. Override-friendly (handy for testing);
# a packaging that owns its own prefix rewrites this line at build time.
: "${INSTALL_TARGET:=/usr/local/sbin/pinned}"

# Where trust state lives. A COMPILE-TIME CONSTANT, not an environment
# default: nothing in the environment can re-point where pinned reads or
# writes the records its verdicts rest on. No knob beats a guarded knob.
# The test harness rewrites this exact line in its sed-stubbed copy, so keep
# it on one line in this shape.
PINNED_ROOT=/var/db/pinned

# Where `add` clones a repo named by url. A compile-time constant for the
# same reason as PINNED_ROOT, and ONE literal spelling on both platforms
# (the records already chose one spelling over per-platform FHS purity, and
# a misported second name would silently give a machine two clone trees).
# The tree is root-owned and provisioned at the first `add` -- deliberately
# not by the nix module, so a manual install lands on the same path.
# The harness rewrites this exact line too.
PINNED_CLONES=/var/db/pinned-clones

# The operators group of that tree: everyone allowed to fetch into the
# shared clones. CONSUMED, never created -- the system configuration
# provisions it (nix/module.nix declares it on both platforms), and its
# absence degrades to a clone owned by the invoker (see do_add): content
# addressing gates trust, ownership only decides who may update, so
# availability wins here -- unlike the record tree, where absence fails
# closed to root-only.
PINNED_CLONES_GROUP=_pinned-clones

# The OPTIONAL machine tier of the ignorable policy. Absent = no machine
# constraint (the user tier stands alone); the FILE is the interface, so a
# configuration manager can declare it (nix: environment.etc) without this
# script knowing anything about the tool that wrote it. A constant for the
# same reason as PINNED_ROOT, and one more: a value aimed at nothing would
# drop the machine rung silently, and dropping a rung WIDENS what verify
# tolerates. The harness rewrites this exact line too.
PINNED_MACHINE_POLICY=/etc/pinned/ignorable.json

# Colour only when stdout is a terminal (piping/redirecting stays clean).
if [ -t 1 ]; then
  C_OFF=$'\033[0m' C_B=$'\033[1m' C_DIM=$'\033[2m'
  C_RED=$'\033[31m' C_GRN=$'\033[32m' C_YEL=$'\033[33m' C_CYN=$'\033[36m'
  # Reserved for repo identity: cyan is the workhorse accent, so the repo
  # under review gets a color nothing else uses.
  C_MAG=$'\033[35m'
  DIFF_COLOR=always
else
  C_OFF='' C_B='' C_DIM='' C_RED='' C_GRN='' C_YEL='' C_CYN='' C_MAG=''
  DIFF_COLOR=never
fi
NL=$'\n' TAB=$'\t'

# Separate gate for the two review-display highlighters ported from the
# hardening repo's claude-shim.bash (color_diff, highlight_json): they keep
# their origin's condition -- a tty AND no NO_COLOR (https://no-color.org).
# pinned's palette above predates that and is tty-gated only, so this is
# deliberately not folded into it: with NO_COLOR set, the reviewed content
# stays byte-for-byte what it was before those two existed.
if [ -n "$C_OFF" ] && [ -z "${NO_COLOR:-}" ]; then HL_ON=1; else HL_ON=''; fi

# What setup would do -- shown BEFORE any sudo prompt, so nobody has to
# authenticate just to read the plan. $1 = the user the sudoers entry names.
setup_plan() {
  cat <<EOF
${C_B}pinned setup will:${C_OFF}

  ${C_B}1.${C_OFF} install this script to ${C_CYN}$INSTALL_TARGET${C_OFF} ${C_DIM}(root:wheel 755)${C_OFF}
  ${C_B}2.${C_OFF} create ${C_CYN}$PINNED_ROOT/${1}${C_OFF} for root-owned pin slots
  ${C_B}3.${C_OFF} write ${C_CYN}/etc/sudoers.d/pinned${C_OFF} granting ${C_B}${1}${C_OFF} sudo for the binary,
     digest-pinned to its sha256 ${C_DIM}(a swapped binary makes sudo refuse)${C_OFF};
     ${C_YEL}no NOPASSWD${C_OFF} -- sudo still authenticates every invocation

If a package manager or configuration-management tool installs pinned
for you, you may prefer declaring the binary and sudoers entry there
instead of running setup: see ${C_CYN}README, "Declarative install"${C_OFF}
${C_DIM}(this repo ships a Nix flake)${C_OFF} -- review works pre-install,
so setup is not required on such machines.

${C_DIM}The exception: when pinned will gate that configuration's own deploys,
its first install cannot arrive through a deploy it hasn't gated yet --
reading this script once and running setup by hand is the intended
bootstrap in that case.${C_OFF}
EOF
}

usage() {
  cat >&2 <<EOF
usage: pinned <action> [args]

  review <repo>... [options]     (sudo) review the diff since the last pin, write pin
  review --file <path> ...       (sudo) file-pin ceremony: freeze, review, record hash
  tombstone <path>               (sudo) retire a pinned file that is gone
  mv <old> <new>                 (sudo) re-key a record to a moved path
  verify [options] <path>        file-pin verdict; quiet exit-code contract for gates
  cat <path>                     the approved bytes, from root custody; fail-closed
  sign <repo> <tag>              create a signed tag at the pinned hash
  signer add|remove|list ...     (sudo) allowed-signers ceremonies
  ignorable add|remove|list ...  (sudo) ignorable-JSON-key grants
  status <repo|file>             record vs live state
  show <file|repo> [options]     trusted re-display; files get hash + wrapper
  list [--under <dir>]           live pins in your tier
  slot <path>                    print the slot directory for a path
  add <repo|url> [options]       (sudo) clone if needed, review, declare as a flake input
  deploy [--dry-run] [--yes]     sync system flake inputs to approved revs, rebuild
  upgrade [--dry-run] [--yes]    (sudo) review every stale flake input, then deploy
  setup [--yes]                  (sudo) provision sudoers digest pin; self-install

full options, exit codes, and the contract: man pinned
approval history: log show --predicate 'eventMessage CONTAINS "pinned:"'
EOF
  exit 1
}

[ $# -ge 1 ] || usage
action="$1"
shift

# ---- shared verification (locked-family pattern) ---------------------------
# Defined before the self-elevation block below, which is the first caller.

# stat differs by FLAVOR, not platform convention: BSD stat takes -f FORMAT
# while GNU's -f means file-system (its FORMAT flag is -c). Detect once from
# whichever stat the trusted PATH resolves -- a nix-built install puts GNU
# coreutils first even on macOS, and NixOS has no BSD stat at all. GNU %a
# prints special bits (setuid/sticky) as a fourth digit where BSD %OLp shows
# low bits only; such a path fails the mode allowlist below, i.e. the
# asymmetry fails closed.
#
# -L: judge the object a name REACHES, never a symlink itself. A symlink's
# own owner/group gate nothing -- replacing one takes write on its parent
# dir, which the ancestry walk already checks -- and BSD symlinks inherit
# their parent's group, so an unfollowed stat reports noise (nix-darwin's
# /run/current-system link shows root:daemon purely because /private/var/run
# is group daemon).
if stat --version >/dev/null 2>&1; then
  stat_owner() { stat -Lc '%U:%G' "$1"; }
  stat_mode()  { stat -Lc '%a' "$1"; }
else
  stat_owner() { stat -Lf '%Su:%Sg' "$1"; }
  stat_mode()  { stat -Lf '%OLp' "$1"; }
fi

# Verify a path is root-owned with no group/other write. Refuses to trust
# binaries or pin state reachable through a user-writable ancestor. The
# OWNER must be root; the GROUP may be anything, because every mode the
# allowlist admits denies group write -- group identity carries no write
# authority (this is what lets the per-user pin tree run 0750
# root:_<user>-pinned for group READ without weakening the walk).
#
# One carved-out exception: macOS's /run resolves to /private/var/run,
# root:daemon 775 -- the OS's own home for the /run/current-system link, so
# a nix-darwin install walks through it. Group daemon COULD swap links
# there, but daemon-gid actors are system services, not code running as the
# user -- outside this tool's threat model (user-level compromise) -- and
# elevation is content-gated by the sudoers sha256 digest regardless of
# which bytes a path reaches: a swapped binary makes sudo refuse.
verify_root_owned_path() {
  local path="$1" owner mode
  owner="$(stat_owner "$path")"
  mode="$(stat_mode "$path")"
  case "$owner" in
    root:daemon)
      case "$mode" in
        775|755|750|700|555|550|500) return 0 ;;
      esac
      echo "ERROR: $path (root:daemon) has mode $mode, expected 775 or stricter" >&2
      return 1 ;;
    root:*) ;;
    *)
      echo "ERROR: $path is owned $owner, expected owner root" >&2
      echo "       fix manually: sudo chown root:wheel $path && sudo chmod 755 $path" >&2
      return 1 ;;
  esac
  case "$mode" in
    755|750|700|555|550|500) ;;
    *)
      echo "ERROR: $path has mode $mode, expected 755 or stricter" >&2
      return 1
      ;;
  esac
}

# The record-file variant: a slot's state file is authoritative only if
# root wrote it and nothing non-root can rewrite it -- owner root, no
# group/other write bit. (Directory modes go through
# verify_root_owned_path; this one admits plain-file modes like 640.)
verify_record_file() {
  local f="$1" owner mode
  owner="$(stat_owner "$f")" || return 1
  case "$owner" in
    root:*) ;;
    *)
      echo "ERROR: record $f is owned $owner, expected owner root" >&2
      return 1 ;;
  esac
  mode="$(stat_mode "$f")"
  case "$mode" in
    *[2367]?|*[2367])
      echo "ERROR: record $f has mode $mode (group/other-writable); refusing" >&2
      return 1 ;;
  esac
}

verify_ancestry() {
  # Walk ancestry of a path (itself excluded) up to /, verify each dir.
  local p
  p="$(dirname "$1")"
  while [ "$p" != "/" ]; do
    verify_root_owned_path "$p" || return 1
    p="$(dirname "$p")"
  done
}

# The interpreter of the installed script must be PINNED in its shebang, not
# resolved at exec time. sudo passes the caller's PATH through to the root
# process (probed live 2026-08-06: `sudo printenv PATH` returned the
# invoker's complete PATH), and a `/usr/bin/env bash` shebang resolves bash
# from that PATH before a single line of this script runs -- so a user-writable
# prefix ahead of the system dirs (/opt/homebrew/bin on an ARM Mac, say)
# supplies the interpreter that then executes as root. The sudoers
# Digest_Spec pins THIS FILE's bytes and says nothing about the interpreter,
# so the digest does not notice.
#
# Line 1 of this file already names /bin/bash, so a verbatim install passes
# this check without anyone doing anything -- the guard is belt and braces
# for the installs that did not come from a verbatim copy: one made before
# the shebang was pinned, or one whose first line was hand-edited.
#
# A provisioning-time guard is all this can be, and it is enough to be worth
# writing: it cannot defend against an interpreter that has ALREADY been
# substituted (that interpreter runs our code and owes us nothing), it
# catches an install carrying an unpinned interpreter while the machine is
# still honest -- before the sudoers grant makes the gap reachable.
verify_interpreter_pin() { # <installed-script>
  local f="$1" line interp why=""
  if [ ! -f "$f" ]; then
    echo "ERROR: $f is not a regular file; cannot read its interpreter" >&2
    return 1
  fi
  IFS= read -r line <"$f" || line=""
  # First token after the #!, with tabs and leading blanks out of the way.
  interp=""
  case "$line" in
    '#!'*)
      interp="${line#\#!}"
      interp="${interp//"$TAB"/ }"
      while [ "${interp# }" != "$interp" ]; do interp="${interp# }"; done
      interp="${interp%% *}" ;;
  esac
  if [ -z "$interp" ]; then
    why="$f has no shebang, so its interpreter is whatever executes it"
  else
    case "$interp" in
      */env|env)
        why="$f runs under an env shebang: $line" ;;
      /*)
        verify_root_owned_path "$interp" \
          || why="$f names an interpreter that is not root-owned: $interp" ;;
      *)
        why="$f names a relative interpreter: $line" ;;
    esac
  fi
  [ -n "$why" ] || return 0
  echo "REFUSE: $why" >&2
  echo "        The sudoers digest pins this script's bytes, not its interpreter, and" >&2
  echo "        sudo passes the caller's PATH through to the root process. An" >&2
  echo "        unpinned interpreter therefore lets the invoker choose which bash" >&2
  echo "        runs as root, and the digest cannot see it." >&2
  echo "        Reinstall from a current checkout -- its first line already names an" >&2
  echo "        absolute interpreter -- or edit this install's first line to a" >&2
  echo "        root-owned absolute path, then rerun setup. See README," >&2
  echo "        \"Bootstrap without executing unverified code\"." >&2
  return 1
}

# FROZEN VOCABULARY. The action tags below are an append-only audit trail's
# nouns, not UI copy: renaming one when a verb is renamed splits the history
# into eras that no single query spans. The log already carries one such
# scar (the display verb logged action=review before 2026-08-13 and
# action=show after), which is why the ceremony tags stayed approve and
# approve-file through the approve->review rename. The harness pins the set.
log_action() {
  # visible via: log show --predicate 'eventMessage CONTAINS "pinned:"' --last 1d
  logger -t pinned "user=${inv:-$(id -un)} action=$1 repo=${2:-} hash=${3:-} result=${4:-ok}"
}

# Root ceremonies share one entry check: really root, really via sudo
# (the human behind the ceremony is $SUDO_USER, recorded as $inv).
require_root() {
  [ "$EUID" -eq 0 ] || { echo "$1 must run as root (sudo pinned $1 ...)" >&2; exit 1; }
  inv="${SUDO_USER:-}"
  [ -n "$inv" ] || { echo "$1 must be invoked via sudo" >&2; exit 1; }
}

# ---- scrubbed git ----------------------------------------------------------

# git resolved from the pinned PATH above (root-owned dirs only), so a
# user-writable prefix can never shadow it. Fail loud up front rather than
# confusingly mid-ceremony. If your trusted git lives outside those dirs, edit
# the PATH line BEFORE bootstrapping: this hand-read file is the configuration
# surface (declarative installs substitute it at build time instead).
command -v git >/dev/null 2>&1 || {
  echo "ERROR: no git in the trusted PATH ($PATH)" >&2
  echo "       install git system-wide; pinned will not use a user-writable one" >&2
  exit 1
}

# Run git against $repo with NOTHING attacker-influencable in play:
# env -i (no GIT_* smuggling), no global/system config, repo-local config
# neutralized where it matters (-c overrides, no pager, no fsmonitor daemon).
# show/diff/rev-parse/log run no hooks; aliases can't shadow builtins.
# Trusted pager for review output: absolute system less, -R passes the
# diff colors through, -F quits immediately when the content already fits
# one screen -- so a short diff stays on the normal screen (nothing to
# page, nothing to dismiss) while long content still gets the alternate
# screen and real scrollback. No -X: the alternate screen is wanted.
# cat when non-interactive or less is absent. Never $PAGER/user config --
# the pager sits between reviewed bytes and eyes.
page() {
  if [ -t 1 ] && command -v less >/dev/null 2>&1; then
    less -RF
  else
    cat
  fi
}

# The root-side ceremony announces itself: everything below this line is
# pinned's own authoritative display, not a caller's orientation preview.
# Printed only after the self-elevation, never in the pre-sudo handoff, and
# with NO leading blank -- a direct `pinned review` must not open with a
# stray empty line, so the separator before the handoff belongs to whoever
# called us (see the hardening shim's claude wrapper).
ceremony_banner() {
  printf '%s=== pinned: review (authoritative) ===%s\n' "$C_B" "$C_OFF"
}

# ---- review-display highlighters -------------------------------------------
#
# Both began as ports of the orientation renderers in the hardening repo's
# nix/claude-shim.bash. Only highlight_json still has a counterpart there
# (the shim's preview became a drift index and dropped its diff colourer),
# so this pair is now the authoritative one -- the family resemblance is
# history, not a contract. Two deliberate deviations from the originals,
# both about byte fidelity in a display that a trust decision is made from:
#   * stdin instead of a file argument, so the `show` verb can colour the
#     ONE buffer it read rather than taking a second look at the file;
#   * LC_ALL=C, so awk indexes bytes and an invalid multibyte sequence
#     survives the round trip unchanged.
# They decorate; they never transform. Colour off (not a tty, or NO_COLOR)
# means byte-identical passthrough.

# Colorized unified diff. Colour is applied per line-prefix, never inside a
# line, so the bytes stay greppable; $0 is reprinted verbatim.
color_diff() {
  if [ -n "$HL_ON" ]; then
    LC_ALL=C awk -v R=$'\033[31m' -v G=$'\033[32m' -v C=$'\033[1;36m' -v B=$'\033[1m' -v O=$'\033[0m' '
      /^(\+\+\+|---) / { print B $0 O; next }
      /^@@/            { print C $0 O; next }
      /^\+/            { print G $0 O; next }
      /^-/             { print R $0 O; next }
                       { print }
    '
  else
    cat
  fi
}

# Display-only shape line for a captured diff: hunk count and +/- line counts,
# so a trimmed-context view still states how many places changed. Read from the
# SAME buffer that is about to be shown, and structurally unable to change it --
# every changed line prints regardless of this count. The "---"/"+++" header
# lines are excluded; a removed line whose own text starts with "--" collides
# with that prefix and is undercounted (cosmetic, same as color_diff's).
diff_shape() {
  LC_ALL=C awk '
    /^@@/     { h++; next }
    /^\+\+\+/ { next }
    /^---/    { next }
    /^\+/     { a++; next }
    /^-/      { d++; next }
    END { printf "%d hunks, +%d/-%d lines\n", h+0, a+0, d+0 }'
}

# Byte-preserving JSON syntax highlighter. It inserts ANSI ONLY between the
# content's original characters -- it never reindents, reorders, or reparses
# -- so what is displayed is EXACTLY what is hashed. (A trust prompt must not
# pretty-print: jq -C would collapse duplicate keys, drop trailing junk, and
# normalise escapes, hiding exactly the tricks a hostile settings file might
# use.) Colouring is best-effort per line -- a malformed token only
# mis-colours; the text stays byte-exact. Strings are assumed single-line
# (true for JSON, which escapes newlines as \n), so it scans line-by-line.
highlight_json() {
  if [ -z "$HL_ON" ] || ! command -v awk >/dev/null 2>&1; then
    cat; return
  fi
  LC_ALL=C awk -v K=$'\033[1;36m' -v S=$'\033[0;32m' -v N=$'\033[0;33m' \
      -v L=$'\033[1;35m' -v P=$'\033[2m' -v O=$'\033[0m' '
    {
      line = $0; n = length(line); i = 1; out = ""
      while (i <= n) {
        c = substr(line, i, 1)
        if (c == "\"") {                                  # string -> key if a : follows
          s = c; i++
          while (i <= n) {
            d = substr(line, i, 1); s = s d; i++
            if (d == "\\") { s = s substr(line, i, 1); i++; continue }
            if (d == "\"") break
          }
          j = i
          while (j <= n && substr(line, j, 1) ~ /[ \t]/) j++
          if (substr(line, j, 1) == ":") out = out K s O; else out = out S s O
        }
        else if (c ~ /[-0-9]/) {                          # number
          t = c; i++
          while (i <= n && substr(line, i, 1) ~ /[-+0-9.eE]/) { t = t substr(line, i, 1); i++ }
          out = out N t O
        }
        else if (substr(line, i, 4) == "true" || substr(line, i, 4) == "null") { out = out L substr(line, i, 4) O; i += 4 }
        else if (substr(line, i, 5) == "false") { out = out L "false" O; i += 5 }
        else if (c ~ /[][{}:,]/) { out = out P c O; i++ } # punctuation
        else { out = out c; i++ }                         # whitespace / other
      }
      print out
    }
  '
}

# May this content be routed through highlight_json? Decoration only: a "no"
# shows the raw bytes, exactly as before these functions existed. Both guards
# are about fidelity, not taste:
#   * it must parse as JSON -- the same test the shim's preview uses to decide
#     a file is JSON, and jq also rejects raw NUL bytes, which awk would
#     silently drop from the display;
#   * its last byte must be a newline, because awk terminates a final line
#     that lacks one, and this display may not invent a byte.
# The newline is the caller's to report ($1): checking it here would need a
# second pass over the same stdin. jq absent from the trusted PATH -> no
# colour, never a guess.
# $1 = 1 when the content ends in a newline; stdin = the exact bytes.
highlight_json_ok() {
  [ -n "$HL_ON" ] || return 1
  [ "${1:-}" = 1 ] || return 1
  command -v jq >/dev/null 2>&1 || return 1
  jq -e . >/dev/null 2>&1
}

# Review diff. NEVER call `sgit diff` directly for anything a human reads:
# .gitattributes (attacker-writable, and it works UNTRACKED -- no commit, no
# trace in the reviewed content) can route a path through an external diff
# driver (diff.<n>.command) or a textconv filter (diff.<n>.textconv) defined in
# the repo-local .git/config, which is equally attacker-writable. env -i and
# GIT_CONFIG_{GLOBAL,SYSTEM}=/dev/null do NOT stop this -- the drivers come
# from repo-local config, not global/system config or the environment. A
# textconv that maps both sides to one constant renders as an EMPTY diff:
# "this commit changed nothing", for a commit that changed everything.
# --no-ext-diff --no-textconv is the only thing that closes it.
# Measured 2026-07-27 on git 2.54.0; harness + evidence in the hardening repo:
# proofs/claims/git/git-diff-display-falsifiable-by-repo-drivers.md
# The ONLY way to diff in this script. Always carries the hardening flags, so
# a future edit cannot reintroduce a falsifiable review by writing the obvious
# thing; `sgit diff` itself is refused below.
sgit_diff() {
  _sgit_diff_ok=1 sgit -c color.diff="$DIFF_COLOR" diff --no-ext-diff --no-textconv "$@"
}

sgit() {
  # Structural guard: any diff a human might read must carry --no-ext-diff
  # --no-textconv, so reaching for a rendering subcommand here is a bug, not a
  # style choice. Refuse loudly instead of silently rendering through an
  # attacker's driver. Git offers no config switch that disables textconv
  # globally, so per-command flags are the only mechanism -- which is exactly
  # why it needs a guard rather than a convention. (The subcommand is found by
  # scanning past leading global options, since `-c key=val` precedes it.)
  if [ "${_sgit_diff_ok:-0}" -ne 1 ]; then
    local _args _i=0 _sub="" _a
    _args=("$@")
    while [ "$_i" -lt "${#_args[@]}" ]; do   # find the subcommand
      case "${_args[$_i]}" in
        -c) _i=$((_i + 2)) ;;               # -c takes a value; skip both
        --*) _i=$((_i + 1)) ;;
        *) _sub="${_args[$_i]}"; break ;;
      esac
    done
    case "$_sub" in
      # Every subcommand that can RENDER a diff, not just `diff` -- `show` and
      # `log -p` route through the same attacker-controlled drivers. Refusing
      # the whole class means a future edit reaching for any of them has to
      # add a hardened helper rather than silently reopening the hole.
      diff|show|format-patch|diff-tree|diff-index|diff-files|whatchanged|range-diff)
        echo "pinned: internal error -- '$_sub' can render through repo diff drivers; use sgit_diff" >&2
        exit 1 ;;
      log|reflog|stash)
        # Scan only AFTER the subcommand: a leading global `-c key=val` is not
        # log's combined-diff `-c`.
        _i=$((_i + 1))
        while [ "$_i" -lt "${#_args[@]}" ]; do
          _a="${_args[$_i]}"; _i=$((_i + 1))
          case "$_a" in
            -p|-u|--patch|--cc|-c|--full-diff)
              echo "pinned: internal error -- patch-producing '$_sub' renders through repo diff drivers; use sgit_diff" >&2
              exit 1 ;;
          esac
        done ;;
    esac
  fi
  # safe.directory: running as root on a user-owned repo trips git's
  # ownership check, and env -i strips the SUDO_UID escape hatch git
  # would use. Trust exactly $repo, from the command line (protected
  # config). The check's job -- refusing attacker-planted repo config
  # and hooks -- is already done here by scrubbing and hookless commands.
  # attr.tree=<empty tree>: attributes come from an EMPTY tree instead of the
  # working tree, so no .gitattributes -- committed or untracked -- can select a
  # diff driver, textconv filter, or clean/smudge filter for ANY subcommand.
  # This is the only repo-wide switch that exists (there is no config that
  # disables textconv globally), so it is the primary defense; the per-command
  # --no-ext-diff --no-textconv in sgit_diff and the render guard above are the
  # second and third layers. Silently ignored by git older than ~2.40 -- which
  # is why the other two layers still carry their weight.
  env -i PATH="$PATH" HOME=/var/empty \
    GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null \
    git -C "$repo" --no-pager -c safe.directory="$repo" \
    -c attr.tree=4b825dc642cb6eb9a060e54bf8d69288fbee4904 \
    -c core.fsmonitor=false -c core.pager=cat "$@"
}

# The "commits since last approval" listing, one aligned line per commit,
# newest first:
#
#   <hash>  <subject>  <n> files  +<ins> -<del>
#
# Counts pluralize ("1 file", "2 files") without breaking alignment: the
# count-and-noun pair is one token, right-aligned to the widest token in
# the range, exactly like the signed +/- numbers beside it.
#
# Orientation before the review: how many places each commit touched, so a
# one-line "fix typo" that rewrites forty files cannot pass as one. The
# counts come from sgit -- the same hardened path the reviewed diff takes,
# so attr.tree=<empty tree> holds here too and no repo-local textconv or
# diff driver can shrink a commit to "nothing changed" in this display
# either. `log --numstat` without -p renders no patch, which is why the
# sgit render guard passes it; --shortstat would mean parsing a sentence,
# so the machine-readable form is the one used.
#
# Binary files count as changed files and contribute nothing to +/-, which
# is exactly what git reports for them ("-" in both columns). A merge has
# no per-commit diff at all (git omits it unless asked), so its counts read
# "-" rather than a fabricated zero; the authoritative diff below covers
# the merged content regardless.
#
# $1 = old rev, $2 = new rev, $3 = line prefix (default none).
print_commit_range() {
  # %x01 delimits the commit blocks: the subject is the last field, so it
  # may hold tabs, and %s never holds a newline (git folds the subject).
  sgit log --format='%x01%h%x09%s' --numstat "${1}..${2}" | LC_ALL=C awk \
    -v pre="${3:-}" -v cyn="$C_CYN" -v dim="$C_DIM" \
    -v grn="$C_GRN" -v red="$C_RED" -v off="$C_OFF" '
    function fit(s,   k) {                      # cap the subject column
      if (length(s) <= 60) return s
      k = 57
      # awk indexes bytes here, so back off over UTF-8 continuation bytes
      # rather than cutting a character in half.
      while (k > 0 && substr(s, k + 1, 1) ~ /^[\200-\277]$/) k--
      return substr(s, 1, k) "..."
    }
    /^\001/ {
      n++
      line = substr($0, 2)
      t = index(line, "\t")
      if (t > 0) { hsh[n] = substr(line, 1, t - 1); sbj[n] = fit(substr(line, t + 1)) }
      else       { hsh[n] = line; sbj[n] = "" }
      nfl[n] = 0; ins[n] = 0; del[n] = 0; mrg[n] = 1
      # %h picks its own length per commit, so the hash gets a column too.
      if (length(hsh[n]) > hw) hw = length(hsh[n])
      if (length(sbj[n]) > sw) sw = length(sbj[n])
      next
    }
    /^[0-9-]+\t/ {
      mrg[n] = 0
      nfl[n]++
      if ($1 != "-") ins[n] += $1
      if ($2 != "-") del[n] += $2
      next
    }
    END {
      for (j = 1; j <= n; j++) {
        if (mrg[j]) continue
        tok[j] = nfl[j] (nfl[j] == 1 ? " file" : " files")
        if (length(tok[j]) > tw) tw = length(tok[j])
        if (length(ins[j]) > iw) iw = length(ins[j])
        if (length(del[j]) > dw) dw = length(del[j])
      }
      if (hw < 1) hw = 1
      if (sw < 1) sw = 1
      if (tw < 1) tw = 1
      if (iw < 1) iw = 1
      if (dw < 1) dw = 1
      for (j = 1; j <= n; j++) {
        out = pre cyn sprintf("%-" hw "s", hsh[j]) off "  " sprintf("%-" sw "s", sbj[j]) "  "
        if (mrg[j])
          out = out dim sprintf("%" tw "s", "-") "  " \
                sprintf("%" (iw + 1) "s", "-") " " sprintf("%" (dw + 1) "s", "-") off
        else
          # The sign is part of the token, right-aligned with it: "+103"
          # over "  +2", never a "+" stranded from its digits.
          out = out dim sprintf("%" tw "s", tok[j]) off "  " \
                grn sprintf("%" (iw + 1) "s", "+" ins[j]) off " " \
                red sprintf("%" (dw + 1) "s", "-" del[j]) off
        print out
      }
    }
  '
}

# THE ANCESTRY LATTICE: how a candidate rev stands to the rev already
# pinned, decided over the COMMIT GRAPH and never by parsing a version
# string. Names are repo content and version sort is a convention; only
# reachability says whether trust is moving forward.
#
#   equal      old == new                  a no-op (the already-pinned path)
#   forward    old is an ancestor of new   the ordinary approval
#   backward   new is an ancestor of old   commits are being UN-approved
#   diverged   neither                     the pinned line is being abandoned
#
# merge-base --is-ancestor is plumbing: it answers by EXIT CODE and renders
# nothing, so no repo-local diff driver or textconv filter is in play. It
# still goes through sgit (env -i, no global/system config, safe.directory
# for the root-on-user-repo case) by giving $repo a local value -- one
# hardened git path, whether or not the caller sits in a resolved-repo
# context.
#
# A rev git cannot reach (a pin the checkout gc'd away, a rewritten history)
# makes both calls fail, which reads as "diverged": neither is provably an
# ancestor of the other, so the ceremony refuses unless the human declares
# it. Fail-closed is the only safe answer to "git cannot relate these".
#
# $1 = repo path, $2 = the pinned rev, $3 = the candidate rev.
ancestry_class() {
  local repo="$1" old="$2" new="$3"
  if [ "$old" = "$new" ]; then printf 'equal'; return 0; fi
  if sgit merge-base --is-ancestor "$old" "$new" 2>/dev/null; then
    printf 'forward'; return 0
  fi
  if sgit merge-base --is-ancestor "$new" "$old" 2>/dev/null; then
    printf 'backward'; return 0
  fi
  printf 'diverged'
}

# The declared non-forward alarm: the ceremony's loudest display, in the
# --trust banner's colors and full-caps `!!!` shape, because both say the
# same kind of thing -- trust is moving somewhere the ordinary reading does
# not cover. Ruled off to a fixed column, so the block reads as one object
# rather than three ragged sentences; every line is fixed-length text plus
# an abbreviated rev, so the width is deterministic.
# $1 = class, $2 = pinned rev, $3 = candidate rev, $4 = merge base (diverged
# only; empty when the two revs have no common ancestor in this checkout).
_alarm_line() { printf '%s!!! %-54s !!!%s\n' "$C_RED$C_B" "$1" "$C_OFF"; }
print_ancestry_alarm() {
  local l
  case "$1" in
    backward)
      l="$(printf 'BACKWARD: %.10s -> %.10s' "$2" "$3")"
      _alarm_line "$l"
      _alarm_line "The candidate is an ANCESTOR of the current pin: the"
      _alarm_line "commits between are being UN-approved."
      ;;
    diverged)
      l="$(printf 'DIVERGED: %.10s -> %.10s' "$2" "$3")"
      _alarm_line "$l"
      _alarm_line "The candidate is NOT on the pinned line of history:"
      if [ -n "${4:-}" ]; then
        _alarm_line "$(printf 'that line is being ABANDONED at merge base %.10s' "$4")"
        _alarm_line "(history rewrite or side branch)."
      else
        _alarm_line "that line is being ABANDONED, and the two revs share"
        _alarm_line "no common ancestor in this checkout."
      fi
      ;;
  esac
}

# The lattice's gate. The flag DECLARES the relationship the human believes
# they are approving, and reality must CONFORM -- declared, never inferred:
# a tool that inferred "you probably meant to go backward" would be deciding
# the one thing the ceremony exists to make a human decide. So a missing
# declaration refuses, and a WRONG declaration refuses too, naming the class
# that actually holds.
# Prints its refusal on stderr and returns 1; returns 0 to proceed.
# $1 = actual class, $2 = declared class ('' = none), $3 = pinned rev,
# $4 = candidate rev, $5 = repo path (for the remediation line).
ancestry_gate() {
  local actual="$1" declared="$2" old="$3" new="$4" p="$5" phrase
  case "$actual" in
    equal|forward)
      [ -n "$declared" ] || return 0
      printf '%sREFUSE: nothing to override -- the candidate is a descendant of the pin%s\n' \
        "$C_RED$C_B" "$C_OFF" >&2
      echo "        pinned:    $old" >&2
      echo "        candidate: $new" >&2
      echo "        drop --$declared" >&2
      return 1 ;;
    backward) phrase="is backward of the pin" ;;
    *)        phrase="has diverged from the pin" ;;
  esac
  if [ -z "$declared" ]; then
    printf '%sREFUSE: the candidate %s%s\n' "$C_RED$C_B" "$phrase" "$C_OFF" >&2
  elif [ "$declared" != "$actual" ]; then
    printf '%sREFUSE: --%s declared, but the candidate %s%s\n' \
      "$C_RED$C_B" "$declared" "$phrase" "$C_OFF" >&2
  else
    return 0
  fi
  echo "        pinned:    $old" >&2
  echo "        candidate: $new" >&2
  if [ "$actual" = backward ]; then
    echo "        the commits between are being un-approved" >&2
  else
    echo "        the pinned line of history is being abandoned" >&2
  fi
  echo "        declare it to proceed: pinned review $p --$actual" >&2
  return 1
}

# One listing header in the two shapes this script uses: the root ceremony
# rules its sections off, the pre-sudo preview labels them.
# $1 = style (rule|label), $2 = the header text.
_ancestry_hdr() {
  if [ "$1" = label ]; then
    printf '%s%s:%s\n' "$C_B" "$2" "$C_OFF"
  else
    printf '%s--- %s ---%s\n' "$C_B" "$2" "$C_OFF"
  fi
}

# The commits a move covers, listed in the direction that makes them
# readable. `<pin>..<candidate>` is EMPTY for a candidate that sits behind
# the pin, and a review that says nothing about what it is about to
# un-approve is worse than no review; a diverged move has two ranges and no
# single one of them is the story.
# $1 = class, $2 = pinned rev, $3 = candidate rev, $4 = merge base (may be
# empty), $5 = header style, $6 = line prefix.
print_ancestry_listing() {
  local cls="$1" old="$2" new="$3" mb="$4" style="${5:-rule}" pre="${6:-}"
  case "$cls" in
    backward)
      _ancestry_hdr "$style" "commits being un-approved"
      print_commit_range "$new" "$old" "$pre" || true ;;
    diverged)
      if [ -z "$mb" ]; then
        _ancestry_hdr "$style" "no common ancestor in this checkout -- no range to list"
        return 0
      fi
      _ancestry_hdr "$style" "commits being un-approved (leaving the pinned line)"
      print_commit_range "$mb" "$old" "$pre" || true
      echo
      _ancestry_hdr "$style" "commits arriving on the new line"
      print_commit_range "$mb" "$new" "$pre" || true ;;
    *)
      _ancestry_hdr "$style" "commits since last approval"
      print_commit_range "$old" "$new" "$pre" || true ;;
  esac
}

# The floor in one call: classify, gate, announce. Used by both evidence
# branches of the ceremony and by the pre-sudo preview, so all three refuse
# the same shapes with the same words.
#
# Leaves the class in $ancestry_cls and, for a diverged candidate, the merge
# base in $ancestry_mb -- the inspect_slot convention (the caller declares
# them local). Returns 1 when the ceremony must not proceed.
# $1 = repo path, $2 = pinned rev ('' = first approval), $3 = candidate rev,
# $4 = declared class ('' = none).
ancestry_floor() {
  local repo="$1"
  ancestry_cls="" ancestry_mb=""
  if [ -z "$2" ]; then
    # A first approval classifies nothing: there is no pin for a
    # relationship to hold against, so a declaration describes nothing.
    [ -z "$4" ] || {
      echo "first approval: there is no pin for --$4 to move from" >&2
      return 1
    }
    return 0
  fi
  ancestry_cls="$(ancestry_class "$repo" "$2" "$3")"
  ancestry_gate "$ancestry_cls" "$4" "$2" "$3" "$repo" || return 1
  case "$ancestry_cls" in
    diverged)
      # Tolerated failure: two revs with no common ancestor in this
      # checkout still have a class, and the alarm says so in words.
      ancestry_mb="$(sgit merge-base "$2" "$3" 2>/dev/null || true)"
      print_ancestry_alarm "$ancestry_cls" "$2" "$3" "$ancestry_mb"
      echo ;;
    backward)
      print_ancestry_alarm "$ancestry_cls" "$2" "$3"
      echo ;;
  esac
}

# The plural suffix for a counted noun ("1 commit", "2 commits"). Defined up
# here because the pre-sudo elevation arm runs before later definitions.
plural_s() { [ "$1" = 1 ] || printf s; }

# URL-encode % and / so a path becomes an unambiguous flat slot name;
# decode reverses it (%2F first, then %25 -- the reverse order would
# corrupt paths containing literal "%2F").
# Slot names are percent-encoded absolute paths. Encode every byte outside
# [A-Za-z0-9._-] rather than just % and /: a slot name is a DIRECTORY name,
# and an unescaped shell or glob metacharacter in one is a hazard waiting for
# a caller that forgets a quote. A project at /Users/x/foo[1], or the very
# real /Library/Application Support/..., would otherwise land literally in
# the name -- the space merely looked ugly in error output, but the bracket
# would have made `for f in "$d"/pin.*`-style globs match the wrong slot, or
# nothing at all. An allowlist is the only version of this that stays correct
# as call sites change.
#
# Paths built only of safe bytes and "/" encode exactly as before, so slots
# created by the previous rule keep their names and need no migration.
# LC_ALL=C so the walk is over BYTES: a UTF-8 path encodes one byte at a
# time and round-trips exactly, instead of depending on the locale's idea of
# a character.
#
# Deliberately NO Unicode normalization here, and do not add any. Byte-exact
# keying is what keeps distinct files distinct: on a normalization-SENSITIVE
# filesystem (case-sensitive APFS, or ext4 on the NixOS side) the NFC and NFD
# spellings of a name are two different files, and folding them to one key
# would hand one file's pin to the other. Where two spellings really are one
# file -- the normalization-insensitive default macOS volume -- canon_path
# has already resolved it: readlink -f returns the spelling the filesystem
# stores, whichever spelling it was given, and every recorded key goes
# through it (review --file refuses a path that is not a regular file). The
# filesystem is the authority on whether two names are one file; this
# function must not second-guess it.
encode() {
  printf '%s' "$1" | LC_ALL=C awk '
    BEGIN { for (i = 1; i < 256; i++) ord[sprintf("%c", i)] = i }
    {
      out = ""
      for (i = 1; i <= length($0); i++) {
        c = substr($0, i, 1)
        if (c ~ /^[A-Za-z0-9._-]$/) out = out c
        else out = out sprintf("%%%02X", ord[c])
      }
      printf "%s", out
    }'
}
decode() {
  printf '%s' "$1" | LC_ALL=C awk '
    function unhex(h,   digits, v, j) {
      digits = "0123456789ABCDEF"; v = 0
      for (j = 1; j <= 2; j++) v = v * 16 + index(digits, toupper(substr(h, j, 1))) - 1
      return v
    }
    {
      out = ""; n = length($0)
      for (i = 1; i <= n; i++) {
        c = substr($0, i, 1)
        if (c == "%" && i + 2 <= n && substr($0, i + 1, 2) ~ /^[0-9A-Fa-f][0-9A-Fa-f]$/) {
          out = out sprintf("%c", unhex(substr($0, i + 1, 2))); i += 2
        } else out = out c
      }
      printf "%s", out
    }'
}

# ---- slot storage ----------------------------------------------------------
# Layout: $PINNED_ROOT/<user>/ holds exactly two wrapper dirs --
#   slots/<encoded-path>/   one root-owned dir per pinned path
#   policy/                 allowed_signers + ignorable.json
#
# The wrapper dirs are the MOUNT MENU: a lane mounts its own slot dirs and
# policy/ read-only, never <user>/ itself, which would disclose every
# pinned path name. Two rules shaped this layout, and both are the reason
# a flat <user>/ignorable.json + <user>/allowed_signers was rejected:
#
#   * DIRECTORIES ARE MOUNTED, NEVER FILES. Every write here is an atomic
#     rename over a staged temp file, so the name gets a NEW inode -- and a
#     bind-mounted (or virtiofs-shared) FILE pins the inode it was mounted
#     from, which means a guest would keep reading the pre-ceremony bytes
#     forever. Sharing the enclosing dir re-reads the name every time.
#   * SELECTIVE DISCLOSURE. One dir per disclosure class: policy says what
#     MAY be trusted (small, boring, safe to expose to a lane), slots say
#     WHAT IS pinned (the list of paths is itself information). Loose files
#     directly under <user>/ would force a lane that needs the policy to
#     mount the slot list with it.

# The per-user tier an invocation operates on: the human behind sudo for
# root ceremonies, the invoking user otherwise.
tier_user() {
  if [ "$EUID" -eq 0 ] && [ -n "${SUDO_USER:-}" ]; then
    printf '%s\n' "$SUDO_USER"
  else
    id -un
  fi
}

# One group name on every platform, after the owning tool (the
# _<user>-locked convention; underscore is both Apple's system-account
# prefix and Debian policy's). One literal spelling matters: absence
# fails CLOSED to root-only 0700, so a misported per-platform name would
# silently degrade, never error.
pin_group() { printf '_%s-pinned' "$1"; }

group_exists() {
  if command -v getent >/dev/null 2>&1; then
    getent group "$1" >/dev/null 2>&1
  else
    dscacheutil -q group -a name "$1" 2>/dev/null | grep -q '^name:'
  fi
}

slot_dir_for()   { printf '%s/%s/slots/%s\n' "$PINNED_ROOT" "$1" "$(encode "$2")"; }
policy_dir_for() { printf '%s/%s/policy\n' "$PINNED_ROOT" "$1"; }

# Create/re-assert the per-user subtree (root only). The group is
# CONSUMED, never created -- the system configuration provisions it;
# absent means root-only 0700, privacy over availability, and the first
# root-side ceremony after the group appears re-asserts 0750 tree-wide.
# Sets TREE_GRP/TREE_DMODE/TREE_FMODE for subsequent slot writes.
ensure_tree() {
  local u="$1" udir grp
  udir="$PINNED_ROOT/$u"
  grp="$(pin_group "$u")"
  install -d -m 755 -o root -g wheel "$PINNED_ROOT"
  if group_exists "$grp"; then
    TREE_GRP="$grp" TREE_DMODE=750 TREE_FMODE=640
  else
    printf '%swarning: group %s does not exist -- %s stays root-only (0700) until it does%s\n' \
      "$C_YEL" "$grp" "$udir" "$C_OFF" >&2
    TREE_GRP=wheel TREE_DMODE=700 TREE_FMODE=600
  fi
  install -d -m "$TREE_DMODE" -o root -g "$TREE_GRP" \
    "$udir" "$udir/slots" "$udir/policy"
  # SELF-HEAL: allowed_signers used to live in <user>/signers/. It is
  # policy -- what MAY be trusted -- so it belongs with the rest of the
  # policy class, in the one dir a lane can be handed without also being
  # handed the slot list. Moved here rather than by a migration script,
  # because ensure_tree already runs at the start of every root ceremony
  # and is the one place that owns this tree's shape. Loud: a trust file
  # changing location is not a detail to discover later. (The per-slot
  # override stays at slots/<enc>/signers/ -- slot contents are one
  # disclosure class and ride the slot's own mount.)
  local old_signers="$udir/signers" moved=0
  if [ -f "$old_signers/allowed_signers" ]; then
    if [ -e "$udir/policy/allowed_signers" ]; then
      printf '%swarning: both %s/allowed_signers and %s/policy/allowed_signers exist;\n' \
        "$C_YEL" "$old_signers" "$udir" >&2
      printf '         policy/ is the one that is read -- inspect and remove the old file by hand%s\n' \
        "$C_OFF" >&2
    else
      mv -f "$old_signers/allowed_signers" "$udir/policy/allowed_signers"
      printf '%snote: moved allowed_signers into the policy dir:%s\n' "$C_YEL" "$C_OFF" >&2
      printf '      %s/allowed_signers -> %s/policy/allowed_signers\n' "$old_signers" "$udir" >&2
      moved=1
    fi
  fi
  if [ -d "$old_signers" ]; then
    # Only an EMPTY leftover goes; anything still in there is unexplained
    # state that a trust tool must not delete on a hunch.
    if rmdir "$old_signers" 2>/dev/null; then
      # The removal continues the move-note only when THIS run printed one.
      # An earlier run's move leaves the empty dir behind, and an indented
      # continuation under nothing reads as a lost line.
      if [ "$moved" -eq 1 ]; then
        printf '%s      removed the now-empty %s%s\n' "$C_YEL" "$old_signers" "$C_OFF" >&2
      else
        printf '%snote: removed the now-empty legacy dir %s%s\n' "$C_YEL" "$old_signers" "$C_OFF" >&2
      fi
    else
      printf '%swarning: %s is not empty; left in place (nothing reads it any more)%s\n' \
        "$C_YEL" "$old_signers" "$C_OFF" >&2
    fi
  fi
  # Deterministic sweep so a group arriving (or leaving) heals the whole
  # tree, not just paths the current ceremony touches.
  chown -R "root:$TREE_GRP" "$udir"
  if [ "$TREE_DMODE" = 750 ]; then
    chmod -R u=rwX,g=rX,o= "$udir"
  else
    chmod -R u=rwX,g=,o= "$udir"
  fi
}

# Classify a slot directory. Sets slot_state (none|rev|pin|tombstone),
# slot_file, slot_kind (git / sha256 / ... -- the declared verifier).
# Structure rule: EXACTLY ONE of rev.<vcs> / pin.<algo> / tombstone;
# more is a malformed slot and every consumer refuses fail-closed.
inspect_slot() {
  local d="$1" f n=0
  slot_state=none slot_file="" slot_kind=""
  [ -d "$d" ] || return 0
  for f in "$d"/rev.* "$d"/pin.* "$d"/tombstone; do
    [ -e "$f" ] || continue
    n=$((n + 1)); slot_file="$f"
    case "$f" in
      */tombstone) slot_state=tombstone; slot_kind="" ;;
      */rev.*)     slot_state=rev;  slot_kind="${f##*/rev.}" ;;
      */pin.*)     slot_state=pin;  slot_kind="${f##*/pin.}" ;;
    esac
  done
  if [ "$n" -gt 1 ]; then
    slot_state=malformed; slot_file=""; slot_kind=""
    echo "ERROR: malformed slot $d: more than one of rev.*/pin.*/tombstone" >&2
    return 1
  fi
  return 0
}

# Write a slot's state file atomically and enforce exactly-one state:
# stage inside the slot dir, remove competing state files, rename into
# place. The transient stateless moment reads as "no slot" -- a verify
# racing the rename refuses, i.e. fails closed. Callers run ensure_tree
# first (it sets TREE_*).
write_slot_state() {
  local d="$1" name="$2" content="$3" tmp f
  install -d -m "$TREE_DMODE" -o root -g "$TREE_GRP" "$d"
  tmp="$(mktemp "$d/.stage.XXXXXX")"
  printf '%s\n' "$content" >"$tmp"
  chown "root:$TREE_GRP" "$tmp"
  chmod "$TREE_FMODE" "$tmp"
  for f in "$d"/rev.* "$d"/pin.* "$d"/tombstone; do
    [ -e "$f" ] || continue
    [ "$f" = "$d/$name" ] || rm -f "$f"
  done
  mv -f "$tmp" "$d/$name"
}

# The ANNOTATION writers (tag / ignored.json / approved) -- and, with the
# same discipline, the policy files. Same atomic stage-chown-chmod-rename
# and the same ownership as the state file, but annotations take no part in
# the exactly-one-state rule, so nothing is removed here. The target dir
# always exists by the time these run (the state write creates the slot
# root-owned; ensure_tree creates policy/), which is why neither re-asserts
# it.
#   write_note       content from a string (one trailing newline added)
#   write_slot_copy  content copied from a file, byte for byte
write_note() {
  local d="$1" name="$2" tmp
  tmp="$(mktemp "$d/.stage.XXXXXX")"
  printf '%s\n' "$3" >"$tmp"
  chown "root:$TREE_GRP" "$tmp"
  chmod "$TREE_FMODE" "$tmp"
  mv -f "$tmp" "$d/$name"
}
write_slot_copy() {
  local d="$1" name="$2" src="$3" tmp
  tmp="$(mktemp "$d/.stage.XXXXXX")"
  cat -- "$src" >"$tmp"
  chown "root:$TREE_GRP" "$tmp"
  chmod "$TREE_FMODE" "$tmp"
  mv -f "$tmp" "$d/$name"
}

# Drop a slot's ignored-key DECLARATION, in any declared format -- including
# one this version does not recognize, which is why the glob and not a fixed
# name. Called wherever the declaration is re-stated without keys: the file
# ceremony re-states it every time, exactly like `tag`.
clear_ignore_decl() { rm -f "$1"/ignored.*; }

# Declaration AND stored witness -- everything the ceremony re-states. The
# file ceremony calls this on the extras it is not carrying, and the two
# places where a FILE record stops existing call it wholesale: a repo
# approval taking the slot over, and a tombstone (retired content has no
# bytes worth custody, and no keys left to tolerate).
clear_slot_ignore() { clear_ignore_decl "$1"; rm -f "$1/approved"; }

# ---- hash algorithms (file pins) -------------------------------------------
# Labels are EXACT function names -- the shipped --algo vocabulary and the
# pin.<algo> filename suffixes; verbatim lookup tokens, never parsed on
# "-". Digest LENGTH alone fixes the digest size, not the algorithm
# (sha256, sha512/256, blake2b-256 and blake3 all emit 64 hex), hence a
# declared label per record -- and declare-then-validate makes length a
# checkable invariant: a wrong-length digest is a malformed record,
# refused before anything is hashed. Unknown labels refuse.

algo_hash_cmd() {
  case "$1" in
    sha256)      echo "shasum -a 256" ;;
    sha384)      echo "shasum -a 384" ;;
    sha512)      echo "shasum -a 512" ;;
    sha512256)   echo "shasum -a 512256" ;;
    blake2b-256) echo "b2sum -l 256" ;;
    blake2b-384) echo "b2sum -l 384" ;;
    blake2b-512) echo "b2sum -l 512" ;;
    blake3)      echo "b3sum --no-names" ;;
    *) return 1 ;;
  esac
}

algo_hex_len() {
  case "$1" in
    sha256|sha512256|blake2b-256|blake3) echo 64 ;;
    sha384|blake2b-384)                  echo 96 ;;
    sha512|blake2b-512)                  echo 128 ;;
    *) return 1 ;;
  esac
}

# Fail closed when the declared function's tool is absent from the
# trusted PATH -- availability is checked here, never encoded in help.
require_hasher() {
  case "$1" in
    blake3)
      command -v b3sum >/dev/null 2>&1 || {
        echo "ERROR: $1 declared but b3sum is not in the trusted PATH ($PATH)" >&2
        echo "       install b3sum system-wide (a user-writable one would defeat the gate)" >&2
        return 1
      } ;;
    blake2b-*)
      command -v b2sum >/dev/null 2>&1 || {
        echo "ERROR: $1 declared but b2sum is not in the trusted PATH ($PATH)" >&2
        echo "       install GNU coreutils system-wide (a user-writable b2sum would defeat the gate)" >&2
        return 1
      } ;;
  esac
}

hash_file() {
  # $1 = algo label, $2 = file. Echoes the digest; equals what the
  # stock tool (shasum/b2sum/b3sum) reports for the same file, so every
  # record can be cross-checked with ordinary tools.
  local cmd out
  cmd="$(algo_hash_cmd "$1")" || return 1
  require_hasher "$1" || return 1
  out="$($cmd "$2")" || return 1
  printf '%s\n' "${out%% *}"
}

# Canonicalize a path that need not exist (BSD readlink -f demands
# existence): resolve the nearest EXISTING ancestor, then re-append the
# missing tail literally.
#
# Walking up rather than stopping at the immediate parent is load-bearing.
# A path is absent whether one component is missing or five, and the verdict
# for an absent path belongs to its SLOT -- no slot -> 10, live pin -> 20,
# tombstone -> 0. Erroring out because the parent dir happens to be gone
# made those states unreachable for an entire subtree: verify returned a
# generic failure that callers must treat as "pinned itself broke" (the shim
# hard-refuses on it, fail-closed), so a project that simply never had a
# .claude-devcontainer/ could not launch. Tombstone was worse -- it refuses
# a path that still exists, so the one case tombstones are FOR, a directory
# removed wholesale, was the one case it could not name.
#
# Only the missing tail is appended literally, and that is safe precisely
# because it does not exist: there are no symlinks left to resolve below
# the deepest real ancestor. `..` in the tail is the exception -- it would
# have to traverse a directory that isn't there, so there is no honest
# answer and it refuses.
canon_path() {
  local p="$1" d b tail=""
  if [ -e "$p" ]; then
    readlink -f "$p"
    return
  fi
  d="$p"
  while :; do
    b="$(basename "$d")"; d="$(dirname "$d")"
    case "$b" in
      ..) echo "ERROR: cannot resolve: $p (.. below a missing directory)" >&2; return 1 ;;
      .)  : ;;
      *)  tail="$b${tail:+/}$tail" ;;
    esac
    # dirname bottoms out at / (or . for a relative path), both of which
    # exist, so this terminates.
    [ -e "$d" ] && break
  done
  d="$(readlink -f "$d" 2>/dev/null)" \
    || { echo "ERROR: cannot resolve: $p" >&2; return 1; }
  printf '%s/%s\n' "${d%/}" "$tail"
}

# Private scratch for frozen copies; removed on exit. freeze_file is THE
# single read of a subject file -- display, diff, hash and emit all
# derive from the frozen copy, never a second look at the live path
# (TOCTOU closure). Sets FROZEN_COPY.
workdir="" FREEZE_N=0
# Never-failing: under set -e a failing EXIT trap OVERRIDES the script's
# exit status (a bare `[ -n ... ] && ...` here turned verify's success
# into exit 1 -- live-fired in the build harness).
cleanup_workdir() { [ -z "$workdir" ] || rm -rf "$workdir"; }
trap cleanup_workdir EXIT
freeze_file() {
  [ -n "$workdir" ] || workdir="$(mktemp -d)"
  FREEZE_N=$((FREEZE_N + 1))
  FROZEN_COPY="$workdir/frozen.$FREEZE_N"
  cat -- "$1" >"$FROZEN_COPY"
}

resolve_repo() {
  [ $# -ge 1 ] || usage
  repo="$(readlink -f "$1")"
  [ -n "$repo" ] && [ -d "$repo" ] || { echo "not a directory: ${1}" >&2; exit 1; }
  # Let git's own stderr through -- swallowing it turned a safe.directory
  # refusal into a misleading "not a git work tree".
  sgit rev-parse --is-inside-work-tree >/dev/null \
    || { echo "not a usable git work tree: $repo (git error above)" >&2; exit 1; }
  # A repo pin names a commit of the WHOLE repo -- there is no per-subdir
  # trust semantic, so a slot keyed on a subdirectory could only mislead:
  # deploy matches flake inputs by repo root, and a root slot plus a subdir
  # slot could pin one repo at two revs. Refuse rather than silently re-key
  # to the root: a trust ceremony names its object.
  local top
  top="$(sgit rev-parse --show-toplevel)" || exit 1
  if [ "$repo" != "$(readlink -f "$top")" ]; then
    echo "not the work-tree root: $repo" >&2
    echo "       a pin names the whole repo; name its root: $top" >&2
    exit 1
  fi
  default_slot="$(slot_dir_for "$(tier_user)" "$repo")"
}

# Declared-name grammar for the slot `tag` annotation, deliberately
# narrower than git's own ref rules: the name is spliced into sed
# expressions and flake URLs at deploy time, so only [A-Za-z0-9._/+-]
# survives -- validated fail-closed on WRITE and on READ (the record
# declares; an undeclared shape refuses).
validate_tag_name() {
  case "$1" in
    ''|-*|/*|*/|*..*|*.lock|*.lock/*) return 1 ;;
    *[!A-Za-z0-9._/+-]*) return 1 ;;
  esac
  return 0
}

# ---- add: argument grammar (pure, so the preview and the root side share it)

# What `add` was handed, printed as one word: `path` for a directory that
# already exists (used IN PLACE -- add never copies or edits a checkout), or
# `url` for something to clone. An argument that is neither names both
# readings in its refusal, because "no such directory" alone would hide the
# other half of the grammar.
#
# The directory test comes FIRST: a local path is unambiguous and cannot be
# redirected anywhere, so nothing that exists is ever fetched over a network.
add_arg_kind() {
  [ -n "$1" ] || return 1
  if [ -d "$1" ]; then printf 'path\n'; return 0; fi
  case "$1" in
    *://*) printf 'url\n'; return 0 ;;
    # git's other remote spelling, [user@]host:path. The colon must come
    # before the first slash, or /var/tmp/a:b would read as host `/var/tmp/a`.
    *:*)
      case "${1%%:*}" in
        ''|*/*) ;;
        *) printf 'url\n'; return 0 ;;
      esac ;;
  esac
  echo "ERROR: '$1' is neither an existing directory nor a clonable url" >&2
  echo "       directory: the checkout to pin, used in place" >&2
  echo "       url:       scheme://host/path or [user@]host:path, cloned into $PINNED_CLONES" >&2
  return 1
}

# The default name for the flake attribute and (for a url) the clone
# directory: the last path component, without a trailing .git. Both remote
# spellings end in the same component, so one derivation covers them.
add_input_name() {
  local n="$1"
  n="${n%/}"        # a trailing slash names the same repo
  n="${n##*/}"
  n="${n##*:}"      # scp-like remotes carry no slash before the colon
  n="${n%.git}"
  printf '%s\n' "$n"
}

# The name grammar, fail-closed on both of its uses: the name is spliced
# into a nix attribute path AND into a root-owned directory name under
# $PINNED_CLONES. Deliberately narrower than nix's own identifier rules
# (which admit quoted anything) -- a name outside this set is typed
# differently, not admitted by loosening the check. Validated names are also
# regex-safe, which is what lets flake_declares_input below interpolate one.
validate_input_name() {
  case "$1" in
    ''|[!A-Za-z_]*) return 1 ;;
    *[!A-Za-z0-9_-]*) return 1 ;;
  esac
  return 0
}

# Does the flake source on stdin declare an input by this name? A HEURISTIC
# over nix source -- pinned parses no nix -- matching the three spellings a
# hand-written flake uses at the start of a line:
#     inputs.<name>.url = ...      <name>.url = ...      <name> = {
# It is used for two questions, and both fail SAFE rather than silently:
# a name collision in the system flake (refused; a false positive costs the
# human one rename), and whether an approved repo declares a `nixpkgs` input
# (which decides only whether the added block carries a follows line -- and
# nix itself errors loudly at eval if that guess is wrong).
# $1 must have passed validate_input_name: no regex metacharacter survives it.
flake_declares_input() {
  grep -qE "^[[:space:]]*(inputs\.)?$1([[:space:]]*=|\.[A-Za-z0-9_.-]+[[:space:]]*=)"
}

# ---- ignored keys (verify-side tolerance) ----------------------------------
#
# A file slot may declare `ignored.<format>`: keys whose later drift verify
# tolerates. ONE format ships -- `ignored.json`, a JSON array of jq key
# paths:
#     [["model"],["effortLevel"],["statusLine","command"]]
# The SUFFIX is the declaration, exactly like rev.<vcs> and pin.<algo>: the
# record says which grammar its content is written in, and an unrecognized
# suffix (ignored.toml, ignored.yaml, ...) REFUSES rather than being
# guessed at -- which is also the extension point, should another format
# ever be worth implementing.
#
# WHY REAL JSON, and not the dotted lines this started as: the .json suffix
# has to be truthful, jq's delpaths takes exactly this shape (so the
# comparison consumes the record with no translation step in between), and
# a JSON object key may contain ANY character -- dots, spaces, parentheses
# ("Bash(git status:*)" is a real settings key). A dotted line cannot spell
# those; an array of strings spells all of them. GENERALITY LIVES IN THE
# STORAGE, CONVENIENCE IN THE HUMAN SURFACE: the CLI still takes
# --ignore-json-key model (or a.b.c) and every display joins paths back
# with dots, and dot-splitting happens ONLY at that surface.
#
# The pin stays byte-exact -- the declaration changes only what VERIFY does
# with a mismatch, and only when it can prove the difference is confined to
# those keys. KEYS ONLY -- no array subscripts -- because an index is a
# position, not a name, and a tolerated position would silently move with
# an insertion.

# The CLI's dotted convenience grammar, and ONLY that: [A-Za-z0-9_.-] with
# no leading, trailing or doubled dot. It bounds what may be typed, never
# what may be stored -- a key outside it is spelled by writing the path
# array, not by loosening this. Validated fail-closed before any dot-split.
validate_ignore_key() {
  case "$1" in
    ''|.*|*.|*..*) return 1 ;;
    *[!A-Za-z0-9_.-]*) return 1 ;;
  esac
  return 0
}

# jq is what makes every JSON-shaped rung of the ladder readable at all;
# without it there is no honest answer, only a guess. One refusal, one
# remediation, everywhere. $1 = what needed it, for the message.
require_jq() {
  command -v jq >/dev/null 2>&1 && return 0
  echo "ERROR: $1 needs jq in the trusted PATH ($PATH)" >&2
  echo "       install jq system-wide (a user-writable one could falsify the comparison)" >&2
  return 1
}

# One dotted key -> one jq path array: "statusLine.command" ->
# ["statusLine","command"]. Interpolating the segments raw is safe ONLY
# because validate_ignore_key has already excluded quotes, backslashes and
# every other byte that would need escaping -- validate first, build second.
ign_key_path_json() {
  printf '%s' "$1" | LC_ALL=C awk '
    {
      n = split($0, seg, "."); p = ""
      for (j = 1; j <= n; j++) p = p (j > 1 ? "," : "") "\"" seg[j] "\""
      printf "[%s]", p
    }'
}

# The space-separated dotted list the CLI collected -> the JSON array of
# paths jq's delpaths/getpath want, which is also exactly what the slot
# records:
#   "model effortLevel statusLine.command"
#     -> [["model"],["effortLevel"],["statusLine","command"]]
ign_paths_json() {
  printf '%s\n' "$1" | LC_ALL=C awk '
    {
      out = ""
      for (i = 1; i <= NF; i++) {
        n = split($i, seg, ".")
        p = ""
        for (j = 1; j <= n; j++) p = p (j > 1 ? "," : "") "\"" seg[j] "\""
        out = out (i > 1 ? "," : "") "[" p "]"
      }
      printf "[%s]\n", out
    }'
}

# A JSON array of paths -> the dotted, comma-separated form humans read.
# Display only: a key containing a dot renders ambiguously here and is
# still stored, compared and enforced exactly.
ign_display() {
  printf '%s' "$1" | jq -r 'map(join(".")) | join(", ")'
}

# Read + validate a slot's ignored-key declaration into IGN_PATHS (the
# canonical compact JSON array -- what delpaths is handed, and what a
# declaration is compared against). Exit status is three-valued, because
# "nothing declared" and "declared but unusable" are different answers:
#   0  a valid ignored.json; IGN_PATHS holds its paths
#   1  no ignored.* at all -- the feature is simply not declared here
#   2  a declaration that cannot be honoured (unknown format, more than
#      one, not root-owned, empty, no jq, or content outside the shape).
#      Loud, and every caller falls back to the STRICTER verdict.
IGN_PATHS=""
read_ignored_paths() {
  local d="$1" f found="" fmt
  IGN_PATHS=""
  for f in "$d"/ignored.*; do
    [ -e "$f" ] || continue
    if [ -n "$found" ]; then
      echo "REFUSE: slot $d declares more than one ignored.<format>; refusing all of them" >&2
      return 2
    fi
    found="$f"
  done
  [ -n "$found" ] || return 1
  fmt="${found##*/ignored.}"
  case "$fmt" in
    json) ;;
    *)
      echo "REFUSE: $found declares unsupported ignored-key format '$fmt'; refusing" >&2
      echo "        (the shipped format is ignored.json -- a JSON array of key paths)" >&2
      return 2 ;;
  esac
  verify_record_file "$found" || return 2
  require_jq "reading $found" || return 2
  if ! jq -e 'type == "array"
              and all(.[]; type == "array" and length > 0
                           and all(.[]; type == "string"))' \
       <"$found" >/dev/null 2>&1; then
    echo "REFUSE: $found is outside the ignored-key shape: a JSON array of nonempty" >&2
    echo '        arrays of strings, e.g. [["model"],["statusLine","command"]]' >&2
    return 2
  fi
  [ "$(jq 'length' <"$found")" -gt 0 ] || {
    echo "REFUSE: $found declares no keys; an empty declaration tolerates nothing" >&2
    return 2
  }
  IGN_PATHS="$(jq -c . <"$found")" || return 2
  return 0
}

# Does this slot declare ignored keys at all (in any format)? Cheap
# existence test, used to decide whether the tolerance path is even in
# play before spending anything on it.
slot_declares_ignore() {
  local f
  for f in "$1"/ignored.*; do
    [ -e "$f" ] && return 0
  done
  return 1
}

# ---- the ignorable policy (machine tier, user tier) ------------------------
#
# What a slot MAY declare, root-owned and separate from the declaration
# itself. Two tiers, both arrays of entries:
#     [{"path":["model"],"under":"/Users/x/.config"},{"path":["effortLevel"]}]
# "under" is optional and means EVERYWHERE when omitted; when present it is
# an absolute prefix matched at a component boundary, so /a/b covers /a/b
# and /a/b/c and never /a/bb -- the same rule `list --under` uses.
#
# The EFFECTIVE policy is the intersection: a user entry counts only if the
# machine tier has the same path with a scope that covers it (no machine
# tier at all = no machine constraint, so the user tier stands alone). An
# absent or empty user tier grants NOTHING -- the fail-closed direction --
# and an unreadable tier of either kind grants nothing either.

# The shared jq preamble: the two coverage rules live in exactly one place,
# so the review-side check, the verify-side check and the intersection can
# never drift apart. norm() folds a trailing slash and spells the root as
# "" (so "" + "/" prefixes every absolute path).
POLICY_JQ='
  def norm($p): if $p == null then null elif $p == "/" then "" else ($p | rtrimstr("/")) end;
  def covers_path($scope; $target):
    norm($scope) as $s
    | if $s == null then true
      else ($target == $s or ($target | startswith($s + "/")))
      end;
  def covers_scope($mscope; $uscope):
    norm($mscope) as $m | norm($uscope) as $u
    | if $m == null then true
      elif $u == null then false
      else ($u == $m or ($u | startswith($m + "/")))
      end;
'

# The shape a policy file must have. Unknown object keys are REFUSED, not
# skipped: a key this version does not understand could be a NARROWING
# constraint written by a newer one, and ignoring it would silently widen
# the grant.
POLICY_VALID='
  type == "array" and all(.[];
    type == "object"
    and ((keys - ["path", "under"]) | length) == 0
    and has("path")
    and (.path | type == "array" and length > 0 and all(.[]; type == "string"))
    and (if has("under")
         then (.under | type == "string" and startswith("/")
               and (. == "/" or (endswith("/") | not))
               and (contains("//") | not))
         else true end))
'

# Read + validate ONE tier into POLICY_JSON. Three-valued like the slot
# declaration: 0 valid, 1 absent, 2 present but unusable (loud).
POLICY_JSON=""
read_policy_file() {
  local f="$1" label="$2"
  POLICY_JSON=""
  [ -e "$f" ] || return 1
  [ -f "$f" ] || { echo "REFUSE: $label $f is not a regular file" >&2; return 2; }
  verify_record_file "$f" || return 2
  verify_ancestry "$f" || return 2
  require_jq "reading $f" || return 2
  jq -e "$POLICY_VALID" <"$f" >/dev/null 2>&1 || {
    echo "REFUSE: $label $f is not a valid ignorable policy" >&2
    echo '        (a JSON array of {"path":["a","b"],"under":"/abs/prefix"};' >&2
    echo '        "under" is optional and means everywhere; no other keys)' >&2
    return 2
  }
  POLICY_JSON="$(jq -c . <"$f")" || return 2
  return 0
}

# Load both tiers and their intersection for tier user $1:
#   POL_MACHINE  the machine tier, "" when there is none
#   POL_USER     the user tier ([] when absent)
#   POL_EFF      what review and verify actually check against
# Returns 1, loudly, when a tier that EXISTS cannot be read: an unreadable
# policy grants nothing rather than everything.
POL_MACHINE="" POL_USER="[]" POL_EFF="[]"
load_policy() {
  local u="$1" rc=0
  POL_MACHINE="" POL_USER="[]" POL_EFF="[]"
  read_policy_file "$PINNED_MACHINE_POLICY" "machine policy" || rc=$?
  case "$rc" in
    0) POL_MACHINE="$POLICY_JSON" ;;
    1) ;;
    *) return 1 ;;
  esac
  rc=0
  read_policy_file "$(policy_dir_for "$u")/ignorable.json" "user policy" || rc=$?
  case "$rc" in
    0) POL_USER="$POLICY_JSON" ;;
    1) return 0 ;;
    *) return 1 ;;
  esac
  if [ -z "$POL_MACHINE" ]; then
    POL_EFF="$POL_USER"
  else
    POL_EFF="$(jq -c -n --argjson m "$POL_MACHINE" --argjson u "$POL_USER" \
      "$POLICY_JQ"'[ $u[] as $e
                     | select(any($m[]; .path == $e.path and covers_scope(.under; $e.under)))
                     | $e ]')" || return 1
  fi
  return 0
}

# How many of the declared paths $2 does the effective policy $1 NOT grant
# for the path $3? Counted structurally (never by counting output lines: a
# key may contain a newline), because this number is a trust decision.
policy_ungranted_count() {
  jq -n --argjson e "$1" --argjson d "$2" --arg f "$3" \
    "$POLICY_JQ"'[ $d[] as $p
                   | select([ $e[] | select(.path == $p and covers_path(.under; $f)) ] | length == 0) ]
                 | length'
}

# The same set, dotted, one per line -- for the human-readable refusal.
policy_ungranted() {
  jq -r -n --argjson e "$1" --argjson d "$2" --arg f "$3" \
    "$POLICY_JQ"'$d[] as $p
                 | select([ $e[] | select(.path == $p and covers_path(.under; $f)) ] | length == 0)
                 | ($p | join("."))'
}

# Per-key grant PROVENANCE for the ceremony display: "<dotted><TAB><scope>",
# where the scope is "*" for a grant that holds everywhere, "-" for no
# grant at all, and otherwise the prefix it is scoped to. When several
# entries cover the path, the NARROWEST is reported: that is the one worth
# reading, since it says how far the tolerance actually reaches.
policy_grants() {
  jq -r -n --argjson e "$1" --argjson d "$2" --arg f "$3" \
    "$POLICY_JQ"'$d[] as $p
                 | [ $e[] | select(.path == $p and covers_path(.under; $f)) | (.under // "") ] as $m
                 | ($p | join(".")) + "\t"
                   + (if ($m | length) == 0 then "-"
                      else ($m | sort_by(length) | last | if . == "" then "*" else . end)
                      end)'
}

# The ladder rung the ceremony enforces: may THIS ceremony declare THESE
# keys for THIS path? A refusal that does not say what to run is a refusal
# a human routes around, so it names the exact grant command per key.
policy_check_declaration() { # $1 effective policy  $2 declared paths  $3 abs path
  local n names k
  n="$(policy_ungranted_count "$1" "$2" "$3")" || return 1
  # A count that is not a number is a check that did not happen, which is
  # NOT the same as a check that passed.
  case "$n" in
    0) return 0 ;;
    ''|*[!0-9]*)
      echo "REFUSE: the ignorable policy check did not complete; declaring nothing" >&2
      return 1 ;;
  esac
  names="$(policy_ungranted "$1" "$2" "$3")"
  printf '%sREFUSE: the ignorable policy does not grant these keys for%s %s\n' \
    "$C_RED$C_B" "$C_OFF" "$3" >&2
  while IFS= read -r k; do
    [ -n "$k" ] && printf '          %s\n' "$k" >&2
  done <<EOF
$names
EOF
  echo "        grant them first -- each is its own root ceremony:" >&2
  while IFS= read -r k; do
    [ -n "$k" ] && printf '          sudo pinned ignorable add %s --under %s\n' "$k" "$(dirname "$3")" >&2
  done <<EOF
$names
EOF
  echo "        (omit --under to grant a key everywhere; pinned ignorable list shows both tiers)" >&2
  return 1
}

# May these bytes be PROJECTED (parsed, keys deleted, re-serialized) as a
# stand-in for themselves? Three refusals, all of them parser-differential
# hazards -- a "yes" here is what lets verify answer 5 instead of 11, so
# each one fails closed. $1 = file, $2 = which side, for the note.
#
#   NUL bytes: jq accepts a trailing NUL and treats the file as one
#   document; other JSON parsers do not. The difference would be invisible
#   to a structural comparison, so it must not reach one.
#
#   Exactly one document: jq reads a CONCATENATED STREAM of values, every
#   other parser reads one value and stops. A two-document file is a
#   disagreement, not a document.
#
#   DUPLICATE OBJECT KEYS: jq keeps the LAST occurrence, JavaScript's
#   JSON.parse keeps the last, Python's json keeps the last, but Go's
#   encoding/json and several others differ, and the file's actual
#   consumer is not this tool's to assume. Uncertainty -> abort.
#
# The duplicate test, measured on jq-1.7.1 (2026-07-30):
#   `jq --stream` emits one event per value occurrence, so a duplicated
#   key emits BOTH occurrences ({"a":1,"a":2} -> [["a"],1] / [["a"],2] /
#   [["a"]]), while re-serializing through jq (`jq -c .`) collapses them
#   to the last. Comparing the two event COUNTS therefore detects a
#   duplicate anywhere at any depth -- including duplicates whose values
#   are themselves objects, where the leaf PATHS differ and a path-multiset
#   comparison would miss them ({"a":{"x":1},"a":{"y":2}} -> 5 events raw,
#   3 canonical). Verified against duplicates of every value shape
#   (scalar/object/array/empty-object, nested, inside arrays, byte-identical
#   values) and against duplicate-free documents carrying big integers,
#   1e1000, 1.0, escapes, astral-plane strings, empty containers and
#   five-deep nesting -- counts equal in every duplicate-free case, strictly
#   greater in every duplicated one. It cannot false-negative: every dropped
#   occurrence costs at least one event (even `{}` emits one).
json_projectable() {
  local f="$1" side="$2" n_raw n_canon
  if [ "$(LC_ALL=C tr -d '\000' <"$f" | wc -c)" -ne "$(wc -c <"$f")" ]; then
    echo "note: $side contains NUL bytes; not comparable as JSON (byte-exact verdict stands)" >&2
    return 1
  fi
  if [ "$(jq -s 'length' <"$f" 2>/dev/null)" != 1 ]; then
    echo "note: $side is not exactly one JSON document (byte-exact verdict stands)" >&2
    return 1
  fi
  n_raw="$(jq --stream -c . <"$f" 2>/dev/null | wc -l)"
  n_canon="$(jq -c . <"$f" 2>/dev/null | jq --stream -c . 2>/dev/null | wc -l)"
  if [ "$n_raw" -lt 1 ] || [ "$n_raw" -ne "$n_canon" ]; then
    echo "REFUSE: $side contains duplicate object keys -- parsers disagree on which one wins," >&2
    echo "        so no structural comparison of it can be trusted (byte-exact verdict stands)" >&2
    return 1
  fi
  return 0
}

# The tolerance path itself: is the live content the approved content with
# only the declared keys changed? Prints the per-key drift report and the
# verdict line on success (stdout, the machine contract); every failure
# returns 1 so the caller falls back to the byte-exact refusal.
#   $1 slot  $2 algo label  $3 recorded digest  $4 live (frozen) copy
#   $5 caller --baseline (may be empty)  $6 the path, for the verdict line
ignored_keys_match() {
  local slot="$1" label="$2" rec_digest="$3" live="$4" base="$5" path="$6"
  local approved="" paths pa pb rc=0 ungranted
  command -v jq >/dev/null 2>&1 || {
    echo "note: $slot declares ignored keys but jq is not in the trusted PATH ($PATH);" >&2
    echo "      the byte-exact verdict stands (install jq system-wide to enable the comparison)" >&2
    return 1
  }
  read_ignored_paths "$slot" || rc=$?
  [ "$rc" -eq 0 ] || return 1
  # THE LADDER AT USE TIME: a recorded key is tolerated only while the
  # effective policy still grants it FOR THIS PATH. Checked here, not only
  # at the ceremony, so narrowing the policy bites at the very next verify
  # -- no re-ceremony, no stale grant surviving in a slot nobody revisits.
  # An unreadable policy grants nothing and lands right back at 11.
  if ! load_policy "$(tier_user)"; then
    echo "note: the ignorable policy cannot be read; the byte-exact verdict stands" >&2
    return 1
  fi
  local n_ungranted
  n_ungranted="$(policy_ungranted_count "$POL_EFF" "$IGN_PATHS" "$path")" || n_ungranted=""
  case "$n_ungranted" in
    0) ;;
    ''|*[!0-9]*)
      # A count that is not a number is a check that did not happen.
      echo "note: the ignorable policy check did not complete; the byte-exact verdict stands" >&2
      return 1 ;;
    *)
      ungranted="$(policy_ungranted "$POL_EFF" "$IGN_PATHS" "$path" | tr '\n' ' ')"
      echo "note: $slot records ignored key$(plural_s "$n_ungranted") the policy no longer grants for this path:" >&2
      echo "      ${ungranted% } (byte-exact verdict stands; re-approve, or: pinned ignorable add)" >&2
      return 1 ;;
  esac
  # THE WITNESS. Root custody first: the slot's own copy has already been
  # re-hashed against the record (the slot invariant in do_verify). A caller
  # baseline is the same kind of evidence arriving by a different road, so it
  # proves itself here instead, by the same self-verifying trick -- neither
  # storage location nor custody is what makes a witness usable, the re-hash
  # is. Custody is preferred only because it cannot be withheld or swapped
  # between calls.
  if [ -f "$slot/approved" ]; then
    approved="$slot/approved"
  elif [ -n "$base" ]; then
    if [ ! -f "$base" ]; then
      echo "note: --baseline $base is not a readable file (byte-exact verdict stands)" >&2
      return 1
    fi
    if [ "$(hash_file "$label" "$base")" != "$rec_digest" ]; then
      echo "note: --baseline $base does not re-hash to the approved record (byte-exact verdict stands)" >&2
      return 1
    fi
    approved="$base"
  else
    echo "note: $slot declares ignored keys but holds no approved copy, and no --baseline was" >&2
    echo "      given; there is no witness to compare against (byte-exact verdict stands;" >&2
    echo "      pass verify --baseline <copy>, or re-approve with --store)" >&2
    return 1
  fi
  json_projectable "$approved" "the approved bytes" || return 1
  json_projectable "$live" "$path" || return 1
  # The record IS the delpaths argument -- no translation step between what
  # the slot declares and what the comparison deletes.
  paths="$IGN_PATHS"
  # Project and canonicalize IDENTICALLY on both sides (-S sorts keys, -c
  # compacts), then compare bytes: key order and whitespace are not what
  # this comparison is about, the remaining VALUES are.
  pa="$(jq -S -c --argjson p "$paths" 'delpaths($p)' <"$approved" 2>/dev/null)" || return 1
  pb="$(jq -S -c --argjson p "$paths" 'delpaths($p)' <"$live" 2>/dev/null)" || return 1
  if [ -z "$pa" ] || [ "$pa" != "$pb" ]; then
    echo "note: differences remain outside the declared ignored keys ($(ign_display "$paths"))" >&2
    return 1
  fi
  # Report which declared keys actually moved -- the caller's whole reason
  # to care. A key whose value is unchanged is not reported; a key missing
  # on one side and present on the other IS a difference. getpath refuses
  # to index a non-object, so both reads are guarded.
  jq -n -r --argjson p "$paths" \
     --slurpfile a "$approved" --slurpfile b "$live" '
    $p[] as $path
    | (try ($a[0] | getpath($path)) catch "unreadable") as $va
    | (try ($b[0] | getpath($path)) catch "unreadable") as $vb
    | if $va == $vb then empty else ($path | join(".")) end
  ' 2>/dev/null | while IFS= read -r line; do
    [ -n "$line" ] && printf 'ignored-drift: %s\n' "$line"
  done
  printf '%s~ matches modulo declared ignored keys:%s %s\n' "$C_YEL" "$C_OFF" "$path"
  return 0
}

read_rev() {
  # Echoes the slot's pinned rev, or nothing for no slot / no state.
  # The slot DECLARES the VCS in the filename (rev.git); validation is
  # exact per declaration -- rev.git is exactly 40 or 64 hex -- and an
  # undeclared/unknown rev.<vcs> refuses outright. Also refuses
  # tombstoned, file-pin and malformed slots: the caller asked for a
  # repo rev, and anything else answering would be a lie.
  local d="$1" rev
  inspect_slot "$d" || return 1
  case "$slot_state" in
    none) return 0 ;;
    rev)  ;;
    tombstone)
      echo "ERROR: slot $d is tombstoned (retired content); a new approval would reinstate it" >&2
      return 1 ;;
    pin)
      echo "ERROR: slot $d holds a file pin, not a repo rev" >&2
      return 1 ;;
  esac
  case "$slot_kind" in
    git) ;;
    *)
      echo "ERROR: $slot_file declares unsupported VCS '$slot_kind'; refusing" >&2
      return 1 ;;
  esac
  verify_record_file "$slot_file" || return 1
  IFS= read -r rev <"$slot_file" || true
  case "$rev" in
    *[!0-9a-f]*|'')
      echo "ERROR: rev file $slot_file is corrupt: '$rev'" >&2
      return 1
      ;;
  esac
  # Exactly git's two object formats -- SHA-1 (40) or SHA-256 (64).
  [ "${#rev}" -eq 40 ] || [ "${#rev}" -eq 64 ] \
    || { echo "ERROR: rev file $slot_file has bad hash length for rev.git" >&2; return 1; }
  printf '%s\n' "$rev"
}

# The file-pin counterpart of read_rev: read and VALIDATE a slot's pin
# record, setting REC_LABEL / REC_HEXLEN / REC_DIGEST. Refuses -- loudly,
# return 1 -- an undeclared algorithm, a digest that is not hex or not the
# declared function's LENGTH (declare-then-validate makes length a checkable
# invariant), and a record naming a path other than the one asked about.
# ONE reader for every verb that answers about a file record, so verify and
# cat can never drift apart on what a valid record is.
#
# The record file's OWNERSHIP is deliberately NOT checked here: it is
# verify_record_file's job, and the two callers answer differently for a
# violated invariant (see do_cat's contract), so it stays at the call site.
read_pin_record() { # $1 = state file, $2 = declared label, $3 = the path asked about
  local f="$1" line rec_path
  REC_LABEL="$2"
  algo_hash_cmd "$REC_LABEL" >/dev/null 2>&1 || {
    echo "ERROR: $f declares unknown algorithm '$REC_LABEL'; refusing" >&2
    return 1
  }
  REC_HEXLEN="$(algo_hex_len "$REC_LABEL")"
  IFS= read -r line <"$f" || line=""
  REC_DIGEST="${line%%  *}"
  rec_path="${line#*  }"
  case "$REC_DIGEST" in
    *[!0-9a-f]*|'')
      echo "ERROR: record $f is corrupt" >&2
      return 1 ;;
  esac
  [ "${#REC_DIGEST}" -eq "$REC_HEXLEN" ] || {
    echo "ERROR: record $f: digest length ${#REC_DIGEST} does not match $REC_LABEL ($REC_HEXLEN hex); malformed record" >&2
    return 1
  }
  [ "$rec_path" = "$3" ] || {
    echo "ERROR: record $f names path '$rec_path', not '$3'; malformed record" >&2
    return 1
  }
}

# ---- setup -----------------------------------------------------------------

do_setup() {
  require_root setup

  local assume_yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes) assume_yes=1; shift ;;
      *)     usage ;;
    esac
  done

  # Interactive confirm for direct-root invocation (sudo ./pinned setup);
  # the unprivileged path already confirmed pre-elevation and passed --yes.
  if [ "$assume_yes" -ne 1 ]; then
    setup_plan "$inv"
    local answer
    printf '%sproceed? [y/N]%s ' "$C_B" "$C_OFF"
    read -r answer </dev/tty
    case "$answer" in
      y|Y|yes) ;;
      *) echo "aborted; nothing installed"; exit 2 ;;
    esac
  fi

  # 1. Self-install; verify every ancestor of INSTALL_TARGET first.
  local self target target_dir
  self="$(readlink -f "$0")"
  target="$INSTALL_TARGET"
  target_dir="$(dirname "$target")"
  install -d -m 755 -o root -g wheel "$target_dir"
  verify_ancestry "$target" || exit 1
  verify_root_owned_path "$target_dir" || exit 1
  if [ "$self" != "$target" ]; then
    install -m 755 -o root -g wheel "$self" "$target"
    echo "installed: $target"
  else
    echo "binary already at $target"
  fi
  # The bytes at $target are final now, so this is the file the digest below
  # will pin -- and the one whose shebang decides which interpreter sudo
  # hands root. Checked here, before the grant exists: refusing costs the
  # human a reinstall, granting would cost them the interpreter.
  verify_interpreter_pin "$target" || exit 1

  # 2. Pin tree for the invoking user
  ensure_tree "$inv"
  echo "pin tree: $PINNED_ROOT/$inv"

  # 3. Sudoers entry with binary-digest pin (validated before installing).
  #    sudo recomputes the binary's SHA-256 at every invocation and refuses
  #    silently on mismatch -- integrity check lives in sudo, not in us.
  local sudoers_target sudoers_line digest tmp
  sudoers_target=/etc/sudoers.d/pinned
  digest="$(shasum -a 256 "$target" | awk '{print $1}')"
  sudoers_line="$inv ALL=(root) sha256:$digest ${target}"
  if [ -f "$sudoers_target" ] && grep -qF "$sudoers_line" "$sudoers_target"; then
    echo "sudoers digest current: $sudoers_target"
  else
    tmp="$(mktemp)"
    printf '%s\n' "$sudoers_line" >"$tmp"
    if visudo -c -f "$tmp" >/dev/null 2>&1; then
      install -m 440 -o root -g wheel "$tmp" "$sudoers_target"
      echo "wrote sudoers entry with digest: $sudoers_target"
      echo "  digest: sha256:$digest"
    else
      echo "sudoers validation failed; not installing" >&2
      rm -f "$tmp"
      exit 1
    fi
    rm -f "$tmp"
  fi

  log_action setup
  echo
  echo "setup complete"
  echo "  next: sudo pinned review <repo>"
}

if [ "$action" = "setup" ]; then
  do_setup "$@"
  exit 0
fi

# Re-verify INSTALL_TARGET itself and its ancestry on every invocation
# (catches a later "chown -R \$USER /usr/local" undoing the install-path
# guarantees).
if [ -f "$INSTALL_TARGET" ]; then
  verify_root_owned_path "$INSTALL_TARGET" || exit 1
  verify_ancestry "$INSTALL_TARGET" || exit 1
fi

# The exact argv sudo is about to run, colored by role the same way deploy
# renders its commands: sudo bold, command name cyan, verb and flags plain,
# file paths cyan (identifiers and paths are cyan everywhere; yellow stays
# reserved for attention text). The color codes go into the DISPLAY string
# only -- the exec sites build their argv from the variables, never from
# this. Quote first (anything outside the safe set gets single quotes, so
# the line stays pasteable), then color the quoted token.
elevation_cmd_disp() { # elev action args...
  local elev="$1" act="$2" a a_disp out
  shift 2
  out="${C_B}sudo${C_OFF} -- ${C_CYN}${elev}${C_OFF} $act"
  for a in "$@"; do
    case "$a" in
      *[!A-Za-z0-9_/.:=-]*) a_disp="'$a'" ;;
      *)                    a_disp="$a" ;;
    esac
    case "$a" in
      -*) out="$out $a_disp" ;;
      *)  out="$out ${C_CYN}${a_disp}${C_OFF}" ;;
    esac
  done
  printf '%s' "$out"
}

# The in-place editor every flake write goes through: sed, not perl -- sed
# is POSIX-everywhere while perl is not guaranteed (minimal NixOS). Only the
# -i spelling differs by flavor (GNU: -i; BSD: -i ''), detected like stat
# above. Sets SED_I in the CALLER's scope, which both callers declare local:
# deploy syncs a stale rev= to its pin, add syncs its placeholder to the rev
# just approved, and the two must not drift into two spellings of the same
# edit. Expressions stay safe as literals because every operand is validated
# hex or a regex-escaped path.
set_sed_i() {
  if sed --version >/dev/null 2>&1; then SED_I=(sed -i); else SED_I=(sed -i ''); fi
}

# Per-OS system flake file; deploy, upgrade and add share one default.
default_flake_file() {
  if [ "$(uname -s)" = Darwin ]; then
    printf '/etc/nix-darwin/flake.nix'
  else
    printf '/etc/nixos/flake.nix'
  fi
}

# EVERY git+file input of the system flake, one line each in flake order:
# `<path>|<declared-tag-or-empty>|<state>` -- upgrade's work list and the
# whole picture its plan renders. An input upgrade will not act on is a
# LINE, never a silent omission: a plan that listed only the actionable
# inputs left a reader unable to tell "at its pin" from "this tool never
# looked at it".
#
# The declared tag rides along because upgrade must NOT route a tag-declared
# slot through a plain review: that clears the declaration, and deploy
# would leave ref= aimed at a tag that no longer names the rev. The state
# rides along because the ancestry class is upgrade's FLOOR -- only forward
# inputs may join an automatic ceremony -- and because everything else the
# scan can find out is what the quiet rows say:
#
#   norev        the input url carries no rev= (nix floats the ref)
#   noslot       no slot, or a slot holding no state
#   malformed    a slot read_rev refuses -- two state files, a tombstone, a
#                file pin, a corrupt record; deploy refuses on it too
#   nocheckout   nothing at that path that git reads as a work tree
#   nohead       a work tree with no commit at HEAD
#   missing-pin  the checkout no longer holds the pinned object
#   equal | forward | backward | diverged   HEAD's ancestry against the pin
#
# Staleness is the ancestry class, not a commit count. The old
# `rev-list --count <pin>..HEAD` test answered 0 for a checkout sitting
# BEHIND its pin, so a rolled-back working copy read as "nothing to do" and
# never appeared anywhere; classifying makes that state visible.
scan_flake_inputs() { # <flakefile> [tier-user]
  local flake="$1" tu="${2:-$(id -un)}" url p r slot approved head tag st
  grep -oE 'git\+file:///[^"]+' "$flake" | while IFS= read -r url; do
    p="${url#git+file://}"; p="${p%%\?*}"
    r="$(printf '%s' "$url" | grep -oE '[?&]rev=[0-9a-f]{40,128}' | head -n1 | cut -d= -f2 || true)"
    slot="$(slot_dir_for "$tu" "$p")"
    # First line only: the record is one name, and a stray second line must
    # not become a second field of this function's output.
    tag=""
    if [ -f "$slot/tag" ]; then IFS= read -r tag <"$slot/tag" || tag=""; fi
    approved=""
    if [ -z "$r" ]; then
      st=norev
    # read_rev's refusals (tombstone, file pin, malformed, corrupt) are one
    # state here: the plan says deploy will refuse, and deploy's own read is
    # where the accurate reason is printed.
    elif ! approved="$(read_rev "$slot" 2>/dev/null)"; then
      st=malformed
    elif [ -z "$approved" ]; then
      st=noslot
    # safe.directory: upgrade runs this as root on user-owned checkouts;
    # without it git's dubious-ownership refusal would silently read every
    # repo as not-a-repo (same fix sgit carries).
    elif ! { [ -d "$p" ] && git -C "$p" -c safe.directory="$p" rev-parse --git-dir >/dev/null 2>&1; }; then
      st=nocheckout
    # A pin the checkout no longer holds cannot be classified against
    # anything, so it gets its own state rather than a guessed class: a
    # remediation built on a guess is one the human cannot act on.
    elif ! git -C "$p" -c safe.directory="$p" cat-file -e "${approved}^{commit}" 2>/dev/null; then
      st=missing-pin
    else
      # --verify --quiet, not a bare rev-parse: a bare one ECHOES its
      # argument on failure, so an unborn HEAD handed the literal
      # 'HEAD^{commit}' to the classifier, which could relate it to nothing
      # and answered "diverged" -- a refused row for a repo with no commit.
      head="$(git -C "$p" -c safe.directory="$p" rev-parse --verify --quiet 'HEAD^{commit}' 2>/dev/null || true)"
      if [ -z "$head" ]; then
        st=nohead
      else
        st="$(ancestry_class "$p" "$approved" "$head")"
      fi
    fi
    printf '%s|%s|%s\n' "$p" "$tag" "$st"
  done || true
}

# The single release tag at a repo's HEAD, if there is EXACTLY one and it
# passes the declared-name grammar -- upgrade's deterministic selector for
# tag-declared slots. Empty output = no unambiguous release at HEAD (none,
# several, or an out-of-grammar name): route to a manual review --tag,
# never guess. A name-sorted "latest release" search is deliberately NOT
# offered: version sort is a convention, and the tag namespace is
# attacker-writable repo content -- an invented v99 or a backward-pointing
# tag must never CHOOSE what a ceremony reviews. A tag AT HEAD adds only a
# name to the commit a plain review would already cover.
head_release_tag() { # <repo-path>
  local t n
  t="$(git -C "$1" -c safe.directory="$1" tag --points-at HEAD 2>/dev/null || true)"
  [ -n "$t" ] || return 0
  n="$(printf '%s\n' "$t" | grep -c . || true)"
  [ "$n" = 1 ] || return 0
  validate_tag_name "$t" || return 0
  printf '%s' "$t"
}

# The signed-release OFFER's discovery: for one stale forward repo, the tags
# upgrade would hand to `review --signed-tag`, one per line.
#
# WHY SELECTION MAY HAPPEN HERE AND NOT IN head_release_tag ABOVE. Tag names
# are attacker-writable repo content, so an UNVERIFIED name must never CHOOSE
# what a ceremony covers -- that is why a name-sorted "latest release" search
# is refused. This selector never orders names: it verifies FIRST and orders
# the surviving set by ANCESTRY over the commit graph. Someone without the
# signer key cannot enter a candidate at all, and the holder of the key is
# exactly who the human already chose to trust by installing it. The offer is
# still only an offer -- do_approve re-verifies every tag as root, applies the
# ancestry floor, and the human confirms.
#
# Exit status carries the three outcomes the plan and the router render
# differently:
#   0  offer: the printed tags all name the unique ancestry-maximum commit
#   1  no offer: route this repo normally (plain review, or the tag rule)
#   2  verified tags disagree: no unique maximum -- by-hand work, skipped
#
# Runs BOTH root-side (do_upgrade) and unprivileged (the pre-sudo plan). A
# signers file the invoking user cannot read is "no offer", never an error:
# the plan degrades to the review route and the root side, which is the
# authority, re-derives the offer against the file it can read.
#
# $1 = repo path, $2 = tier user.
signed_upgrade_tags() {
  local repo="$1" tu="$2" slot signers pin head t c
  local cand_t cand_c n i j maxc ok
  slot="$(slot_dir_for "$tu" "$repo")"
  # Per-slot signers take precedence over the user tier, exactly as the
  # ceremony resolves them: a key trusted to vouch for one repo must not
  # implicitly vouch for every repo on the machine.
  signers="$slot/signers/allowed_signers"
  [ -f "$signers" ] || signers="$(policy_dir_for "$tu")/allowed_signers"
  [ -r "$signers" ] || return 1
  pin="$(read_rev "$slot" 2>/dev/null)" || return 1
  [ -n "$pin" ] || return 1
  head="$(sgit rev-parse --verify --quiet 'HEAD^{commit}' 2>/dev/null)" || return 1
  [ -n "$head" ] || return 1
  cand_t=(); cand_c=()
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    # The declared-name grammar, before anything else: a name upgrade could
    # not record as the slot's declaration is not a name it may offer.
    validate_tag_name "$t" || continue
    c="$(sgit rev-parse --verify --quiet "refs/tags/${t}"'^{commit}' 2>/dev/null)" || continue
    [ -n "$c" ] || continue
    # Strictly newer than the pin, and on the checkout's own line of
    # history: a release off to the side is by-hand work, not an offer.
    [ "$(ancestry_class "$repo" "$pin" "$c")" = forward ] || continue
    case "$(ancestry_class "$repo" "$c" "$head")" in
      equal|forward) ;;
      *) continue ;;
    esac
    sgit -c gpg.ssh.allowedSignersFile="$signers" verify-tag "$t" >/dev/null 2>&1 || continue
    cand_t+=("$t"); cand_c+=("$c")
  done <<EOF
$(sgit tag 2>/dev/null || true)
EOF
  n="${#cand_t[@]}"
  [ "$n" -gt 0 ] || return 1
  # The unique ancestry MAXIMUM: the candidate commit every other candidate
  # commit is an ancestor of. Two distinct commits can never both qualify
  # (mutual ancestry means equal), so finding one is finding the only one.
  maxc=""
  i=0
  while [ "$i" -lt "$n" ]; do
    ok=1
    j=0
    while [ "$j" -lt "$n" ]; do
      if [ "${cand_c[$j]}" != "${cand_c[$i]}" ]; then
        case "$(ancestry_class "$repo" "${cand_c[$j]}" "${cand_c[$i]}")" in
          forward) ;;
          *) ok=0; break ;;
        esac
      fi
      j=$((j + 1))
    done
    if [ "$ok" -eq 1 ]; then maxc="${cand_c[$i]}"; break; fi
    i=$((i + 1))
  done
  # Verified tags on lines that do not contain one another: nothing here can
  # say which release the human meant, and guessing is the one thing this
  # selector exists not to do.
  [ -n "$maxc" ] || return 2
  # Every verified tag naming that commit rides along. do_approve's
  # all-tags-must-agree rule then reads them as k-of-n agreement for free.
  i=0
  while [ "$i" -lt "$n" ]; do
    if [ "${cand_c[$i]}" = "$maxc" ]; then printf '%s\n' "${cand_t[$i]}"; fi
    i=$((i + 1))
  done
  return 0
}

# The offer's orientation: how far HEAD stands past the release that would be
# pinned. Empty when the tag names HEAD itself -- nothing to orient.
# $1 = repo path, $2 = tag name.
signed_offer_lag() {
  local repo="$1" c h n
  c="$(sgit rev-parse --verify --quiet "refs/tags/${2}"'^{commit}' 2>/dev/null)" || return 0
  h="$(sgit rev-parse --verify --quiet 'HEAD^{commit}' 2>/dev/null)" || return 0
  [ "$c" != "$h" ] || return 0
  n="$(sgit rev-list --count "${c}..HEAD" 2>/dev/null || true)"
  [ -n "$n" ] || return 0
  printf '%s' "$n"
}

# Which route one stale forward repo takes, in one word, plus the detail the
# plan and the router each need. The signed-release offer OUTRANKS both the
# head_release_tag rule and a plain review: a verified signature is stronger
# evidence than a name at HEAD, and it is what the plan puts on offer.
#
# Leaves the answer in $upg_route and its detail in $upg_info -- the
# inspect_slot convention (the caller declares both local), not a printed
# word, because a command substitution's subshell would strip the second
# half. The detail is the agreeing tag names for `signed`, the HEAD release
# for `tagged`, the stale declaration for `notag`, empty for the rest.
#   signed    review --signed-tag <tags>
#   disagree  verified tags with no unique maximum -- by-hand work
#   tagged    review --tag <release at HEAD>
#   notag     tag-declared, no single release at HEAD -- by-hand work
#   review    plain review
# $1 = repo path, $2 = declared tag ('' = rev-only slot), $3 = tier user.
upgrade_route() {
  local p="$1" tag="$2" tu="$3" rc=0 so ht
  upg_route="" upg_info=""
  so="$(signed_upgrade_tags "$p" "$tu")" || rc=$?
  case "$rc" in
    0) upg_route=signed; upg_info="$so"; return 0 ;;
    2) upg_route=disagree;              return 0 ;;
  esac
  if [ -z "$tag" ]; then upg_route=review; return 0; fi
  ht="$(head_release_tag "$p")"
  if [ -n "$ht" ]; then upg_route=tagged; upg_info="$ht"; return 0; fi
  upg_route=notag; upg_info="$tag"
}

# Render scan_flake_inputs output for humans: ONE aligned row per input, in
# flake order, and only the rows a ceremony will cover are highlighted. The
# quiet rows are the point -- an input at its pin, without a rev=, without a
# slot or without a checkout is a state the reader must be able to see, and
# an omitted line is indistinguishable from a tool that never looked.
#
# Routing is decided ONCE per repo up front rather than re-derived per row:
# deciding costs signature verifications, and a plan that could disagree
# with itself would be worse than a slow one. do_upgrade calls the same
# scan + upgrade_route pair, so the plan and the router cannot drift.
#
# $1 = scan lines, $2 = tier user, $3 = the flake file the scan read.
print_upgrade_plan() {
  local p tag st tu="${2:-$(id -un)}" flake="${3:-}" upg_route upg_info
  local r_p r_lbl r_lc r_pc r_det r_ex
  local n i w=0 act=0 quiet=0 lbl lc pc det ex pad t t1 tj lag
  if [ -z "$1" ]; then
    printf '%snothing to approve -- every pinned input is at its approved rev%s\n' "$C_DIM" "$C_OFF"
    return 0
  fi
  r_p=(); r_lbl=(); r_lc=(); r_pc=(); r_det=(); r_ex=()
  while IFS='|' read -r p tag st; do
    [ -n "$p" ] || continue
    # The quiet default: dim label, dim path, dim parenthetical. Only the
    # rows below that raise their voice say so.
    lbl="" lc="$C_DIM" pc="$C_DIM" det="" ex=""
    case "$st" in
      forward)
        upgrade_route "$p" "$tag" "$tu"
        case "$upg_route" in
          signed|tagged|review)
            # The actionable rows are the plan's payload -- bold cyan path,
            # the palette's own emphasis on an identifier (cyan everywhere;
            # yellow stays attention text), so they read before anything
            # quiet on the page does.
            lbl="review:" lc="$C_B" pc="$C_CYN$C_B"; act=1 ;;
        esac
        case "$upg_route" in
          signed)
            tj=""; t1=""
            while IFS= read -r t; do
              [ -n "$t" ] || continue
              [ -n "$t1" ] || t1="$t"
              if [ -z "$tj" ]; then tj="$t"; else tj="$tj, $t"; fi
            done <<EOF
$upg_info
EOF
            det="(signed release $tj -- signature-gated)"
            # The release, not HEAD, is what the ceremony pins; say so
            # wherever the two are not the same commit.
            lag="$(signed_offer_lag "$p" "$t1")"
            if [ -n "$lag" ]; then
              ex="HEAD is $lag commit$(plural_s "$lag") past the release; the release is what gets pinned"
            fi ;;
          tagged)
            det="(release tag $upg_info)" ;;
          notag)
            lbl="skipped:" lc="$C_YEL" pc=""
            det="(declared tag $upg_info; no single release tag at HEAD -- review --tag by hand)" ;;
          disagree)
            lbl="skipped:" lc="$C_YEL" pc=""
            det="(verified signed tags disagree -- review --signed-tag by hand)" ;;
        esac ;;
      equal)
        lbl="at pin:"; quiet=$((quiet + 1)) ;;
      # norev and noslot count as quiet too: the healthy summary tail says
      # "every PINNED input", and an input without a pin is not one -- its
      # row right above already tells the reader what it is.
      # The lattice's floor: an automatic ceremony only ever covers a
      # forward checkout. Un-approving commits, or abandoning the pinned
      # line, is a declaration a human makes by hand -- so these are named
      # loudly, with the flag that would declare them, and join no batch.
      backward)
        lbl="refused:" lc="$C_RED$C_B" pc=""
        det="(checkout is backward of the pin -- review --backward by hand)" ;;
      diverged)
        lbl="refused:" lc="$C_RED$C_B" pc=""
        det="(checkout diverged from the pin -- review --diverged by hand)" ;;
      norev)
        lbl="no pin:"; quiet=$((quiet + 1))
        det="(no rev= in the input -- nix floats the ref; nothing to sync)" ;;
      noslot)
        lbl="no slot:"; quiet=$((quiet + 1))
        det="(no pin slot -- deploys as hand-edited)" ;;
      malformed)
        lbl="no slot:" lc="$C_YEL" pc=""
        det="(slot does not read as a repo rev -- deploy refuses on it)" ;;
      nocheckout)
        lbl="no checkout:"
        det="(no git work tree at that path to compare against the pin)" ;;
      nohead)
        lbl="no head:"
        det="(work tree with no commit at HEAD)" ;;
      missing-pin)
        lbl="missing pin:" lc="$C_YEL" pc=""
        det="(pinned rev is missing from the checkout -- restore the commit or re-approve)" ;;
      *)
        # Unreachable while scan_flake_inputs is the only producer; printed
        # rather than dropped, so a new state cannot go invisible.
        lbl="?:" lc="$C_YEL" pc=""
        det="(unrecognized state $st)" ;;
    esac
    [ "${#lbl}" -gt "$w" ] && w="${#lbl}"
    r_p+=("$p"); r_lbl+=("$lbl"); r_lc+=("$lc"); r_pc+=("$pc")
    r_det+=("$det"); r_ex+=("$ex")
  done <<EOF
$1
EOF
  n="${#r_p[@]}"
  [ "$n" -gt 0 ] || return 0
  if [ -n "$flake" ]; then
    printf '%sInputs in %s:%s\n' "$C_B" "$flake" "$C_OFF"
  else
    printf '%sInputs:%s\n' "$C_B" "$C_OFF"
  fi
  # The label column is padded uncolored -- %-*s counts escape bytes, so the
  # width has to be applied before the colour is wrapped around it.
  pad="$(printf '%*s' "$((w + 4))" '')"
  i=0
  while [ "$i" -lt "$n" ]; do
    printf '  %s%s%s  %s%s%s' \
      "${r_lc[$i]}" "$(printf '%-*s' "$w" "${r_lbl[$i]}")" "$C_OFF" \
      "${r_pc[$i]}" "${r_p[$i]}" "$C_OFF"
    if [ -n "${r_det[$i]}" ]; then
      printf '  %s%s%s' "$C_DIM" "${r_det[$i]}" "$C_OFF"
    fi
    printf '\n'
    if [ -n "${r_ex[$i]}" ]; then
      printf '%s%s%s%s\n' "$pad" "$C_DIM" "${r_ex[$i]}" "$C_OFF"
    fi
    i=$((i + 1))
  done
  if [ "$act" -eq 0 ]; then
    # Same opening either way -- it is what a reader (and the harness) looks
    # for -- but the tail must not claim every input is at its pin when the
    # rows above say a checkout is refused or skipped.
    if [ "$quiet" -eq "$n" ]; then
      printf '%snothing to approve -- every pinned input is at its approved rev%s\n' "$C_DIM" "$C_OFF"
    else
      printf '%snothing to approve -- no input above is a forward checkout upgrade may cover%s\n' \
        "$C_DIM" "$C_OFF"
    fi
  fi
}

# Root-requiring actions self-elevate: re-exec the INSTALLED (root-owned,
# digest-pinned) binary under sudo so the elevated code is never a copy the
# invoker could have modified. Pre-install (setup from a checkout) falls
# back to this script's own path. Sits after the helper definitions so the
# review preview below can reuse them.
case "$action" in
  review|add|setup|tombstone|upgrade|mv)
    if [ "$EUID" -ne 0 ]; then
      # tombstone without exactly its <path> can only ever reach usage --
      # fail here, before authentication costs a sudo prompt.
      if [ "$action" = "tombstone" ] && [ $# -ne 1 ]; then usage; fi
      # mv: two paths that differ, and an old path that is really gone --
      # every one of those is checkable free, so none of them costs an
      # authentication. The peek below is orientation only; the root side
      # re-reads the slot and stays the authority.
      if [ "$action" = "mv" ]; then
        [ $# -eq 2 ] || usage
        mv_old="$(canon_path "$1")" || exit 1
        mv_new="$(canon_path "$2")" || exit 1
        if [ "$mv_old" = "$mv_new" ]; then
          echo "REFUSE: old and new name the same path: $mv_old" >&2
          exit 1
        fi
        if [ -e "$mv_old" ]; then
          echo "REFUSE: $mv_old still exists -- you mv a record whose content has already moved" >&2
          echo "        (move the content first, or review $mv_new instead)" >&2
          exit 1
        fi
        printf '%sold:%s        %s %s(gone)%s\n' "$C_B" "$C_OFF" "$mv_old" "$C_DIM" "$C_OFF"
        printf '%snew:%s        %s\n' "$C_B" "$C_OFF" "$mv_new"
        mv_slot="$(slot_dir_for "$(tier_user)" "$mv_old")"
        # Nothing is CONCLUDED from what this peek cannot see: the tier is
        # root-only until the group exists, so an absent-looking slot may
        # simply be one this user cannot traverse. Hence one honest line for
        # both, and no refusal built on it.
        if [ -d "$mv_slot" ] && inspect_slot "$mv_slot" 2>/dev/null \
           && [ "$slot_state" != none ]; then
          printf '%srecord:%s     %s%s%s %s(%s)%s\n' "$C_B" "$C_OFF" \
            "$C_CYN" "${slot_file##*/}" "$C_OFF" "$C_DIM" "$mv_slot" "$C_OFF"
        else
          printf '%srecord:%s     %s(none visible from here; the root side reads it and answers)%s\n' \
            "$C_B" "$C_OFF" "$C_DIM" "$C_OFF"
        fi
        echo
      fi
      # upgrade: the plan, free of charge -- every input of the flake, with
      # the ones the root-side ceremonies will cover highlighted among them.
      # Orientation only: everything is re-derived as root after sudo, the
      # same contract as review's preview.
      # Malformed argv dies here too, before authentication.
      if [ "$action" = "upgrade" ]; then
        upg_flake="" upg_next=0
        for a in "$@"; do
          if [ "$upg_next" -eq 1 ]; then upg_flake="$a"; upg_next=0; continue; fi
          case "$a" in
            --flake) upg_next=1 ;;
            --dry-run|--yes) ;;
            *) usage ;;
          esac
        done
        [ "$upg_next" -eq 0 ] || { echo "--flake needs a path" >&2; exit 1; }
        [ -n "$upg_flake" ] || upg_flake="$(default_flake_file)"
        [ -r "$upg_flake" ] || {
          printf '%serror: cannot read %s -- pass --flake%s\n' "$C_RED" "$upg_flake" "$C_OFF" >&2
          exit 1
        }
        print_upgrade_plan "$(scan_flake_inputs "$upg_flake")" "$(tier_user)" "$upg_flake"
        printf '%sThen: deploy (sync flake revs to the pins + rebuild)%s\n\n' "$C_DIM" "$C_OFF"
      fi
      # setup: show the plan and confirm BEFORE sudo, so reading what it
      # will do never costs an authentication.
      if [ "$action" = "setup" ]; then
        want_yes=0
        for a in "$@"; do [ "$a" = "--yes" ] && want_yes=1; done
        if [ "$want_yes" -eq 0 ]; then
          setup_plan "$(id -un)"
          printf '%sproceed? [y/N]%s ' "$C_B" "$C_OFF"
          read -r answer </dev/tty
          case "$answer" in
            y|Y|yes) ;;
            *) echo "aborted; nothing installed"; exit 2 ;;
          esac
          set -- --yes "$@"
        fi
      fi
      # review: an unprivileged PREVIEW of what authenticating will let
      # you review, so the sudo prompt never arrives context-free. This is
      # orientation only -- the authoritative review re-derives everything
      # from the object store as root, after sudo.
      if [ "$action" = "review" ]; then
        preview_repos=() preview_tag="" skip_next=0 want_tag=0 file_mode=0 have_ev=0
        preview_step=0 preview_trust=0 preview_signed=0 preview_decl=""
        for a in "$@"; do
          if [ "$want_tag" -eq 1 ]; then preview_tag="$a"; want_tag=0; continue; fi
          if [ "$skip_next" -eq 1 ]; then skip_next=0; continue; fi
          case "$a" in
            --signed-tag) have_ev=1; preview_signed=1; skip_next=1 ;;
            --file) file_mode=1; skip_next=1 ;;
            --baseline|--algo) skip_next=1 ;;
            --tag) have_ev=1; want_tag=1 ;;
            --trust) have_ev=1; preview_trust=1 ;;
            # A bare flag, not evidence -- it says HOW the review is read,
            # not why the commit is trusted. It still binds to one repo.
            --step) preview_step=1 ;;
            # Not evidence either: an ancestry DECLARATION says which way
            # the pin is being moved. It binds to one repo like the rest.
            --backward|--diverged)
              case "$preview_decl" in
                ''|"${a#--}") preview_decl="${a#--}" ;;
                *) echo "--backward and --diverged declare different relationships; give one" >&2
                   exit 1 ;;
              esac ;;
            -*) ;;
            *) preview_repos+=("$a") ;;
          esac
        done
        # A bare review -- no repo, no --file -- can only ever reach
        # usage; fail here, before authentication costs a sudo prompt.
        if [ "${#preview_repos[@]}" -eq 0 ] && [ "$file_mode" -eq 0 ]; then usage; fi
        # --step's refusals, mirrored pre-sudo. The root side re-checks every
        # one of these (it is the authority); refusing here only saves the
        # wasted authentication.
        if [ "$preview_step" -eq 1 ]; then
          if [ "$file_mode" -eq 1 ]; then
            echo "--file is its own ceremony; --step does not combine with it" >&2
            exit 1
          fi
          if [ "$preview_trust" -eq 1 ]; then
            echo "--step is a per-commit review walk; --trust skips review" >&2
            exit 1
          fi
          if [ "$preview_signed" -eq 1 ]; then
            echo "--step is a per-commit review walk; signature evidence has no per-commit reading" >&2
            exit 1
          fi
          if [ -n "$preview_decl" ]; then
            echo "--step walks the commits between the pin and the endpoint, which only exist going forward;" >&2
            echo "review --$preview_decl without --step: the whole-delta diff shows what actually changes" >&2
            exit 1
          fi
        fi
        # The ancestry declarations' own refusals, mirrored pre-sudo like
        # --step's. (The classification itself happens per repo below, where
        # the pin is read.)
        if [ -n "$preview_decl" ]; then
          if [ "$file_mode" -eq 1 ]; then
            echo "--file is its own ceremony; the ancestry declarations do not combine with it" >&2
            exit 1
          fi
          if [ "$preview_trust" -eq 1 ]; then
            echo "--trust vouches for a first approval; there is no pin to move --$preview_decl from" >&2
            exit 1
          fi
        fi
        # Selector and evidence flags name ONE commit of ONE repo, and the
        # step walk is one interactive read of one repo; a batch they cannot
        # bind to dies here, pre-sudo (the root side re-checks).
        if [ "${#preview_repos[@]}" -gt 1 ] \
          && { [ "$have_ev" -eq 1 ] || [ "$preview_step" -eq 1 ] || [ -n "$preview_decl" ]; }; then
          echo "--tag, --signed-tag, --trust, --step and the ancestry declarations bind to one repo; review multiple repos plain" >&2
          exit 1
        fi
        if [ "${#preview_repos[@]}" -gt 0 ] && [ "$file_mode" -eq 0 ]; then
          # One preview per repo; sequential root-side ceremonies follow,
          # sharing the single authentication below.
          all_pinned=1 first_prev=1
          for preview_repo in "${preview_repos[@]}"; do
            resolve_repo "$preview_repo"
            # A bad --tag name dies HERE, pre-sudo -- failing early is the
            # point of the preview.
            if [ -n "$preview_tag" ]; then
              preview_head="$(sgit rev-parse "refs/tags/${preview_tag}"'^{commit}')"
            else
              preview_head="$(sgit rev-parse 'HEAD^{commit}')"
            fi
            # Errors silenced: the tree may be root-only pre-group, and the
            # root-side re-derivation is authoritative anyway.
            preview_pin="$(read_rev "$default_slot" 2>/dev/null)" || preview_pin=""
            # A stepped walk needs a pin to step FROM. (An unreadable slot
            # reads as "no pin" here because the read above is silenced; the
            # root side answers such a slot with its own, accurate refusal.)
            if [ "$preview_step" -eq 1 ] && [ -z "$preview_pin" ]; then
              echo "first approval reviews the full tree; review without --step" >&2
              exit 1
            fi
            # Same short-circuit the privileged side would take -- but here it
            # costs no authentication. The pin is root-owned; HEAD is the
            # repo the caller is looking at.
            if [ -n "$preview_pin" ] && [ "$preview_pin" = "$preview_head" ]; then
              printf '%salready pinned:%s %s  %s%s%s\n' "$C_GRN" "$C_OFF" "$repo" "$C_DIM" "$preview_head" "$C_OFF"
              continue
            fi
            all_pinned=0
            [ "$first_prev" -eq 1 ] || echo
            first_prev=0
            # THE ANCESTRY FLOOR, mirrored: an undeclared backward or
            # diverged move is refused HERE, so it never costs an
            # authentication, and a declared one gets its alarm before the
            # sudo prompt rather than after it. Classification is free
            # unprivileged -- the pin is world-readable in the tier and the
            # commit graph is the caller's own checkout. The root side
            # re-derives all of it and stays the authority.
            #
            # An unreadable slot read as "no pin" above simply classifies
            # nothing here; the root side answers such a slot accurately.
            ancestry_floor "$repo" "$preview_pin" "$preview_head" "$preview_decl" || exit 1
            printf '%srepo:%s       %s%s%s  %s(%s)%s\n' "$C_B" "$C_OFF" "$C_B$C_MAG" "${repo##*/}" "$C_OFF" \
              "$C_DIM" "$repo" "$C_OFF"
            if [ -n "$preview_tag" ]; then
              printf '%stag:%s        %s\n' "$C_B" "$C_OFF" "$preview_tag"
              printf '%scandidate:%s  %s%s%s  %s(%s)%s\n' "$C_B" "$C_OFF" "$C_CYN" "$preview_head" "$C_OFF" \
                "$C_DIM" "$(sgit log -1 --format=%s "$preview_head")" "$C_OFF"
            else
              printf '%sgit HEAD:%s   %s%s%s  %s(%s)%s\n' "$C_B" "$C_OFF" "$C_CYN" "$preview_head" "$C_OFF" \
                "$C_DIM" "$(sgit log -1 --format=%s "$preview_head")" "$C_OFF"
            fi
            if [ -n "$preview_pin" ]; then
              printf '%spinned:%s     %s%s%s\n' "$C_B" "$C_OFF" "$C_CYN" "$preview_pin" "$C_OFF"
              if [ -n "$ancestry_mb" ]; then
                printf '%smerge base:%s %s%s%s\n' "$C_B" "$C_OFF" "$C_CYN" "$ancestry_mb" "$C_OFF"
              fi
              if [ "$preview_pin" != "$preview_head" ]; then
                echo
                print_ancestry_listing "$ancestry_cls" "$preview_pin" "$preview_head" \
                  "$ancestry_mb" label '  '
                if [ "$preview_step" -eq 1 ]; then
                  # Counted with the walk's OWN enumeration, so the number
                  # promised here is the number of confirmations that arrive.
                  preview_steps="$(sgit log --reverse --first-parent --format=%H \
                    "${preview_pin}..${preview_head}" | wc -l | tr -d ' ')"
                  printf '  %sstepping: %s commit%s, oldest first, one confirmation each%s\n' \
                    "$C_DIM" "$preview_steps" "$(plural_s "$preview_steps")" "$C_OFF"
                fi
              fi
            else
              printf '%spinned:%s     (none -- first approval)\n' "$C_B" "$C_OFF"
            fi
          done
          # Every named repo is already at its pin: the whole invocation
          # is a no-op, and it costs no authentication to say so.
          if [ "$all_pinned" -eq 1 ]; then
            printf '%s(nothing to approve; no authentication needed)%s\n' "$C_DIM" "$C_OFF"
            exit 0
          fi
          echo
        fi
      fi
      # add: orientation for each of the three parts -- which checkout, which
      # ceremony, which flake -- so the sudo prompt never arrives
      # context-free. Argv that can only ever reach a root-side argument
      # error dies here, before authentication costs a prompt. Everything
      # below is re-derived as root after sudo, which stays the authority.
      if [ "$action" = "add" ]; then
        add_arg="" add_name="" add_flake="" add_want="" add_signed=0
        for a in "$@"; do
          if [ -n "$add_want" ]; then
            # The token is the flag's own name, so a value missing at the
            # end of argv is named accurately in the refusal below.
            case "$add_want" in
              input) add_name="$a" ;;
              flake) add_flake="$a" ;;
            esac
            add_want=""; continue
          fi
          case "$a" in
            --input) add_want=input ;;
            --flake) add_want=flake ;;
            --signed-tag) add_signed=1; add_want=signed-tag ;;
            -*) usage ;;
            *)
              [ -z "$add_arg" ] || { echo "add takes one repo or url" >&2; exit 1; }
              add_arg="$a" ;;
          esac
        done
        # Word for word what the root side says, so a refusal reads the same
        # whichever half of the verb produced it.
        if [ -n "$add_want" ]; then
          case "$add_want" in
            input)      echo "--input needs a name" >&2 ;;
            flake)      echo "--flake needs a path" >&2 ;;
            signed-tag) echo "--signed-tag needs a tag" >&2 ;;
          esac
          exit 1
        fi
        [ -n "$add_arg" ] || usage
        add_kind="$(add_arg_kind "$add_arg")" || exit 1
        [ -n "$add_name" ] || add_name="$(add_input_name "$add_arg")"
        validate_input_name "$add_name" || {
          echo "ERROR: input name '$add_name' is outside the name grammar [A-Za-z_][A-Za-z0-9_-]*" >&2
          echo "       it becomes a nix attribute and a root-owned directory name; pass --input <name>" >&2
          exit 1
        }
        [ -n "$add_flake" ] || add_flake="$(default_flake_file)"
        [ -r "$add_flake" ] || {
          printf '%serror: cannot read %s -- pass --flake%s\n' "$C_RED" "$add_flake" "$C_OFF" >&2
          exit 1
        }
        if [ "$add_kind" = path ]; then
          add_checkout="$(canon_path "$add_arg")" || exit 1
          printf '%sargument:%s   %s  %s(existing checkout, used in place)%s\n' \
            "$C_B" "$C_OFF" "$add_arg" "$C_DIM" "$C_OFF"
        else
          add_checkout="$PINNED_CLONES/$add_name"
          if [ -d "$add_checkout" ]; then
            printf '%sargument:%s   %s  %s(url; a clone is already at the destination)%s\n' \
              "$C_B" "$C_OFF" "$add_arg" "$C_DIM" "$C_OFF"
          else
            printf '%sargument:%s   %s  %s(url; cloned as %s, never as root)%s\n' \
              "$C_B" "$C_OFF" "$add_arg" "$C_DIM" "$(id -un)" "$C_OFF"
          fi
        fi
        printf '%scheckout:%s   %s\n' "$C_B" "$C_OFF" "$add_checkout"
        printf '%sinput:%s      %s\n' "$C_B" "$C_OFF" "$add_name"
        printf '%sflake:%s      %s\n' "$C_B" "$C_OFF" "$add_flake"
        # Errors silenced: the tier is root-only until the group exists, so
        # an unreadable slot simply reads as "no pin" here.
        add_pin=""
        if [ -d "$add_checkout" ]; then
          add_pin="$(read_rev "$(slot_dir_for "$(tier_user)" "$(canon_path "$add_checkout")")" 2>/dev/null)" \
            || add_pin=""
        fi
        if [ -n "$add_pin" ]; then
          printf '%sceremony:%s   %s(none -- already pinned at %s)%s\n' \
            "$C_B" "$C_OFF" "$C_DIM" "${add_pin:0:10}" "$C_OFF"
        elif [ "$add_signed" -eq 1 ]; then
          printf '%sceremony:%s   signature gate %s(the named tags must verify against your allowed signers)%s\n' \
            "$C_B" "$C_OFF" "$C_DIM" "$C_OFF"
        else
          printf '%sceremony:%s   first approval %s(full-tree review)%s\n' \
            "$C_B" "$C_OFF" "$C_DIM" "$C_OFF"
        fi
        printf '%sThen: the input block, shown in full and confirmed before the flake is touched%s\n\n' \
          "$C_DIM" "$C_OFF"
      fi
      elev="$INSTALL_TARGET"
      if [ -x "$elev" ]; then
        # Refuse to hand sudo a target that is not root-owned end to end.
        # Not hypothetical: old Homebrew left /usr/local user-owned on
        # many Intel Macs, which would make the "installed" copy exactly
        # as swappable as the checkout.
        verify_root_owned_path "$elev" || exit 1
        verify_ancestry "$elev" || exit 1
      else
        # Pre-install fallback: the checkout copy is USER-WRITABLE, so
        # running it as root is only safe in the bootstrap window right
        # after a hand-read. Never silent: warn and confirm. (setup is
        # exempt -- installing the just-read checkout is its whole job.)
        elev="$(readlink -f "$0")"
        if [ "$action" != "setup" ]; then
          printf '%swarning: pinned is not installed at %s.%s\n' "$C_YEL$C_B" "$INSTALL_TARGET" "$C_OFF"
          printf '%s  About to run the uninstalled, user-writable copy at%s\n' "$C_YEL" "$C_OFF"
          printf '%s  %s as root.%s\n' "$C_YEL" "$elev" "$C_OFF"
          printf '%s  Only proceed if you have just read this exact file and%s\n' "$C_YEL" "$C_OFF"
          printf '%s  trust your user-space not to have swapped it since.%s\n' "$C_YEL" "$C_OFF"
          printf '%s  Safer: stage with trusted tooling, read the root-owned copy,%s\n' "$C_YEL" "$C_OFF"
          printf '%s  promote it, rerun (README: "Bootstrap without executing%s\n' "$C_YEL" "$C_OFF"
          printf '%s  unverified code"):%s\n' "$C_YEL" "$C_OFF"
          printf '    sudo /usr/bin/install -d -o root -g wheel -m 755 %s\n' "$(dirname "$INSTALL_TARGET")"
          printf '    sudo /usr/bin/install -o root -g wheel -m 444 \\\n'
          printf '      %s %s-unverified\n' "$elev" "$INSTALL_TARGET"
          printf '    less %s-unverified\n' "$INSTALL_TARGET"
          printf '    sudo mv %s-unverified %s\n' "$INSTALL_TARGET" "$INSTALL_TARGET"
          printf '    sudo chmod 755 %s\n' "$INSTALL_TARGET"
          printf '%scontinue? [y/N]%s ' "$C_B" "$C_OFF"
          read -r answer </dev/tty
          case "$answer" in
            y|Y|yes) ;;
            *) echo "aborted" ; exit 2 ;;
          esac
        fi
      fi
      # Say what the authentication buys BEFORE sudo asks for it, in
      # deploy's shape: the exact command, then one dim line for the
      # contract. The ownership/digest details that used to follow said
      # nothing the checks just above had not already enforced -- the
      # command line and the contract are the parts a reader acts on.
      #
      # THE CONTRACT LINE BELONGS TO WHOEVER ORIENTED. It says "the preview
      # above", so it is printed by the process that printed that preview:
      # pinned, for the repo verbs, whose preview is a few lines up. A
      # `review --file` has no preview of its own -- the launcher that
      # measured the files printed the index and owns the sentence there --
      # so pinned saying it too would either double the launcher's line
      # around "Will run as root:", or point at nothing at all on a direct
      # invocation.
      if { [ "$action" = "review" ] || [ "$action" = "upgrade" ] || [ "$action" = "add" ]; } \
        && [ "$elev" = "$INSTALL_TARGET" ]; then
        cmd_disp="$(elevation_cmd_disp "$elev" "$action" "$@")"
        printf '%sWill run as root:%s\n' "$C_B" "$C_OFF"
        printf '  %s\n\n' "$cmd_disp"
        if [ "${file_mode:-0}" -eq 0 ]; then
          printf '%sThe preview above was orientation only. The sudo ceremony re-derives\n' "$C_DIM"
          printf 'everything it displays, and nothing is pinned until you confirm there.%s\n\n' "$C_OFF"
        fi
      fi
      exec sudo -- "$elev" "$action" "$@"
    fi
    ;;
  signer|ignorable)
    # add/remove write root-owned files; list stays unprivileged. One arm
    # for both verbs: they share the sub-verb shape, and the exec below
    # re-execs whichever $action asked for it.
    case "${1:-}" in
      add|remove)
        if [ "$EUID" -ne 0 ]; then
          # Argv that can only ever reach a root-side argument error fails
          # HERE, before authentication costs a sudo prompt -- the same
          # contract as review's preview. Grammar and content stay
          # root-side; presence of the ceremony's object is checkable free.
          if [ "$action" = "signer" ]; then
            has_key=0 skip_next=0
            for a in "$@"; do
              if [ "$skip_next" -eq 1 ]; then skip_next=0; continue; fi
              case "$a" in
                --file|--key) has_key=1; skip_next=1 ;;
                --repo|--principal) skip_next=1 ;;
              esac
            done
            if [ "$has_key" -eq 0 ]; then
              echo "signer $1 needs the key: --file <pubkey> or --key '<line>'" >&2
              exit 1
            fi
          else
            ign_key="" skip_next=0 first=1
            for a in "$@"; do
              if [ "$first" -eq 1 ]; then first=0; continue; fi
              if [ "$skip_next" -eq 1 ]; then skip_next=0; continue; fi
              case "$a" in
                --under) skip_next=1 ;;
                -*) ;;
                *) ign_key="$a" ;;
              esac
            done
            if [ -z "$ign_key" ]; then
              echo "ignorable $1 needs a key, e.g. model or statusLine.command" >&2
              exit 1
            fi
          fi
          elev="$INSTALL_TARGET"
          if [ -x "$elev" ]; then
            verify_root_owned_path "$elev" || exit 1
            verify_ancestry "$elev" || exit 1
          else
            elev="$(readlink -f "$0")"
            printf '%swarning: pinned is not installed at %s; about to run the\nuser-writable checkout copy as root (safe only right after a hand-read).%s\n' \
              "$C_YEL" "$INSTALL_TARGET" "$C_OFF"
            printf '%scontinue? [y/N]%s ' "$C_B" "$C_OFF"
            read -r answer </dev/tty
            case "$answer" in
              y|Y|yes) ;;
              *) echo "aborted"; exit 2 ;;
            esac
          fi
          # The pre-sudo handoff review gives, in the same shape: the
          # exact command, then what the authentication buys. The root
          # side stays authoritative -- it displays the object and
          # confirms before writing.
          if [ "$elev" = "$INSTALL_TARGET" ]; then
            printf '%sWill run as root:%s\n' "$C_B" "$C_OFF"
            printf '  %s\n\n' "$(elevation_cmd_disp "$elev" "$action" "$@")"
            printf '%ssudo asks you to authenticate; the root-side ceremony shows the %s\nand confirms -- nothing is written until you answer y after it.%s\n\n' \
              "$C_YEL$C_B" "$([ "$action" = signer ] && echo "key" || echo "grant")" "$C_OFF"
          fi
          exec sudo -- "$elev" "$action" "$@"
        fi
        ;;
    esac
    ;;
esac

# ---- review ------------------------------------------------------------------

do_approve() {
  require_root review

  # Orthogonal surface: --tag selects WHICH commit (default HEAD) and, once
  # slots record names, what deploy declares; the evidence flags say WHY it
  # is trusted (--signed-tag verifies, --trust vouches, default is content
  # review). --signed-tag may repeat: threshold multisig. Every named tag
  # must verify against the allowed signers AND name the same commit, or
  # nothing is pinned. k-of-n is the caller demanding whichever k tags they
  # trust.
  local trust=0 repo_args sel_tag="" tag_args files file_base file_ign file_algo=sha256 algo_given=0
  local store=0 ign_given=0 last step=0 decl_class=""
  repo_args=(); tag_args=(); files=(); file_base=(); file_ign=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --signed-tag) tag_args+=("$2"); shift 2 ;;
      --tag)
        [ -z "$sel_tag" ] || { echo "--tag may be given once (it selects the commit)" >&2; exit 1; }
        sel_tag="$2"; shift 2 ;;
      --trust)      trust=1; shift ;;
      # A READING AID for a large delta, never the norm: walk the commits
      # since the pin oldest-first, one diff and one confirmation each, and
      # advance the pin at every yes -- so stopping midway still leaves a
      # coherent, deployable record. The single whole-delta diff stays the
      # default.
      #
      # KNOWN COMPOSITION RISK: an attacker can split mayhem across commits
      # that each read innocently. Per-commit reading covers the same total
      # lines but fragments the attention that would notice the seam, which
      # is why the walk always closes with a whole-run summary (the
      # aggregate diffstat over everything approved in one sitting).
      --step)       step=1; shift ;;
      # The ancestry DECLARATIONS: what the human believes they are
      # approving. Reality must conform (ancestry_gate) or the ceremony
      # refuses -- these widen nothing on their own, they only unlock a
      # ceremony the floor would otherwise refuse.
      --backward|--diverged)
        case "$decl_class" in
          ''|"${1#--}") decl_class="${1#--}" ;;
          *) echo "--backward and --diverged declare different relationships; give one" >&2
             exit 1 ;;
        esac
        shift ;;
      --file)
        [ $# -ge 2 ] || { echo "--file needs a path" >&2; exit 1; }
        files+=("$2"); file_base+=(""); file_ign+=(""); shift 2 ;;
      --baseline)
        [ $# -ge 2 ] || { echo "--baseline needs a path" >&2; exit 1; }
        [ "${#files[@]}" -gt 0 ] \
          || { echo "--baseline must follow the --file it belongs to" >&2; exit 1; }
        [ -z "${file_base[$((${#files[@]} - 1))]}" ] \
          || { echo "one --baseline per --file" >&2; exit 1; }
        file_base[$((${#files[@]} - 1))]="$2"; shift 2 ;;
      --ignore-json-key)
        # Repeatable, and attaches to the preceding --file exactly like
        # --baseline: WHICH keys may drift is a per-path declaration. The
        # flag names its FORMAT because the slot file does (ignored.json);
        # another format would be another flag, never a guess. The dotted
        # spelling is the CLI's convenience form; the slot stores the jq
        # path array it converts to.
        [ $# -ge 2 ] || { echo "--ignore-json-key needs a key" >&2; exit 1; }
        [ "${#files[@]}" -gt 0 ] \
          || { echo "--ignore-json-key must follow the --file it belongs to" >&2; exit 1; }
        validate_ignore_key "$2" || {
          echo "ERROR: ignored key '$2' is outside the key grammar: dotted [A-Za-z0-9_.-]," >&2
          echo "       no leading/trailing/doubled dot, no array subscripts" >&2
          exit 1
        }
        last=$((${#files[@]} - 1))
        file_ign[last]="${file_ign[last]:+${file_ign[last]} }$2"
        ign_given=1; shift 2 ;;
      # Custody, for the whole ceremony rather than per --file: it is one
      # disclosure decision the human is confirming, and a ceremony that
      # stored some of its files and not others would be a decision nobody
      # could read off the command line. FREELY COMBINABLE -- custody serves
      # the ignored-key comparison, but also archives exactly what was
      # approved and feeds the next ceremony's diff, so it means something on
      # a ceremony that declares nothing.
      --store)     store=1; shift ;;
      --algo)
        [ $# -ge 2 ] || { echo "--algo needs a value" >&2; exit 1; }
        file_algo="$2"; algo_given=1; shift 2 ;;
      -*)           usage ;;
      *)            repo_args+=("$1"); shift ;;
    esac
  done
  # The file-pin ceremony is its own mode: repo selectors, evidence flags
  # and the repo walk say nothing about file content.
  if [ "${#files[@]}" -gt 0 ]; then
    if [ "${#repo_args[@]}" -gt 0 ] || [ -n "$sel_tag" ] || [ "$trust" -eq 1 ] \
      || [ "${#tag_args[@]}" -gt 0 ] || [ "$step" -eq 1 ] || [ -n "$decl_class" ]; then
      echo "--file is its own ceremony; repo arguments, evidence flags, --step and the ancestry declarations do not combine with it" >&2
      exit 1
    fi
    do_approve_files
    return
  fi
  [ "$algo_given" -eq 0 ] || { echo "--algo applies to the --file ceremony only" >&2; exit 1; }
  [ "$store" -eq 0 ] || { echo "--store applies to the --file ceremony only" >&2; exit 1; }
  [ "${#repo_args[@]}" -ge 1 ] || usage
  case "$sel_tag" in
    -*) echo "invalid tag name: $sel_tag" >&2; exit 1 ;;
  esac
  # A vouch adds nothing to a signature gate; refuse the no-op combination
  # rather than silently ignoring one flag.
  if [ "$trust" -eq 1 ] && [ "${#tag_args[@]}" -gt 0 ]; then
    echo "--trust adds nothing to a signature-gated review; drop one" >&2
    exit 1
  fi
  # --step's refusals (the preview refuses the same set pre-sudo; these are
  # the authoritative re-checks). Each is a combination whose meaning is not
  # "walk the commits": evidence flags say the content is not being read at
  # all. --tag is NOT refused -- it is a selector, and the walk simply ends
  # at the commit it names instead of HEAD.
  if [ "$step" -eq 1 ]; then
    if [ "$trust" -eq 1 ]; then
      echo "--step is a per-commit review walk; --trust skips review" >&2
      exit 1
    fi
    if [ "${#tag_args[@]}" -gt 0 ]; then
      echo "--step is a per-commit review walk; signature evidence has no per-commit reading" >&2
      exit 1
    fi
    # upgrade's internal batch contract: a decline must fall through to the
    # deploy step, which a walk that advances the pin mid-flight cannot
    # honour. Defensive -- upgrade never passes --step.
    if [ "${APPROVE_BATCH:-0}" -ne 0 ]; then
      echo "--step is an interactive single-repo walk; it does not run inside a batch review" >&2
      exit 1
    fi
    # The walk is a FORWARD reading by construction: it replays the commits
    # between the pin and the endpoint, oldest first. There are no such
    # commits to replay when the endpoint sits behind or beside the pin.
    if [ -n "$decl_class" ]; then
      echo "--step walks the commits between the pin and the endpoint, which only exist going forward;" >&2
      echo "review --$decl_class without --step: the whole-delta diff shows what actually changes" >&2
      exit 1
    fi
  fi
  # A vouch is a first-approval-only escape from reading the tree; there is
  # no pin for it to move away from, so it can never meet a declaration.
  if [ "$trust" -eq 1 ] && [ -n "$decl_class" ]; then
    echo "--trust vouches for a first approval; there is no pin to move --$decl_class from" >&2
    exit 1
  fi
  # Selector and evidence flags name ONE commit of ONE repo, and the step
  # walk is one interactive read of one repo; a multi-repo batch is plain
  # review approvals only (the pre-sudo preview refuses the same
  # combination -- this is the authoritative re-check).
  if [ "${#repo_args[@]}" -gt 1 ] \
    && { [ -n "$sel_tag" ] || [ "$trust" -eq 1 ] || [ "${#tag_args[@]}" -gt 0 ] || [ "$step" -eq 1 ] \
      || [ -n "$decl_class" ]; }; then
    echo "--tag, --signed-tag, --trust, --step and the ancestry declarations bind to one repo; review multiple repos plain" >&2
    exit 1
  fi

  # Create the pin tree BEFORE the ancestry checks -- review must work on
  # machines that never ran setup (declarative installs); ensure_tree also
  # re-asserts ownership and modes on an existing tree.
  ensure_tree "$inv"

  # Sequential ceremonies over the named repos, one sudo authentication for
  # the batch (the file ceremony's shape): each repo is displayed and
  # confirmed on its own, a decline skips ONLY that repo, and a hard error
  # aborts the batch loudly. With one repo the contract is unchanged:
  # already-pinned exits 0, a decline exits 2. upgrade forces the batch
  # contract even for one repo (APPROVE_BATCH): its decline must fall
  # through to the deploy step, never abort it.
  local multi=0 n_approved=0 n_declined=0 n_already=0 repo_arg
  [ "${#repo_args[@]}" -le 1 ] && [ "${APPROVE_BATCH:-0}" -eq 0 ] || multi=1
  for repo_arg in "${repo_args[@]}"; do
    resolve_repo "$repo_arg"
    local slot="$default_slot"
    if [ -n "$sel_tag" ]; then
      sgit check-ref-format "refs/tags/$sel_tag" \
        || { echo "invalid tag name: $sel_tag" >&2; exit 1; }
      # An explicitly selected tag is also the DECLARED name; refuse
      # upfront if it cannot be declared (the fallback declaration from a
      # signed tag merely degrades to rev-only, but an explicit request
      # that cannot be honored must not half-succeed).
      validate_tag_name "$sel_tag" || {
        echo "ERROR: tag name '$sel_tag' is outside the declared-name grammar [A-Za-z0-9._/+-]" >&2
        exit 1
      }
    fi

    # The record must live under a root-owned ancestry or the machine gate
    # is only as strong as the weakest writable dir on the way there.
    # Walk from the deepest component that EXISTS, exactly like the file
    # ceremony below: a first-ever approval has not created the slot yet
    # (write_slot_state creates it root-owned when it records), and walking
    # through the not-yet-existing dir read an empty owner as "not root" --
    # refusing every brand-new repo with a chown remediation for a directory
    # that did not exist.
    if [ -d "$slot" ]; then
      verify_ancestry "$slot/rev.git" || exit 1
    else
      verify_ancestry "$slot" || exit 1
    fi

    local hash old_hash diff_out step_rc ancestry_cls ancestry_mb
    old_hash="$(read_rev "$slot")" || exit 1
    # The walk steps FROM a pin; there is no such thing as a first commit of
    # a tree that already exists. (The preview refuses this pre-sudo too --
    # this is the authoritative re-check.)
    if [ "$step" -eq 1 ] && [ -z "$old_hash" ]; then
      echo "first approval reviews the full tree; review without --step" >&2
      exit 1
    fi

    ceremony_banner

    if [ "${#tag_args[@]}" -gt 0 ]; then
      # Signature gate: verify normally-signed release tags (git tag -s;
      # nothing pinned-specific in the repo) against ROOT-OWNED allowed
      # signers, then pin the commit they name. This is the second-machine
      # bootstrap: clone anywhere, install the signer key once, approve the tag.
      local t
      for t in "${tag_args[@]}"; do
        case "$t" in
          -*) echo "invalid tag name: $t" >&2; exit 1 ;;
        esac
      done
      # Per-slot signers take precedence; the user-tier file is the
      # fallback. A key trusted to vouch for one repo shouldn't implicitly
      # vouch for every repo on the machine; keep machine-wide keys in the
      # user-tier file deliberately.
      local signers="$slot/signers/allowed_signers"
      [ -f "$signers" ] || signers="$(policy_dir_for "$inv")/allowed_signers"
      if [ ! -f "$signers" ]; then
        echo "ERROR: no allowed signers for this repo" >&2
        echo "  install the signer's public key with the signer ceremony:" >&2
        echo "    per-repo: pinned signer add --repo $repo --file <pubkey> --principal <id>" >&2
        echo "    user:     pinned signer add --file <pubkey> --principal <id>" >&2
        echo "  obtain the key out of band (printed card, password manager," >&2
        echo "  existing trusted machine) -- never from this repo." >&2
        exit 1
      fi
      verify_root_owned_path "$PINNED_ROOT" || exit 1
      verify_record_file "$signers" || exit 1
      # Every tag must verify AND name the same commit -- all-or-nothing;
      # a single failure leaves the pin unchanged.
      local t_hash
      hash=""
      for t in "${tag_args[@]}"; do
        if ! sgit -c gpg.ssh.allowedSignersFile="$signers" verify-tag "$t"; then
          printf '%sERROR: signature verification failed for tag %s; pin unchanged%s\n' "$C_RED$C_B" "$t" "$C_OFF" >&2
          log_action approve "$repo" "$t" verify-failed
          exit 1
        fi
        t_hash="$(sgit rev-parse "refs/tags/${t}"'^{commit}')"
        if [ -z "$hash" ]; then
          hash="$t_hash"
        elif [ "$hash" != "$t_hash" ]; then
          printf '%sERROR: tags disagree: %s is at %s, expected %s; pin unchanged%s\n' \
            "$C_RED$C_B" "$t" "$t_hash" "$hash" "$C_OFF" >&2
          log_action approve "$repo" "$t" tags-disagree
          exit 1
        fi
      done
      # An unsigned --tag selector (e.g. the clean release name) joins the
      # agreement rule: it must name the commit the signed set verified.
      if [ -n "$sel_tag" ]; then
        t_hash="$(sgit rev-parse "refs/tags/${sel_tag}"'^{commit}')"
        if [ "$t_hash" != "$hash" ]; then
          printf '%sERROR: tags disagree: %s is at %s, expected %s; pin unchanged%s\n' \
            "$C_RED$C_B" "$sel_tag" "$t_hash" "$hash" "$C_OFF" >&2
          log_action approve "$repo" "$sel_tag" tags-disagree
          exit 1
        fi
      fi
      if [ -n "$old_hash" ] && [ "$old_hash" = "$hash" ]; then
        printf '%salready pinned: %s%s\n' "$C_GRN" "$hash" "$C_OFF"
        if [ "$multi" -eq 1 ]; then n_already=$((n_already + 1)); continue; fi
        exit 0
      fi
      # THE ANCESTRY FLOOR, before a byte of display. A signature proves WHO
      # vouched, never WHICH WAY the pin is moving, so a replayed signed
      # release of an older version is exactly the shape the floor exists to
      # catch -- and a deliberate, declared downgrade to a signed release is
      # the legitimate manual override it exists to allow.
      ancestry_floor "$repo" "$old_hash" "$hash" "$decl_class" || exit 1
      printf '%srepo:%s       %s%s%s  %s(%s)%s\n' "$C_DIM" "$C_OFF" "$C_B$C_MAG" "${repo##*/}" "$C_OFF" \
        "$C_DIM" "$repo" "$C_OFF"
      for t in "${tag_args[@]}"; do
        printf '%stag:%s        %s  %s✓ signature verified against %s%s\n' "$C_DIM" "$C_OFF" "$t" "$C_GRN" "$signers" "$C_OFF"
      done
      [ -n "$sel_tag" ] \
        && printf '%stag:%s        %s  %s(unsigned; names the verified commit)%s\n' "$C_DIM" "$C_OFF" "$sel_tag" "$C_DIM" "$C_OFF"
      [ "${#tag_args[@]}" -gt 1 ] \
        && printf '%s%d/%d tags agree on the commit below%s\n' "$C_GRN" "${#tag_args[@]}" "${#tag_args[@]}" "$C_OFF"
      printf '%scandidate:%s  %s%s%s  %s(%s)%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$hash" "$C_OFF" \
        "$C_DIM" "$(sgit log -1 --format=%s "$hash")" "$C_OFF"
      if [ -n "$old_hash" ]; then
        printf '%spinned:%s     %s%s%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$old_hash" "$C_OFF"
        if [ -n "$ancestry_mb" ]; then
          printf '%smerge base:%s %s%s%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$ancestry_mb" "$C_OFF"
        fi
        # Free orientation on any machine with the clone (that is, every
        # machine review runs on); the signature stays the gate.
        echo
        print_ancestry_listing "$ancestry_cls" "$old_hash" "$hash" "$ancestry_mb"
      fi
    else
      # Human gate: read the diff since the last pin from the object store,
      # at HEAD or at the --tag selector's commit.
      if [ -n "$sel_tag" ]; then
        hash="$(sgit rev-parse "refs/tags/${sel_tag}"'^{commit}')"
      else
        hash="$(sgit rev-parse 'HEAD^{commit}')"
      fi

      if ! sgit_diff --quiet 2>/dev/null || ! sgit_diff --cached --quiet 2>/dev/null; then
        echo "note: work tree is dirty; only committed content at $hash is being approved" >&2
      fi

      if [ -n "$old_hash" ] && [ "$old_hash" = "$hash" ]; then
        printf '%salready pinned: %s%s\n' "$C_GRN" "$hash" "$C_OFF"
        if [ "$multi" -eq 1 ]; then n_already=$((n_already + 1)); continue; fi
        exit 0
      fi

      # THE ANCESTRY FLOOR, before a byte of display: a diff renders a
      # backward move as an honest set of changes, which is exactly why the
      # direction has to be established first -- the diff cannot say whether
      # trust is being extended or withdrawn.
      ancestry_floor "$repo" "$old_hash" "$hash" "$decl_class" || exit 1

      printf '%srepo:%s       %s%s%s  %s(%s)%s\n' "$C_DIM" "$C_OFF" "$C_B$C_MAG" "${repo##*/}" "$C_OFF" \
        "$C_DIM" "$repo" "$C_OFF"
      if [ -n "$sel_tag" ]; then
        printf '%stag:%s        %s\n' "$C_DIM" "$C_OFF" "$sel_tag"
        printf '%scandidate:%s  %s%s%s  %s(%s)%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$hash" "$C_OFF" \
          "$C_DIM" "$(sgit log -1 --format=%s "$hash")" "$C_OFF"
      else
        printf '%sgit HEAD:%s   %s%s%s  %s(%s)%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$hash" "$C_OFF" \
          "$C_DIM" "$(sgit log -1 --format=%s "$hash")" "$C_OFF"
      fi
      if [ -n "$old_hash" ]; then
        printf '%spinned:%s     %s%s%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$old_hash" "$C_OFF"
        if [ -n "$ancestry_mb" ]; then
          printf '%smerge base:%s %s%s%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$ancestry_mb" "$C_OFF"
        fi
        echo
        print_ancestry_listing "$ancestry_cls" "$old_hash" "$hash" "$ancestry_mb"
        if [ "$step" -eq 1 ]; then
          # The walk replaces this whole-delta diff AND the single
          # confirmation below with one of each per commit, and owns the
          # invocation's exit status from here (it binds to one repo, so
          # there is no batch left to fall through to).
          step_rc=0
          approve_step_walk "$slot" "$old_hash" "$hash" || step_rc=$?
          exit "$step_rc"
        fi
        echo
        # The gate before the pager: in a batch the next repo's diff would
        # otherwise open unannounced, with no statement of whose bytes or
        # how much is about to fill the screen. Enter is the only answer --
        # this is orientation, not a decision. Off-tty the read fails and
        # set -e aborts: the same fail-closed contract as the confirms.
        local n_range
        n_range="$(sgit rev-list --count "${old_hash}..${hash}")"
        printf '%snext: review %s%s%s %s%.10s..%.10s%s (%s commit%s); Enter opens the diff%s ' \
          "$C_B" "$C_B$C_MAG" "${repo##*/}" "$C_OFF$C_B" \
          "$C_CYN" "$old_hash" "$hash" "$C_OFF$C_B" \
          "$n_range" "$(plural_s "$n_range")" "$C_OFF"
        read -r answer </dev/tty
        printf '%s--- diff %.10s..%.10s (from object store) ---%s\n' "$C_B" "$old_hash" "$hash" "$C_OFF"
        # Capture first so a git failure aborts (set -e) BEFORE anything is
        # shown as reviewable; then page. Early pager quit (SIGPIPE) is the
        # reviewer's own act -- the diff itself already succeeded.
        diff_out="$(sgit_diff "$old_hash" "$hash")"
        printf '%s\n' "$diff_out" | page || true
      elif [ "$trust" -eq 1 ]; then
        printf '%spinned:%s     (none)\n' "$C_DIM" "$C_OFF"
        echo
        printf '%s!!! FIRST APPROVAL WITH --trust !!!%s\n' "$C_RED$C_B" "$C_OFF"
        printf '%s!!! The full tree at %s is being approved without review. !!!%s\n' "$C_RED$C_B" "$hash" "$C_OFF"
        printf '%s!!! Everything already in this repo becomes trusted as-is. !!!%s\n' "$C_RED$C_B" "$C_OFF"
      else
        printf '%spinned:%s     (none -- first approval: full tree review)\n' "$C_DIM" "$C_OFF"
        echo
        # Same gate as the whole-delta pager; no range exists yet.
        printf '%snext: review %s%s%s full tree at %s%.10s%s; Enter opens the diff%s ' \
          "$C_B" "$C_B$C_MAG" "${repo##*/}" "$C_OFF$C_B" \
          "$C_CYN" "$hash" "$C_OFF$C_B" "$C_OFF"
        read -r answer </dev/tty
        printf '%s--- full tree at %.10s (diff from empty) ---%s\n' "$C_B" "$hash" "$C_OFF"
        # 4b825d... is git's well-known empty tree; this shows every approved byte.
        diff_out="$(sgit_diff 4b825dc642cb6eb9a060e54bf8d69288fbee4904 "$hash")"
        printf '%s\n' "$diff_out" | page || true
      fi
    fi
    echo

    local answer
    printf '%sapprove %s%s%s %s%s%s? [y/N]%s ' "$C_B" "$C_B$C_MAG" "${repo##*/}" "$C_OFF$C_B" \
      "$C_CYN" "$hash" "$C_OFF$C_B" "$C_OFF"
    read -r answer </dev/tty
    case "$answer" in
      y|Y|yes) ;;
      *)
        printf '%saborted; pin unchanged%s\n' "$C_YEL" "$C_OFF"
        log_action approve "$repo" "$hash" abort
        if [ "$multi" -eq 1 ]; then n_declined=$((n_declined + 1)); continue; fi
        exit 2
        ;;
    esac

    write_slot_state "$slot" rev.git "$hash"
    # A repo pin has no JSON keys to tolerate: taking the slot over from a
    # file pin drops any ignored-key declaration with it.
    clear_slot_ignore "$slot"
    # Say so. The --file ceremony has always confirmed each record; the repo
    # ceremony printed nothing unless a tag happened to be declared, so a plain
    # approve answered `y` and returned to the prompt in silence -- which reads
    # exactly like a no-op in the one place a user most needs to know a record
    # was written.
    printf '%s✓ approved:%s %s%s%s -> %s\n' "$C_GRN$C_B" "$C_OFF" "$C_CYN" "$hash" "$C_OFF" "$slot/rev.git"
    # The declared release name (optional `tag` annotation, repo slots
    # only): deploy syncs the input's ref= to it after cross-checking the
    # live tag still names the pinned rev. The --tag selector is the
    # declared name; with only --signed-tag evidence the first signed name
    # is the fallback; a plain review with no tag CLEARS any prior
    # declaration (no declaration -> rev-only sync, a supported shape).
    local decl_tag="$sel_tag"
    if [ -z "$decl_tag" ] && [ "${#tag_args[@]}" -gt 0 ]; then
      decl_tag="${tag_args[0]}"
    fi
    if [ -n "$decl_tag" ]; then
      if ! validate_tag_name "$decl_tag"; then
        printf '%snote: tag name %s is outside the declared-name grammar [A-Za-z0-9._/+-]; not declaring it (rev-only slot)%s\n' \
          "$C_YEL" "$decl_tag" "$C_OFF"
        rm -f "$slot/tag"
      else
        write_note "$slot" tag "$decl_tag"
        printf '%s✓ declared:%s %s -> %s\n' "$C_GRN" "$C_OFF" "$decl_tag" "$slot/tag"
      fi
    else
      rm -f "$slot/tag"
    fi
    log_action approve "$repo" "$hash"
    n_approved=$((n_approved + 1))
  done

  if [ "$multi" -eq 1 ]; then
    echo
    printf '%s%s approved, %s declined, %s already pinned%s\n' \
      "$C_DIM" "$n_approved" "$n_declined" "$n_already" "$C_OFF"
  fi
}

# The --step walk: the commits since the pin, oldest first, one diff and one
# confirmation each, with the pin ADVANCING at every yes. Every checkpoint is
# therefore a coherent, deployable record -- stopping midway rests the pin at
# the last approved commit, and resuming later is an ordinary approve over
# whatever remains. A decline STOPS the walk instead of skipping the commit:
# trust is a tree state, so approving commit N would silently carry N-1's
# changes in with it.
#
# Reached only from the review branch of do_approve, which has already refused
# every combination the walk cannot mean (a first approval, --trust,
# --signed-tag, several repos, a batch). It owns the invocation's exit
# status: 0 if the pin advanced at all -- a later decline does not undo an
# earlier yes -- and 2 if nothing changed, the single-repo decline contract.
#
# A --tag selector moves the ENDPOINT: the walk runs from the pin to the
# commit the tag names, and the name is declared only when that commit is
# actually approved (do_approve validated the name upfront; $sel_tag is its
# local, visible here by dynamic scope). A walk that stops early leaves the
# slot rev-only and says so -- a declaration for a rev the pin never reached
# would make deploy sync ref= to a tag that disagrees with the pin.
#
# $1 = slot, $2 = the currently pinned rev, $3 = the walk's endpoint (HEAD
# or the --tag selector's commit).
approve_step_walk() {
  local slot="$1" old_hash="$2" hash="$3"
  local line c k m prev approved=0 answer diff_out rem totals log_out
  local -a commits=()

  # Captured first so a git failure aborts (set -e) before the walk claims to
  # know how many commits there are. --first-parent because that is the line
  # of history the pin travels along; a merge's second parent arrives as part
  # of the merge commit's own diff.
  log_out="$(sgit log --reverse --first-parent --format=%H "${old_hash}..${hash}")"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    commits+=("$line")
  done <<EOF
$log_out
EOF
  m="${#commits[@]}"
  # No commits between two DIFFERENT revs means the pin is not behind HEAD:
  # rewritten, reversed or diverged history. The whole-delta diff renders that
  # situation honestly (it shows the removal); a walk over an empty list would
  # simply say nothing, which is the one thing a review must never do.
  # The ancestry floor refuses those endpoints before the walk is even
  # entered, so this is the belt to its braces -- it stays because a walk
  # that found nothing to show must never continue on that basis.
  if [ "$m" -eq 0 ]; then
    printf '%sERROR: no commits from the pin to %.10s -- the pin is not behind HEAD%s\n' \
      "$C_RED$C_B" "$hash" "$C_OFF" >&2
    echo "       (reversed or diverged history); review --backward or --diverged" >&2
    echo "       without --step: the whole-delta diff shows what actually changes" >&2
    return 1
  fi

  k=0
  prev="$old_hash"
  while [ "$k" -lt "$m" ]; do
    c="${commits[$k]}"
    k=$((k + 1))
    echo
    printf '%s--- step %s/%s ---%s\n' "$C_B" "$k" "$m" "$C_OFF"
    print_commit_range "$prev" "$c" || true
    echo
    # Same gate as the whole-delta pager; a step is always one commit.
    printf '%snext: review %s%s%s %s%.10s..%.10s%s (1 commit); Enter opens the diff%s ' \
      "$C_B" "$C_B$C_MAG" "${repo##*/}" "$C_OFF$C_B" \
      "$C_CYN" "$prev" "$c" "$C_OFF$C_B" "$C_OFF"
    read -r answer </dev/tty
    # Capture first so a git failure aborts (set -e) BEFORE anything is shown
    # as reviewable; then page. Early pager quit (SIGPIPE) is the reviewer's
    # own act -- the diff itself already succeeded.
    diff_out="$(sgit_diff "$prev" "$c")"
    printf '%s\n' "$diff_out" | page || true
    echo
    printf '%sapprove %s%s%s %s%s%s? [y/N]%s ' "$C_B" "$C_B$C_MAG" "${repo##*/}" "$C_OFF$C_B" \
      "$C_CYN" "$c" "$C_OFF$C_B" "$C_OFF"
    read -r answer </dev/tty
    case "$answer" in
      y|Y|yes) ;;
      *)
        printf '%sdeclined; the walk stops here%s\n' "$C_YEL" "$C_OFF"
        log_action approve "$repo" "$c" abort
        break ;;
    esac
    write_slot_state "$slot" rev.git "$c"
    # A repo pin has no JSON keys to tolerate: taking the slot over from a
    # file pin drops any ignored-key declaration with it.
    clear_slot_ignore "$slot"
    # A mid-walk yes is a plain review, so it CLEARS any declared
    # release name; the declaration is written back only if this yes is the
    # --tag selector's own commit -- the walk arriving at the name it was
    # asked to walk to.
    rm -f "$slot/tag"
    log_action approve "$repo" "$c"
    printf '%s✓ pin advanced:%s %s%s%s\n' "$C_GRN$C_B" "$C_OFF" "$C_CYN" "$c" "$C_OFF"
    if [ -n "$sel_tag" ] && [ "$c" = "$hash" ]; then
      write_note "$slot" tag "$sel_tag"
      printf '%s✓ declared:%s %s -> %s\n' "$C_GRN" "$C_OFF" "$sel_tag" "$slot/tag"
    fi
    prev="$c"
    approved=$((approved + 1))
  done

  echo
  printf '%s--- step summary ---%s\n' "$C_B" "$C_OFF"
  if [ "$approved" -eq 0 ]; then
    printf '%sapproved 0 of %s commit%s; pin unchanged at%s %s%.10s%s\n' \
      "$C_DIM" "$m" "$(plural_s "$m")" "$C_OFF" "$C_CYN" "$old_hash" "$C_OFF"
  else
    printf '%sapproved %s of %s commit%s; pin:%s %s%.10s%s %s->%s %s%.10s%s\n' \
      "$C_DIM" "$approved" "$m" "$(plural_s "$m")" "$C_OFF" "$C_CYN" "$old_hash" "$C_OFF" \
      "$C_DIM" "$C_OFF" "$C_CYN" "$prev" "$C_OFF"
    print_commit_range "$old_hash" "$prev" || true
    # THE COMPOSITION-RISK MITIGATION. Reading one commit at a time covers the
    # same total lines as one whole-delta diff, but it fragments the attention
    # that would notice mayhem split across individually innocent commits.
    # This is what the whole sitting amounted to, in one line, after the fact.
    # Binary files count as changed files and contribute nothing to +/- --
    # what git itself reports for them ("-" in both columns).
    totals="$(sgit_diff --numstat "$old_hash" "$prev" | LC_ALL=C awk '
      { n++; if ($1 != "-") ins += $1; if ($2 != "-") del += $2 }
      END { printf "%d file%s +%d -%d\n", n, (n == 1 ? "" : "s"), ins, del }')"
    printf '%stotal:%s %s\n' "$C_DIM" "$C_OFF" "$totals"
  fi
  rem=$((m - approved))
  if [ "$rem" -gt 0 ]; then
    printf '%sremaining: %s commit%s%s %s(%.10s..%.10s)%s\n' \
      "$C_DIM" "$rem" "$(plural_s "$rem")" "$C_OFF" "$C_CYN" "$prev" "$hash" "$C_OFF"
    [ -z "$sel_tag" ] \
      || printf '%sdeclared name %s not reached; the slot stays rev-only%s\n' \
           "$C_DIM" "$sel_tag" "$C_OFF"
  fi
  [ "$approved" -ge 1 ] || return 2
}

# The file-pin ceremony (the claude-trust-append port). The CEREMONY is
# the only recording path -- there is deliberately NO hash argument and
# no handoff form: a displayless handoff would preserve exactly the
# vulnerable path it replaces (a weak-environment caller feeding an
# opaque hash for root to record sight-unseen). The one display happens
# HERE, root-side, after sudo's env_reset, resting only on root-owned
# code -- a caller's own review (the shim's structural diff) is pre-sudo
# ORIENTATION, and what the record binds to is what THIS display showed:
# the hash is taken from the displayed frozen buffer, so record == seen
# by construction, and a post-freeze swap simply mismatches at the next
# verify. Multiple --file paths share one authentication (sequential
# display + confirm per file, each confirmed one recorded) -- under the
# timestamp_timeout=0 sudoers stance anything else costs one password
# per file. WHICH files get measured is the calling policy's business
# (the shim's declared set); pinned is the capability and approves any
# path -- the old appender's basename allowlist dies here.
do_approve_files() {
  algo_hash_cmd "$file_algo" >/dev/null || {
    echo "unsupported algorithm: $file_algo (use sha256, sha384, sha512, blake2b-256/384/512, blake3)" >&2
    exit 1
  }
  require_hasher "$file_algo" || exit 1
  ensure_tree "$inv"

  local i=0 n="${#files[@]}" f base path slot line new_digest old_digest old_label
  local base_ok recorded=0 declined=0 failed=0 answer state_note nl
  local ign ign_json old_ign old_bad had_copy copy_bad cur_copy ign_note cust_note decl_changed
  local cust_changed shape gate_shape n_lines
  local gk gscope
  local -a hdr_opt=()

  # The ignorable policy, read ONCE for the whole ceremony: every --file in
  # it is checked against the same effective policy, and a policy that
  # cannot be read stops the ceremony rather than approving without one.
  # Only when something is actually declared -- a ceremony that declares
  # nothing has no rung to check.
  if [ "$ign_given" -eq 1 ]; then
    require_jq "--ignore-json-key" || exit 1
    load_policy "$inv" || exit 1
  fi

  # Hunk-header orientation for the baseline diff: diff's OWN -F prints the
  # nearest preceding line matching the regex after each "@@ ... @@", so a
  # hunk announces the section it sits in. '^  "' matches only the
  # two-space-indented keys of conventionally formatted JSON, i.e. TOP-LEVEL
  # keys -- a depth-agnostic regex could name a nested sibling and mislead.
  # Content that never matches (non-JSON, reindented JSON) just keeps plain
  # headers. This is diff reading its own input; nothing external is
  # consulted or run (git's textconv/ext-diff drivers, which DO run
  # repo-controlled code, stay banned in this display).
  #
  # ORIENTATION, NOT AUTHORITY: JSON whitespace is free-form, so the anchor is
  # accurate only for honestly formatted files -- a hostile file can indent a
  # NESTED key at two spaces (still valid JSON) and thereby plant a misleading
  # section label. A spoofed label can lie about WHERE a change sits, never
  # about WHAT changed: every changed line prints regardless, and the recorded
  # digest is taken from the frozen bytes, not from any header. The label is a
  # reading aid; the changed lines are the record.
  #
  # -F is not POSIX (it is in BSD/macOS diff and GNU diffutils). Probe it on
  # two empty files: rc 0 means accepted, rc >=2 means unknown option -- and
  # an unknown option would exit 2 into the `|| true` below and render the
  # review diff as EMPTY. Fail closed to plain headers instead.
  if diff -F '^x' /dev/null /dev/null >/dev/null 2>&1; then
    hdr_opt=(-F '^  "')
  fi

  ceremony_banner

  while [ "$i" -lt "$n" ]; do
    f="${files[$i]}"; base="${file_base[$i]}"; ign="${file_ign[$i]}"; i=$((i + 1))
    [ "$i" -eq 1 ] || echo
    path="$(canon_path "$f")" || { failed=$((failed + 1)); continue; }
    case "$path" in
      *"$NL"*)
        echo "ERROR: refusing a path containing a newline (records are one line per pin)" >&2
        failed=$((failed + 1)); continue ;;
    esac
    if [ ! -f "$path" ]; then
      echo "ERROR: not a regular file: $path" >&2
      echo "       (a pinned file that is gone is retired with: pinned tombstone $path)" >&2
      failed=$((failed + 1)); continue
    fi
    slot="$(slot_dir_for "$inv" "$path")"
    # Ancestry is checked from the deepest component that EXISTS. Checking
    # from the pin file unconditionally meant the walk included $slot, which
    # a first-ever approval has not created yet -- stat failed, the empty
    # owner read as "not root", and every previously unpinned path was
    # refused with a chown/chmod remediation for a directory that did not
    # exist. write_slot_state creates the slot root-owned when it records,
    # so there is nothing to distrust until then; an existing slot is still
    # walked in full.
    if [ -d "$slot" ]; then
      verify_ancestry "$slot/pin.$file_algo" || exit 1
    else
      verify_ancestry "$slot" || exit 1
    fi

    # THE LADDER'S CEREMONY RUNG: a key may be declared here only if the
    # effective policy grants it FOR THIS PATH. Refused per file, before
    # anything is displayed or recorded, and loudly -- semantics are
    # UNIFORM, because pinned cannot tell a human's argv from a calling
    # tool's, so "the human typed it" can never be the reason to allow it.
    ign_json=""
    if [ -n "$ign" ]; then
      ign_json="$(ign_paths_json "$ign")"
      if ! policy_check_declaration "$POL_EFF" "$ign_json" "$path"; then
        failed=$((failed + 1)); continue
      fi
    fi

    old_digest="" old_label="" state_note="" ign_note="" cust_note="" decl_changed=0
    old_ign=""; old_bad=0; had_copy=0; copy_bad=0
    if slot_declares_ignore "$slot"; then
      # Quiet read: a broken declaration is reported by the note below and
      # replaced by this ceremony, so read_ignored_paths' own refusal text
      # would only be noise here.
      if read_ignored_paths "$slot" 2>/dev/null; then
        old_ign="$IGN_PATHS"
      else
        old_bad=1
      fi
    fi
    [ -e "$slot/approved" ] && had_copy=1
    if ! inspect_slot "$slot" 2>/dev/null; then
      # Malformed is unreadable state, not unapproachable state: the
      # ceremony is exactly the act that may reassert it. Loudly.
      state_note="malformed slot -- this approval resets it"
    else
      case "$slot_state" in
        pin)
          verify_record_file "$slot_file" || exit 1
          IFS= read -r line <"$slot_file" || line=""
          old_digest="${line%%  *}"; old_label="$slot_kind" ;;
        tombstone)
          IFS= read -r line <"$slot_file" || line=""
          state_note="tombstoned ($line) -- approving reinstates this path" ;;
        rev)
          state_note="slot held a repo pin -- this approval resets it to a file pin" ;;
      esac
    fi

    # Freeze ONCE; display, diff, hash and record all derive from the
    # frozen copy (record == displayed buffer, by construction).
    freeze_file "$path" || { echo "ERROR: cannot read $path" >&2; failed=$((failed + 1)); continue; }
    local fro="$FROZEN_COPY"
    new_digest="$(hash_file "$file_algo" "$fro")" || exit 1

    # THE TAG RULE, over every extra a slot can hold: the ceremony re-states
    # ALL of them EVERY time, so a review carrying no --ignore clears the
    # declaration and one carrying no --store drops the stored witness.
    # Identical bytes are therefore a no-op only when the declaration AND the
    # custody state are identical too -- otherwise the human still has a
    # narrowing, a widening, or a disclosure change to confirm.
    if [ "$old_bad" -eq 1 ]; then
      decl_changed=1
      ign_note="the slot's ignored-key declaration is unreadable -- this approval replaces it"
    elif [ "$ign_json" != "$old_ign" ]; then
      decl_changed=1
      if [ -z "$ign_json" ]; then
        ign_note="clearing the ignored keys ($(ign_display "$old_ign")) -- every key returns to byte-exact"
      elif [ -n "$old_ign" ]; then
        ign_note="ignored keys change: $(ign_display "$old_ign") -> $(ign_display "$ign_json")"
      fi
    fi
    # A stored witness that does not re-hash to its own record is incoherent
    # slot state, and the ceremony is the documented way out of it (verify
    # says so by name), so it must not be short-circuited away. Same
    # treatment as an unreadable declaration, one hash to find out.
    if [ "$had_copy" -eq 1 ] && [ -n "$old_digest" ]; then
      cur_copy=""
      [ -f "$slot/approved" ] \
        && cur_copy="$(hash_file "$old_label" "$slot/approved" 2>/dev/null || true)"
      [ "$cur_copy" = "$old_digest" ] || copy_bad=1
    fi

    # Custody carries its own note rather than sharing the declaration's:
    # a ceremony can be changing both at once, and each is separately worth
    # reading before a y. Gated on there BEING a prior record -- on a first
    # approval nothing is changing, custody is simply being chosen.
    if [ -n "$old_digest" ] && [ "$had_copy" -ne "$store" ]; then
      decl_changed=1
      if [ "$store" -eq 1 ]; then
        cust_note="custody change: this approval adds a stored copy of the approved bytes to the slot"
      else
        cust_note="custody change: this approval drops the slot's stored copy (pass --store to keep it)"
      fi
    elif [ "$store" -eq 1 ] && [ "$copy_bad" -eq 1 ]; then
      decl_changed=1
      cust_note="the slot's stored copy does not re-hash to its record -- this approval replaces it"
    fi

    if [ -n "$old_digest" ] && [ "$old_label" = "$file_algo" ] && [ "$new_digest" = "$old_digest" ] \
       && [ "$decl_changed" -eq 0 ]; then
      printf '%salready approved:%s %s\n' "$C_GRN" "$C_OFF" "$path"
      continue
    fi

    # WHICH item of the batch this is, before its identity block: a ceremony
    # that asks several questions in a row has to say where in the row you
    # are. A single --file is not a batch (same rule as the summary tail),
    # and the counter counts INVOCATION position, so a skipped or
    # short-circuited file simply leaves a gap -- honest about what it is.
    [ "$n" -le 1 ] || printf '%s[%s/%s]%s\n' "$C_DIM" "$i" "$n" "$C_OFF"
    printf '%sfile:%s       %s%s%s\n' "$C_B" "$C_OFF" "$C_B$C_MAG" "$path" "$C_OFF"
    [ -n "$state_note" ] && printf '%snote:%s       %s%s%s\n' "$C_B" "$C_OFF" "$C_YEL" "$state_note" "$C_OFF"
    [ -n "$ign_note" ] && printf '%snote:%s       %s%s%s\n' "$C_B" "$C_OFF" "$C_YEL" "$ign_note" "$C_OFF"
    [ -n "$cust_note" ] && printf '%snote:%s       %s%s%s\n' "$C_B" "$C_OFF" "$C_YEL" "$cust_note" "$C_OFF"
    if [ -n "$old_digest" ]; then
      printf '%sapproved:%s   %s%s%s  %s(%s)%s\n' "$C_B" "$C_OFF" "$C_CYN" "$old_digest" "$C_OFF" "$C_DIM" "$old_label" "$C_OFF"
    else
      printf '%sapproved:%s   (none -- first approval)\n' "$C_B" "$C_OFF"
    fi
    printf '%s%s:%s     %s%s%s\n' "$C_B" "$file_algo" "$C_OFF" "$C_CYN" "$new_digest" "$C_OFF"
    # The declaration, stated before the confirm and not after it: answering
    # y approves the CONTENT and the tolerance in one act, so the tolerance
    # has to be on screen while the question is being asked.
    if [ -n "$ign" ]; then
      printf '%signored:%s    %s%s%s  %s(these keys may drift without re-approval)%s\n' \
        "$C_B" "$C_OFF" "$C_CYN" "$(ign_display "$ign_json")" "$C_OFF" "$C_YEL" "$C_OFF"
      # Per-key GRANT PROVENANCE: the display audits the ladder, so the
      # rung that permits each key -- and how far that permission reaches
      # -- is on screen while the question is asked. Every key here is
      # granted (an ungranted one never reaches this display).
      while IFS="$TAB" read -r gk gscope; do
        [ -n "$gk" ] || continue
        case "$gscope" in
          '*') printf '            %s%s -- user policy, everywhere%s\n' "$C_DIM" "$gk" "$C_OFF" ;;
          *)   printf '            %s%s -- user policy, under %s%s\n' "$C_DIM" "$gk" "$gscope" "$C_OFF" ;;
        esac
      done <<EOF
$(policy_grants "$POL_EFF" "$ign_json" "$path")
EOF
      [ -z "$POL_MACHINE" ] \
        || printf '            %s(and within the machine policy at %s)%s\n' "$C_DIM" "$PINNED_MACHINE_POLICY" "$C_OFF"
    fi
    # CUSTODY, stated in both directions and always -- not only when it is
    # changing. What the slot will hold after this y is part of what is being
    # approved, and "no copy is kept" is as much a decision as keeping one.
    # But STATING it is one line; EXPLAINING it is a paragraph, and a
    # paragraph re-read at every launch stops being read at all. The
    # explanation is therefore spent where it buys something: when this
    # approval is choosing custody for the first time (no prior record), when
    # it flips the stored-copy state, or when the note above already says the
    # stored copy is being repaired -- exactly the cases the ceremony treats
    # as a custody DECISION rather than a restatement.
    cust_changed=0
    if [ -z "$old_digest" ] || [ "$had_copy" -ne "$store" ] || [ -n "$cust_note" ]; then
      cust_changed=1
    fi
    if [ "$store" -eq 1 ]; then
      printf '%scustody:%s    kept in the slot  %s(--store · pinned cat serves these bytes)%s\n' \
        "$C_B" "$C_OFF" "$C_DIM" "$C_OFF"
      if [ "$cust_changed" -eq 1 ]; then
        printf '            %sA copy of these bytes is kept beside the record as the%s\n' "$C_DIM" "$C_OFF"
        printf '            %switness: what the ignored-key comparison reads, and what%s\n' "$C_DIM" "$C_OFF"
        printf '            %spinned cat serves. It is readable by anything that mounts%s\n' "$C_DIM" "$C_OFF"
        printf '            %sthe slot.%s\n' "$C_DIM" "$C_OFF"
      fi
    else
      printf '%scustody:%s    none  %s(no copy at rest · pinned cat has nothing to serve)%s\n' \
        "$C_B" "$C_OFF" "$C_DIM" "$C_OFF"
      if [ "$cust_changed" -eq 1 ]; then
        printf '            %sNo copy is kept at rest: the slot records the digest and%s\n' "$C_DIM" "$C_OFF"
        printf '            %sdiscloses nothing more, so pinned cat has nothing to serve.%s\n' "$C_DIM" "$C_OFF"
        printf '            %sA consumer that wants the ignored-key comparison brings its%s\n' "$C_DIM" "$C_OFF"
        printf '            %sown witness (verify --baseline). Any copy this slot holds%s\n' "$C_DIM" "$C_OFF"
        printf '            %stoday is dropped by this approval.%s\n' "$C_DIM" "$C_OFF"
      fi
    fi
    echo

    # Diff only against a VERIFIED baseline: the candidate must re-hash
    # to the prior recorded digest (the self-verifying trust-cache
    # trick, root-side). Anything else degrades to the full view --
    # never to a diff against unverified bytes.
    base_ok=0
    if [ -n "$base" ] && [ -n "$old_digest" ] && [ -f "$base" ]; then
      if freeze_file "$base" 2>/dev/null \
        && [ "$(hash_file "$old_label" "$FROZEN_COPY")" = "$old_digest" ]; then
        base_ok=1
        # -U1: unified context lines are UNCHANGED content by definition, and
        # diff prints every changed line at any -U level, so trimming context
        # shortens the read without ever hiding an edit. Produced BEFORE the
        # gate below announces it, so a diff that cannot be made fails while
        # nothing has been promised.
        line="$(diff -U1 ${hdr_opt[@]+"${hdr_opt[@]}"} "$FROZEN_COPY" "$fro" || true)"
        shape="$(printf '%s\n' "$line" | diff_shape)"
        # The gate says the magnitude, so the shape's own "+A/-D lines" tail
        # is re-cut to the gate's spelling rather than counted a second time.
        gate_shape="${shape#*, }"; gate_shape="${gate_shape% lines}"
        gate_shape="${gate_shape/\// }"
      fi
    fi
    # THE GATE BEFORE THE PAGER, as the repo ceremony has it: nothing
    # full-screen arrives unannounced, and what arrives is named with its
    # size first. Enter is the only answer -- this is orientation, not a
    # decision. Off-tty the read fails and set -e aborts the ceremony: the
    # same fail-closed contract as the confirm below.
    if [ "$base_ok" -eq 1 ]; then
      printf '%snext: review %s%s%s %s%s%s; Enter opens the diff%s ' \
        "$C_B" "$C_B$C_MAG" "${path##*/}" "$C_OFF$C_B" \
        "$C_CYN" "$gate_shape" "$C_OFF$C_B" "$C_OFF"
      read -r answer </dev/tty
      printf '%s--- diff vs the approved baseline (exactly the bytes being approved) ---%s\n' "$C_B" "$C_OFF"
      printf '%scontext trimmed to 1 line; every changed line is always shown; @@ section labels are orientation, not authority.%s\n' "$C_DIM" "$C_OFF"
      printf '%s%s%s\n' "$C_DIM" "$shape" "$C_OFF"
      printf '%s\n' "$line" | color_diff | page || true
    else
      if [ -n "$base" ] && [ -n "$old_digest" ]; then
        printf '%snote: baseline does not re-hash to the approved record; showing the full file%s\n' "$C_YEL" "$C_OFF"
      fi
      # Counted with wc, not awk: the frozen buffer can hold any bytes at
      # all, and a line count must not be the thing that refuses a binary.
      # A file whose last line has no terminator still counts as a line.
      nl=''
      [ "$(tail -c1 -- "$fro" | wc -l)" -eq 1 ] && nl=1
      n_lines="$(LC_ALL=C wc -l <"$fro" | tr -d ' ')"
      [ -n "$nl" ] || [ ! -s "$fro" ] || n_lines=$((n_lines + 1))
      printf '%snext: review %s%s%s full content %s%s line%s%s; Enter opens it%s ' \
        "$C_B" "$C_B$C_MAG" "${path##*/}" "$C_OFF$C_B" \
        "$C_CYN" "$n_lines" "$(plural_s "$n_lines")" "$C_OFF$C_B" "$C_OFF"
      read -r answer </dev/tty
      printf '%s--- %s (exactly the bytes being approved) ---%s\n' "$C_B" "$path" "$C_OFF"
      # Syntax colour only when the frozen copy is JSON that awk can carry
      # through unchanged; the digest above came from the file, not from
      # this stream, and highlight_json only inserts SGR codes between the
      # bytes it is given.
      if highlight_json_ok "$nl" <"$fro"; then
        highlight_json <"$fro" | page || true
      else
        page <"$fro" || true
      fi
    fi
    echo

    printf '%sapprove %s%s%s? [y/N]%s ' "$C_B" "$C_B$C_MAG" "$path" "$C_OFF$C_B" "$C_OFF"
    read -r answer </dev/tty
    case "$answer" in
      y|Y|yes)
        write_slot_state "$slot" "pin.$file_algo" "$new_digest  $path"
        # The stored witness is the frozen buffer this ceremony displayed and
        # hashed -- the same single read the record binds to, so custody can
        # never hold bytes the human did not see. A root-owned copy beside
        # the digest is also the one baseline nothing unprivileged can forge;
        # everything else has to prove itself at every use.
        if [ "$store" -eq 1 ]; then
          write_slot_copy "$slot" approved "$fro"
          printf '%s✓ approved:%s %s%s%s -> %s %s(+approved copy)%s\n' \
            "$C_GRN$C_B" "$C_OFF" "$C_CYN" "$new_digest" "$C_OFF" "$slot/pin.$file_algo" "$C_DIM" "$C_OFF"
        else
          rm -f "$slot/approved"
          printf '%s✓ approved:%s %s%s%s -> %s\n' \
            "$C_GRN$C_B" "$C_OFF" "$C_CYN" "$new_digest" "$C_OFF" "$slot/pin.$file_algo"
          # Losing custody is a state change worth naming after the fact too:
          # a consumer reading through the slot stops being served here.
          if [ "$had_copy" -eq 1 ]; then
            printf '%snote: the stored approved copy was dropped -- re-approve with --store to keep one%s\n' \
              "$C_YEL" "$C_OFF"
          fi
        fi
        # The declaration is re-stated from THIS ceremony every time, so the
        # absence of --ignore is itself a declaration: it clears the keys.
        # Clearing first also means a slot never ends up holding two declared
        # formats.
        clear_ignore_decl "$slot"
        if [ -n "$ign" ]; then
          write_note "$slot" ignored.json "$ign_json"
          printf '%s✓ ignoring:%s %s -> %s\n' \
            "$C_GRN" "$C_OFF" "$(ign_display "$ign_json")" "$slot/ignored.json"
        fi
        log_action approve-file "$path" "$new_digest"
        recorded=$((recorded + 1))
        ;;
      *)
        printf '%sdeclined; record unchanged%s\n' "$C_YEL" "$C_OFF"
        log_action approve-file "$path" "$new_digest" abort
        declined=$((declined + 1))
        ;;
    esac
  done

  if [ "$n" -gt 1 ] || [ "$failed" -gt 0 ]; then
    echo
    printf '%s%s recorded, %s declined, %s failed%s\n' "$C_DIM" "$recorded" "$declined" "$failed" "$C_OFF"
  fi
  [ "$failed" -eq 0 ] || exit 1
}

# ---- tombstone -------------------------------------------------------------

# Retire a pinned path that is GONE. The tombstone is sentinel SLOT
# CONTENT, never slot deletion: pin+missing refuses (restore or
# tombstone), tombstone+absent passes silently, tombstone+present
# refuses -- retired content resurrected must not read as merely new.
# Content is one ISO-stamped ASCII line; only its EXISTENCE carries the
# semantics, the line is forensics.
do_tombstone() {
  require_root tombstone
  [ $# -eq 1 ] || usage
  local path slot answer line
  path="$(canon_path "$1")" || exit 1
  if [ -e "$path" ]; then
    echo "REFUSE: $path still exists -- you tombstone what's gone, not what's live" >&2
    echo "        (retire the content first, or review the current content instead)" >&2
    exit 1
  fi
  ensure_tree "$inv"
  slot="$(slot_dir_for "$inv" "$path")"
  inspect_slot "$slot" 2>/dev/null || slot_state=malformed
  case "$slot_state" in
    none)
      echo "no slot: $path was never approved; nothing to tombstone" >&2
      exit 1 ;;
    tombstone)
      IFS= read -r line <"$slot_file" || line=""
      printf 'already tombstoned: %s %s(%s)%s\n' "$path" "$C_DIM" "$line" "$C_OFF"
      exit 0 ;;
  esac
  printf '%spath:%s       %s %s(gone)%s\n' "$C_B" "$C_OFF" "$path" "$C_DIM" "$C_OFF"
  printf '%sslot:%s       %s state: %s\n' "$C_B" "$C_OFF" "$slot" "$slot_state"
  printf '%stombstone %s%s%s? verify will then refuse it until re-approved [y/N]%s ' \
    "$C_B" "$C_CYN" "$path" "$C_OFF$C_B" "$C_OFF"
  read -r answer </dev/tty
  case "$answer" in
    y|Y|yes) ;;
    *) echo "aborted; slot unchanged"; log_action tombstone "$path" "" abort; exit 2 ;;
  esac
  write_slot_state "$slot" tombstone "$(date -u +%Y-%m-%dT%H:%M:%SZ) retired by $inv"
  rm -f "$slot/tag"   # a declared release name has no meaning on a tombstone
  clear_slot_ignore "$slot"   # nor do tolerated keys, or a copy of what is gone
  printf '%s✓ tombstoned:%s %s\n' "$C_GRN$C_B" "$C_OFF" "$path"
  log_action tombstone "$path"
}

# ---- mv --------------------------------------------------------------------

# Hand verify's own diagnosis through, saying whose record and whose bytes it
# was about -- verify names the path whose SLOT it read (the old one), which
# without this line reads as a verdict about the wrong file.
mv_verify_said() { # $1 old  $2 new  $3 captured output
  printf '%sverify, on the record for %s and the bytes now at %s:%s\n' \
    "$C_DIM" "$1" "$2" "$C_OFF" >&2
  cat -- "$3" >&2
}

# Re-key a record to the path its content has MOVED to. A path is a record's
# identity, so a moved repo or file orphans its slot, and re-approving costs a
# full first-approval ceremony -- a review of everything, when nothing
# changed but the name.
#
# WHY THIS NEVER WIDENS TRUST. The record travels VERBATIM: same rev, same
# digest, same declarations. The one new claim is "this path", and even that
# is not taken on the human's word -- the machine checks that the content now
# at <new> is exactly what the record already names (a work tree whose object
# store holds the pinned rev; a file that re-hashes to the pinned digest,
# byte-exact or drifting only in keys the slot already declares ignored). So
# the ceremony asks about precisely what it displays, and no answer to it can
# make any bytes trusted that were not trusted a moment before. Everything
# ambiguous fails closed: an old path that still exists, a tombstoned or
# malformed old slot, and any state at the new slot all refuse rather than
# merge.
#
# The old slot is TOMBSTONED, never deleted: something reappearing at a
# formerly-trusted path must fail closed, and tombstone+present refuses where
# a missing slot would merely re-prompt.
do_mv() {
  require_root mv
  [ $# -eq 2 ] || usage
  local old new old_slot new_slot target what answer line f e
  local state kind src rev digest label tag="" ign_show="" drifted="" travels=""
  local vrc=0 irc=0 vout
  old="$(canon_path "$1")" || exit 1
  new="$(canon_path "$2")" || exit 1
  if [ "$old" = "$new" ]; then
    echo "REFUSE: old and new name the same path: $old" >&2
    exit 1
  fi
  case "$new" in
    *"$NL"*)
      echo "ERROR: refusing a path containing a newline (records are one line per pin)" >&2
      exit 1 ;;
  esac

  ensure_tree "$inv"
  old_slot="$(slot_dir_for "$inv" "$old")"
  new_slot="$(slot_dir_for "$inv" "$new")"

  inspect_slot "$old_slot" || {
    echo "       a malformed record cannot be moved; fix the slot by hand, or review $new" >&2
    exit 1
  }
  case "$slot_state" in
    none)
      echo "no slot: $old was never approved; there is no record to move" >&2
      echo "       (review $new instead)" >&2
      exit 1 ;;
    tombstone)
      IFS= read -r line <"$slot_file" || line=""
      echo "REFUSE: $old is tombstoned ($line)" >&2
      echo "        a tombstone marks the old path's own history; it does not travel --" >&2
      echo "        review $new instead" >&2
      exit 1 ;;
  esac
  state="$slot_state" kind="$slot_kind" src="$slot_file"
  verify_ancestry "$src" || exit 1

  # mv FOLLOWS a move that already happened. While the old path is still
  # there the premise is simply false, and two live paths would be claiming
  # one record.
  if [ -e "$old" ]; then
    echo "REFUSE: $old still exists -- you mv a record whose content has already moved" >&2
    echo "        (move the content first, or review $new instead)" >&2
    exit 1
  fi

  # RECORDS DO NOT MERGE. Anything already at the new slot -- a live record,
  # a tombstone, or the signer data `signer add --repo` leaves in an
  # otherwise state-free slot -- is state a human decided on, and absorbing
  # it silently is exactly the quiet widening this tool exists to refuse.
  if [ -d "$new_slot" ]; then
    inspect_slot "$new_slot" || exit 1
    if [ "$slot_state" != none ]; then
      echo "REFUSE: $new already has a record ($slot_state); records do not merge" >&2
      echo "        tombstone or review $new explicitly" >&2
      exit 1
    fi
    if [ -e "$new_slot/signers" ]; then
      echo "REFUSE: $new_slot holds per-slot signer data (signers/allowed_signers)" >&2
      echo "        moving a record onto it would silently place this content under those" >&2
      echo "        signers; reconcile them by hand, then re-run" >&2
      exit 1
    fi
    for e in "$new_slot"/* "$new_slot"/.[!.]*; do
      if [ -e "$e" ]; then
        echo "REFUSE: $new_slot already holds ${e##*/}; records do not merge" >&2
        echo "        inspect the slot and clear it by hand, then re-run" >&2
        exit 1
      fi
    done
  fi
  case "$state" in
    rev) target="rev.$kind"; what=rev ;;
    *)   target="pin.$kind"; what=digest ;;
  esac
  # Same shape as review: walk from the state file when the slot exists,
  # from the slot itself when this write is about to create it.
  if [ -d "$new_slot" ]; then
    verify_ancestry "$new_slot/$target" || exit 1
  else
    verify_ancestry "$new_slot" || exit 1
  fi

  # CONFORMANCE -- the security core. The record is not re-decided here; the
  # content at the new path has to answer to it.
  case "$state" in
    rev)
      [ "$kind" = git ] \
        || { echo "ERROR: $src declares unsupported VCS '$kind'; refusing" >&2; exit 1; }
      rev="$(read_rev "$old_slot")" || exit 1
      [ -n "$rev" ] || { echo "ERROR: $src holds no rev; malformed record" >&2; exit 1; }
      [ -d "$new" ] || {
        echo "REFUSE: $new is not a directory; a repo record moves to a work tree" >&2
        exit 1
      }
      # resolve_repo is the contract every repo verb resolves through: a
      # usable work tree, named at its ROOT. It sets $repo, which the sgit
      # below runs against.
      resolve_repo "$new"
      # A record names a commit, so the repository that answers to it is the
      # one whose object store HOLDS that commit. A work tree that does not
      # is a different repository wearing the new name.
      sgit cat-file -e "${rev}^{commit}" 2>/dev/null || {
        echo "REFUSE: $new is a work tree, but its object store does not hold the pinned rev" >&2
        echo "        $rev -- this is not the repository the record names" >&2
        exit 1
      }
      ;;
    pin)
      verify_record_file "$src" || exit 1
      read_pin_record "$src" "$kind" "$old" || exit 1
      label="$REC_LABEL"; digest="$REC_DIGEST"
      [ -f "$new" ] || {
        echo "REFUSE: $new is not a regular file; a file record moves to a file" >&2
        exit 1
      }
      freeze_file "$new" || { echo "ERROR: cannot read $new" >&2; exit 1; }
      # THE CHECK IS VERIFY ITSELF -- the gate's own verdict, run against the
      # OLD slot's record with the NEW path's frozen bytes. Reusing it is what
      # keeps mv from holding a private opinion about what "matches" means: 0
      # is byte-exact, 5 is drift confined to keys the slot already declares
      # ignored (and the policy still grants), and every other answer refuses.
      # The owner/mode invariant is the one part this cannot exercise -- verify
      # checks it on the original path, which is by definition gone here -- so
      # it stays what it always was, a per-use question the next verify at the
      # new path answers (30), never something a record carries.
      vout="$workdir/mv-verify"
      vrc=0
      (do_verify --frozen "$FROZEN_COPY" "$old") >"$vout" 2>&1 || vrc=$?
      case "$vrc" in
        0) ;;
        5)
          while IFS= read -r line; do
            case "$line" in
              ignored-drift:*) drifted="${drifted:+$drifted, }${line#ignored-drift: }" ;;
            esac
          done <"$vout" ;;
        11)
          mv_verify_said "$old" "$new" "$vout"
          echo "REFUSE: the content at $new is not what $old's record names" >&2
          echo "        a mv carries the record verbatim; review $new instead" >&2
          exit 1 ;;
        *)
          mv_verify_said "$old" "$new" "$vout"
          echo "ERROR: $old's record could not be checked against $new (verify exit $vrc)" >&2
          exit 1 ;;
      esac
      ;;
  esac

  # The annotations that travel. The tag is re-read through the same
  # declared-name grammar every other reader applies -- a name this version
  # would refuse must not ride along unexamined.
  if [ -f "$old_slot/tag" ]; then
    verify_record_file "$old_slot/tag" || exit 1
    IFS= read -r tag <"$old_slot/tag" || tag=""
    if [ -n "$tag" ] && ! validate_tag_name "$tag"; then
      echo "ERROR: $old_slot/tag is outside the declared-name grammar [A-Za-z0-9._/+-]: $tag" >&2
      echo "       clear it by hand (rm $old_slot/tag), then re-run" >&2
      exit 1
    fi
  fi
  if slot_declares_ignore "$old_slot"; then
    irc=0
    read_ignored_paths "$old_slot" 2>/dev/null || irc=$?
    if [ "$irc" -eq 0 ]; then
      ign_show="$(ign_display "$IGN_PATHS")"
    else
      ign_show="(declaration unreadable; carried verbatim)"
    fi
  fi

  printf '%sold:%s        %s %s(gone)%s\n' "$C_B" "$C_OFF" "$old" "$C_DIM" "$C_OFF"
  printf '%snew:%s        %s%s%s\n' "$C_B" "$C_OFF" "$C_CYN" "$new" "$C_OFF"
  printf '%sslot:%s       %s\n' "$C_B" "$C_OFF" "$old_slot"
  printf '            %s-> %s%s\n' "$C_DIM" "$new_slot" "$C_OFF"
  case "$state" in
    rev)
      printf '%skind:%s       repo record %s(%s)%s\n' "$C_B" "$C_OFF" "$C_DIM" "$target" "$C_OFF"
      printf '%srev:%s        %s%s%s  %s(%s)%s\n' "$C_B" "$C_OFF" "$C_CYN" "$rev" "$C_OFF" \
        "$C_DIM" "$(sgit log -1 --format=%s "$rev")" "$C_OFF" ;;
    pin)
      printf '%skind:%s       file record %s(%s)%s\n' "$C_B" "$C_OFF" "$C_DIM" "$target" "$C_OFF"
      printf '%sdigest:%s     %s%s%s  %s(%s)%s\n' "$C_B" "$C_OFF" "$C_CYN" "$digest" "$C_OFF" \
        "$C_DIM" "$label" "$C_OFF"
      if [ -n "$drifted" ]; then
        printf '%snote:%s       %sthe file at the new path is not byte-identical: %s%s\n' \
          "$C_B" "$C_OFF" "$C_YEL" "$drifted" "$C_OFF"
        printf '            %sthe difference is confined to keys this slot already declares%s\n' \
          "$C_DIM" "$C_OFF"
        printf '            %signored, so the record still names this content (verify: 5).%s\n' \
          "$C_DIM" "$C_OFF"
      fi ;;
  esac
  [ -z "$tag" ] || travels="tag $tag"
  [ -z "$ign_show" ] || travels="${travels:+$travels; }ignored keys: $ign_show"
  [ ! -f "$old_slot/approved" ] || travels="${travels:+$travels; }the approved copy"
  [ ! -f "$old_slot/signers/allowed_signers" ] \
    || travels="${travels:+$travels; }per-slot allowed_signers"
  if [ -n "$travels" ]; then
    printf '%stravels:%s    %s\n' "$C_B" "$C_OFF" "$travels"
  else
    printf '%stravels:%s    %s(the record only -- no annotations)%s\n' "$C_B" "$C_OFF" "$C_DIM" "$C_OFF"
  fi
  echo
  printf '%sConsumers will now trust this content at the new path.%s\n' "$C_B" "$C_OFF"
  printf '%sThe record itself does not change -- same %s, same declarations; only the\n' \
    "$C_DIM" "$what"
  printf 'path it answers to does. The old path above is tombstoned by this move, so\n'
  printf 'anything reappearing there refuses until it is approved on its own.%s\n' "$C_OFF"
  echo
  printf '%smv %s%s%s -> %s%s%s? [y/N]%s ' \
    "$C_B" "$C_CYN" "$old" "$C_OFF$C_B" "$C_CYN" "$new" "$C_OFF$C_B" "$C_OFF"
  read -r answer </dev/tty
  case "$answer" in
    y|Y|yes) ;;
    *) echo "aborted; both slots unchanged"; log_action mv "$old" "$new" abort; exit 2 ;;
  esac

  # WRITE ORDER: the new record first, so there is never a moment when this
  # content has no live record at all. A crash between the two writes leaves
  # the old record live beside the new one -- two paths, one rev or digest,
  # both verifying -- which is the safe failure: nothing is trusted that was
  # not trusted before, and re-running finishes the job.
  case "$state" in
    rev) write_slot_state "$new_slot" "$target" "$rev" ;;
    # The check line names the LIVE path (that is what makes `shasum -c`
    # work on it), so it is the one byte-sequence that must be rewritten:
    # digest preserved, path re-named, two-space separator kept.
    pin) write_slot_state "$new_slot" "$target" "$digest  $new" ;;
  esac
  [ -z "$tag" ] || write_note "$new_slot" tag "$tag"
  # By suffix, not by name: a declared format this version does not
  # recognize still belongs to the record and still travels with it.
  for f in "$old_slot"/ignored.*; do
    [ -e "$f" ] || continue
    write_slot_copy "$new_slot" "${f##*/}" "$f"
  done
  [ ! -f "$old_slot/approved" ] || write_slot_copy "$new_slot" approved "$old_slot/approved"
  if [ -f "$old_slot/signers/allowed_signers" ]; then
    install -d -m "$TREE_DMODE" -o root -g "$TREE_GRP" "$new_slot/signers"
    write_slot_copy "$new_slot/signers" allowed_signers "$old_slot/signers/allowed_signers"
  fi
  printf '%s✓ moved:%s %s%s%s -> %s\n' "$C_GRN$C_B" "$C_OFF" "$C_CYN" "$new" "$C_OFF" "$new_slot/$target"

  write_slot_state "$old_slot" tombstone "$(date -u +%Y-%m-%dT%H:%M:%SZ) moved to $new by $inv"
  rm -f "$old_slot/tag"          # the declared name left with the record
  clear_slot_ignore "$old_slot"  # as did the tolerated keys and the copy
  if [ -f "$old_slot/signers/allowed_signers" ]; then
    rm -f "$old_slot/signers/allowed_signers"
    # Only an EMPTY leftover goes -- anything still in there is unexplained
    # state a trust tool must not delete on a hunch (ensure_tree's rule).
    rmdir "$old_slot/signers" 2>/dev/null \
      || printf '%swarning: %s is not empty; left in place%s\n' \
           "$C_YEL" "$old_slot/signers" "$C_OFF" >&2
  fi
  printf '%s✓ tombstoned:%s %s %s(moved to %s)%s\n' \
    "$C_GRN$C_B" "$C_OFF" "$old" "$C_DIM" "$new" "$C_OFF"
  log_action mv "$old" "$new"
}

# ---- verify ----------------------------------------------------------------

# The consumer verdict for file pins -- replaces every consumer's
# private copy of the state table (writer/reader split: review records,
# verify answers). Exit contract, a stable API:
#   0   state matches the record (pin + match, or tombstone + absent)
#   5   the bytes differ, but ONLY in keys the slot declared ignored (see
#       ignored.<format> above) AND the ignorable policy still grants every
#       one of those keys for this path -- and the differing keys are named on
#       stdout, one `ignored-drift: <key>` line each
#   10  no slot for this path
#   11  hash mismatch
#   13  tombstoned but the path is present (retired content resurrected)
#   20  live pin but the file is missing
#   30  mode/ownership invariant violated
# The decade is the consumer's action class, and it is ONE taxonomy across
# the verbs that answer about a record (verify here, cat below): teens
# "review fixes it", twenties "restore or tombstone", thirties "invariant".
# 12, 14 and 15 are RETIRED and never reused; 16 belongs to cat ("no stored
# witness"). A new code takes the next free number in its class.
#
# THE NUMBERING RULE, settled: renumber WHOLESALE when coherence demands it
# (as the sweep into decade classes did) and never backfill a retired slot
# piecemeal. A retired number is a number some deployed consumer still
# remembers; handing it a new meaning makes a running gate misread a verdict
# it thinks it understands, silently, until the next deploy catches up. A
# wholesale renumber is loud and lands with its consumers.
#
# Anything structural (malformed slot, unknown algorithm, wrong recorded
# path, unreadable tier) is a hard error: exit 1, fail closed. The
# common gate stays `if pinned verify <path>; then`.
#
# Four forms; the slot key is ALWAYS the original <path>:
#   verify <path>                 gate/report: freeze internally, verdict only
#   verify --emit <path>          freeze, verify, print the VERIFIED bytes on
#                                 stdout; NOTHING on nonzero exit. The "verify
#                                 and emit the SAME bytes" shape as one call.
#                                 BYTE-EXACT ONLY: --emit never answers 5,
#                                 because bytes that merely match modulo
#                                 ignored keys are not the verified bytes.
#   verify --frozen <copy> <path> caller-frozen bytes against <path>'s record,
#                                 for callers that must hold bytes before a
#                                 verdict exists; digest from the copy, the
#                                 mode invariant still checks the original.
#   verify --baseline <copy> <path>
#                                 a CALLER-BROUGHT WITNESS for the ignored-key
#                                 comparison, for a slot that keeps none of
#                                 its own (review --store is what keeps one).
#                                 A permanent interface, not a shim: custody
#                                 is opt-in, so a caller that held the last
#                                 approved bytes is an ordinary case. The copy
#                                 must re-hash to the record or it is ignored;
#                                 a forged one can only ever make verify
#                                 STRICTER (the projection then differs).
# Consumer rule: PARSE content -> --emit or --frozen; gate/display only
# -> bare form (the verdict refers to one coherent frozen moment; a
# caller's later live read is the caller's race).
do_verify() {
  local emit=0 frozen="" baseline="" path=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --emit) emit=1; shift ;;
      --frozen)
        [ $# -ge 2 ] || { echo "--frozen needs the copy's path" >&2; exit 1; }
        frozen="$2"; shift 2 ;;
      --baseline)
        [ $# -ge 2 ] || { echo "--baseline needs the copy's path" >&2; exit 1; }
        baseline="$2"; shift 2 ;;
      -*) echo "unknown verify option: $1" >&2; usage ;;
      *)  [ -z "$path" ] || { echo "verify takes one path" >&2; usage; }
          path="$1"; shift ;;
    esac
  done
  [ -n "$path" ] || usage
  if [ "$emit" -eq 1 ] && [ -n "$frozen" ]; then
    echo "--emit and --frozen are exclusive" >&2
    exit 1
  fi
  path="$(canon_path "$path")" || exit 1

  local tier slot
  tier="$(tier_user)"
  slot="$(slot_dir_for "$tier" "$path")"
  if [ ! -d "$slot" ]; then
    # Distinguish "no slot" from "cannot see the slots": an unreadable
    # tier must never read as unapproved.
    if [ -d "$PINNED_ROOT/$tier" ] && [ ! -r "$PINNED_ROOT/$tier" ]; then
      echo "ERROR: cannot read $PINNED_ROOT/$tier -- are you in group $(pin_group "$tier")?" >&2
      exit 1
    fi
    echo "no slot: $path" >&2
    exit 10
  fi
  inspect_slot "$slot" || exit 1
  local line
  case "$slot_state" in
    none)
      echo "no slot: $path" >&2
      exit 10 ;;
    rev)
      echo "ERROR: $path has a repo slot (rev.$slot_kind); verify covers file pins -- use status" >&2
      exit 1 ;;
    tombstone)
      verify_record_file "$slot_file" || exit 1
      if [ -e "$path" ]; then
        IFS= read -r line <"$slot_file" || line=""
        echo "REFUSE: $path is tombstoned ($line) but present -- retired content resurrected" >&2
        exit 13
      fi
      exit 0 ;;
    pin) ;;
  esac

  verify_record_file "$slot_file" || exit 1
  read_pin_record "$slot_file" "$slot_kind" "$path" || exit 1
  local label="$REC_LABEL" rec_digest="$REC_DIGEST"

  # SLOT INVARIANT, checked before anything about the live file: if the
  # slot keeps an `approved` copy, that copy MUST re-hash to the record it
  # sits beside. Authenticating a witness before use is the rule everywhere
  # -- what makes this a hard error rather than a quietly declined witness is
  # WHERE these bytes are: root custody, which nothing unprivileged can have
  # written. Bytes that are both root-owned and not the approved bytes are
  # incoherent state, not weak evidence. Checked eagerly (even when the live
  # file matches byte for byte) because a slot either holds coherent state or
  # it does not, and the moment to say so is the next time anyone looks.
  if [ -e "$slot/approved" ]; then
    [ -f "$slot/approved" ] || {
      echo "ERROR: $slot/approved is not a regular file; malformed slot" >&2
      exit 1
    }
    verify_record_file "$slot/approved" || exit 1
    local copy_digest
    copy_digest="$(hash_file "$label" "$slot/approved")" || exit 1
    [ "$copy_digest" = "$rec_digest" ] || {
      echo "ERROR: $slot/approved does not re-hash to its own record; malformed slot" >&2
      echo "  record $label: $rec_digest" >&2
      echo "  copy   $label: $copy_digest" >&2
      echo "  re-approve the path to reset the slot: pinned review --file $path ..." >&2
      exit 1
    }
  fi

  # Order: existence (20), then the mode invariant (30), then content
  # (11). With --frozen the copy evidences existence -- absence was the
  # caller's to catch at its freeze -- so 20 cannot arise there.
  local subject
  if [ -n "$frozen" ]; then
    [ -f "$frozen" ] || { echo "ERROR: frozen copy is not a readable file: $frozen" >&2; exit 1; }
    subject="$frozen"
  else
    if [ ! -e "$path" ]; then
      echo "REFUSE: $path is pinned but missing (restore it, or run: pinned tombstone $path)" >&2
      exit 20
    fi
    [ -f "$path" ] || { echo "ERROR: not a regular file: $path" >&2; exit 1; }
  fi
  # The invariant, always on the ORIGINAL path: owned by the tier user OR
  # root, and not group- or world-writable. Deliberately not a pinned VALUE
  # (A7): verification is per-use and content-addressed, so a rewrite through
  # a loosened mode is caught by the hash check at the next use, and
  # against a process running AS the user the mode is irrelevant (the
  # owner can chmod back). The absolute invariant needs no per-slot
  # storage and never churns. Root ownership is admitted because it is
  # STRICTLY STRONGER than tier ownership -- the tier user cannot rewrite a
  # root-owned file at all -- and root-owned configs are exactly the files a
  # user most wants pinned (e.g. a managed settings floor: root-owned by
  # design as the raceless anchor, yet still worth a content record so a
  # root-side change re-enters review).
  if [ -e "$path" ]; then
    local owner mode
    owner="$(stat_owner "$path")"
    if [ "${owner%%:*}" != "$tier" ] && [ "${owner%%:*}" != root ]; then
      echo "REFUSE: $path is owned by ${owner%%:*}, expected $tier (or root)" >&2
      exit 30
    fi
    mode="$(stat_mode "$path")"
    case "$mode" in
      *[2367]?|*[2367])
        echo "REFUSE: $path has mode $mode (group/other-writable); fix: chmod go-w $path" >&2
        exit 30 ;;
    esac
  fi

  if [ -z "$frozen" ]; then
    freeze_file "$path" || { echo "ERROR: cannot read $path" >&2; exit 1; }
    subject="$FROZEN_COPY"
  fi
  local live_digest
  live_digest="$(hash_file "$label" "$subject")" || exit 1
  if [ "$live_digest" != "$rec_digest" ]; then
    # The byte-exact answer is 11. A slot that declares ignored keys gets
    # one chance to prove the difference is confined to them; anything that
    # cannot be proven -- no declaration, no last-approved bytes, no jq, an
    # unparseable or ambiguous side, a difference elsewhere -- lands right
    # back here. --emit is excluded on purpose: what it prints must be the
    # verified bytes, and these are not.
    if [ "$emit" -eq 0 ] && slot_declares_ignore "$slot" \
       && ignored_keys_match "$slot" "$label" "$rec_digest" "$subject" "$baseline" "$path"; then
      exit 5
    fi
    echo "REFUSE: $path does not match its approved record" >&2
    echo "  approved $label: $rec_digest" >&2
    echo "  live     $label: $live_digest" >&2
    exit 11
  fi
  if [ "$emit" -eq 1 ]; then
    cat -- "$subject"
  else
    printf '%s✓ verified:%s %s\n' "$C_GRN" "$C_OFF" "$path"
  fi
}

# ---- cat -------------------------------------------------------------------

# CUSTODY'S VERIFIED READER. The moment a slot keeps an `approved` witness it
# becomes a place to read approved bytes from, and something WILL read that
# file directly -- which is exactly what must not happen, because nothing
# outside pinned interprets slot contents. So custody ships with the reader
# that authenticates before it serves: cat re-hashes the stored witness
# against the record and only then emits it.
#
# Unprivileged, and writes nothing: slot dirs are group-readable by the tier
# user, so a reader has nothing to elevate for. Root ownership of the slot
# buys that the bytes cannot have been written by anything unprivileged; the
# re-hash is what proves they are the APPROVED bytes.
#
# Exit contract, the same decade taxonomy verify uses:
#   0   the witness re-hashed to the record; its bytes are on stdout
#   1   error -- including a MALFORMED SLOT (a witness that does not re-hash,
#       more than one state file), the class verify hard-errors on too
#   10  no record for this path
#   13  tombstoned
#   16  the record is valid but the slot keeps NO witness (remediation:
#       pinned review --file <path> --store)
#   20  the record is live but the FILE is missing
#   30  a slot ownership/mode invariant is violated
# NOTHING reaches stdout in any failure case: a consumer piping cat into a
# parser gets the approved bytes or an empty stream, never a fragment and
# never an error message.
#
# 30 WHERE VERIFY SAYS 1, on the same slot-ownership check: for a GATE, a
# record it cannot trust is a structural failure of the tool; for a READER it
# is the same class of thing as a wrong-owner live file -- an invariant to
# fix with chown/chmod, not a record to re-approve. The LIVE file's mode is
# not checked at all here, because cat does not serve the live file; only its
# existence is consulted, below.
#
# 20 BEFORE 16, deliberately: a deleted file signals retirement, and custody
# must not go on serving a removed file's content to consumers that never
# notice it is gone -- restore it, or tombstone it. Answering 16 first would
# also name a remediation that cannot run, since review --file refuses a
# path that is not there.
#
# SERVES DESPITE DRIFT, deliberately: a consumer pointed straight at the
# slot's `approved` file reads the approved bytes regardless of what the live
# file says today, and cat is that same access with verification added --
# refusing here would only push such consumers back to the raw file. On this
# rung the approved bytes ARE the authoritative content; the live file is the
# editing surface, waiting for its next ceremony. A consumer that cares
# whether the two agree calls verify. One job per verb.
do_cat() {
  [ $# -eq 1 ] || { echo "cat takes one path" >&2; usage; }
  local path tier slot line
  tier="$(tier_user)"
  path="$(canon_path "$1")" || exit 1
  slot="$(slot_dir_for "$tier" "$path")"
  if [ ! -d "$slot" ]; then
    # Distinguish "no slot" from "cannot see the slots", exactly as verify
    # does: an unreadable tier must never read as unapproved.
    if [ -d "$PINNED_ROOT/$tier" ] && [ ! -r "$PINNED_ROOT/$tier" ]; then
      echo "ERROR: cannot read $PINNED_ROOT/$tier -- are you in group $(pin_group "$tier")?" >&2
      exit 1
    fi
    echo "no slot: $path" >&2
    exit 10
  fi
  inspect_slot "$slot" || exit 1
  case "$slot_state" in
    none)
      echo "no slot: $path" >&2
      exit 10 ;;
    rev)
      # Custody is a FILE-pin concept. A repo slot records a rev, and the
      # content behind that rev already lives in git, addressable by it --
      # there is nothing for pinned to hold a second copy of.
      echo "ERROR: $path has a repo slot (rev.$slot_kind); cat serves file pins" >&2
      echo "       a repo's content lives in git: read the approved rev from the slot" >&2
      echo "       (pinned slot $path, or a root-owned symlink at it) and ask git --" >&2
      echo "       git -C $path show <rev>:<file>" >&2
      exit 1 ;;
    tombstone)
      IFS= read -r line <"$slot_file" || line=""
      echo "REFUSE: $path is tombstoned ($line); there is no approved content to serve" >&2
      exit 13 ;;
  esac

  verify_record_file "$slot_file" || exit 30
  read_pin_record "$slot_file" "$slot_kind" "$path" || exit 1

  if [ ! -e "$path" ]; then
    echo "REFUSE: $path is pinned but missing -- custody does not serve a removed file" >&2
    echo "        (restore it, or run: pinned tombstone $path)" >&2
    exit 20
  fi
  [ -f "$path" ] || { echo "ERROR: not a regular file: $path" >&2; exit 1; }

  if [ ! -e "$slot/approved" ]; then
    echo "REFUSE: $slot keeps no approved copy; there is nothing to serve" >&2
    echo "        (custody is opt-in: pinned review --file $path --store)" >&2
    exit 16
  fi
  [ -f "$slot/approved" ] || {
    echo "ERROR: $slot/approved is not a regular file; malformed slot" >&2
    exit 1
  }
  verify_record_file "$slot/approved" || exit 30
  local copy_digest
  copy_digest="$(hash_file "$REC_LABEL" "$slot/approved")" || exit 1
  [ "$copy_digest" = "$REC_DIGEST" ] || {
    echo "ERROR: $slot/approved does not re-hash to its own record; malformed slot" >&2
    echo "  record $REC_LABEL: $REC_DIGEST" >&2
    echo "  copy   $REC_LABEL: $copy_digest" >&2
    echo "  re-approve the path to reset the slot: pinned review --file $path --store" >&2
    exit 1
  }
  # Only now, and raw. The bytes are the deliverable, so nothing decorates
  # them -- and nothing else has been written to this stream to decorate.
  cat -- "$slot/approved"
}

# ---- status ----------------------------------------------------------------

do_status() {
  inv="$(tier_user)"  # not id -un: correct tier under sudo (root has none)
  [ $# -ge 1 ] || usage
  # A directory is a repo; anything else (present or not) is a file pin.
  if [ ! -d "$1" ]; then
    do_status_file "$1"
    return
  fi
  resolve_repo "$@"
  local slot="$default_slot" hash head_hash ahead
  hash="$(read_rev "$slot")" || exit 1
  head_hash="$(sgit rev-parse 'HEAD^{commit}')"

  printf '%srepo:%s       %s%s%s  %s(%s)%s\n' "$C_DIM" "$C_OFF" "$C_B$C_MAG" "${repo##*/}" "$C_OFF" \
    "$C_DIM" "$repo" "$C_OFF"
  printf '%sslot:%s       %s\n' "$C_DIM" "$C_OFF" "$slot"
  if [ -z "$hash" ]; then
    printf '%spinned:%s     (none)\n' "$C_DIM" "$C_OFF"
  else
    printf '%spinned:%s     %s%s%s  %s(%s)%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$hash" "$C_OFF" \
      "$C_DIM" "$(sgit log -1 --format=%s "$hash" 2>/dev/null || echo 'commit not in repo!')" "$C_OFF"
  fi
  printf '%sgit HEAD:%s   %s%s%s  %s(%s)%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$head_hash" "$C_OFF" \
    "$C_DIM" "$(sgit log -1 --format=%s "$head_hash")" "$C_OFF"
  if [ -n "$hash" ] && [ "$hash" = "$head_hash" ]; then
    printf '%sstate:%s      %s✓ HEAD is approved%s\n' "$C_DIM" "$C_OFF" "$C_GRN" "$C_OFF"
  elif [ -n "$hash" ]; then
    ahead="$(sgit rev-list --count "${hash}..${head_hash}" 2>/dev/null || echo '?')"
    printf '%sstate:%s      %s✗ HEAD is not approved (%s commit%s ahead of pin)%s\n' "$C_DIM" "$C_OFF" \
      "$C_RED" "$ahead" "$(plural_s "$ahead")" "$C_OFF"
  else
    printf '%sstate:%s      %s✗ never approved%s\n' "$C_DIM" "$C_OFF" "$C_RED" "$C_OFF"
  fi
  # Availability, not trust: the pin means what it means regardless of the
  # checkout (content-addressed), but a rev the object store no longer
  # holds cannot be RE-FETCHED -- surface that here instead of as a nix
  # error mid-rebuild. (nix may still deploy from its store cache.)
  if [ -n "$hash" ] && ! sgit cat-file -e "${hash}^{commit}" 2>/dev/null; then
    printf '%swarning: the pinned rev is missing from this checkout (rewritten history or gc?) --%s\n' "$C_RED$C_B" "$C_OFF"
    printf '%s         a deploy that needs to re-fetch it will fail; restore the commit or re-approve%s\n' "$C_RED$C_B" "$C_OFF"
  fi
  if ! sgit_diff --quiet 2>/dev/null || ! sgit_diff --cached --quiet 2>/dev/null; then
    printf '%swarning: work tree is dirty (uncommitted changes are never approved)%s\n' "$C_YEL" "$C_OFF"
  fi
}

# File-pin status: the record, and the live path's verdict against it.
# The verdict is verify's own (subshell), so status can never disagree
# with the gate.
do_status_file() {
  local path slot rc line
  path="$(canon_path "$1")" || exit 1
  slot="$(slot_dir_for "$inv" "$path")"
  printf '%sfile:%s       %s\n' "$C_DIM" "$C_OFF" "$path"
  printf '%sslot:%s       %s\n' "$C_DIM" "$C_OFF" "$slot"
  if ! inspect_slot "$slot" 2>/dev/null; then
    printf '%sstate:%s      %s✗ malformed slot -- inspect it by hand%s\n' "$C_DIM" "$C_OFF" "$C_RED$C_B" "$C_OFF"
    exit 1
  fi
  case "$slot_state" in
    none)
      printf '%spinned:%s     (none)\n' "$C_DIM" "$C_OFF"
      printf '%sstate:%s      %s✗ never approved%s\n' "$C_DIM" "$C_OFF" "$C_RED" "$C_OFF"
      return ;;
    rev)
      IFS= read -r line <"$slot_file" || line=""
      printf '%spinned:%s     %s%s%s  %s(rev.%s -- a repo pin at a non-directory path)%s\n' \
        "$C_DIM" "$C_OFF" "$C_CYN" "$line" "$C_OFF" "$C_YEL" "$slot_kind" "$C_OFF"
      return ;;
    tombstone)
      IFS= read -r line <"$slot_file" || line=""
      printf '%spinned:%s     tombstoned %s(%s)%s\n' "$C_DIM" "$C_OFF" "$C_DIM" "$line" "$C_OFF"
      if [ -e "$path" ]; then
        printf '%sstate:%s      %s✗ tombstoned but present (retired content resurrected)%s\n' \
          "$C_DIM" "$C_OFF" "$C_RED$C_B" "$C_OFF"
      else
        printf '%sstate:%s      %s✓ tombstoned and absent%s\n' "$C_DIM" "$C_OFF" "$C_GRN" "$C_OFF"
      fi
      return ;;
    pin)
      IFS= read -r line <"$slot_file" || line=""
      printf '%spinned:%s     %s%s%s  %s(%s)%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "${line%%  *}" "$C_OFF" \
        "$C_DIM" "$slot_kind" "$C_OFF"
      # The slot's extras, when it has them: WHICH keys may drift is part
      # of what this record says, so it belongs in the record's report.
      if slot_declares_ignore "$slot"; then
        if read_ignored_paths "$slot" 2>/dev/null; then
          printf '%signored:%s    %s%s%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$(ign_display "$IGN_PATHS")" "$C_OFF"
        else
          printf '%signored:%s    %s✗ unusable declaration (re-approve to reset)%s\n' \
            "$C_DIM" "$C_OFF" "$C_YEL" "$C_OFF"
        fi
      fi
      # Custody is reported for EVERY file record, declaration or not --
      # same rule as list: a byte-exact slot with (or without) a copy is
      # a fact about the record, not about its ignore declaration.
      if [ -e "$slot/approved" ]; then
        printf '%scustody:%s    approved bytes kept in the slot (pinned cat serves them)\n' "$C_DIM" "$C_OFF"
      else
        printf '%scustody:%s    %snone -- a consumer supplies its own witness (verify --baseline),%s\n' \
          "$C_DIM" "$C_OFF" "$C_DIM" "$C_OFF"
        printf '            %sor re-approve with --store%s\n' "$C_DIM" "$C_OFF"
      fi
      rc=0; (do_verify "$path" >/dev/null 2>&1) || rc=$?
      case "$rc" in
        0)  printf '%sstate:%s      %s✓ live file matches the record%s\n' "$C_DIM" "$C_OFF" "$C_GRN" "$C_OFF" ;;
        5)  printf '%sstate:%s      %s~ live file matches except in the ignored keys%s\n' "$C_DIM" "$C_OFF" "$C_YEL" "$C_OFF" ;;
        11) printf '%sstate:%s      %s✗ live file differs from the record%s\n' "$C_DIM" "$C_OFF" "$C_RED$C_B" "$C_OFF" ;;
        20) printf '%sstate:%s      %s✗ pinned but missing (restore, or tombstone)%s\n' "$C_DIM" "$C_OFF" "$C_RED" "$C_OFF" ;;
        30) printf '%sstate:%s      %s✗ mode/ownership invariant violated%s\n' "$C_DIM" "$C_OFF" "$C_RED" "$C_OFF" ;;
        *)  printf '%sstate:%s      %s✗ verify error (exit %s)%s\n' "$C_DIM" "$C_OFF" "$C_RED" "$rc" "$C_OFF" ;;
      esac ;;
  esac
}

# ---- sign ------------------------------------------------------------------

do_sign() {
  # Export the pin as a normal signed release tag -- NO re-read anywhere in
  # the path. The hash comes from the root-owned pin file and is passed to
  # git explicitly, so "what gets signed" is exactly "what was approved";
  # a compromised environment can neither alter the hash nor this binary.
  # Runs as the plain user: signing needs the user's SSH agent (1Password),
  # which sudo strips. The agent popup is blind (shows key use, not
  # content) -- the binding to content is this code path, plus the rule
  # that an unprompted popup is always denied.
  [ "$EUID" -ne 0 ] || { echo "run sign without sudo (it needs your SSH agent)" >&2; exit 1; }
  inv="$(id -un)"
  [ $# -eq 2 ] || usage
  local tag_name="$2"
  case "$tag_name" in
    -*) echo "invalid tag name: $tag_name" >&2; exit 1 ;;
  esac
  resolve_repo "$1"
  sgit check-ref-format "refs/tags/$tag_name" \
    || { echo "invalid tag name: $tag_name" >&2; exit 1; }

  local hash
  hash="$(read_rev "$default_slot")" || exit 1
  [ -n "$hash" ] || { echo "no pin for $repo -- review first" >&2; exit 1; }

  # An existing tag may be signed IF it already points at the pinned rev
  # (e.g. an unsigned release tag being promoted). Pointing anywhere else
  # is refused: sign never moves what a tag means. Note -f replaces any
  # previous signature on the tag; co-signers use distinct tag names.
  local force=""
  if sgit rev-parse -q --verify "refs/tags/${tag_name}" >/dev/null 2>&1; then
    local existing
    existing="$(sgit rev-parse "refs/tags/${tag_name}"'^{commit}')"
    if [ "$existing" != "$hash" ]; then
      echo "ERROR: tag $tag_name exists at $existing, not the pinned $hash" >&2
      echo "       refusing to move it -- pick another name, or review that rev first" >&2
      exit 1
    fi
    echo "note: $tag_name already points at the pinned rev; re-signing in place"
    force="-f"
  fi

  # User git config deliberately in play here: it supplies user.signingkey
  # and gpg.format=ssh. An attacker rewriting those can only produce a
  # signature by the WRONG key, which allowed_signers verification rejects
  # -- fail closed. The absolute git binary and the explicit hash are what
  # matter; `git tag` runs no hooks and builtins can't be alias-shadowed.
  if [ -n "$force" ]; then
    git -C "$repo" --no-pager tag -s -f -m "signed by $inv via pinned" "$tag_name" "$hash"
  else
    git -C "$repo" --no-pager tag -s -m "signed by $inv via pinned" "$tag_name" "$hash"
  fi
  printf '%s✓ signed:%s %s at %s%s%s (the pinned hash)\n' "$C_GRN$C_B" "$C_OFF" "$tag_name" "$C_CYN" "$hash" "$C_OFF"
  printf '%s  consumers verify with review --signed-tag %s against their allowed_signers%s\n' "$C_DIM" "$tag_name" "$C_OFF"
  log_action sign "$repo" "$hash"
}

# ---- list ------------------------------------------------------------------

do_list() {
  # Every live (non-tombstoned) pin in the invoking user's tier, one per
  # line: declared kind (git / sha256 / ...), digest, decoded path.
  # Unprivileged -- reading needs membership in the tier's group. Slot
  # names never leave this function: consumers get decoded paths.
  inv="$(tier_user)"  # not id -un: correct tier under sudo (root has none)
  local under=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --under)
        [ $# -ge 2 ] || { echo "--under needs a directory" >&2; exit 1; }
        under="$2"; shift 2 ;;
      *) echo "unknown list option: $1" >&2; usage ;;
    esac
  done
  if [ -n "$under" ]; then
    # Matching is on DECODED paths at a component boundary (--under /a/b
    # matches /a/b/c, never /a/bc), so normalize to an absolute path
    # with no trailing slash.
    case "$under" in
      /*) ;;
      *) under="$(pwd -P)/$under" ;;
    esac
    [ -d "$under" ] && under="$(readlink -f "$under")"
    while [ "${under%/}" != "$under" ]; do under="${under%/}"; done
    [ -n "$under" ] || under=/
  fi

  local sroot="$PINNED_ROOT/$inv/slots"
  [ -d "$PINNED_ROOT" ] || { echo "no pin root ($PINNED_ROOT) -- nothing approved yet" >&2; exit 1; }
  if [ ! -d "$sroot" ]; then echo "(no pins)"; exit 0; fi
  [ -r "$sroot" ] || {
    echo "ERROR: cannot read $sroot -- are you in group $(pin_group "$inv")?" >&2
    exit 1
  }
  local d path line digest found=0 copy annotated
  for d in "$sroot"/*/; do
    d="${d%/}"
    [ -e "$d" ] || continue
    path="$(decode "${d##*/}")"
    if [ -n "$under" ]; then
      case "$path" in
        "$under"|"$under"/*) ;;
        *) continue ;;
      esac
    fi
    if ! inspect_slot "$d" 2>/dev/null; then
      printf '%sMALFORMED%s  %s\n' "$C_RED$C_B" "$C_OFF" "$path"
      found=1; continue
    fi
    case "$slot_state" in
      none|tombstone) continue ;;
      rev)
        if digest="$(read_rev "$d" 2>/dev/null)" && [ -n "$digest" ]; then
          printf '%-11s %s%s%s  %s\n' "$slot_kind" "$C_CYN" "$digest" "$C_OFF" "$path"
        else
          printf '%sCORRUPT%s  %s\n' "$C_RED$C_B" "$C_OFF" "$path"
        fi ;;
      pin)
        IFS= read -r line <"$slot_file" || line=""
        digest="${line%%  *}"
        case "$digest" in
          *[!0-9a-f]*|'') printf '%sCORRUPT%s  %s\n' "$C_RED$C_B" "$C_OFF" "$path" ;;
          *)
            printf '%-11s %s%s%s  %s\n' "$slot_kind" "$C_CYN" "$digest" "$C_OFF" "$path"
            # Extras ride an INDENTED continuation line, never the row
            # itself: the row is a parsed contract (`<kind> <digest>  <abs
            # path>`, and a decoded path may contain spaces), so a marker
            # inside it would have to be teased back out by every consumer.
            # A line that cannot match the row shape is skipped by all of
            # them and read by humans.
            #
            # Custody is annotated on EVERY well-formed file row, present or
            # absent: a consumer reading through the slot (pinned cat, a
            # baseline-free verify) is served by one and refused by the
            # other, and a silence that means "byte-exact, no copy" is a
            # silence somebody has to stat the slot to resolve.
            if [ -e "$d/approved" ]; then copy=1; else copy=0; fi
            annotated=0
            if slot_declares_ignore "$d"; then
              if read_ignored_paths "$d" 2>/dev/null; then
                # Copy plus declaration: one combined line, so the two
                # facts about the same slot do not read as two slots.
                printf '%s            ignored: %s%s%s\n' "$C_DIM" "$(ign_display "$IGN_PATHS")" \
                  "$([ "$copy" -eq 1 ] && printf ' (+approved copy)')" "$C_OFF"
                if [ "$copy" -eq 1 ]; then annotated=1; fi
              else
                printf '%s            ignored: unusable declaration%s\n' "$C_YEL" "$C_OFF"
              fi
            fi
            if [ "$annotated" -eq 0 ]; then
              if [ "$copy" -eq 1 ]; then
                printf '%s            (+approved copy)%s\n' "$C_DIM" "$C_OFF"
              else
                printf '%s            no approved copy -- re-approve with --store to keep one%s\n' \
                  "$C_YEL" "$C_OFF"
              fi
            fi ;;
        esac ;;
    esac
    found=1
  done
  [ "$found" -eq 1 ] || echo "(no pins)"
}

# ---- show ------------------------------------------------------------------

# Trusted display of a file OUTSIDE any repo, for hash-gated consumers (e.g. a
# hook wired in a content-gated settings file: the wrapper reads once, hashes
# what it read, and executes only on match). Show is the REHEARSAL: it
# records nothing -- `review --file` is the ceremony that does, and
# `verify --emit` is the programmatic read. Humans review, machines verify;
# the record happens only in the review ceremony. A DIRECTORY argument
# takes the repo branch below (do_show_repo) instead; the file ceremony
# here is untouched by it.
#
# The security-relevant act is the READ, not the hash. Hashing is trivial;
# what earns trust is that the bytes shown to you and the bytes hashed are the
# SAME single read -- never two reads of a file an attacker can swap between
# them. So: one read into memory, display those bytes, hash those bytes.
#
# Runs unprivileged (nothing to elevate -- it writes nothing). Root ownership
# of this binary is what protects the ceremony itself: a user-writable display
# script could show you innocent bytes and hash malicious ones, and unlike a
# falsified display that lie would SURVIVE (you would paste a hash that
# genuinely matches the malicious file). A lying display fails closed; a lying
# ceremony fails open. That asymmetry is why this lives here.
do_show() {
  # $algo carries a default, so given-ness needs its own marker; $length has
  # none yet at this point (its default is applied further down), so emptiness
  # is its marker. Both are read by the repo branch, which refuses them.
  local algo=sha256 file="" a length="" algo_given=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --algo|-a)
        [ $# -ge 2 ] || { echo "--algo needs a value" >&2; exit 1; }
        algo="$2"; algo_given=1; shift 2 ;;
      --length|-l)
        [ $# -ge 2 ] || { echo "--length needs a value (bits)" >&2; exit 1; }
        length="$2"; shift 2 ;;
      --) shift; break ;;
      -*) echo "unknown option: $1" >&2; usage ;;
      *)  [ -z "$file" ] || { echo "show takes one file or repo" >&2; usage; }
          file="$1"; shift ;;
    esac
  done
  [ -n "$file" ] || [ $# -eq 0 ] || { file="$1"; shift; }
  [ -n "$file" ] || usage

  # A directory is a repo, the same shape test status uses; anything else --
  # present or not -- stays with the file ceremony below. A directory that is
  # not a usable git work tree is resolve_repo's refusal, not this dispatch's.
  if [ -d "$file" ]; then
    [ "$algo_given" -eq 0 ] && [ -z "$length" ] \
      || { echo "--algo/--length apply to the file display" >&2; exit 1; }
    do_show_repo "$file"
    return
  fi

  # Only algorithms whose collision resistance still carries a trust decision.
  # The floor is 256 bits of OUTPUT (~128-bit collision resistance), applied by
  # output length rather than by family -- so sha512/256 is in and sha512/224 is
  # out, exactly like sha224, despite both being SHA-512 underneath. sha1/md5
  # are refused outright: this hash IS the gate, and a chosen-prefix collision
  # would let the bytes you reviewed and the bytes that execute differ.
  #
  # Post-quantum: nothing to do here. Grover only square-roots preimage search
  # and quantum collision search does not beat classical in practice, so a
  # 256-bit hash stays adequate; PQ pressure is on SIGNATURES, not digests.
  # 384/512 are available if you want margin anyway.
  #
  # Adding another function (blake2/blake3 below are the template) means one
  # case arm here plus one hash_cmd branch below. The constraint is not the
  # algorithm, it is the BINARY: whatever computes the digest decides whether
  # the gate passes, so it must resolve inside the trusted PATH pinned at the
  # top of this file. That is also why there is no --hasher flag taking a
  # path -- it would let the caller nominate an attacker-writable verifier.
  #
  # Values are each algorithm's standard name, one rule across families.
  # BLAKE2 kept per-length names (RFC 7693 era), so those carry a suffix;
  # BLAKE3 is one function whose standard digest is 256-bit, longer output
  # being the same function as an XOF -- that is what --length is for, and
  # why blake3 takes no suffix. sha512/256 and unsuffixed blake2b (= -512,
  # its standard default) are accepted, not advertised. $algo normalizes to
  # what the hasher's -a/-l flag wants.
  local algo_name
  case "$algo" in
    sha256)              algo_name="sha"; algo=256 ;;
    sha384)              algo_name="sha"; algo=384 ;;
    sha512)              algo_name="sha"; algo=512 ;;
    sha512/256)          algo_name="sha"; algo=512256 ;;
    blake2b-256)         algo_name="blake2"; algo=256 ;;
    blake2b-384)         algo_name="blake2"; algo=384 ;;
    blake2b-512|blake2b) algo_name="blake2"; algo=512 ;;
    blake3)              algo_name="blake3" ;;
    md5|sha1|MD5|SHA1)
      echo "refusing $algo: collision-vulnerable, and this hash is the gate" >&2
      exit 1 ;;
    sha224|sha512/224|blake2b-224)
      echo "refusing $algo: 224-bit output is below the 256-bit floor for a trust decision" >&2
      exit 1 ;;
    blake2s|blake2s-*)
      echo "unsupported: b2sum computes BLAKE2b only; blake2b-256 gives the same 256-bit output" >&2
      exit 1 ;;
    *)
      echo "unsupported algorithm: $algo (use sha256, sha384, sha512, blake2b-256/384/512, blake3)" >&2
      exit 1 ;;
  esac

  # --length: blake3 only -- the XOF's output size, in BITS like every length
  # in the algorithm names. Everything else carries its length in the name.
  if [ -n "$length" ]; then
    [ "$algo_name" = blake3 ] || {
      echo "--length applies only to blake3 (other algorithms carry their length in the name)" >&2
      exit 1
    }
    case "$length" in
      ''|*[!0-9]*) echo "--length must be a whole number of bits" >&2; exit 1 ;;
    esac
    [ $((length % 8)) -eq 0 ] || { echo "--length must be a multiple of 8 bits" >&2; exit 1; }
    [ "$length" -ge 256 ] || {
      echo "refusing --length $length: below the 256-bit floor for a trust decision" >&2
      exit 1
    }
  else
    length=256
  fi

  # Resolve the hashing command; fail closed and say what to install. The
  # usage text lists every algorithm regardless of what this machine has:
  # help describes the interface and must not vary by host -- availability
  # is this check's job.
  case "$algo_name" in
    blake3)
      command -v b3sum >/dev/null 2>&1 || {
        echo "blake3 requested but b3sum is not in the trusted PATH ($PATH)" >&2
        echo "       install b3sum system-wide (a user-writable one would defeat the gate)" >&2
        exit 1
      } ;;
    blake2)
      command -v b2sum >/dev/null 2>&1 || {
        echo "blake2b requested but b2sum is not in the trusted PATH ($PATH)" >&2
        echo "       install GNU coreutils system-wide (a user-writable b2sum would defeat the gate)" >&2
        exit 1
      } ;;
  esac

  [ -f "$file" ] || { echo "not a regular file: $file" >&2; exit 1; }

  # NUL bytes cannot survive a shell variable, so the consumer wrapper could
  # never execute the file's literal bytes. Refuse rather than hash something
  # that differs from what any wrapper would run.
  if [ "$(LC_ALL=C tr -d '\000' <"$file" | wc -c)" -ne "$(wc -c <"$file")" ]; then
    echo "refusing: file contains NUL bytes (not shell-executable text)" >&2
    exit 1
  fi

  # THE single read. Everything below is derived from $content, never from a
  # second look at the file. The `; printf x` + `%x` idiom preserves trailing
  # newlines, which plain $(cat) strips -- so $content is the file's bytes
  # EXACTLY, and the digest below equals `shasum -a <algo> <file>`. Matching
  # the ordinary check matters: you can verify this tool with any other tool.
  local content hash nl
  content="$(cat -- "$file"; printf x)" || { echo "cannot read: $file" >&2; exit 1; }
  content="${content%x}"

  printf '%s--- %s (exactly the bytes being hashed) ---%s\n' "$C_B" "$file" "$C_OFF"
  # Both the guard and the highlighter are fed $content, not the file, so the
  # single-read rule holds; the digest below still comes from $content too,
  # never from the coloured stream.
  nl=''
  [ "${content%"$NL"}" != "$content" ] && nl=1
  if printf '%s' "$content" | highlight_json_ok "$nl"; then
    printf '%s' "$content" | highlight_json | page || true
  else
    printf '%s' "$content" | page || true
  fi

  # Digest and the command that recomputes it, kept in lockstep: $hash_cmd is
  # emitted into the wrapper verbatim, so the two sides cannot drift.
  local hash hash_cmd label
  if [ "$algo_name" = blake3 ]; then
    hash_cmd="b3sum --no-names --length $((length / 8))"   # b3sum takes bytes
    if [ "$length" -eq 256 ]; then
      label="blake3"
    else
      label="blake3 (${length}-bit)"   # descriptive; there is no blake3-N name
    fi
  elif [ "$algo_name" = blake2 ]; then
    hash_cmd="b2sum -l $algo"
    label="blake2b-$algo"
  else
    hash_cmd="shasum -a $algo"
    case "$algo" in
      512256) label="sha512/256" ;;   # canonical name; -a takes the digit form
      *)      label="sha${algo}" ;;
    esac
  fi

  hash="$(printf '%s' "$content" | $hash_cmd)" || { echo "hashing failed" >&2; exit 1; }
  hash="${hash%% *}"
  [ -n "$hash" ] || { echo "hashing failed" >&2; exit 1; }

  echo
  printf '%s%s:%s %s%s%s\n' "$C_B" "$label" "$C_OFF" "$C_CYN" "$hash" "$C_OFF"
  echo
  # Emit the consumer snippet, not just the hash: the wrapper must read and
  # hash exactly as this did, or the two sides drift and every launch refuses.
  # It opens by pinning PATH for the same reason this script does -- a hook
  # inherits the session's PATH, which legitimately contains user-writable
  # prefixes (~/.nix-profile, ~/.local/bin, /opt/homebrew/bin), so bare names
  # would otherwise resolve through directories an attacker can write. One
  # pinned PATH, then bare tools, exactly as above.
  printf '%sfail-closed wrapper (paste into the hash-gated settings file):%s\n' "$C_DIM" "$C_OFF"
  cat <<EOF
export PATH=$PATH; c=\$(cat $file; printf x); c=\${c%x}; h=\$(printf '%s' "\$c" | $hash_cmd); [ "\${h%% *}" = "$hash" ] && exec bash -c "\$c" || { echo 'hook hash mismatch -- refusing' >&2; exit 2; }
EOF
  log_action show "$file" "$hash"
}

# The repo half of show: re-display what the pin NAMES, through the same
# hardened path the review ceremony used. Once a repo is pinned, the only
# trusted re-read was for FILE pins (`cat` serves the stored witness); a repo's
# content could only be re-read through ambient git, whose display is
# falsifiable by repo-local diff drivers and textconv filters -- the whole
# reason sgit exists. It RECORDS NOTHING: show rehearses, review records.
#
# Unprivileged is correct here. Content-addressing carries the trust (the rev
# names the bytes, and the pin file it comes from is root-owned), and the
# root-owned installed binary means the display path itself cannot be swapped
# by a user-space attacker. There is nothing to write, so nothing to elevate.
do_show_repo() {
  resolve_repo "$1"
  local hash head_hash tag diff_out ahead
  hash="$(read_rev "$default_slot")" || exit 1
  [ -n "$hash" ] || {
    echo "no pin for $repo; show re-displays a pin (review it first)" >&2
    exit 1
  }
  # Availability up front: a rev the object store no longer holds (rewritten
  # history or gc) has nothing to display, and saying so beats a raw git error
  # arriving mid-header with part of a ceremony already on screen. cat-file -e
  # answers existence only -- the display itself goes through sgit_diff.
  sgit cat-file -e "${hash}^{commit}" 2>/dev/null || {
    echo "ERROR: the pinned rev $hash is missing from this checkout (rewritten history or gc?)" >&2
    echo "       there is nothing to re-display; restore the commit or re-approve" >&2
    exit 1
  }

  printf '%srepo:%s       %s%s%s  %s(%s)%s\n' "$C_DIM" "$C_OFF" "$C_B$C_MAG" "${repo##*/}" "$C_OFF" \
    "$C_DIM" "$repo" "$C_OFF"
  printf '%spinned:%s     %s%s%s  %s(%s)%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$hash" "$C_OFF" \
    "$C_DIM" "$(sgit log -1 --format=%s "$hash")" "$C_OFF"
  if [ -r "$default_slot/tag" ]; then
    IFS= read -r tag <"$default_slot/tag" || tag=""
    [ -z "$tag" ] \
      || printf '%stag:%s        %s  %s(declared)%s\n' "$C_DIM" "$C_OFF" "$tag" "$C_DIM" "$C_OFF"
  fi

  # ORIENTATION ONLY -- where the checkout stands relative to the pin. The
  # display below is of the PIN, never of HEAD, so nothing here selects what
  # gets shown; it just keeps a reader from mistaking one for the other.
  head_hash="$(sgit rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null || true)"
  if [ -z "$head_hash" ]; then
    printf '%sthis checkout has no live HEAD%s\n' "$C_DIM" "$C_OFF"
  elif [ "$head_hash" = "$hash" ]; then
    printf '%slive HEAD is at the pin%s\n' "$C_DIM" "$C_OFF"
  elif sgit merge-base --is-ancestor "$hash" HEAD 2>/dev/null; then
    ahead="$(sgit rev-list --count "${hash}..HEAD")"
    printf '%slive HEAD is %s commit%s past the pin%s\n' "$C_DIM" \
      "$ahead" "$(plural_s "$ahead")" "$C_OFF"
  else
    printf '%slive HEAD does not descend from the pin%s\n' "$C_DIM" "$C_OFF"
  fi
  # No dirty-tree note: review carries one because it pins HEAD's commit while
  # the reviewer looks at a work tree that may hold more. This display comes
  # from the object store at a rev that is already fixed, so uncommitted
  # changes cannot alter a byte of it and saying otherwise would be noise.

  echo
  printf '%s--- full tree at %.10s (from object store) ---%s\n' "$C_B" "$hash" "$C_OFF"
  # 4b825d... is git's well-known empty tree: the diff from it is every byte
  # the pin names, exactly what a first approval displays. Capture first so a
  # git failure aborts (set -e) BEFORE anything is shown as reviewable; then
  # page. Early pager quit (SIGPIPE) is the reader's own act.
  diff_out="$(sgit_diff 4b825dc642cb6eb9a060e54bf8d69288fbee4904 "$hash")"
  printf '%s\n' "$diff_out" | page || true

  # Syslog is audit history, not a record: the file half logs the same way,
  # and neither writes a slot.
  log_action show "$repo" "$hash"
}

# ---- slot ------------------------------------------------------------------

do_slot() {
  # Print the slot directory for ANY path -- repo, file, present or not.
  # This is the one place slot names are spelled: consumers (lane
  # launchers deciding what goes in the payload, root-owned symlinks)
  # must never reimplement the encoding, so the resolver has to answer
  # for the same paths verify does, including ones that do not exist yet.
  #
  #   sudo ln -s "$(pinned slot <repo>)" /etc/nix-darwin/pinned-rev
  #   d="$(pinned slot "$f")"; [ -d "$d" ] && tar -C / -c "${d#/}"
  #
  # A NAME RESOLVER, NOT AN EXISTENCE ORACLE: it never says whether the
  # path is pinned (that is verify) or whether the slot dir is there (the
  # caller's own -d). Canonicalization is canon_path's, the same one
  # verify keys its slot with -- one code path, so a repo and a file can
  # never encode differently -- which also inherits its refusal of a `..`
  # tail below a missing directory.
  [ $# -eq 1 ] || { echo "slot takes one path" >&2; usage; }
  local path tier
  # The tier verify would key the slot under, so `sudo pinned slot ...`
  # still answers for the human, not for root.
  tier="$(tier_user)"
  path="$(canon_path "$1")" || exit 1
  slot_dir_for "$tier" "$path"
}

# ---- signer ----------------------------------------------------------------

# Manage allowed_signers through a ceremony instead of hand-run sudo
# installs: fingerprint display, confirm, atomic root-owned write, syslog
# line. Input is EXPLICITLY FLAGGED, never sniffed -- a trust tool does
# not guess whether an operand is a path or key material (--file vs
# --key; public keys are not secret, so --key in argv is fine). A full
# allowed_signers line is taken as-is (it carries its principal); a bare
# public key needs --principal to construct one. THE PRINCIPAL IS THE
# LABEL, and it is load-bearing: ssh-keygen -Y matches it at
# verification, so it cannot drift into decoration.
#
# Storage: user tier = <user>/policy/allowed_signers (who may vouch is
# POLICY, and rides the policy dir a lane can be handed without the slot
# list); --repo writes the per-slot override at slots/<enc>/signers/,
# which stays with the slot because slot contents are one disclosure
# class. `signer add --repo` may create a slot dir holding only signers/ -- a legitimate
# pre-approve bootstrap, since review --signed-tag verifies AGAINST the
# signers; verify still answers "no slot" for such a dir. remove is
# first-class: key compromise response must not be the hand-edited path.
#
# Format is OpenSSH's SSHSIG allowed_signers, deliberately: the
# signature layer is git SSH signing end to end, stock ssh-keygen -Y
# verification, nothing pinned-specific anywhere. (# comment lines DO
# survive OpenSSH's parser -- measured 2026-07-29 with ssh-keygen -Y
# verify -- but this tool writes none.)

is_keytype() {
  case "$1" in
    ssh-ed25519|ssh-rsa|ssh-dss|rsa-sha2-256|rsa-sha2-512|ecdsa-sha2-*|sk-ssh-ed25519@openssh.com|sk-ecdsa-sha2-*) return 0 ;;
  esac
  return 1
}

key_fingerprint() {
  # $1 = keytype, $2 = base64 blob. Echoes ssh-keygen's fingerprint line.
  printf '%s %s\n' "$1" "$2" | ssh-keygen -lf /dev/stdin
}

do_signer() {
  [ $# -ge 1 ] || usage
  local sub="$1"; shift
  case "$sub" in add|remove|list) ;; *) usage ;; esac
  command -v ssh-keygen >/dev/null 2>&1 \
    || { echo "ERROR: no ssh-keygen in the trusted PATH ($PATH)" >&2; exit 1; }

  local repo_arg="" keyfile="" keyline="" principal=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)
        [ $# -ge 2 ] || { echo "--repo needs a path" >&2; exit 1; }
        repo_arg="$2"; shift 2 ;;
      --file)
        [ $# -ge 2 ] || { echo "--file needs a path" >&2; exit 1; }
        keyfile="$2"; shift 2 ;;
      --key)
        [ $# -ge 2 ] || { echo "--key needs a line" >&2; exit 1; }
        keyline="$2"; shift 2 ;;
      --principal)
        [ $# -ge 2 ] || { echo "--principal needs an identity" >&2; exit 1; }
        principal="$2"; shift 2 ;;
      *) echo "unknown signer option: $1" >&2; usage ;;
    esac
  done

  # Resolve the target file. resolve_repo keys the slot to the ceremony
  # tier (SUDO_USER when elevated), same as review.
  local tier target
  tier="$(tier_user)"
  if [ -n "$repo_arg" ]; then
    resolve_repo "$repo_arg"
    target="$default_slot/signers/allowed_signers"
  else
    target="$(policy_dir_for "$tier")/allowed_signers"
  fi

  if [ "$sub" = "list" ]; then
    [ -z "$keyfile$keyline$principal" ] || { echo "signer list takes only --repo" >&2; exit 1; }
    do_signer_list "$target"
    return
  fi
  require_root signer

  if [ -n "$keyfile" ] && [ -n "$keyline" ]; then
    echo "--file and --key are exclusive" >&2
    exit 1
  fi
  [ -n "$keyfile" ] || [ -n "$keyline" ] \
    || { echo "signer $sub needs --file <pubkey> or --key '<line>'" >&2; exit 1; }
  local line
  if [ -n "$keyfile" ]; then
    [ -f "$keyfile" ] || { echo "not a readable file: $keyfile" >&2; exit 1; }
    IFS= read -r line <"$keyfile" || line=""
  else
    line="$keyline"
  fi
  case "$line" in
    ''|'#'*)
      echo "ERROR: no key material in the input" >&2; exit 1 ;;
    *"$NL"*)
      echo "ERROR: one key per invocation (the input has multiple lines)" >&2; exit 1 ;;
  esac

  # Classify: bare public key vs full allowed_signers line.
  local first keytype keyblob entry
  first="${line%% *}"
  if is_keytype "$first"; then
    keytype="$first"
    entry="${line#* }"; keyblob="${entry%% *}"
    if [ "$sub" = "add" ]; then
      [ -n "$principal" ] || {
        echo "ERROR: a bare public key needs --principal <identity>" >&2
        echo "       (the principal is the label ssh-keygen -Y matches at verification)" >&2
        exit 1
      }
      case "$principal" in
        *[!A-Za-z0-9@._+-]*|'')
          echo "ERROR: principal must be non-empty [A-Za-z0-9@._+-]" >&2; exit 1 ;;
      esac
      entry="$principal $keytype $keyblob"
    else
      entry=""   # remove matches by key blob; no line to construct
    fi
  else
    [ -z "$principal" ] \
      || { echo "ERROR: --principal only applies to a bare public key (this line already carries one)" >&2; exit 1; }
    entry="$line"
    # Find the key material past the principal (and any options field).
    local words w i=0 ki=-1
    read -r -a words <<EOF
$line
EOF
    for w in "${words[@]}"; do
      if is_keytype "$w"; then ki="$i"; break; fi
      i=$((i + 1))
    done
    [ "$ki" -ge 1 ] || { echo "ERROR: no recognized key type in the line" >&2; exit 1; }
    keytype="${words[$ki]}"
    keyblob="${words[$((ki + 1))]:-}"
    [ -n "$keyblob" ] || { echo "ERROR: key type with no key material" >&2; exit 1; }
  fi

  local fp
  fp="$(key_fingerprint "$keytype" "$keyblob")" \
    || { echo "ERROR: ssh-keygen cannot parse this key" >&2; exit 1; }

  local answer tmp tdir
  tdir="$(dirname "$target")"
  if [ "$sub" = "add" ]; then
    ensure_tree "$inv"
    if [ -n "$repo_arg" ]; then
      install -d -m "$TREE_DMODE" -o root -g "$TREE_GRP" "$default_slot" "$tdir"
    fi
    if [ -f "$target" ] && grep -qF "$keyblob" "$target"; then
      printf '%salready present%s (same key material): %s\n' "$C_GRN" "$C_OFF" "$target"
      exit 0
    fi
    printf '%starget:%s      %s\n' "$C_B" "$C_OFF" "$target"
    printf '%sentry:%s       %s\n' "$C_B" "$C_OFF" "$entry"
    printf '%sfingerprint:%s %s\n' "$C_B" "$C_OFF" "$fp"
    printf '%s(obtain the key out of band -- printed card, password manager, existing\ntrusted machine -- never from the repo it will vouch for.)%s\n' "$C_DIM" "$C_OFF"
    printf '%strust this key to vouch? [y/N]%s ' "$C_B" "$C_OFF"
    read -r answer </dev/tty
    case "$answer" in
      y|Y|yes) ;;
      *) echo "aborted; signers unchanged"; log_action signer-add "$target" "" abort; exit 2 ;;
    esac
    tmp="$(mktemp "$tdir/.stage.XXXXXX")"
    { [ -f "$target" ] && cat "$target"; printf '%s\n' "$entry"; } >"$tmp"
    chown "root:$TREE_GRP" "$tmp"
    chmod "$TREE_FMODE" "$tmp"
    mv -f "$tmp" "$target"
    printf '%s✓ added:%s %s\n' "$C_GRN$C_B" "$C_OFF" "$fp"
    log_action signer-add "$target" "${fp##*SHA256:}"
  else
    [ -f "$target" ] || { echo "no signers file: $target" >&2; exit 1; }
    if ! grep -qF "$keyblob" "$target"; then
      echo "key not present in $target" >&2
      exit 1
    fi
    ensure_tree "$inv"
    printf '%starget:%s      %s\n' "$C_B" "$C_OFF" "$target"
    printf '%sremoving:%s\n' "$C_B" "$C_OFF"
    grep -F "$keyblob" "$target" | sed 's/^/  /'
    printf '%sfingerprint:%s %s\n' "$C_B" "$C_OFF" "$fp"
    printf "%sremove this key's entries? [y/N]%s " "$C_B" "$C_OFF"
    read -r answer </dev/tty
    case "$answer" in
      y|Y|yes) ;;
      *) echo "aborted; signers unchanged"; log_action signer-remove "$target" "" abort; exit 2 ;;
    esac
    tmp="$(mktemp "$tdir/.stage.XXXXXX")"
    grep -vF "$keyblob" "$target" >"$tmp" || true   # empty result is fine: verifies nothing, fail closed
    chown "root:$TREE_GRP" "$tmp"
    chmod "$TREE_FMODE" "$tmp"
    mv -f "$tmp" "$target"
    printf '%s✓ removed:%s %s\n' "$C_GRN$C_B" "$C_OFF" "$fp"
    log_action signer-remove "$target" "${fp##*SHA256:}"
  fi
}

do_signer_list() {
  # Principals, key types, fingerprints. Unprivileged (group-read).
  local f="$1" line words ki i w found=0
  [ -f "$f" ] || { echo "(no signers file: $f)"; return; }
  while IFS= read -r line; do
    case "$line" in ''|'#'*) continue ;; esac
    read -r -a words <<EOF
$line
EOF
    ki=-1; i=0
    for w in "${words[@]}"; do
      if is_keytype "$w"; then ki="$i"; break; fi
      i=$((i + 1))
    done
    if [ "$ki" -lt 1 ] || [ -z "${words[$((ki + 1))]:-}" ]; then
      printf '%sUNPARSEABLE%s  %s\n' "$C_RED$C_B" "$C_OFF" "$line"
      found=1
      continue
    fi
    printf '%s%s%s  %s  %s\n' "$C_CYN" "${words[0]}" "$C_OFF" "${words[$ki]}" \
      "$(key_fingerprint "${words[$ki]}" "${words[$((ki + 1))]}" 2>/dev/null || echo 'fingerprint failed')"
    found=1
  done <"$f"
  [ "$found" -eq 1 ] || echo "(no signers)"
}

# ---- ignorable -------------------------------------------------------------

# The user tier of the ignorable policy, managed by the same kind of
# ceremony the signers get: display, confirm, atomic root-owned write,
# syslog line. Nothing here decides that a key IS ignored -- that stays the
# review ceremony's per-path declaration. This decides only what such a
# declaration is ALLOWED to say, which is why it is a separate root act:
# granting "model may drift under my settings dir" once is a decision worth
# making deliberately; re-confirming it at every settings edit is not.
#
# --under is the whole point of the scoping: a grant that reads "model,
# everywhere" would tolerate a `model` key in ANY pinned file on the
# machine, including one where it means something else entirely. The
# prefix matches at a component boundary, the same rule `list --under`
# uses, so /a/b covers /a/b/c and never /a/bb.
do_ignorable() {
  [ $# -ge 1 ] || usage
  local sub="$1"; shift
  case "$sub" in add|remove|list) ;; *) usage ;; esac

  local key="" under=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --under)
        [ $# -ge 2 ] || { echo "--under needs a directory" >&2; exit 1; }
        under="$2"; shift 2 ;;
      -*) echo "unknown ignorable option: $1" >&2; usage ;;
      *)  [ -z "$key" ] || { echo "ignorable $sub takes one key" >&2; usage; }
          key="$1"; shift ;;
    esac
  done
  require_jq "the ignorable policy" || exit 1

  local tier
  tier="$(tier_user)"
  if [ "$sub" = list ]; then
    [ -z "$key$under" ] \
      || { echo "ignorable list takes no arguments (it shows every entry of both tiers)" >&2; exit 1; }
    do_ignorable_list "$tier"
    return
  fi

  require_root ignorable
  [ -n "$key" ] || { echo "ignorable $sub needs a key, e.g. model or statusLine.command" >&2; exit 1; }
  validate_ignore_key "$key" || {
    echo "ERROR: key '$key' is outside the key grammar: dotted [A-Za-z0-9_.-]," >&2
    echo "       no leading/trailing/doubled dot, no array subscripts" >&2
    exit 1
  }
  # Scope normalization, exactly as `list --under` does it: absolute,
  # symlinks resolved when the directory exists, no trailing slash. The
  # stored prefix has to be the spelling a canonicalized subject path
  # carries, or the grant would quietly never match anything.
  if [ -n "$under" ]; then
    case "$under" in
      /*) ;;
      *)  echo "ERROR: --under needs an absolute directory (a grant is not relative to a cwd)" >&2
          exit 1 ;;
    esac
    [ -d "$under" ] && under="$(readlink -f "$under")"
    while [ "${under%/}" != "$under" ]; do under="${under%/}"; done
    [ -n "$under" ] || under=/
    case "$under" in
      *//*) echo "ERROR: --under must not contain an empty path component" >&2; exit 1 ;;
    esac
  fi

  ensure_tree "$inv"
  local pf
  pf="$(policy_dir_for "$inv")/ignorable.json"
  load_policy "$inv" || exit 1

  local path_json dup scope_disp new_json answer covered=1
  path_json="$(ign_key_path_json "$key")"
  dup="$(jq -n --argjson e "$POL_USER" --argjson p "$path_json" --arg u "$under" \
    '[ $e[] | select(.path == $p and ((.under // "") == $u)) ] | length')"
  if [ -n "$under" ]; then scope_disp="under $under"; else scope_disp="everywhere"; fi

  if [ "$sub" = add ]; then
    [ "$dup" -eq 0 ] || {
      echo "REFUSE: already granted, $scope_disp: $key" >&2
      echo "        (a second identical entry would say nothing new; see: pinned ignorable list)" >&2
      exit 1
    }
    new_json="$(jq -n --argjson e "$POL_USER" --argjson p "$path_json" --arg u "$under" \
      '$e + [ if $u == "" then {path: $p} else {path: $p, under: $u} end ]')" || exit 1
    if [ -n "$POL_MACHINE" ]; then
      covered="$(jq -n --argjson m "$POL_MACHINE" --argjson p "$path_json" --arg u "$under" \
        "$POLICY_JQ"'[ $m[]
                       | select(.path == $p
                                and covers_scope(.under; (if $u == "" then null else $u end))) ]
                     | length')" || exit 1
    fi
  else
    [ "$dup" -gt 0 ] || {
      echo "REFUSE: no such grant to withdraw: $key, $scope_disp" >&2
      echo "        remove takes the exact entry -- same key and same scope; the entries are" >&2
      echo "        listed by: pinned ignorable list" >&2
      exit 1
    }
    new_json="$(jq -n --argjson e "$POL_USER" --argjson p "$path_json" --arg u "$under" \
      '[ $e[] | select((.path == $p and ((.under // "") == $u)) | not) ]')" || exit 1
  fi

  printf '%starget:%s      %s\n' "$C_B" "$C_OFF" "$pf"
  printf '%skey:%s         %s%s%s  %s(stored as %s)%s\n' \
    "$C_B" "$C_OFF" "$C_CYN" "$key" "$C_OFF" "$C_DIM" "$path_json" "$C_OFF"
  printf '%sscope:%s       %s%s%s\n' "$C_B" "$C_OFF" "$C_CYN" "$scope_disp" "$C_OFF"
  if [ "$sub" = add ]; then
    printf '            %sreview --file may then declare this key ignored for paths in%s\n' "$C_DIM" "$C_OFF"
    printf '            %sscope; verify answers 5 instead of 11 when only it drifts%s\n' "$C_DIM" "$C_OFF"
    if [ "$covered" -eq 0 ]; then
      printf '%snote:%s        %sthe machine policy (%s) does not cover this scope --\n' \
        "$C_B" "$C_OFF" "$C_YEL" "$PINNED_MACHINE_POLICY"
      printf '            the entry will be recorded but will not be effective%s\n' "$C_OFF"
    fi
  else
    printf '            %sany slot that records this key falls back to a byte-exact%s\n' "$C_DIM" "$C_OFF"
    printf '            %sverdict (11) at the very next verify -- no re-ceremony needed%s\n' "$C_DIM" "$C_OFF"
  fi
  if [ "$sub" = add ]; then
    printf '%sgrant this key? [y/N]%s ' "$C_B" "$C_OFF"
  else
    printf '%swithdraw this grant? [y/N]%s ' "$C_B" "$C_OFF"
  fi
  read -r answer </dev/tty
  case "$answer" in
    y|Y|yes) ;;
    *) echo "aborted; policy unchanged"; log_action "ignorable-$sub" "$key" "" abort; exit 2 ;;
  esac
  write_note "$(policy_dir_for "$inv")" ignorable.json "$new_json"
  if [ "$sub" = add ]; then
    printf '%s✓ granted:%s %s%s%s %s -> %s\n' "$C_GRN$C_B" "$C_OFF" "$C_CYN" "$key" "$C_OFF" "$scope_disp" "$pf"
  else
    printf '%s✓ withdrawn:%s %s%s%s %s -> %s\n' "$C_GRN$C_B" "$C_OFF" "$C_CYN" "$key" "$C_OFF" "$scope_disp" "$pf"
  fi
  log_action "ignorable-$sub" "$key" "${under:-everywhere}"
}

# One entry per line: dotted key, then the scope it is granted in.
policy_print_entries() { # $1 = a policy array
  local k sc
  if [ "$(printf '%s' "$1" | jq 'length')" -eq 0 ]; then
    printf '  %s(no entries)%s\n' "$C_DIM" "$C_OFF"
    return
  fi
  while IFS="$TAB" read -r k sc; do
    [ -n "$k" ] || continue
    case "$sc" in
      '*') printf '  %s%-24s%s everywhere\n' "$C_CYN" "$k" "$C_OFF" ;;
      *)   printf '  %s%-24s%s under %s\n' "$C_CYN" "$k" "$C_OFF" "$sc" ;;
    esac
  done <<EOF
$(printf '%s' "$1" | jq -r '.[] | (.path | join(".")) + "\t" + (.under // "*")')
EOF
}

# Both tiers AND the intersection, in one unprivileged command: "why was
# this key dropped" has to be answerable without reading two files by hand
# and doing the prefix arithmetic in your head.
do_ignorable_list() {
  local u="$1" pf mach_present=0 user_present=0
  pf="$(policy_dir_for "$u")/ignorable.json"
  [ -e "$PINNED_MACHINE_POLICY" ] && mach_present=1
  [ -e "$pf" ] && user_present=1
  load_policy "$u" || exit 1

  printf '%smachine tier:%s %s\n' "$C_B" "$C_OFF" "$PINNED_MACHINE_POLICY"
  if [ "$mach_present" -eq 0 ]; then
    printf '  %s(absent -- no machine constraint; the user tier stands alone)%s\n' "$C_DIM" "$C_OFF"
  else
    policy_print_entries "$POL_MACHINE"
  fi
  echo
  printf '%suser tier:%s    %s\n' "$C_B" "$C_OFF" "$pf"
  if [ "$user_present" -eq 0 ]; then
    printf '  %s(absent -- nothing is ignorable; every --ignore-json-key is refused)%s\n' "$C_DIM" "$C_OFF"
  else
    policy_print_entries "$POL_USER"
  fi
  echo
  printf '%seffective%s %s(machine intersect user -- what review and verify check)%s\n' \
    "$C_B" "$C_OFF" "$C_DIM" "$C_OFF"
  policy_print_entries "$POL_EFF"
}

# ---- deploy ----------------------------------------------------------------
# The acting consumer, merged into this binary (user decision 2026-07-28):
# one file to hand-read at bootstrap, and the sudoers digest attests the
# deployer too. The pin-stating paths never execute what they approve;
# deploy acts only by composing and SHOWING the commands that run as root,
# then running them under ordinary sudo -- it never self-elevates.
#
# Scans the system flake for git+file:// inputs, looks each repo up in the
# pin files, syncs every stale rev= to its APPROVED hash in one perl
# invocation, and rebuilds. The flake matching the pins says nothing about
# what the SYSTEM runs (a prior rebuild may have failed after the rev
# swap), so the rebuild runs even when every input is already in sync.
# Inputs with no pin slot deploy as hand-edited and are surfaced loudly,
# not blocked; non-local inputs (github:...) are not pinned's to speak for.
do_deploy() {
  local DRY=0 YES=0 FLAKE_ARG="" stale_repos upd_cmd p
  stale_repos=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) DRY=1; shift ;;
      --yes) YES=1; shift ;;
      --flake)
        [ $# -ge 2 ] || { echo "--flake needs a path" >&2; exit 1; }
        FLAKE_ARG="$2"; shift 2 ;;
      *) echo "unknown deploy option: $1" >&2; usage ;;
    esac
  done

  # Per-OS flake root and rebuild command. The rebuild tool is named by
  # ABSOLUTE path: it lives only in the system profile, which the trusted
  # PATH of a manual (non-nix) install deliberately lacks -- and sudo
  # inherits our PATH, so a bare name would die with "command not found"
  # exactly when run from a bootstrap checkout (live-fired 2026-07-28).
  # The absolute path also makes the displayed sudo command unambiguous.
  local DEFAULT_FLAKE REBUILD FLAKE
  DEFAULT_FLAKE="$(default_flake_file)"
  if [ "$(uname -s)" = Darwin ]; then
    REBUILD="/run/current-system/sw/bin/darwin-rebuild"
  else
    REBUILD="/run/current-system/sw/bin/nixos-rebuild"
  fi
  [ -x "$REBUILD" ] || {
    printf '%serror: %s not found -- is this a nix-darwin/NixOS system?%s\n' \
      "$C_RED" "$REBUILD" "$C_OFF" >&2
    exit 1
  }
  # --flake is the ONLY override: an env knob would not survive sudo's
  # env_reset, so upgrade's pre-sudo plan and its root-side ceremonies
  # could silently read DIFFERENT flakes. Argv crosses the boundary.
  FLAKE="${FLAKE_ARG:-$DEFAULT_FLAKE}"
  [ -r "$FLAKE" ] || {
    printf '%serror: cannot read %s -- pass --flake%s\n' "$C_RED" "$FLAKE" "$C_OFF" >&2
    exit 1
  }

  # Collect git+file inputs: repo path + current rev= + current ref=,
  # one per line. An input without rev= is skipped (nothing to sync; nix
  # floats the branch).
  local inputs
  inputs="$(grep -oE 'git\+file:///[^"]+' "$FLAKE" | while IFS= read -r url; do
    p="${url#git+file://}"; p="${p%%\?*}"
    r="$(printf '%s' "$url" | grep -oE '[?&]rev=[0-9a-f]{40,128}' | head -n1 | cut -d= -f2 || true)"
    ref="$(printf '%s' "$url" | grep -oE '[?&]ref=[^&]*' | head -n1 | cut -d= -f2- || true)"
    [ -n "$r" ] && printf '%s|%s|%s\n' "$p" "$r" "$ref"
  done || true)"
  [ -n "$inputs" ] || {
    printf '%serror: no git+file inputs with rev= in %s -- nothing deploy manages%s\n' \
      "$C_RED" "$FLAKE" "$C_OFF" >&2
    exit 1
  }

  # Longest repo basename, for column alignment.
  local width=0 path name flake_rev
  while IFS='|' read -r path _; do
    name="${path##*/}"
    [ "${#name}" -gt "$width" ] && width="${#name}"
  done <<EOF
$inputs
EOF

  # The shared in-place editor (set_sed_i); each stale input contributes one
  # -e expression to a single invocation.
  local SED_I=()
  set_sed_i

  local sed_exprs=() updates=0 unpinned=0 slot approved ahead
  local decl_tag want_ref ref_stale live_tag tag_detail esc
  printf '%sgit+file inputs%s %s(%s)%s\n' "$C_B" "$C_OFF" "$C_DIM" "$FLAKE" "$C_OFF"
  while IFS='|' read -r path flake_rev flake_ref; do
    name="${path##*/}"
    # tier_user, not id -un: under `pinned upgrade` this scan runs in the
    # self-elevated ROOT process, where id -un names a tier that does not
    # exist (/var/db/pinned/root) -- every input then read "no pin slot"
    # and deploy synced nothing (live-fired 2026-08-03, first root-context
    # deploy). Standalone unprivileged deploy never hit it.
    slot="$(slot_dir_for "$(tier_user)" "$path")"
    # read_rev refuses tombstoned/malformed/unknown-VCS slots -- a
    # deploy through a retired or undeclared record must not proceed.
    approved="$(read_rev "$slot")" || exit 1
    if [ -z "$approved" ]; then
      unpinned=$((unpinned + 1))
      printf '  %-*s  %snix flake %s%s   %s! no pin slot -- deploys as hand-edited%s\n' \
        "$width" "$name" "$C_CYN" "${flake_rev:0:10}" "$C_OFF" "$C_YEL" "$C_OFF"
      continue
    fi
    # Declared release name: sync ref= only after cross-checking that
    # the LIVE tag still names the approved rev -- a moved or deleted
    # tag is a clean fail-closed refusal here, never a nix fetch error.
    # No declaration -> rev-only sync; rev-only slots are a supported
    # shape, not degraded (the rev is the anchor, the name is context).
    decl_tag="" want_ref="" ref_stale=0
    if [ -f "$slot/tag" ]; then
      verify_record_file "$slot/tag" || exit 1
      IFS= read -r decl_tag <"$slot/tag" || decl_tag=""
      validate_tag_name "$decl_tag" || {
        printf '%serror: %s declares an invalid tag name; refusing%s\n' \
          "$C_RED$C_B" "$slot/tag" "$C_OFF" >&2
        exit 1
      }
      live_tag="$(git -C "$path" rev-parse -q --verify "refs/tags/${decl_tag}^{commit}" 2>/dev/null || true)"
      if [ "$live_tag" != "$approved" ]; then
        if [ -z "$live_tag" ]; then tag_detail="is missing from the checkout"; else tag_detail="names ${live_tag:0:10}, not the approved ${approved:0:10}"; fi
        printf '%serror: slot for %s declares tag %s, but the live tag %s -- refusing (moved or deleted tags do not deploy)%s\n' \
          "$C_RED$C_B" "$name" "$decl_tag" "$tag_detail" "$C_OFF" >&2
        exit 1
      fi
      want_ref="refs/tags/$decl_tag"
      [ -n "$flake_ref" ] && [ "$flake_ref" != "$want_ref" ] && ref_stale=1
    fi
    if [ "$flake_rev" = "$approved" ] && [ "$ref_stale" -eq 0 ]; then
      printf '  %-*s  %spinned %s%s = %snix flake%s   %s✓ in sync%s\n' \
        "$width" "$name" "$C_CYN" "${approved:0:10}" "$C_OFF" "$C_DIM" "$C_OFF" "$C_GRN" "$C_OFF"
    else
      updates=$((updates + 1))
      if [ "$flake_rev" != "$approved" ]; then
        sed_exprs+=(-e "s/rev=${flake_rev}/rev=${approved}/g")
      fi
      printf '  %-*s  %spinned %s%s %s!=%s %snix flake %s%s   %s-> update%s\n' \
        "$width" "$name" "$C_CYN" "${approved:0:10}" "$C_OFF" "$C_YEL" "$C_OFF" \
        "$C_CYN" "${flake_rev:0:10}" "$C_OFF" "$C_YEL$C_B" "$C_OFF"
      if [ "$ref_stale" -eq 1 ]; then
        # Scoped to this input by its literal path (regex-escaped); the
        # rev expressions can stay global because revs are unique hex.
        esc="$(printf '%s' "$path" | sed 's/[][\.*^$|]/\\&/g')"
        sed_exprs+=(-e "s|\\(git+file://${esc}?[^\"]*\\)ref=[^&\"]*|\\1ref=${want_ref}|")
        printf '  %-*s  %sref %s -> %s%s\n' \
          "$width" '' "$C_YEL" "$flake_ref" "$want_ref" "$C_OFF"
      fi
    fi
    if [ -n "$decl_tag" ]; then
      if [ -z "$flake_ref" ]; then
        printf '  %-*s  %sdeclares tag %s, but the input has no ref= -- rev-only sync%s\n' \
          "$width" '' "$C_YEL" "$decl_tag" "$C_OFF"
      elif [ "$ref_stale" -eq 0 ]; then
        printf '  %-*s  %stag %s (live tag verified at the approved rev)%s\n' \
          "$width" '' "$C_DIM" "$decl_tag" "$C_OFF"
      fi
    fi
    # Context only -- approvals gate the build, the checkout gates nothing.
    # Direct git (not sgit: that is bound to one resolved repo), rendering
    # nothing; the dirty checks still carry the driver-proof flags, and
    # safe.directory keeps the answers honest when upgrade runs this as
    # root on user-owned checkouts.
    if [ -d "$path" ] && git -C "$path" -c safe.directory="$path" rev-parse --git-dir >/dev/null 2>&1; then
      # Availability probe: a pin the checkout no longer holds (rewritten
      # history, gc) surfaces here as a warning, not as a nix fetch error
      # mid-rebuild. A warning and not a refusal: nix may still hold the
      # input in its store cache, in which case the rebuild succeeds
      # without touching the repo.
      if ! git -C "$path" -c safe.directory="$path" cat-file -e "${approved}^{commit}" 2>/dev/null; then
        printf '  %-*s  %s! pinned rev is missing from the checkout -- a rebuild that needs to re-fetch it will fail; restore the commit or re-approve%s\n' \
          "$width" '' "$C_YEL" "$C_OFF"
      fi
      ahead="$(git -C "$path" -c safe.directory="$path" rev-list --count "${approved}..HEAD" 2>/dev/null || echo '?')"
      if [ "$ahead" != 0 ]; then
        printf '  %-*s  %sgit HEAD is %s commit%s past the pin (unapproved)%s\n' \
          "$width" '' "$C_DIM" "$ahead" "$(plural_s "$ahead")" "$C_OFF"
        stale_repos+=("$path")
      fi
      if ! git -C "$path" -c safe.directory="$path" diff --no-ext-diff --no-textconv --quiet 2>/dev/null \
        || ! git -C "$path" -c safe.directory="$path" diff --no-ext-diff --no-textconv --cached --quiet 2>/dev/null; then
        printf '  %-*s  %swork tree is dirty (uncommitted changes never deploy)%s\n' \
          "$width" '' "$C_DIM" "$C_OFF"
      fi
    fi
  done <<EOF
$inputs
EOF
  printf '\n'

  # The update path: upgrade chains the batch of review ceremonies and
  # this deploy behind one authentication; the selective form stays
  # pasteable. Approval remains its own ceremony -- deploy only points.
  if [ "${#stale_repos[@]}" -gt 0 ]; then
    upd_cmd="pinned review"
    for p in "${stale_repos[@]}"; do upd_cmd="$upd_cmd $p"; done
    printf '%sTo update (each repo still reviewed):%s\n' "$C_B" "$C_OFF"
    printf '  pinned upgrade\n'
    printf '  %s(selective: %s, then rerun deploy)%s\n\n' "$C_DIM" "$upd_cmd" "$C_OFF"
  fi

  if [ "$updates" -eq 0 ]; then
    if [ "$unpinned" -gt 0 ]; then
      printf '%sPinned inputs all at their approved revs%s %s(%s without a pin slot)%s\n' \
        "$C_GRN" "$C_OFF" "$C_YEL" "$unpinned" "$C_OFF"
    else
      printf '%sAll inputs at their approved revs%s\n' "$C_GRN" "$C_OFF"
    fi
    # Rebuild unconditionally, and say why: the flake being in sync says
    # NOTHING about what the running system was built from (live-fired
    # 2026-07-28: an in-sync early exit left a stale system in place).
    printf '%sRebuilding anyway -- the flake says nothing about what the running system\nwas built from; if it is already current, this is a fast no-op.%s\n\n' \
      "$C_DIM" "$C_OFF"
  fi

  # Display structurally: what is shown is the exact shell spelling of the
  # argv that runs (expressions hold no quotes -- hex revs, fixed template
  # -- so single-quoting them is their pasteable form). Parts are colored
  # by role so the command reads at a glance: sudo bold, command name
  # cyan, expressions plain, file paths cyan (identifiers and paths are
  # cyan everywhere; yellow stays reserved for attention text).
  local PIN_CMD=() REBUILD_CMD=() expr_disp="" e
  REBUILD_CMD=("$REBUILD" switch --flake "$(dirname "$FLAKE")")
  printf '%sWill run as root:%s\n' "$C_B" "$C_OFF"
  if [ "$updates" -gt 0 ]; then
    PIN_CMD=("${SED_I[@]}" "${sed_exprs[@]}" "$FLAKE")
    for e in "${sed_exprs[@]}"; do
      if [ "$e" = "-e" ]; then expr_disp="${expr_disp}-e "; else expr_disp="${expr_disp}'${e}' "; fi
    done
    if [ "${#SED_I[@]}" -eq 3 ]; then
      printf "  %ssudo%s %ssed%s -i '' %s%s%s%s\n" \
        "$C_B" "$C_OFF" "$C_CYN" "$C_OFF" "$expr_disp" "$C_CYN" "$FLAKE" "$C_OFF"
    else
      printf '  %ssudo%s %ssed%s -i %s%s%s%s\n' \
        "$C_B" "$C_OFF" "$C_CYN" "$C_OFF" "$expr_disp" "$C_CYN" "$FLAKE" "$C_OFF"
    fi
  fi
  printf '  %ssudo%s %s%s%s switch --flake %s%s%s\n' \
    "$C_B" "$C_OFF" "$C_CYN" "$REBUILD" "$C_OFF" "$C_CYN" "$(dirname "$FLAKE")" "$C_OFF"
  printf '\n'

  if [ "$DRY" -eq 1 ]; then
    printf '%sDry run -- nothing executed%s\n' "$C_YEL" "$C_OFF"
    exit 0
  fi

  if [ "$YES" -eq 0 ]; then
    if [ ! -t 0 ]; then
      printf '%serror: no tty for confirmation -- pass --yes to proceed non-interactively%s\n' \
        "$C_RED" "$C_OFF" >&2
      exit 2
    fi
    printf '%sproceed? [y/N]%s ' "$C_B" "$C_OFF"
    IFS= read -r answer
    case "$answer" in
      y|Y|yes|YES) ;;
      *) printf '%saborted%s\n' "$C_YEL" "$C_OFF"; exit 2 ;;
    esac
  fi

  if [ "$updates" -gt 0 ]; then
    sudo "${PIN_CMD[@]}"
    printf '%s✓ flake revs updated (%s input%s)%s\n' "$C_GRN" "$updates" "$(plural_s "$updates")" "$C_OFF"
  fi
  sudo "${REBUILD_CMD[@]}"
  printf '%s✓ rebuild complete%s\n' "$C_GRN" "$C_OFF"
}

# ---- upgrade ---------------------------------------------------------------

# review + deploy, chained: every git+file input whose checkout moved past
# its pin gets the SAME ceremony `review` runs -- upgrade removes
# typing, never scrutiny -- then deploy syncs the flake to the approved
# revs and rebuilds. The whole verb runs behind ONE self-elevation, so the
# batch of ceremonies and the rebuild cost a single authentication
# (deploy's own sudo calls are no-ops for root). A declined repo is
# skipped, not fatal: deploy simply keeps its old rev. Tag-declared slots
# are never plain-approved (that would clear the declaration and strand
# the input's ref=); they are listed for a manual review --tag instead.
# The ancestry floor is the admission rule: only FORWARD checkouts join a
# ceremony here. Backward and diverged ones are named in the plan with the
# declaration flag that would approve them by hand -- an automatic round
# must never un-approve commits or leave the pinned line of history.
do_upgrade() {
  require_root upgrade
  local args a expect_flake=0 DRY=0 FLAKE_ARG=""
  args=("$@")
  for a in "$@"; do
    if [ "$expect_flake" -eq 1 ]; then FLAKE_ARG="$a"; expect_flake=0; continue; fi
    case "$a" in
      --dry-run) DRY=1 ;;
      --yes) ;;
      --flake) expect_flake=1 ;;
      *) echo "unknown upgrade option: $a" >&2; usage ;;
    esac
  done
  [ "$expect_flake" -eq 0 ] || { echo "--flake needs a path" >&2; exit 1; }
  local FLAKE
  FLAKE="${FLAKE_ARG:-$(default_flake_file)}"
  [ -r "$FLAKE" ] || {
    printf '%serror: cannot read %s -- pass --flake%s\n' "$C_RED" "$FLAKE" "$C_OFF" >&2
    exit 1
  }

  # Authoritative re-derivation: the pre-sudo plan was orientation, this
  # is what the ceremonies actually cover. The route each repo takes is
  # upgrade_route's, the same decision the plan rendered: a signed release
  # offer first, then the tag-declared rule (HEAD carries the next release),
  # then a plain review. The tag and signed routes are their own do_approve
  # call each, because their selectors bind to one repo.
  local scan p tag st tu upg_route upg_info repos tagged_p tagged_t
  local signed_p signed_t sargs t i
  repos=(); tagged_p=(); tagged_t=(); signed_p=(); signed_t=()
  tu="$(tier_user)"
  scan="$(scan_flake_inputs "$FLAKE" "$tu")"
  print_upgrade_plan "$scan" "$tu" "$FLAKE"
  echo
  if [ -n "$scan" ]; then
    while IFS='|' read -r p tag st; do
      # The ancestry floor: only a forward checkout joins a ceremony. Every
      # other state is a row the plan already rendered -- refused, skipped,
      # or simply quiet -- with whatever by-hand remediation it has.
      [ "$st" = forward ] || continue
      upgrade_route "$p" "$tag" "$tu"
      case "$upg_route" in
        signed) signed_p+=("$p"); signed_t+=("$upg_info") ;;
        tagged) tagged_p+=("$p"); tagged_t+=("$upg_info") ;;
        review) repos+=("$p") ;;
        # disagree/notag are by-hand work: named in the plan, never automatic.
      esac
    done <<EOF
$scan
EOF
  fi
  if [ "${#repos[@]}" -gt 0 ] || [ "${#tagged_p[@]}" -gt 0 ] || [ "${#signed_p[@]}" -gt 0 ]; then
    if [ "$DRY" -eq 1 ]; then
      printf '%sDry run: no ceremonies; deploy preview follows%s\n\n' "$C_DIM" "$C_OFF"
    else
      APPROVE_BATCH=1
      if [ "${#repos[@]}" -gt 0 ]; then
        do_approve ${repos[@]+"${repos[@]}"}
      fi
      i=0
      while [ "$i" -lt "${#tagged_p[@]}" ]; do
        do_approve "${tagged_p[$i]}" --tag "${tagged_t[$i]}"
        i=$((i + 1))
      done
      # The offer's acceptance is the signed ceremony's own y/N under the
      # batch contract: declining skips this repo and the rest still run.
      # Every agreeing tag is passed, so the ceremony's all-must-agree rule
      # reads them as the k-of-n agreement they are.
      i=0
      while [ "$i" -lt "${#signed_p[@]}" ]; do
        sargs=()
        while IFS= read -r t; do
          if [ -n "$t" ]; then sargs+=(--signed-tag "$t"); fi
        done <<EOF
${signed_t[$i]}
EOF
        do_approve "${signed_p[$i]}" ${sargs[@]+"${sargs[@]}"}
        i=$((i + 1))
      done
      APPROVE_BATCH=0
      echo
    fi
  fi
  do_deploy ${args[@]+"${args[@]}"}
}

# ---- add -------------------------------------------------------------------

# Part 1 for a url argument: the shared clone tree at $PINNED_CLONES.
# Sets CLONE_DIR. Root supervises; git never runs as root here.
#
# THE URL IS TRANSPORT, NOTHING ELSE. Trust binds AFTER the fetch -- the
# ceremony reviews the tree, or a signature gates it -- so a redirected,
# hostile or simply wrong remote is bounded by the review that follows, not
# by how the bytes arrived. What the fetch must not do is EXECUTE anything:
# GIT_ALLOW_PROTOCOL keeps git to the four transports below, which is what
# shuts out `ext::` (a remote helper is a command line), and the scrubbed
# HOME means no user git config and no credential helper participates.
# Consequences worth knowing: public https/git works, agent-backed ssh works
# when the socket survives sudo, and credentialed https does not -- clone
# that one by hand and `pinned add <path>` the checkout.
add_clone() { # <url> <name>
  CLONE_DIR="$PINNED_CLONES/$2"
  local origin rc=0
  if [ -e "$CLONE_DIR" ]; then
    # An existing destination is REUSED only when its provenance matches:
    # same url, in a real repository. Anything else is unexplained state
    # that a trust tool must not adopt on a hunch.
    [ -d "$CLONE_DIR" ] \
      || { echo "ERROR: $CLONE_DIR exists and is not a directory; refusing" >&2; exit 1; }
    # --show-toplevel, and it must be this very directory: git's repository
    # discovery walks UP, so a plain directory sitting inside some other
    # checkout answers for that checkout instead. Reading a parent's origin
    # here would compare the wrong remote entirely.
    local top=""
    top="$(git -C "$CLONE_DIR" -c safe.directory="$CLONE_DIR" rev-parse --show-toplevel 2>/dev/null || true)"
    if [ -z "$top" ] || [ "$(canon_path "$top")" != "$(canon_path "$CLONE_DIR")" ]; then
      echo "ERROR: $CLONE_DIR exists but is not a git repository of its own; refusing" >&2
      echo "       inspect it, move it aside, or name another input with --input" >&2
      exit 1
    fi
    origin="$(git -C "$CLONE_DIR" -c safe.directory="$CLONE_DIR" config --get remote.origin.url 2>/dev/null || true)"
    if [ "$origin" != "$1" ]; then
      echo "ERROR: $CLONE_DIR holds a clone of another remote; refusing" >&2
      printf '       its origin:    %s\n' "${origin:-(none)}" >&2
      printf '       you asked for: %s\n' "$1" >&2
      exit 1
    fi
    printf '%s✓ clone:%s    %s %s(already here; origin matches, nothing fetched)%s\n' \
      "$C_GRN" "$C_OFF" "$CLONE_DIR" "$C_DIM" "$C_OFF"
    return 0
  fi
  install -d -m 755 -o root -g wheel "$PINNED_CLONES"
  if group_exists "$PINNED_CLONES_GROUP"; then
    # Group-writable, because updating the clone is what operators do, and
    # setgid so that later objects carry the group on Linux too -- BSD
    # directories inherit their parent's group natively, Linux ones only
    # with this bit.
    install -d -m 2775 -o root -g "$PINNED_CLONES_GROUP" "$CLONE_DIR"
  else
    printf '%swarning: group %s does not exist -- %s will be owned by %s alone%s\n' \
      "$C_YEL" "$PINNED_CLONES_GROUP" "$CLONE_DIR" "$inv" "$C_OFF" >&2
    printf '%s         sharing the clone with other operators needs that group; the system\n' "$C_YEL" >&2
    printf '         configuration declares it (nix: security.pinned)%s\n' "$C_OFF" >&2
    install -d -m 755 -o "$inv" "$CLONE_DIR"
  fi
  printf '%scloning:%s    %s\n' "$C_DIM" "$C_OFF" "$1"
  # AS THE INVOKER, never as root: root's job here is the directory, not the
  # network. core.sharedRepository=group lands in the new repo's config at
  # init time, so later fetches by another operator leave readable objects.
  # No --depth: the ancestry lattice and the full-tree review of a first
  # approval both need real history.
  # SSH_AUTH_SOCK survives to here only if your sudoers keeps it; without it
  # an agent-backed remote cannot authenticate, which is the by-hand case.
  sudo -u "$inv" env -i PATH="$PATH" \
    GIT_CONFIG_NOSYSTEM=1 HOME=/var/empty \
    SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-}" \
    GIT_ALLOW_PROTOCOL=file:git:http:https:ssh \
    git clone --config core.sharedRepository=group -- "$1" "$CLONE_DIR" || rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "ERROR: clone failed; nothing was pinned or declared" >&2
    if rmdir "$CLONE_DIR" 2>/dev/null; then
      echo "       removed the empty $CLONE_DIR" >&2
    else
      echo "       $CLONE_DIR holds a partial clone; inspect and remove it by hand" >&2
    fi
    exit 1
  fi
  printf '%s✓ cloned:%s   %s\n' "$C_GRN" "$C_OFF" "$CLONE_DIR"
}

# One verb from "this repo exists somewhere" to "pinned, and declared as an
# input of the system flake", in three idempotent parts -- a checkout, a
# pin, a declaration -- each skipped with a note when it is already
# satisfied, and all three satisfied meaning there is nothing to do.
#
# NOTHING HERE IS A SECOND REVIEW PATH: the pin comes from do_approve, the
# same ceremony `pinned review` runs, and the flake edit reuses deploy's
# in-place editor. add composes; it decides nothing about trust on its own.
#
# add never edits a CONSUMING repo. Wiring the input into a configuration
# (module imports, overlays, an anchor template's mirror) stays a human
# edit, because a tool that wrote into the repos it gates would be
# approving its own changes.
#
# THE PLACEHOLDER DANCE. The block is written with an all-zero rev and only
# then synced to the approved one. A crash between the two leaves a rev that
# can never be fetched, so the next rebuild fails loudly instead of building
# whatever a floating ref happens to point at -- the interruption fails
# closed, and the shape is the one nix-config's anchor template documents.
do_add() {
  require_root add

  local arg="" name="" flake_arg="" tag_args
  tag_args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --input)
        [ $# -ge 2 ] || { echo "--input needs a name" >&2; exit 1; }
        [ -z "$name" ] || { echo "--input may be given once (it names one input)" >&2; exit 1; }
        name="$2"; shift 2 ;;
      # Rides through to the ceremony unchanged, with review's own
      # semantics: repeatable, and every named tag must verify AND name the
      # same commit (threshold multisig).
      --signed-tag)
        [ $# -ge 2 ] || { echo "--signed-tag needs a tag" >&2; exit 1; }
        tag_args+=(--signed-tag "$2"); shift 2 ;;
      --flake)
        [ $# -ge 2 ] || { echo "--flake needs a path" >&2; exit 1; }
        flake_arg="$2"; shift 2 ;;
      -*) usage ;;
      *)
        [ -z "$arg" ] || { echo "add takes one repo or url" >&2; exit 1; }
        arg="$1"; shift ;;
    esac
  done
  [ -n "$arg" ] || usage

  local kind
  kind="$(add_arg_kind "$arg")" || exit 1
  [ -n "$name" ] || name="$(add_input_name "$arg")"
  validate_input_name "$name" || {
    echo "ERROR: input name '$name' is outside the name grammar [A-Za-z_][A-Za-z0-9_-]*" >&2
    echo "       it becomes a nix attribute and a root-owned directory name; pass --input <name>" >&2
    exit 1
  }
  local FLAKE
  FLAKE="${flake_arg:-$(default_flake_file)}"
  [ -r "$FLAKE" ] || {
    printf '%serror: cannot read %s -- pass --flake%s\n' "$C_RED" "$FLAKE" "$C_OFF" >&2
    exit 1
  }
  ensure_tree "$inv"

  # ---- part 1: the checkout ------------------------------------------------
  local checkout
  if [ "$kind" = path ]; then
    checkout="$arg"
    printf '%s✓ checkout:%s %s %s(used in place; add never copies or edits a checkout)%s\n' \
      "$C_GRN" "$C_OFF" "$(canon_path "$arg")" "$C_DIM" "$C_OFF"
  else
    add_clone "$arg" "$name"
    checkout="$CLONE_DIR"
  fi
  resolve_repo "$checkout"
  local slot="$default_slot"

  # ---- part 3, the free half: is the input already there? ------------------
  # Cheap refusals before any ceremony: a name collision the human has to
  # resolve should never cost a review first.
  local declared=0
  if grep -qF -e "git+file://${repo}?" -e "git+file://${repo}\"" "$FLAKE"; then
    declared=1
    printf '%s✓ input:%s    %s %s(a git+file input already names this repo)%s\n' \
      "$C_GRN" "$C_OFF" "$FLAKE" "$C_DIM" "$C_OFF"
  elif flake_declares_input "$name" <"$FLAKE"; then
    echo "ERROR: $FLAKE already declares an input named '$name', for another path; refusing" >&2
    echo "       which repo owns that name is yours to resolve: pass --input <other-name>" >&2
    exit 1
  fi

  # ---- part 2: the pin -----------------------------------------------------
  local pin
  pin="$(read_rev "$slot")" || exit 1
  if [ -n "$pin" ]; then
    printf '%s✓ pin:%s      %s%s%s %s(already approved; no ceremony)%s\n' \
      "$C_GRN" "$C_OFF" "$C_CYN" "$pin" "$C_OFF" "$C_DIM" "$C_OFF"
    if [ "${#tag_args[@]}" -gt 0 ]; then
      printf '%snote: --signed-tag has nothing to gate here; the repo is already pinned%s\n' \
        "$C_YEL" "$C_OFF" >&2
    fi
  else
    echo
    do_approve "$repo" ${tag_args[@]+"${tag_args[@]}"}
    pin="$(read_rev "$slot")" || exit 1
    # Defensive: the ceremony exits 2 on a decline, so reaching this with no
    # record would mean a shape neither verb knows about. Never declare an
    # input for a repo nothing vouched for.
    [ -n "$pin" ] || {
      echo "ERROR: the ceremony recorded no pin; refusing to declare an input" >&2
      exit 1
    }
    echo
  fi

  if [ "$declared" -eq 1 ]; then
    # Whether that input's rev is the approved one is DEPLOY's question, not
    # add's -- syncing revs is the one thing deploy exists for, and doing it
    # here would be a second answer to it. Saying which state the flake is in
    # still belongs here: this is also how an add interrupted between its
    # insert and its rev sync gets repaired.
    local decl_lines
    decl_lines="$(grep -F "git+file://${repo}?" "$FLAKE" || true)"
    case "$decl_lines" in
      *"rev=${pin}"*)
        printf '%snothing to do -- checkout, pin and input are all in place%s\n' "$C_DIM" "$C_OFF" ;;
      *)
        printf '%snote: the declared input does not name the approved rev yet%s\n' "$C_YEL" "$C_OFF"
        printf '  %spinned deploy%s   %s(syncs every input to its pin, rebuilds)%s\n' \
          "$C_CYN" "$C_OFF" "$C_DIM" "$C_OFF" ;;
    esac
    return 0
  fi

  # ---- part 3: the declaration ---------------------------------------------
  # The ref an input needs. A slot that declares a release name pins to that
  # name (the same declaration deploy syncs ref= to); otherwise the
  # checkout's own branch. A detached HEAD with no declared name leaves
  # nothing honest to write, so it refuses rather than guessing a branch.
  local ref="" decl_tag=""
  if [ -f "$slot/tag" ]; then
    verify_record_file "$slot/tag" || exit 1
    IFS= read -r decl_tag <"$slot/tag" || decl_tag=""
    validate_tag_name "$decl_tag" || {
      echo "ERROR: $slot/tag declares an invalid tag name; refusing" >&2
      exit 1
    }
    ref="refs/tags/$decl_tag"
  else
    ref="$(sgit symbolic-ref --quiet HEAD 2>/dev/null || true)"
    case "$ref" in
      refs/heads/?*) ;;
      *)
        echo "ERROR: $repo is on a detached HEAD and its slot declares no tag" >&2
        echo "       an input needs a ref: check out the branch you deploy from," >&2
        echo "       or review --tag <tag> so the record declares one" >&2
        exit 1 ;;
    esac
    # The same declared-name grammar tags answer to: the ref is spliced into
    # a flake url and into sed expressions, and git admits ref names ('&',
    # for one) that neither survives.
    validate_tag_name "$ref" || {
      echo "ERROR: branch name '${ref#refs/heads/}' is outside the declared-name grammar [A-Za-z0-9._/+-]" >&2
      exit 1
    }
  fi

  # The follows line is included only when the APPROVED tree declares a
  # nixpkgs input -- read from the object store at the pinned rev, never from
  # the work tree, so what the block says about the repo is what was
  # approved. cat-file, not show: sgit refuses every rendering subcommand.
  local follows=0 has_flake=1 blob=""
  if sgit cat-file -e "${pin}:flake.nix" 2>/dev/null; then
    blob="$(sgit cat-file blob "${pin}:flake.nix")"
    if flake_declares_input nixpkgs <<<"$blob"; then follows=1; fi
  else
    has_flake=0
  fi

  local zeros=0000000000000000000000000000000000000000
  local block url
  url="git+file://${repo}?ref=${ref}&rev=${zeros}"
  block="    ${name} = {${NL}      url = \"${url}\";${NL}"
  if [ "$follows" -eq 1 ]; then
    block="${block}      inputs.nixpkgs.follows = \"nixpkgs\";${NL}"
  fi
  block="${block}    };${NL}"

  # The insertion point is the flake's own inputs block. Absent, there is no
  # honest place for this to go, and a trust-adjacent file the human
  # hand-maintains is not one to guess at: print the block and let them
  # place it.
  if ! grep -q '^  inputs = {' "$FLAKE"; then
    echo "ERROR: no '  inputs = {' line in $FLAKE -- refusing to guess where an input belongs" >&2
    echo "       insert this block by hand, then rerun to sync its rev:" >&2
    printf '%s' "$block" >&2
    exit 1
  fi

  printf '%sinput block%s %s(inserted after the inputs = { line of %s)%s\n\n' \
    "$C_B" "$C_OFF" "$C_DIM" "$FLAKE" "$C_OFF"
  printf '%s\n' "$block"
  if [ "$has_flake" -eq 0 ]; then
    printf '%snote: the approved tree has no flake.nix -- nix will refuse this input at\n' "$C_YEL"
    printf '      eval time; add one, review it, then rerun%s\n' "$C_OFF"
  elif [ "$follows" -eq 0 ]; then
    printf '%snote: the approved flake.nix declares no nixpkgs input, so the block carries\n' "$C_DIM"
    printf '      no follows line%s\n' "$C_OFF"
  fi
  printf '%sthe rev goes in as %s zeros and is synced to the pin right after -- an\n' "$C_DIM" "${#zeros}"
  printf 'interrupted add leaves an input that cannot be fetched, never one that floats%s\n\n' "$C_OFF"

  local answer
  printf '%sadd this input to %s%s%s? [y/N]%s ' \
    "$C_B" "$C_CYN" "$FLAKE" "$C_OFF$C_B" "$C_OFF"
  read -r answer </dev/tty
  case "$answer" in
    y|Y|yes) ;;
    *)
      printf '%saborted; flake unchanged%s\n' "$C_YEL" "$C_OFF"
      log_action add "$repo" "$pin" abort
      exit 2
      ;;
  esac

  # Written root-side, atomically: a staged copy in the same directory (so
  # the rename cannot cross a filesystem) carrying the original's owner and
  # mode. Every byte outside the inserted block is copied through unchanged
  # -- this file is hand-maintained, and add is a guest in it.
  # The block travels to awk through a file, not through -v: a -v value
  # holding newlines is a fatal error in BSD awk (macOS ships one).
  local fdir tmp fowner fmode blk_file
  [ -n "$workdir" ] || workdir="$(mktemp -d)"
  blk_file="$workdir/inputblock"
  printf '%s' "$block" >"$blk_file"
  fdir="$(dirname "$FLAKE")"
  fowner="$(stat_owner "$FLAKE")"
  fmode="$(stat_mode "$FLAKE")"
  tmp="$(mktemp "$fdir/.pinned-add.XXXXXX")"
  awk -v blkfile="$blk_file" '
    BEGIN { while ((getline l < blkfile) > 0) blk = blk l "\n" }
    { print }
    !placed && index($0, "  inputs = {") == 1 { printf "%s", blk; placed = 1 }
  ' "$FLAKE" >"$tmp"
  chown "$fowner" "$tmp"
  chmod "$fmode" "$tmp"
  mv -f "$tmp" "$FLAKE"

  # The sync half of the placeholder dance, through deploy's own in-place
  # editor. Scoped to this input by its literal path (regex-escaped), so the
  # placeholder of an unrelated, interrupted add is left for its own rerun;
  # the rev operands are validated hex on both sides.
  local SED_I=() esc
  set_sed_i
  esc="$(printf '%s' "$repo" | sed 's/[][\.*^$|]/\\&/g')"
  "${SED_I[@]}" -e "s|\\(git+file://${esc}?[^\"]*\\)rev=${zeros}|\\1rev=${pin}|" "$FLAKE"
  grep -qF "git+file://${repo}?ref=${ref}&rev=${pin}" "$FLAKE" || {
    echo "ERROR: the input's rev did not sync to the pin in $FLAKE; inspect it before rebuilding" >&2
    exit 1
  }
  printf '%s✓ input:%s    %s -> %s %s(rev %s)%s\n' \
    "$C_GRN$C_B" "$C_OFF" "$name" "$FLAKE" "$C_DIM" "${pin:0:10}" "$C_OFF"
  log_action add "$repo" "$pin"

  echo
  printf '%sConsuming it stays yours:%s pinned declares the input and never edits the\n' "$C_B" "$C_OFF"
  printf 'repositories it gates, so the module import (or overlay, or whatever this\n'
  printf 'input feeds) is a hand edit. Once it is wired:\n'
  printf '  %spinned deploy%s   %s(sync every input to its pin, rebuild)%s\n' \
    "$C_CYN" "$C_OFF" "$C_DIM" "$C_OFF"
}

case "$action" in
  review)    do_approve "$@" ;;
  add)       do_add "$@" ;;
  tombstone) do_tombstone "$@" ;;
  mv)        do_mv "$@" ;;
  verify)    do_verify "$@" ;;
  cat)       do_cat "$@" ;;
  sign)      do_sign "$@" ;;
  signer)    do_signer "$@" ;;
  ignorable) do_ignorable "$@" ;;
  status)    do_status "$@" ;;
  list)      do_list "$@" ;;
  slot)      do_slot "$@" ;;
  show)      do_show "$@" ;;
  deploy)    do_deploy "$@" ;;
  upgrade)   do_upgrade "$@" ;;
  *)         usage ;;
esac
