# Part 1 for a url argument: the shared clone tree at $PINNED_CLONES.
# Sets CLONE_DIR. Root supervises; git never runs as root here.
#
# THE URL IS TRANSPORT, NOTHING ELSE. Trust binds AFTER the fetch -- the
# ceremony reviews the tree, or a signature gates it -- so a redirected,
# hostile or simply wrong remote is bounded by the review that follows, not
# by how the bytes arrived. What the fetch must not do is EXECUTE anything:
# GIT_ALLOW_PROTOCOL keeps git to the four transports below, which is what
# shuts out `ext::` (a remote helper is a command line), and the scrubbed
# HOME means no user git config and no credential helper participates.
# Consequences worth knowing: public https/git works, agent-backed ssh works
# when the socket survives sudo, and credentialed https does not -- clone
# that one by hand and `pinned add <path>` the checkout.
add_clone() { # <url> <name>
  CLONE_DIR="$PINNED_CLONES/$2"
  local origin rc=0
  if [ -e "$CLONE_DIR" ]; then
    # An existing destination is REUSED only when its provenance matches:
    # same url, in a real repository. Anything else is unexplained state
    # that a trust tool must not adopt on a hunch.
    [ -d "$CLONE_DIR" ] \
      || { echo "ERROR: $CLONE_DIR exists and is not a directory; refusing" >&2; exit 1; }
    # --show-toplevel, and it must be this very directory: git's repository
    # discovery walks UP, so a plain directory sitting inside some other
    # checkout answers for that checkout instead. Reading a parent's origin
    # here would compare the wrong remote entirely.
    local top=""
    top="$(git -C "$CLONE_DIR" -c safe.directory="$CLONE_DIR" rev-parse --show-toplevel 2>/dev/null || true)"
    if [ -z "$top" ] || [ "$(canon_path "$top")" != "$(canon_path "$CLONE_DIR")" ]; then
      echo "ERROR: $CLONE_DIR exists but is not a git repository of its own; refusing" >&2
      echo "       inspect it, move it aside, or name another input with --input" >&2
      exit 1
    fi
    origin="$(git -C "$CLONE_DIR" -c safe.directory="$CLONE_DIR" config --get remote.origin.url 2>/dev/null || true)"
    if [ "$origin" != "$1" ]; then
      echo "ERROR: $CLONE_DIR holds a clone of another remote; refusing" >&2
      printf '       its origin:    %s\n' "${origin:-(none)}" >&2
      printf '       you asked for: %s\n' "$1" >&2
      exit 1
    fi
    printf '%s✓ clone:%s    %s %s(already here; origin matches, nothing fetched)%s\n' \
      "$C_GRN" "$C_OFF" "$CLONE_DIR" "$C_DIM" "$C_OFF"
    return 0
  fi
  install -d -m 755 -o root -g wheel "$PINNED_CLONES"
  if group_exists "$PINNED_CLONES_GROUP"; then
    # Group-writable, because updating the clone is what operators do, and
    # setgid so that later objects carry the group on Linux too -- BSD
    # directories inherit their parent's group natively, Linux ones only
    # with this bit.
    install -d -m 2775 -o root -g "$PINNED_CLONES_GROUP" "$CLONE_DIR"
  else
    printf '%swarning: group %s does not exist -- %s will be owned by %s alone%s\n' \
      "$C2_YEL" "$PINNED_CLONES_GROUP" "$CLONE_DIR" "$inv" "$C2_OFF" >&2
    printf '%s         sharing the clone with other operators needs that group; the system\n' "$C2_YEL" >&2
    printf '         configuration declares it (nix: security.pinned)%s\n' "$C2_OFF" >&2
    install -d -m 755 -o "$inv" "$CLONE_DIR"
  fi
  printf '%scloning:%s    %s\n' "$C_DIM" "$C_OFF" "$1"
  # AS THE INVOKER, never as root: root's job here is the directory, not the
  # network. core.sharedRepository=group lands in the new repo's config at
  # init time, so later fetches by another operator leave readable objects.
  # No --depth: the ancestry lattice and the full-tree review of a first
  # approval both need real history.
  # SSH_AUTH_SOCK survives to here only if your sudoers keeps it; without it
  # an agent-backed remote cannot authenticate, which is the by-hand case.
  sudo -u "$inv" env -i PATH="$PATH" \
    GIT_CONFIG_NOSYSTEM=1 HOME=/var/empty \
    SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-}" \
    GIT_ALLOW_PROTOCOL=file:git:http:https:ssh \
    git clone --config core.sharedRepository=group -- "$1" "$CLONE_DIR" || rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "ERROR: clone failed; nothing was pinned or declared" >&2
    if rmdir "$CLONE_DIR" 2>/dev/null; then
      echo "       removed the empty $CLONE_DIR" >&2
    else
      echo "       $CLONE_DIR holds a partial clone; inspect and remove it by hand" >&2
    fi
    exit 1
  fi
  printf '%s✓ cloned:%s   %s\n' "$C_GRN" "$C_OFF" "$CLONE_DIR"
}

# One verb from "this repo exists somewhere" to "pinned, and wired in as an
# input of the system flake", in three idempotent parts -- a checkout, a
# pin, a wired input -- each skipped with a note when it is already
# satisfied, and all three satisfied meaning there is nothing to do.
#
# NOTHING HERE IS A SECOND REVIEW PATH: the pin comes from do_approve, the
# same ceremony `pinned review` runs, and the flake edit reuses deploy's
# in-place editor. add composes; it decides nothing about trust on its own.
#
# add never edits a CONSUMING repo. Wiring the input into a configuration
# (module imports, overlays, an anchor template's mirror) stays a human
# edit, because a tool that wrote into the repos it gates would be
# approving its own changes.
#
# THE PLACEHOLDER DANCE. The block is written with an all-zero rev and only
# then synced to the approved one. A crash between the two leaves a rev that
# can never be fetched, so the next rebuild fails loudly instead of building
# whatever a floating ref happens to point at -- the interruption fails
# closed, and the shape is the one nix-config's anchor template documents.
do_add() {
  require_root add

  local arg="" name="" flake_arg="" tag_args
  tag_args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --input)
        [ $# -ge 2 ] || { echo "--input needs a name" >&2; exit 1; }
        [ -z "$name" ] || { echo "--input may be given once (it names one input)" >&2; exit 1; }
        name="$2"; shift 2 ;;
      # Rides through to the ceremony unchanged, with review's own
      # semantics: repeatable, and every named tag must verify AND name the
      # same commit (threshold multisig).
      --signed-tag)
        [ $# -ge 2 ] || { echo "--signed-tag needs a tag" >&2; exit 1; }
        tag_args+=(--signed-tag "$2"); shift 2 ;;
      --flake)
        [ $# -ge 2 ] || { echo "--flake needs a path" >&2; exit 1; }
        flake_arg="$2"; shift 2 ;;
      # The elevation gate's answer, riding through in the displayed argv;
      # the ceremony's own confirmations below are untouched by it.
      --yes) shift ;;
      -*) usage ;;
      *)
        [ -z "$arg" ] || { echo "add takes one repo or url" >&2; exit 1; }
        arg="$1"; shift ;;
    esac
  done
  [ -n "$arg" ] || usage

  local kind
  kind="$(add_arg_kind "$arg")" || exit 1
  [ -n "$name" ] || name="$(add_input_name "$arg")"
  validate_input_name "$name" || {
    echo "ERROR: input name '$name' is outside the name grammar [A-Za-z_][A-Za-z0-9_-]*" >&2
    echo "       it becomes a nix attribute and a root-owned directory name; pass --input <name>" >&2
    exit 1
  }
  local FLAKE
  FLAKE="${flake_arg:-$(default_flake_file)}"
  [ -r "$FLAKE" ] || {
    printf '%serror: cannot read %s -- pass --flake%s\n' "$C2_RED" "$FLAKE" "$C2_OFF" >&2
    exit 1
  }
  ensure_tree "$inv"

  # ---- part 1: the checkout ------------------------------------------------
  local checkout
  if [ "$kind" = path ]; then
    checkout="$arg"
    printf '%s✓ checkout:%s %s %s(used in place; add never copies or edits a checkout)%s\n' \
      "$C_GRN" "$C_OFF" "$(canon_path "$arg")" "$C_DIM" "$C_OFF"
  else
    add_clone "$arg" "$name"
    checkout="$CLONE_DIR"
  fi
  resolve_repo "$checkout"
  local slot="$default_slot"

  # ---- part 3, the free half: is the input already there? ------------------
  # Cheap refusals before any ceremony: a name collision the human has to
  # resolve should never cost a review first.
  local declared=0
  if grep -qF -e "git+file://${repo}?" -e "git+file://${repo}\"" "$FLAKE"; then
    declared=1
    printf '%s✓ input:%s    %s %s(a git+file input already names this repo)%s\n' \
      "$C_GRN" "$C_OFF" "$FLAKE" "$C_DIM" "$C_OFF"
  elif flake_declares_input "$name" <"$FLAKE"; then
    echo "ERROR: $FLAKE already declares an input named '$name', for another path; refusing" >&2
    echo "       which repo owns that name is yours to resolve: pass --input <other-name>" >&2
    exit 1
  fi

  # ---- part 2: the pin -----------------------------------------------------
  local pin
  pin="$(read_rev "$slot" "$repo")" || exit 1
  if [ -n "$pin" ]; then
    printf '%s✓ pin:%s      %s%s%s %s(already approved; no ceremony)%s\n' \
      "$C_GRN" "$C_OFF" "$C_CYN" "$pin" "$C_OFF" "$C_DIM" "$C_OFF"
    if [ "${#tag_args[@]}" -gt 0 ]; then
      printf '%snote: --signed-tag has nothing to gate here; the repo is already pinned%s\n' \
        "$C2_YEL" "$C2_OFF" >&2
    fi
  else
    echo
    do_approve "$repo" ${tag_args[@]+"${tag_args[@]}"}
    pin="$(read_rev "$slot" "$repo")" || exit 1
    # Defensive: the ceremony exits 2 on a decline, so reaching this with no
    # record would mean a shape neither verb knows about. Never wire in an
    # input for a repo nothing vouched for.
    [ -n "$pin" ] || {
      echo "ERROR: the ceremony recorded no pin; refusing to wire an input" >&2
      exit 1
    }
    echo
  fi

  if [ "$declared" -eq 1 ]; then
    # Whether that input's rev is the approved one is DEPLOY's question, not
    # add's -- syncing revs is the one thing deploy exists for, and doing it
    # here would be a second answer to it. Saying which state the flake is in
    # still belongs here: this is also how an add interrupted between its
    # insert and its rev sync gets repaired.
    local decl_lines
    decl_lines="$(grep -F "git+file://${repo}?" "$FLAKE" || true)"
    case "$decl_lines" in
      *"rev=${pin}"*)
        printf '%snothing to do -- checkout, pin and input are all in place%s\n' "$C_DIM" "$C_OFF" ;;
      *)
        printf '%snote: the wired input does not name the approved rev yet%s\n' "$C_YEL" "$C_OFF"
        printf '  %spinned deploy%s   %s(syncs every input to its pin, rebuilds)%s\n' \
          "$C_CYN" "$C_OFF" "$C_DIM" "$C_OFF" ;;
    esac
    return 0
  fi

  # ---- part 3: the wiring --------------------------------------------------
  # The ref an input needs. A slot that declares a release name pins to that
  # name (the same declaration deploy syncs ref= to); otherwise the
  # checkout's own branch. A detached HEAD with no declared name leaves
  # nothing honest to write, so it refuses rather than guessing a branch.
  local ref="" decl_tag=""
  if [ -f "$slot/release" ]; then
    verify_record_file "$slot/release" || exit 1
    IFS= read -r decl_tag <"$slot/release" || decl_tag=""
    validate_release_name "$decl_tag" || {
      echo "ERROR: $slot/release declares an invalid release name; refusing" >&2
      exit 1
    }
    ref="refs/tags/$decl_tag"
  else
    ref="$(sgit symbolic-ref --quiet HEAD 2>/dev/null || true)"
    case "$ref" in
      refs/heads/?*) ;;
      *)
        echo "ERROR: $repo is on a detached HEAD and its slot declares no release" >&2
        echo "       an input needs a ref: check out the branch you deploy from," >&2
        echo "       or review --tag <tag> so the record declares one" >&2
        exit 1 ;;
    esac
    # The same declared-name grammar tags answer to: the ref is spliced into
    # a flake url and into sed expressions, and git admits ref names ('&',
    # for one) that neither survives.
    validate_release_name "$ref" || {
      echo "ERROR: branch name '${ref#refs/heads/}' is outside the declared-name grammar [A-Za-z0-9._/+-]" >&2
      exit 1
    }
  fi

  # The follows line is included only when the APPROVED tree declares a
  # nixpkgs input -- read from the object store at the pinned rev, never from
  # the work tree, so what the block says about the repo is what was
  # approved. cat-file, not show: sgit refuses every rendering subcommand.
  local follows=0 has_flake=1 blob=""
  if sgit cat-file -e "${pin}:flake.nix" 2>/dev/null; then
    blob="$(sgit cat-file blob "${pin}:flake.nix")"
    if flake_declares_input nixpkgs <<<"$blob"; then follows=1; fi
  else
    has_flake=0
  fi

  local zeros=0000000000000000000000000000000000000000
  local block url
  url="git+file://${repo}?ref=${ref}&rev=${zeros}"
  block="    ${name} = {${NL}      url = \"${url}\";${NL}"
  if [ "$follows" -eq 1 ]; then
    block="${block}      inputs.nixpkgs.follows = \"nixpkgs\";${NL}"
  fi
  block="${block}    };${NL}"

  # The insertion point is the flake's own inputs block. Absent, there is no
  # honest place for this to go, and a trust-adjacent file the human
  # hand-maintains is not one to guess at: print the block and let them
  # place it.
  if ! grep -q '^  inputs = {' "$FLAKE"; then
    echo "ERROR: no '  inputs = {' line in $FLAKE -- refusing to guess where an input belongs" >&2
    echo "       insert this block by hand, then rerun to sync its rev:" >&2
    printf '%s' "$block" >&2
    exit 1
  fi

  printf '%sinput block%s %s(inserted after the inputs = { line of %s)%s\n\n' \
    "$C_B" "$C_OFF" "$C_DIM" "$FLAKE" "$C_OFF"
  printf '%s\n' "$block"
  if [ "$has_flake" -eq 0 ]; then
    printf '%snote: the approved tree has no flake.nix -- nix will refuse this input at\n' "$C_YEL"
    printf '      eval time; add one, review it, then rerun%s\n' "$C_OFF"
  elif [ "$follows" -eq 0 ]; then
    printf '%snote: the approved flake.nix declares no nixpkgs input, so the block carries\n' "$C_DIM"
    printf '      no follows line%s\n' "$C_OFF"
  fi
  printf '%sthe rev goes in as %s zeros and is synced to the pin right after -- an\n' "$C_DIM" "${#zeros}"
  printf 'interrupted add leaves an input that cannot be fetched, never one that floats%s\n\n' "$C_OFF"

  local answer
  printf '%sadd this input to %s%s%s? [%sy%s/%sN%s]%s ' \
    "$C_B" "$C_CYN" "$FLAKE" "$C_OFF$C_B" \
    "$C_BLU" "$C_OFF$C_B" "$C_BLU" "$C_OFF$C_B" "$C_OFF"
  drain_tty
  read -r answer </dev/tty
  case "$answer" in
    y|Y|yes) ;;
    *)
      printf '%saborted; flake unchanged%s\n' "$C_YEL" "$C_OFF"
      log_action add "$repo" "$pin" abort
      exit 2
      ;;
  esac

  # Written root-side, atomically: a staged copy in the same directory (so
  # the rename cannot cross a filesystem) carrying the original's owner and
  # mode. Every byte outside the inserted block is copied through unchanged
  # -- this file is hand-maintained, and add is a guest in it.
  # The block travels to awk through a file, not through -v: a -v value
  # holding newlines is a fatal error in BSD awk (macOS ships one).
  local fdir tmp fowner fmode blk_file
  [ -n "$workdir" ] || workdir="$(mktemp -d)"
  blk_file="$workdir/inputblock"
  printf '%s' "$block" >"$blk_file"
  fdir="$(dirname "$FLAKE")"
  fowner="$(stat_owner "$FLAKE")"
  fmode="$(stat_mode "$FLAKE")"
  tmp="$(mktemp "$fdir/.pinned-add.XXXXXX")"
  awk -v blkfile="$blk_file" '
    BEGIN { while ((getline l < blkfile) > 0) blk = blk l "\n" }
    { print }
    !placed && index($0, "  inputs = {") == 1 { printf "%s", blk; placed = 1 }
  ' "$FLAKE" >"$tmp"
  chown "$fowner" "$tmp"
  chmod "$fmode" "$tmp"
  mv -f "$tmp" "$FLAKE"

  # The sync half of the placeholder dance, through deploy's own in-place
  # editor. Scoped to this input by its literal path (regex-escaped), so the
  # placeholder of an unrelated, interrupted add is left for its own rerun;
  # the rev operands are validated hex on both sides.
  local SED_I=() esc
  set_sed_i
  esc="$(printf '%s' "$repo" | sed 's/[][\.*^$|]/\\&/g')"
  "${SED_I[@]}" -e "s|\\(git+file://${esc}?[^\"]*\\)rev=${zeros}|\\1rev=${pin}|" "$FLAKE"
  grep -qF "git+file://${repo}?ref=${ref}&rev=${pin}" "$FLAKE" || {
    echo "ERROR: the input's rev did not sync to the pin in $FLAKE; inspect it before rebuilding" >&2
    exit 1
  }
  printf '%s✓ input:%s    %s -> %s %s(rev %s)%s\n' \
    "$C_GRN$C_B" "$C_OFF" "$name" "$FLAKE" "$C_DIM" "${pin:0:10}" "$C_OFF"
  log_action add "$repo" "$pin"

  echo
  printf '%sConsuming it stays yours:%s pinned wires the input in and never edits the\n' "$C_B" "$C_OFF"
  printf 'repositories it gates, so the module import (or overlay, or whatever this\n'
  printf 'input feeds) is a hand edit. Once it is wired:\n'
  printf '  %spinned deploy%s   %s(sync every input to its pin, rebuild)%s\n' \
    "$C_CYN" "$C_OFF" "$C_DIM" "$C_OFF"
}

case "$action" in
  review)    do_approve "$@" ;;
  add)       do_add "$@" ;;
  tombstone) do_tombstone "$@" ;;
  rekey)     do_rekey "$@" ;;
  declare)   do_declare "$@" ;;
  verify)    do_verify "$@" ;;
  cat)       do_cat "$@" ;;
  rev)       do_rev "$@" ;;
  sign)      do_sign "$@" ;;
  signer)    do_signer "$@" ;;
  ignorable) do_ignorable "$@" ;;
  status)    do_status "$@" ;;
  list)      do_list "$@" ;;
  slot)      do_slot "$@" ;;
  show)      do_show "$@" ;;
  deploy)    do_deploy "$@" ;;
  upgrade)   do_upgrade "$@" ;;
  *)         usage ;;
esac
