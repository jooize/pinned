#!/usr/bin/env bash
# pinned -- review-and-pin a git rev behind a human gate.
#
#   pinned bless <repo> [--trust-current]   review diff since last pin -> approve -> pin
#   pinned bless <repo> --tag <tag>         verify signed tag -> approve -> pin
#   pinned sign  <repo> <tag>               signed release tag at the PINNED sha
#   pinned status <repo>                    pinned SHA vs HEAD; dirty-tree warning
#   pinned setup [--yes]                    provision sudoers digest pin; self-install
#
# bless/setup self-elevate via sudo (re-exec of the installed root-owned
# binary); sign runs as the user because it needs the SSH agent.
#
# bless runs root-owned code end to end: it resolves the rev to a SHA, shows
# the diff from the OBJECT STORE (scrubbed env, no user git config, no pager,
# no hooks), and writes the approved SHA to a root-owned pin file. Deploy
# tooling builds git+file://<repo>?rev=<sha> and nothing else. The SHA never
# crosses a trust boundary in human hands.
#
# Signing exports the pin: sign creates a perfectly normal signed release
# tag (git tag -s, nothing pinned-specific in the repo), but the sha it
# signs comes from the root-owned pin file -- you read once at bless;
# nothing is re-read at sign time, so there is nothing to MITM. bless
# --tag verifies such a tag against root-owned allowed signers
# (/etc/pinned/allowed_signers, git's native format) -- that is the
# second-machine bootstrap: clone anywhere, install the signer key once,
# bless the release.
#
# Consumers read the pin from /etc/pinned/<encoded-repo-path>; for a
# friendlier path, point a root-owned symlink at the slot, e.g.
#   ln -s "/etc/pinned/$(pinned slot /path/to/repo)" /etc/nix-darwin/pinned-rev

# Pin PATH so bare command names can't be hijacked even if sudoers env_keep
# ever leaks PATH from the invoker.
export PATH=/usr/bin:/bin:/usr/sbin:/sbin

set -euo pipefail

# Override-friendly defaults (handy for testing).
: "${INSTALL_TARGET:=/usr/local/sbin/pinned}"
: "${PIN_ROOT:=/etc/pinned}"

usage() {
  cat >&2 <<EOF
usage: pinned <action> [args]

  bless <repo> [--trust-current]
                     (sudo) review diff since last pin, approve, write pin
  bless <repo> --tag <tag>
                     (sudo) verify signed tag against
                     /etc/pinned/allowed_signers, approve, write pin
  sign <repo> <tag>  create signed tag <tag> at the PINNED sha -- no sudo
                     (needs your SSH agent, e.g. 1Password)
  status <repo>      pinned SHA vs HEAD; warns on dirty tree
  slot <repo>        print the repo's pin-file path (for consumer symlinks)
  setup [--yes]      (sudo) provision sudoers digest pin; self-install

blessing history: log show --predicate 'eventMessage CONTAINS "pinned:"'
EOF
  exit 1
}

[ $# -ge 1 ] || usage
action="$1"
shift

# Root-requiring actions self-elevate: re-exec the INSTALLED (root-owned,
# digest-pinned) binary under sudo so the elevated code is never a copy the
# invoker could have modified. Pre-install (setup from a checkout) falls
# back to this script's own path.
case "$action" in
  bless|setup)
    if [ "$EUID" -ne 0 ]; then
      elev="$INSTALL_TARGET"
      [ -x "$elev" ] || elev="$(readlink -f "$0")"
      exec /usr/bin/sudo -- "$elev" "$action" "$@"
    fi
    ;;
esac

log_action() {
  # visible via: log show --predicate 'eventMessage CONTAINS "pinned:"' --last 1d
  logger -t pinned "user=${inv:-$(id -un)} action=$1 repo=${2:-} rev=${3:-} result=${4:-ok}"
}

# ---- shared verification (locked-family pattern) ---------------------------

# Verify a path is root:wheel owned with no group/other write. Refuses to
# trust binaries or pin files reachable through a user-writable ancestor.
verify_root_owned_path() {
  local path="$1" owner mode
  owner="$(stat -f '%Su:%Sg' "$path")"
  mode="$(stat -f '%OLp' "$path")"
  if [ "$owner" != "root:wheel" ]; then
    echo "ERROR: $path is owned $owner, expected root:wheel" >&2
    echo "       fix manually: sudo chown root:wheel $path && sudo chmod 755 $path" >&2
    return 1
  fi
  case "$mode" in
    755|750|700|555|550|500) ;;
    *)
      echo "ERROR: $path has mode $mode, expected 755 or stricter" >&2
      return 1
      ;;
  esac
}

verify_ancestry() {
  # Walk ancestry of a path (itself excluded) up to /, verify each dir.
  local p
  p="$(dirname "$1")"
  while [ "$p" != "/" ]; do
    verify_root_owned_path "$p" || return 1
    p="$(dirname "$p")"
  done
}

# ---- scrubbed git ----------------------------------------------------------

# Absolute git; nix system profile first, Apple's as fallback.
GIT=/run/current-system/sw/bin/git
[ -x "$GIT" ] || GIT=/usr/bin/git

# Run git against $repo with NOTHING attacker-influencable in play:
# env -i (no GIT_* smuggling), no global/system config, repo-local config
# neutralized where it matters (-c overrides, no pager, no fsmonitor daemon).
# show/diff/rev-parse/log run no hooks; aliases can't shadow builtins.
sgit() {
  env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin HOME=/var/empty \
    GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null \
    "$GIT" -C "$repo" --no-pager -c core.fsmonitor=false -c core.pager=cat "$@"
}

# URL-encode % and / so a repo path becomes an unambiguous flat filename.
encode() {
  printf '%s' "$1" | sed -e 's|%|%25|g' -e 's|/|%2F|g'
}

resolve_repo() {
  [ $# -ge 1 ] || usage
  repo="$(readlink -f "$1")"
  [ -n "$repo" ] && [ -d "$repo" ] || { echo "not a directory: ${1}" >&2; exit 1; }
  sgit rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || { echo "not a git work tree: $repo" >&2; exit 1; }
  default_pin_file="$PIN_ROOT/$(encode "$repo")"
}

read_pin() {
  # Echoes pinned sha or nothing. Validates format so a tampered pin file
  # can't smuggle arbitrary text into git argv.
  local f="$1" sha
  [ -f "$f" ] || return 0
  sha="$(head -n1 "$f")"
  case "$sha" in
    *[!0-9a-f]*|'')
      echo "ERROR: pin file $f is corrupt: '$sha'" >&2
      return 1
      ;;
  esac
  # 40 (SHA-1) through 128 (SHA-512) hex chars: covers current git/hg
  # hashes and leaves room for future backends (blake3, post-quantum).
  [ "${#sha}" -ge 40 ] && [ "${#sha}" -le 128 ] \
    || { echo "ERROR: pin file $f has bad hash length" >&2; return 1; }
  printf '%s\n' "$sha"
}

# ---- setup -----------------------------------------------------------------

do_setup() {
  [ "$EUID" -eq 0 ] || { echo "setup must run as root (sudo $0 setup)" >&2; exit 1; }
  inv="${SUDO_USER:-}"
  [ -n "$inv" ] || { echo "setup must be invoked via sudo" >&2; exit 1; }

  local assume_yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes) assume_yes=1; shift ;;
      *)     usage ;;
    esac
  done

  if [ "$assume_yes" -ne 1 ]; then
    cat <<EOF
pinned setup will:
  1. install this script to $INSTALL_TARGET (root:wheel 755)
  2. create $PIN_ROOT for root-owned pin files
  3. write /etc/sudoers.d/pinned granting $inv sudo for the binary,
     digest-pinned to its sha256 (a swapped binary makes sudo refuse)

If this machine is managed declaratively (nix-darwin, NixOS, ...), you
may prefer to declare the binary and sudoers entry in your system
config instead of running setup -- EXCEPT on the first machine, where
pinned gates that very deploy path: manual setup after a hand-read of
this script is the intended bootstrap there.
EOF
    local answer
    printf 'proceed? [y/N] '
    read -r answer </dev/tty
    case "$answer" in
      y|Y|yes) ;;
      *) echo "aborted; nothing installed."; exit 2 ;;
    esac
  fi

  # 1. Self-install; verify every ancestor of INSTALL_TARGET first.
  local self target target_dir
  self="$(readlink -f "$0")"
  target="$INSTALL_TARGET"
  target_dir="$(dirname "$target")"
  install -d -m 755 -o root -g wheel "$target_dir"
  verify_ancestry "$target" || exit 1
  verify_root_owned_path "$target_dir" || exit 1
  if [ "$self" != "$target" ]; then
    install -m 755 -o root -g wheel "$self" "$target"
    echo "installed: $target"
  else
    echo "binary already at $target"
  fi

  # 2. Pin root
  install -d -m 755 -o root -g wheel "$PIN_ROOT"
  echo "pin root: $PIN_ROOT"

  # 3. Sudoers entry with binary-digest pin (validated before installing).
  #    sudo recomputes the binary's SHA-256 at every invocation and refuses
  #    silently on mismatch -- integrity check lives in sudo, not in us.
  local sudoers_target sudoers_line digest tmp
  sudoers_target=/etc/sudoers.d/pinned
  digest="$(shasum -a 256 "$target" | awk '{print $1}')"
  sudoers_line="$inv ALL=(root) sha256:$digest ${target}"
  if [ -f "$sudoers_target" ] && grep -qF "$sudoers_line" "$sudoers_target"; then
    echo "sudoers digest current: $sudoers_target"
  else
    tmp="$(mktemp)"
    printf '%s\n' "$sudoers_line" >"$tmp"
    if visudo -c -f "$tmp" >/dev/null 2>&1; then
      install -m 440 -o root -g wheel "$tmp" "$sudoers_target"
      echo "wrote sudoers entry with digest: $sudoers_target"
      echo "  digest: sha256:$digest"
    else
      echo "sudoers validation failed; not installing" >&2
      rm -f "$tmp"
      exit 1
    fi
    rm -f "$tmp"
  fi

  log_action setup
  echo
  echo "setup complete."
  echo "  next: sudo pinned bless <repo>"
}

if [ "$action" = "setup" ]; then
  do_setup "$@"
  exit 0
fi

# Re-verify INSTALL_TARGET ancestry on every invocation (catches a later
# "chown -R \$USER /usr/local" undoing the install-path guarantees).
if [ -f "$INSTALL_TARGET" ]; then
  verify_ancestry "$INSTALL_TARGET" || exit 1
fi

# ---- bless -----------------------------------------------------------------

do_bless() {
  [ "$EUID" -eq 0 ] || { echo "bless must run as root (sudo pinned bless <repo>)" >&2; exit 1; }
  inv="${SUDO_USER:-}"
  [ -n "$inv" ] || { echo "bless must be invoked via sudo" >&2; exit 1; }

  local trust_current=0 tag_arg="" repo_arg=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --tag)           tag_arg="$2"; shift 2 ;;
      --trust-current) trust_current=1; shift ;;
      -*)              usage ;;
      *)               repo_arg="$1"; shift ;;
    esac
  done
  [ -n "$repo_arg" ] || usage
  resolve_repo "$repo_arg"
  local pin_file="$default_pin_file"

  # The pin file must live under a root-owned ancestry or the machine gate
  # is only as strong as the weakest writable dir on the way there.
  verify_ancestry "$pin_file" || exit 1

  local sha old_sha
  old_sha="$(read_pin "$pin_file")" || exit 1

  if [ -n "$tag_arg" ]; then
    # Signature gate: verify a normally-signed release tag (git tag -s;
    # nothing pinned-specific in the repo) against ROOT-OWNED allowed
    # signers, then pin the commit it names. This is the second-machine
    # bootstrap: clone anywhere, install the signer key once, bless the tag.
    case "$tag_arg" in
      -*) echo "invalid tag name: $tag_arg" >&2; exit 1 ;;
    esac
    local signers="$PIN_ROOT/allowed_signers"
    if [ ! -f "$signers" ]; then
      echo "ERROR: $signers not found" >&2
      echo "  install the signer's public key (git allowed-signers format) root-owned:" >&2
      echo "    sudo install -m 644 -o root -g wheel <file> $signers" >&2
      echo "  obtain the key OUT OF BAND (printed card, password manager," >&2
      echo "  existing trusted machine) -- never from this repo." >&2
      exit 1
    fi
    verify_root_owned_path "$PIN_ROOT" || exit 1
    if [ "$(stat -f '%Su:%Sg' "$signers")" != "root:wheel" ]; then
      echo "ERROR: $signers is not root:wheel owned" >&2
      exit 1
    fi
    if ! sgit -c gpg.ssh.allowedSignersFile="$signers" verify-tag "$tag_arg"; then
      echo "ERROR: signature verification FAILED for tag $tag_arg; pin unchanged" >&2
      log_action bless "$repo" "$tag_arg" verify-failed
      exit 1
    fi
    sha="$(sgit rev-parse "refs/tags/${tag_arg}"'^{commit}')"
    if [ -n "$old_sha" ] && [ "$old_sha" = "$sha" ]; then
      echo "already pinned: $sha"
      exit 0
    fi
    echo "repo:    $repo"
    echo "tag:     $tag_arg  (signature verified against $signers)"
    echo "commit:  $sha  ($(sgit log -1 --format=%s "$sha"))"
    [ -n "$old_sha" ] && echo "pinned:  $old_sha"
  else
    # Human gate: read the diff since the last pin from the object store.
    sha="$(sgit rev-parse 'HEAD^{commit}')"

    if ! sgit diff --quiet 2>/dev/null || ! sgit diff --cached --quiet 2>/dev/null; then
      echo "note: work tree is dirty; only COMMITTED content at $sha is being blessed" >&2
    fi

    if [ -n "$old_sha" ] && [ "$old_sha" = "$sha" ]; then
      echo "already pinned: $sha"
      exit 0
    fi

    echo "repo:    $repo"
    echo "HEAD:    $sha  ($(sgit log -1 --format=%s "$sha"))"
    if [ -n "$old_sha" ]; then
      echo "pinned:  $old_sha"
      echo
      echo "--- commits since last blessing ---"
      sgit log --format='%h %s' "${old_sha}..${sha}" || true
      echo
      echo "--- diff ${old_sha}..${sha} (from object store) ---"
      sgit diff "$old_sha" "$sha"
    elif [ "$trust_current" -eq 1 ]; then
      echo "pinned:  (none)"
      echo
      echo "!!! FIRST BLESSING WITH --trust-current !!!"
      echo "!!! The full tree at $sha is being blessed WITHOUT review. !!!"
      echo "!!! Everything already in this repo becomes trusted as-is. !!!"
    else
      echo "pinned:  (none -- first blessing: full tree review)"
      echo
      echo "--- full tree at ${sha} (diff from empty) ---"
      # 4b825d... is git's well-known empty tree; this shows every blessed byte.
      sgit diff 4b825dc642cb6eb9a060e54bf8d69288fbee4904 "$sha"
    fi
  fi
  echo

  local answer
  printf 'bless %s? [y/N] ' "$sha"
  read -r answer </dev/tty
  case "$answer" in
    y|Y|yes) ;;
    *)
      echo "aborted; pin unchanged."
      log_action bless "$repo" "$sha" abort
      exit 2
      ;;
  esac

  # Atomic pin write: stage in the (root-owned) pin dir, single rename.
  local tmp
  tmp="$(mktemp "$PIN_ROOT/.pin.XXXXXX")"
  printf '%s\n' "$sha" >"$tmp"
  chown root:wheel "$tmp"
  chmod 644 "$tmp"
  mv -f "$tmp" "$pin_file"
  echo "pinned: $sha -> $pin_file"
  log_action bless "$repo" "$sha"
}

# ---- status ----------------------------------------------------------------

do_status() {
  inv="$(id -un)"
  resolve_repo "$@"
  local pin_file="$default_pin_file" sha head_sha
  sha="$(read_pin "$pin_file")" || exit 1
  head_sha="$(sgit rev-parse 'HEAD^{commit}')"

  echo "repo:    $repo"
  echo "pin:     ${pin_file}"
  if [ -z "$sha" ]; then
    echo "pinned:  (none)"
  else
    echo "pinned:  $sha  ($(sgit log -1 --format=%s "$sha" 2>/dev/null || echo 'commit not in repo!'))"
  fi
  echo "HEAD:    $head_sha  ($(sgit log -1 --format=%s "$head_sha"))"
  if [ -n "$sha" ] && [ "$sha" = "$head_sha" ]; then
    echo "state:   ✓ HEAD is blessed"
  elif [ -n "$sha" ]; then
    echo "state:   ✗ HEAD is NOT blessed ($(sgit rev-list --count "${sha}..${head_sha}" 2>/dev/null || echo '?') commits ahead of pin)"
  else
    echo "state:   ✗ never blessed"
  fi
  if ! sgit diff --quiet 2>/dev/null || ! sgit diff --cached --quiet 2>/dev/null; then
    echo "warning: work tree is dirty (uncommitted changes are never blessed)"
  fi
}

# ---- sign ------------------------------------------------------------------

do_sign() {
  # Export the pin as a normal signed release tag -- NO re-read anywhere in
  # the path. The sha comes from the root-owned pin file and is passed to
  # git explicitly, so "what gets signed" is exactly "what was blessed";
  # a compromised environment can neither alter the sha nor this binary.
  # Runs as the plain user: signing needs the user's SSH agent (1Password),
  # which sudo strips. The agent popup is blind (shows key use, not
  # content) -- the binding to content is this code path, plus the rule
  # that an unprompted popup is always denied.
  [ "$EUID" -ne 0 ] || { echo "run sign WITHOUT sudo (it needs your SSH agent)" >&2; exit 1; }
  inv="$(id -un)"
  [ $# -eq 2 ] || usage
  local tag_name="$2"
  case "$tag_name" in
    -*) echo "invalid tag name: $tag_name" >&2; exit 1 ;;
  esac
  resolve_repo "$1"
  sgit check-ref-format "refs/tags/$tag_name" \
    || { echo "invalid tag name: $tag_name" >&2; exit 1; }

  local sha
  sha="$(read_pin "$default_pin_file")" || exit 1
  [ -n "$sha" ] || { echo "no pin for $repo -- bless first" >&2; exit 1; }

  # User git config deliberately in play here: it supplies user.signingkey
  # and gpg.format=ssh. An attacker rewriting those can only produce a
  # signature by the WRONG key, which allowed_signers verification rejects
  # -- fail closed. The absolute git binary and the explicit sha are what
  # matter; `git tag` runs no hooks and builtins can't be alias-shadowed.
  "$GIT" -C "$repo" --no-pager tag -s -m "signed by $inv via pinned" "$tag_name" "$sha"
  echo "signed: $tag_name at $sha (the pinned rev)"
  echo "  consumers verify with bless --tag $tag_name against their allowed_signers"
  log_action sign "$repo" "$sha"
}

# ---- slot ------------------------------------------------------------------

do_slot() {
  # Print the repo's pin-file path, for consumers and root-owned symlinks:
  #   sudo ln -s "$(pinned slot <repo>)" /etc/nix-darwin/pinned-rev
  inv="$(id -un)"
  resolve_repo "$@"
  printf '%s\n' "$default_pin_file"
}

case "$action" in
  bless)  do_bless "$@" ;;
  sign)   do_sign "$@" ;;
  status) do_status "$@" ;;
  slot)   do_slot "$@" ;;
  *)      usage ;;
esac
