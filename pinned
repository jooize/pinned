#!/usr/bin/env bash
# pinned -- review-and-pin a git rev behind a human gate.
#
#   pinned approve <repo> [--trust-current]   review diff since last pin -> approve -> pin
#   pinned approve <repo> --tag <t> [--tag ..] verify signed tag(s) -> approve -> pin
#                                              (repeat --tag = threshold multisig:
#                                              all must agree on one commit)
#   pinned sign <repo> <tag>                  signed release tag at the PINNED hash
#   pinned status <repo>                      pinned hash vs HEAD; dirty-tree warning
#   pinned setup [--yes]                      provision sudoers digest pin; self-install
#
# approve/setup self-elevate via sudo (re-exec of the installed root-owned
# binary); sign runs as the user because it needs the SSH agent.
#
# approve runs root-owned code end to end: it resolves the rev to a hash, shows
# the diff from the OBJECT STORE (scrubbed env, no user git config, no pager,
# no hooks), and writes the approved hash to a root-owned pin file. Deploy
# tooling builds git+file://<repo>?rev=<hash> and nothing else. The hash never
# crosses a trust boundary in human hands.
#
# Signing exports the pin: sign creates a perfectly normal signed release
# tag (git tag -s, nothing pinned-specific in the repo), but the hash it
# signs comes from the root-owned pin file -- you read once at approve;
# nothing is re-read at sign time, so there is nothing to MITM. approve
# --tag verifies such a tag against root-owned allowed signers
# (per-repo <pin file>.signers first, global /etc/pinned/allowed_signers
# as fallback; git's native format) -- that is the
# second-machine bootstrap: clone anywhere, install the signer key once,
# approve the release.
#
# Consumers read the pin from /etc/pinned/<encoded-repo-path>; for a
# friendlier path, point a root-owned symlink at the slot, e.g.
#   ln -s "/etc/pinned/$(pinned slot /path/to/repo)" /etc/nix-darwin/pinned-rev

# Pin PATH to root-owned directories only, before anything runs. This is the
# ONE place trust in command resolution is established: everything below calls
# tools by bare name, and this line is what makes that safe. Keeping it in a
# single auditable place beats scattering absolute paths, which only restate
# the same fact once per call site.
#
# Only the OS's own root-owned directories belong here. A packaging that
# installs pinned alongside its own root-owned toolchain (the nix module does)
# prepends its prefix by rewriting this line at build time -- the package
# manager knows its trusted prefix; this script does not guess at them. NOTE
# what must NEVER be added: ~/.nix-profile, ~/.local/bin, /opt/homebrew/bin and
# friends are user-writable, which is exactly why an inherited PATH cannot be
# trusted even from a session you trust.
export PATH=/usr/bin:/bin:/usr/sbin:/sbin

set -euo pipefail

# Override-friendly defaults (handy for testing).
: "${INSTALL_TARGET:=/usr/local/sbin/pinned}"
: "${PIN_ROOT:=/etc/pinned}"

# Colour only when stdout is a terminal (piping/redirecting stays clean).
if [ -t 1 ]; then
  C_OFF=$'\033[0m' C_B=$'\033[1m' C_DIM=$'\033[2m'
  C_RED=$'\033[31m' C_GRN=$'\033[32m' C_YEL=$'\033[33m' C_CYN=$'\033[36m'
  DIFF_COLOR=always
else
  C_OFF='' C_B='' C_DIM='' C_RED='' C_GRN='' C_YEL='' C_CYN=''
  DIFF_COLOR=never
fi

# What setup would do -- shown BEFORE any sudo prompt, so nobody has to
# authenticate just to read the plan. $1 = the user the sudoers entry names.
setup_plan() {
  cat <<EOF
${C_B}pinned setup will:${C_OFF}

  ${C_B}1.${C_OFF} install this script to ${C_CYN}$INSTALL_TARGET${C_OFF} ${C_DIM}(root:wheel 755)${C_OFF}
  ${C_B}2.${C_OFF} create ${C_CYN}$PIN_ROOT${C_OFF} for root-owned pin files
  ${C_B}3.${C_OFF} write ${C_CYN}/etc/sudoers.d/pinned${C_OFF} granting ${C_B}${1}${C_OFF} sudo for the binary,
     digest-pinned to its sha256 ${C_DIM}(a swapped binary makes sudo refuse)${C_OFF};
     ${C_YEL}no NOPASSWD${C_OFF} -- sudo still authenticates every invocation

If a package manager or configuration-management tool installs pinned
for you, you may prefer declaring the binary and sudoers entry there
instead of running setup: see ${C_CYN}README, "Declarative install"${C_OFF}
${C_DIM}(this repo ships a Nix flake)${C_OFF} -- approve works pre-install,
so setup is not required on such machines.

${C_DIM}The exception: when pinned will gate that configuration's own deploys,
its first install cannot arrive through a deploy it hasn't gated yet --
reading this script once and running setup by hand is the intended
bootstrap in that case.${C_OFF}
EOF
}

usage() {
  cat >&2 <<EOF
usage: pinned <action> [args]

  approve <repo> [--trust-current]
                     (sudo) review diff since last pin, approve, write pin
  approve <repo> --tag <tag> [--tag <tag> ...]
                     (sudo) verify signed tag(s) against root-owned
                     allowed signers (per-repo <pin file>.signers,
                     else global /etc/pinned/allowed_signers); all
                     tags must name the same commit; approve, pin
  sign <repo> <tag>  create signed tag <tag> at the PINNED hash -- no sudo
                     (needs your SSH agent, e.g. 1Password)
  status <repo>      pinned hash vs HEAD; warns on dirty tree
  read <file> [--algo <name>] [--length <bits>]
                     trusted read of a non-repo file: display and hash ONE
                     read, print the hash + a fail-closed wrapper -- no sudo
                     names: sha256 sha384 sha512, blake2b-256/-384/-512,
                     blake3 (--length: blake3 only, default 256); blake2b
                     and blake3 need b2sum / b3sum in the trusted PATH
  list               all pins: hash and repo path
  slot <repo>        print the repo's pin-file path (for consumer symlinks)
  setup [--yes]      (sudo) provision sudoers digest pin; self-install

approval history: log show --predicate 'eventMessage CONTAINS "pinned:"'
EOF
  exit 1
}

[ $# -ge 1 ] || usage
action="$1"
shift

# ---- shared verification (locked-family pattern) ---------------------------
# Defined before the self-elevation block below, which is the first caller.

# stat differs by FLAVOR, not platform convention: BSD stat takes -f FORMAT
# while GNU's -f means file-system (its FORMAT flag is -c). Detect once from
# whichever stat the trusted PATH resolves -- a nix-built install puts GNU
# coreutils first even on macOS, and NixOS has no BSD stat at all. GNU %a
# prints special bits (setuid/sticky) as a fourth digit where BSD %OLp shows
# low bits only; such a path fails the mode allowlist below, i.e. the
# asymmetry fails closed.
#
# -L: judge the object a name REACHES, never a symlink itself. A symlink's
# own owner/group gate nothing -- replacing one takes write on its parent
# dir, which the ancestry walk already checks -- and BSD symlinks inherit
# their parent's group, so an unfollowed stat reports noise (nix-darwin's
# /run/current-system link shows root:daemon purely because /private/var/run
# is group daemon).
if stat --version >/dev/null 2>&1; then
  stat_owner() { stat -Lc '%U:%G' "$1"; }
  stat_mode()  { stat -Lc '%a' "$1"; }
else
  stat_owner() { stat -Lf '%Su:%Sg' "$1"; }
  stat_mode()  { stat -Lf '%OLp' "$1"; }
fi

# Verify a path is root-owned with no group/other write. Refuses to trust
# binaries or pin files reachable through a user-writable ancestor. Group is
# root's own (wheel on macOS/BSD, root on Linux); either way the mode
# allowlist below denies every group-write bit, so group identity carries no
# write authority.
#
# One carved-out exception: macOS's /run resolves to /private/var/run,
# root:daemon 775 -- the OS's own home for the /run/current-system link, so
# a nix-darwin install walks through it. Group daemon COULD swap links
# there, but daemon-gid actors are system services, not code running as the
# user -- outside this tool's threat model (user-level compromise) -- and
# elevation is content-gated by the sudoers sha256 digest regardless of
# which bytes a path reaches: a swapped binary makes sudo refuse.
verify_root_owned_path() {
  local path="$1" owner mode
  owner="$(stat_owner "$path")"
  mode="$(stat_mode "$path")"
  case "$owner" in
    root:wheel|root:root) ;;
    root:daemon)
      case "$mode" in
        775|755|750|700|555|550|500) return 0 ;;
      esac
      echo "ERROR: $path (root:daemon) has mode $mode, expected 775 or stricter" >&2
      return 1 ;;
    *)
      echo "ERROR: $path is owned $owner, expected root:wheel (or root:root)" >&2
      echo "       fix manually: sudo chown root:wheel $path && sudo chmod 755 $path" >&2
      return 1 ;;
  esac
  case "$mode" in
    755|750|700|555|550|500) ;;
    *)
      echo "ERROR: $path has mode $mode, expected 755 or stricter" >&2
      return 1
      ;;
  esac
}

verify_ancestry() {
  # Walk ancestry of a path (itself excluded) up to /, verify each dir.
  local p
  p="$(dirname "$1")"
  while [ "$p" != "/" ]; do
    verify_root_owned_path "$p" || return 1
    p="$(dirname "$p")"
  done
}

log_action() {
  # visible via: log show --predicate 'eventMessage CONTAINS "pinned:"' --last 1d
  logger -t pinned "user=${inv:-$(id -un)} action=$1 repo=${2:-} hash=${3:-} result=${4:-ok}"
}

# ---- scrubbed git ----------------------------------------------------------

# git resolved from the pinned PATH above (root-owned dirs only), so a
# user-writable prefix can never shadow it. Fail loud up front rather than
# confusingly mid-approve. If your trusted git lives outside those dirs, edit
# the PATH line BEFORE bootstrapping: this hand-read file is the configuration
# surface (declarative installs substitute it at build time instead).
command -v git >/dev/null 2>&1 || {
  echo "ERROR: no git in the trusted PATH ($PATH)" >&2
  echo "       install git system-wide; pinned will not use a user-writable one" >&2
  exit 1
}

# Run git against $repo with NOTHING attacker-influencable in play:
# env -i (no GIT_* smuggling), no global/system config, repo-local config
# neutralized where it matters (-c overrides, no pager, no fsmonitor daemon).
# show/diff/rev-parse/log run no hooks; aliases can't shadow builtins.
# Trusted pager for review output: absolute system less, -R passes the
# diff colors through. cat when non-interactive or less is absent. Never
# $PAGER/user config -- the pager sits between reviewed bytes and eyes.
page() {
  if [ -t 1 ] && command -v less >/dev/null 2>&1; then
    less -R
  else
    cat
  fi
}

# Review diff. NEVER call `sgit diff` directly for anything a human reads:
# .gitattributes (attacker-writable, and it works UNTRACKED -- no commit, no
# trace in the reviewed content) can route a path through an external diff
# driver (diff.<n>.command) or a textconv filter (diff.<n>.textconv) defined in
# the repo-local .git/config, which is equally attacker-writable. env -i and
# GIT_CONFIG_{GLOBAL,SYSTEM}=/dev/null do NOT stop this -- the drivers come
# from repo-local config, not global/system config or the environment. A
# textconv that maps both sides to one constant renders as an EMPTY diff:
# "this commit changed nothing", for a commit that changed everything.
# --no-ext-diff --no-textconv is the only thing that closes it.
# Measured 2026-07-27 on git 2.54.0; harness + evidence in the hardening repo:
# proofs/claims/git/git-diff-display-falsifiable-by-repo-drivers.md
# The ONLY way to diff in this script. Always carries the hardening flags, so
# a future edit cannot reintroduce a falsifiable review by writing the obvious
# thing; `sgit diff` itself is refused below.
sgit_diff() {
  _sgit_diff_ok=1 sgit -c color.diff="$DIFF_COLOR" diff --no-ext-diff --no-textconv "$@"
}

sgit() {
  # Structural guard: any diff a human might read must carry --no-ext-diff
  # --no-textconv, so reaching for a rendering subcommand here is a bug, not a
  # style choice. Refuse loudly instead of silently rendering through an
  # attacker's driver. Git offers no config switch that disables textconv
  # globally, so per-command flags are the only mechanism -- which is exactly
  # why it needs a guard rather than a convention. (The subcommand is found by
  # scanning past leading global options, since `-c key=val` precedes it.)
  if [ "${_sgit_diff_ok:-0}" -ne 1 ]; then
    local _args _i=0 _sub="" _a
    _args=("$@")
    while [ "$_i" -lt "${#_args[@]}" ]; do   # find the subcommand
      case "${_args[$_i]}" in
        -c) _i=$((_i + 2)) ;;               # -c takes a value; skip both
        --*) _i=$((_i + 1)) ;;
        *) _sub="${_args[$_i]}"; break ;;
      esac
    done
    case "$_sub" in
      # Every subcommand that can RENDER a diff, not just `diff` -- `show` and
      # `log -p` route through the same attacker-controlled drivers. Refusing
      # the whole class means a future edit reaching for any of them has to
      # add a hardened helper rather than silently reopening the hole.
      diff|show|format-patch|diff-tree|diff-index|diff-files|whatchanged|range-diff)
        echo "pinned: internal error -- '$_sub' can render through repo diff drivers; use sgit_diff" >&2
        exit 1 ;;
      log|reflog|stash)
        # Scan only AFTER the subcommand: a leading global `-c key=val` is not
        # log's combined-diff `-c`.
        _i=$((_i + 1))
        while [ "$_i" -lt "${#_args[@]}" ]; do
          _a="${_args[$_i]}"; _i=$((_i + 1))
          case "$_a" in
            -p|-u|--patch|--cc|-c|--full-diff)
              echo "pinned: internal error -- patch-producing '$_sub' renders through repo diff drivers; use sgit_diff" >&2
              exit 1 ;;
          esac
        done ;;
    esac
  fi
  # safe.directory: running as root on a user-owned repo trips git's
  # ownership check, and env -i strips the SUDO_UID escape hatch git
  # would use. Trust exactly $repo, from the command line (protected
  # config). The check's job -- refusing attacker-planted repo config
  # and hooks -- is already done here by scrubbing and hookless commands.
  # attr.tree=<empty tree>: attributes come from an EMPTY tree instead of the
  # working tree, so no .gitattributes -- committed or untracked -- can select a
  # diff driver, textconv filter, or clean/smudge filter for ANY subcommand.
  # This is the only repo-wide switch that exists (there is no config that
  # disables textconv globally), so it is the primary defense; the per-command
  # --no-ext-diff --no-textconv in sgit_diff and the render guard above are the
  # second and third layers. Silently ignored by git older than ~2.40 -- which
  # is why the other two layers still carry their weight.
  env -i PATH="$PATH" HOME=/var/empty \
    GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null \
    git -C "$repo" --no-pager -c safe.directory="$repo" \
    -c attr.tree=4b825dc642cb6eb9a060e54bf8d69288fbee4904 \
    -c core.fsmonitor=false -c core.pager=cat "$@"
}

# URL-encode % and / so a repo path becomes an unambiguous flat filename.
encode() {
  printf '%s' "$1" | sed -e 's|%|%25|g' -e 's|/|%2F|g'
}

resolve_repo() {
  [ $# -ge 1 ] || usage
  repo="$(readlink -f "$1")"
  [ -n "$repo" ] && [ -d "$repo" ] || { echo "not a directory: ${1}" >&2; exit 1; }
  # Let git's own stderr through -- swallowing it turned a safe.directory
  # refusal into a misleading "not a git work tree".
  sgit rev-parse --is-inside-work-tree >/dev/null \
    || { echo "not a usable git work tree: $repo (git error above)" >&2; exit 1; }
  default_pin_file="$PIN_ROOT/$(encode "$repo")"
}

read_pin() {
  # Echoes pinned hash or nothing. Validates format so a tampered pin file
  # can't smuggle arbitrary text into git argv.
  local f="$1" hash
  [ -f "$f" ] || return 0
  hash="$(head -n1 "$f")"
  case "$hash" in
    *[!0-9a-f]*|'')
      echo "ERROR: pin file $f is corrupt: '$hash'" >&2
      return 1
      ;;
  esac
  # 40 (SHA-1) through 128 (SHA-512) hex chars: covers current git/hg
  # hashes and leaves room for future backends (blake3, post-quantum).
  [ "${#hash}" -ge 40 ] && [ "${#hash}" -le 128 ] \
    || { echo "ERROR: pin file $f has bad hash length" >&2; return 1; }
  printf '%s\n' "$hash"
}

# ---- setup -----------------------------------------------------------------

do_setup() {
  [ "$EUID" -eq 0 ] || { echo "setup must run as root (sudo $0 setup)" >&2; exit 1; }
  inv="${SUDO_USER:-}"
  [ -n "$inv" ] || { echo "setup must be invoked via sudo" >&2; exit 1; }

  local assume_yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes) assume_yes=1; shift ;;
      *)     usage ;;
    esac
  done

  # Interactive confirm for direct-root invocation (sudo ./pinned setup);
  # the unprivileged path already confirmed pre-elevation and passed --yes.
  if [ "$assume_yes" -ne 1 ]; then
    setup_plan "$inv"
    local answer
    printf '%sproceed? [y/N]%s ' "$C_B" "$C_OFF"
    read -r answer </dev/tty
    case "$answer" in
      y|Y|yes) ;;
      *) echo "aborted; nothing installed."; exit 2 ;;
    esac
  fi

  # 1. Self-install; verify every ancestor of INSTALL_TARGET first.
  local self target target_dir
  self="$(readlink -f "$0")"
  target="$INSTALL_TARGET"
  target_dir="$(dirname "$target")"
  install -d -m 755 -o root -g wheel "$target_dir"
  verify_ancestry "$target" || exit 1
  verify_root_owned_path "$target_dir" || exit 1
  if [ "$self" != "$target" ]; then
    install -m 755 -o root -g wheel "$self" "$target"
    echo "installed: $target"
  else
    echo "binary already at $target"
  fi

  # 2. Pin root
  install -d -m 755 -o root -g wheel "$PIN_ROOT"
  echo "pin root: $PIN_ROOT"

  # 3. Sudoers entry with binary-digest pin (validated before installing).
  #    sudo recomputes the binary's SHA-256 at every invocation and refuses
  #    silently on mismatch -- integrity check lives in sudo, not in us.
  local sudoers_target sudoers_line digest tmp
  sudoers_target=/etc/sudoers.d/pinned
  digest="$(shasum -a 256 "$target" | awk '{print $1}')"
  sudoers_line="$inv ALL=(root) sha256:$digest ${target}"
  if [ -f "$sudoers_target" ] && grep -qF "$sudoers_line" "$sudoers_target"; then
    echo "sudoers digest current: $sudoers_target"
  else
    tmp="$(mktemp)"
    printf '%s\n' "$sudoers_line" >"$tmp"
    if visudo -c -f "$tmp" >/dev/null 2>&1; then
      install -m 440 -o root -g wheel "$tmp" "$sudoers_target"
      echo "wrote sudoers entry with digest: $sudoers_target"
      echo "  digest: sha256:$digest"
    else
      echo "sudoers validation failed; not installing" >&2
      rm -f "$tmp"
      exit 1
    fi
    rm -f "$tmp"
  fi

  log_action setup
  echo
  echo "setup complete."
  echo "  next: sudo pinned approve <repo>"
}

if [ "$action" = "setup" ]; then
  do_setup "$@"
  exit 0
fi

# Re-verify INSTALL_TARGET itself and its ancestry on every invocation
# (catches a later "chown -R \$USER /usr/local" undoing the install-path
# guarantees).
if [ -f "$INSTALL_TARGET" ]; then
  verify_root_owned_path "$INSTALL_TARGET" || exit 1
  verify_ancestry "$INSTALL_TARGET" || exit 1
fi

# Root-requiring actions self-elevate: re-exec the INSTALLED (root-owned,
# digest-pinned) binary under sudo so the elevated code is never a copy the
# invoker could have modified. Pre-install (setup from a checkout) falls
# back to this script's own path. Sits after the helper definitions so the
# approve preview below can reuse them.
case "$action" in
  approve|setup)
    if [ "$EUID" -ne 0 ]; then
      # setup: show the plan and confirm BEFORE sudo, so reading what it
      # will do never costs an authentication.
      if [ "$action" = "setup" ]; then
        want_yes=0
        for a in "$@"; do [ "$a" = "--yes" ] && want_yes=1; done
        if [ "$want_yes" -eq 0 ]; then
          setup_plan "$(id -un)"
          printf '%sproceed? [y/N]%s ' "$C_B" "$C_OFF"
          read -r answer </dev/tty
          case "$answer" in
            y|Y|yes) ;;
            *) echo "aborted; nothing installed."; exit 2 ;;
          esac
          set -- --yes "$@"
        fi
      fi
      # approve: an unprivileged PREVIEW of what authenticating will let
      # you review, so the sudo prompt never arrives context-free. This is
      # orientation only -- the authoritative review re-derives everything
      # from the object store as root, after sudo.
      if [ "$action" = "approve" ]; then
        preview_repo="" skip_next=0
        for a in "$@"; do
          if [ "$skip_next" -eq 1 ]; then skip_next=0; continue; fi
          case "$a" in
            --tag) skip_next=1 ;;
            -*) ;;
            *) preview_repo="$a" ;;
          esac
        done
        if [ -n "$preview_repo" ]; then
          resolve_repo "$preview_repo"
          preview_head="$(sgit rev-parse 'HEAD^{commit}')"
          preview_pin="$(read_pin "$default_pin_file")" || preview_pin=""
          # Same short-circuit the privileged side would take -- but here it
          # costs no authentication. The pin is root-owned; HEAD is the
          # repo the caller is looking at.
          if [ -n "$preview_pin" ] && [ "$preview_pin" = "$preview_head" ]; then
            printf '%salready pinned: %s%s\n' "$C_GRN" "$preview_head" "$C_OFF"
            printf '%s(nothing to approve; no authentication needed)%s\n' "$C_DIM" "$C_OFF"
            exit 0
          fi
          printf '%srepo:%s    %s\n' "$C_B" "$C_OFF" "$repo"
          printf '%sHEAD:%s    %s%s%s  %s(%s)%s\n' "$C_B" "$C_OFF" "$C_CYN" "$preview_head" "$C_OFF" \
            "$C_DIM" "$(sgit log -1 --format=%s "$preview_head")" "$C_OFF"
          if [ -n "$preview_pin" ]; then
            printf '%spinned:%s  %s%s%s\n' "$C_B" "$C_OFF" "$C_CYN" "$preview_pin" "$C_OFF"
            if [ "$preview_pin" != "$preview_head" ]; then
              echo
              printf '%scommits since last approval:%s\n' "$C_B" "$C_OFF"
              sgit log --format='  %h %s' "${preview_pin}..${preview_head}" || true
            fi
          else
            printf '%spinned:%s  (none -- first approval)\n' "$C_B" "$C_OFF"
          fi
          echo
        fi
      fi
      elev="$INSTALL_TARGET"
      if [ -x "$elev" ]; then
        # Refuse to hand sudo a target that is not root-owned end to end.
        # Not hypothetical: old Homebrew left /usr/local user-owned on
        # many Intel Macs, which would make the "installed" copy exactly
        # as swappable as the checkout.
        verify_root_owned_path "$elev" || exit 1
        verify_ancestry "$elev" || exit 1
      else
        # Pre-install fallback: the checkout copy is USER-WRITABLE, so
        # running it as root is only safe in the bootstrap window right
        # after a hand-read. Never silent: warn and confirm. (setup is
        # exempt -- installing the just-read checkout is its whole job.)
        elev="$(readlink -f "$0")"
        if [ "$action" != "setup" ]; then
          printf '%swarning: pinned is not installed at %s.%s\n' "$C_YEL$C_B" "$INSTALL_TARGET" "$C_OFF"
          printf '%s  About to run the UNINSTALLED, user-writable copy at%s\n' "$C_YEL" "$C_OFF"
          printf '%s  %s as root.%s\n' "$C_YEL" "$elev" "$C_OFF"
          printf '%s  Only proceed if you have just read this exact file and%s\n' "$C_YEL" "$C_OFF"
          printf '%s  trust your user-space not to have swapped it since.%s\n' "$C_YEL" "$C_OFF"
          printf '%s  Safer: stage with trusted tooling, read the root-owned copy,%s\n' "$C_YEL" "$C_OFF"
          printf '%s  promote it, rerun (README: "Bootstrap without executing%s\n' "$C_YEL" "$C_OFF"
          printf '%s  unverified code"):%s\n' "$C_YEL" "$C_OFF"
          printf '    sudo /usr/bin/install -d -o root -g wheel -m 755 %s\n' "$(dirname "$INSTALL_TARGET")"
          printf '    sudo /usr/bin/install -o root -g wheel -m 444 \\\n'
          printf '      %s %s-unverified\n' "$elev" "$INSTALL_TARGET"
          printf '    less %s-unverified\n' "$INSTALL_TARGET"
          printf '    sudo mv %s-unverified %s\n' "$INSTALL_TARGET" "$INSTALL_TARGET"
          printf '    sudo chmod 755 %s\n' "$INSTALL_TARGET"
          printf '%scontinue? [y/N]%s ' "$C_B" "$C_OFF"
          read -r answer </dev/tty
          case "$answer" in
            y|Y|yes) ;;
            *) echo "aborted." ; exit 2 ;;
          esac
        fi
      fi
      # Say what the authentication buys BEFORE sudo asks for it.
      if [ "$action" = "approve" ] && [ "$elev" = "$INSTALL_TARGET" ]; then
        printf '%sself-elevating:%s sudo runs the installed root-owned binary %s%s%s\n' \
          "$C_B" "$C_OFF" "$C_CYN" "$elev" "$C_OFF"
        printf 'It shows the authoritative review (from the object store, as\n'
        printf 'root); the preview above is orientation only. Nothing is pinned\n'
        printf 'until you answer y after that review. If your sudo prompt shows\n'
        printf 'the command being authorized, verify it names exactly that binary.\n'
      fi
      exec sudo -- "$elev" "$action" "$@"
    fi
    ;;
esac

# ---- approve -----------------------------------------------------------------

do_approve() {
  [ "$EUID" -eq 0 ] || { echo "approve must run as root (sudo pinned approve <repo>)" >&2; exit 1; }
  inv="${SUDO_USER:-}"
  [ -n "$inv" ] || { echo "approve must be invoked via sudo" >&2; exit 1; }

  # --tag may repeat: threshold multisig. Every named tag must verify
  # against the allowed signers AND name the same commit, or nothing is
  # pinned. k-of-n is the caller demanding whichever k tags they trust.
  local trust_current=0 repo_arg="" tag_args
  tag_args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --tag)           tag_args+=("$2"); shift 2 ;;
      --trust-current) trust_current=1; shift ;;
      -*)              usage ;;
      *)               repo_arg="$1"; shift ;;
    esac
  done
  [ -n "$repo_arg" ] || usage
  resolve_repo "$repo_arg"
  local pin_file="$default_pin_file"

  # Create the pin root BEFORE the ancestry check -- approve must work on
  # machines that never ran setup (declarative installs); install -d also
  # re-asserts root:wheel 755 on an existing dir.
  install -d -m 755 -o root -g wheel "$PIN_ROOT"

  # The pin file must live under a root-owned ancestry or the machine gate
  # is only as strong as the weakest writable dir on the way there.
  verify_ancestry "$pin_file" || exit 1

  local hash old_hash diff_out
  old_hash="$(read_pin "$pin_file")" || exit 1

  if [ "${#tag_args[@]}" -gt 0 ]; then
    # Signature gate: verify normally-signed release tags (git tag -s;
    # nothing pinned-specific in the repo) against ROOT-OWNED allowed
    # signers, then pin the commit they name. This is the second-machine
    # bootstrap: clone anywhere, install the signer key once, approve the tag.
    local t
    for t in "${tag_args[@]}"; do
      case "$t" in
        -*) echo "invalid tag name: $t" >&2; exit 1 ;;
      esac
    done
    # Per-repo signers take precedence; the global file is the fallback.
    # A key trusted to vouch for one repo shouldn't implicitly vouch for
    # every repo on the machine; keep machine-wide keys in the global
    # file deliberately.
    local signers="${pin_file}.signers"
    [ -f "$signers" ] || signers="$PIN_ROOT/allowed_signers"
    if [ ! -f "$signers" ]; then
      echo "ERROR: no allowed signers for this repo" >&2
      echo "  install the signer's public key (git allowed-signers format) root-owned:" >&2
      echo "    per-repo: sudo install -m 644 -o root -g wheel <file> ${pin_file}.signers" >&2
      echo "    global:   sudo install -m 644 -o root -g wheel <file> $PIN_ROOT/allowed_signers" >&2
      echo "  obtain the key OUT OF BAND (printed card, password manager," >&2
      echo "  existing trusted machine) -- never from this repo." >&2
      exit 1
    fi
    verify_root_owned_path "$PIN_ROOT" || exit 1
    case "$(stat_owner "$signers")" in root:wheel|root:root) ;; *)
      echo "ERROR: $signers is not root-owned (root:wheel / root:root)" >&2
      exit 1 ;;
    esac
    # Every tag must verify AND name the same commit -- all-or-nothing;
    # a single failure leaves the pin unchanged.
    local t_hash
    hash=""
    for t in "${tag_args[@]}"; do
      if ! sgit -c gpg.ssh.allowedSignersFile="$signers" verify-tag "$t"; then
        printf '%sERROR: signature verification FAILED for tag %s; pin unchanged%s\n' "$C_RED$C_B" "$t" "$C_OFF" >&2
        log_action approve "$repo" "$t" verify-failed
        exit 1
      fi
      t_hash="$(sgit rev-parse "refs/tags/${t}"'^{commit}')"
      if [ -z "$hash" ]; then
        hash="$t_hash"
      elif [ "$hash" != "$t_hash" ]; then
        printf '%sERROR: tags disagree: %s is at %s, expected %s; pin unchanged%s\n' \
          "$C_RED$C_B" "$t" "$t_hash" "$hash" "$C_OFF" >&2
        log_action approve "$repo" "$t" tags-disagree
        exit 1
      fi
    done
    if [ -n "$old_hash" ] && [ "$old_hash" = "$hash" ]; then
      printf '%salready pinned: %s%s\n' "$C_GRN" "$hash" "$C_OFF"
      exit 0
    fi
    printf '%srepo:%s    %s\n' "$C_DIM" "$C_OFF" "$repo"
    for t in "${tag_args[@]}"; do
      printf '%stag:%s     %s  %s✓ signature verified against %s%s\n' "$C_DIM" "$C_OFF" "$t" "$C_GRN" "$signers" "$C_OFF"
    done
    [ "${#tag_args[@]}" -gt 1 ] \
      && printf '%s%d/%d tags agree on the commit below%s\n' "$C_GRN" "${#tag_args[@]}" "${#tag_args[@]}" "$C_OFF"
    printf '%scommit:%s  %s%s%s  %s(%s)%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$hash" "$C_OFF" \
      "$C_DIM" "$(sgit log -1 --format=%s "$hash")" "$C_OFF"
    [ -n "$old_hash" ] && printf '%spinned:%s  %s%s%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$old_hash" "$C_OFF"
  else
    # Human gate: read the diff since the last pin from the object store.
    hash="$(sgit rev-parse 'HEAD^{commit}')"

    if ! sgit_diff --quiet 2>/dev/null || ! sgit_diff --cached --quiet 2>/dev/null; then
      echo "note: work tree is dirty; only COMMITTED content at $hash is being approved" >&2
    fi

    if [ -n "$old_hash" ] && [ "$old_hash" = "$hash" ]; then
      printf '%salready pinned: %s%s\n' "$C_GRN" "$hash" "$C_OFF"
      exit 0
    fi

    printf '%srepo:%s    %s\n' "$C_DIM" "$C_OFF" "$repo"
    printf '%sHEAD:%s    %s%s%s  %s(%s)%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$hash" "$C_OFF" \
      "$C_DIM" "$(sgit log -1 --format=%s "$hash")" "$C_OFF"
    if [ -n "$old_hash" ]; then
      printf '%spinned:%s  %s%s%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$old_hash" "$C_OFF"
      echo
      printf '%s--- commits since last approval ---%s\n' "$C_B" "$C_OFF"
      sgit log --format='%h %s' "${old_hash}..${hash}" || true
      echo
      printf '%s--- diff %.10s..%.10s (from object store) ---%s\n' "$C_B" "$old_hash" "$hash" "$C_OFF"
      # Capture first so a git failure aborts (set -e) BEFORE anything is
      # shown as reviewable; then page. Early pager quit (SIGPIPE) is the
      # reviewer's own act -- the diff itself already succeeded.
      diff_out="$(sgit_diff "$old_hash" "$hash")"
      printf '%s\n' "$diff_out" | page || true
    elif [ "$trust_current" -eq 1 ]; then
      printf '%spinned:%s  (none)\n' "$C_DIM" "$C_OFF"
      echo
      printf '%s!!! FIRST APPROVAL WITH --trust-current !!!%s\n' "$C_RED$C_B" "$C_OFF"
      printf '%s!!! The full tree at %s is being approved WITHOUT review. !!!%s\n' "$C_RED$C_B" "$hash" "$C_OFF"
      printf '%s!!! Everything already in this repo becomes trusted as-is. !!!%s\n' "$C_RED$C_B" "$C_OFF"
    else
      printf '%spinned:%s  (none -- first approval: full tree review)\n' "$C_DIM" "$C_OFF"
      echo
      printf '%s--- full tree at %.10s (diff from empty) ---%s\n' "$C_B" "$hash" "$C_OFF"
      # 4b825d... is git's well-known empty tree; this shows every approved byte.
      diff_out="$(sgit_diff 4b825dc642cb6eb9a060e54bf8d69288fbee4904 "$hash")"
      printf '%s\n' "$diff_out" | page || true
    fi
  fi
  echo

  local answer
  printf '%sapprove %s%s%s? [y/N]%s ' "$C_B" "$C_CYN" "$hash" "$C_OFF$C_B" "$C_OFF"
  read -r answer </dev/tty
  case "$answer" in
    y|Y|yes) ;;
    *)
      printf '%saborted; pin unchanged.%s\n' "$C_YEL" "$C_OFF"
      log_action approve "$repo" "$hash" abort
      exit 2
      ;;
  esac

  # Atomic pin write: stage in the (root-owned) pin dir, single rename.
  local tmp
  tmp="$(mktemp "$PIN_ROOT/.pin.XXXXXX")"
  printf '%s\n' "$hash" >"$tmp"
  chown root:wheel "$tmp"
  chmod 644 "$tmp"
  mv -f "$tmp" "$pin_file"
  printf '%s✓ pinned:%s %s%s%s -> %s\n' "$C_GRN$C_B" "$C_OFF" "$C_CYN" "$hash" "$C_OFF" "$pin_file"
  log_action approve "$repo" "$hash"
}

# ---- status ----------------------------------------------------------------

do_status() {
  inv="$(id -un)"
  resolve_repo "$@"
  local pin_file="$default_pin_file" hash head_hash
  hash="$(read_pin "$pin_file")" || exit 1
  head_hash="$(sgit rev-parse 'HEAD^{commit}')"

  printf '%srepo:%s    %s\n' "$C_DIM" "$C_OFF" "$repo"
  printf '%spin:%s     %s\n' "$C_DIM" "$C_OFF" "$pin_file"
  if [ -z "$hash" ]; then
    printf '%spinned:%s  (none)\n' "$C_DIM" "$C_OFF"
  else
    printf '%spinned:%s  %s%s%s  %s(%s)%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$hash" "$C_OFF" \
      "$C_DIM" "$(sgit log -1 --format=%s "$hash" 2>/dev/null || echo 'commit not in repo!')" "$C_OFF"
  fi
  printf '%sHEAD:%s    %s%s%s  %s(%s)%s\n' "$C_DIM" "$C_OFF" "$C_CYN" "$head_hash" "$C_OFF" \
    "$C_DIM" "$(sgit log -1 --format=%s "$head_hash")" "$C_OFF"
  if [ -n "$hash" ] && [ "$hash" = "$head_hash" ]; then
    printf '%sstate:%s   %s✓ HEAD is approved%s\n' "$C_DIM" "$C_OFF" "$C_GRN" "$C_OFF"
  elif [ -n "$hash" ]; then
    printf '%sstate:%s   %s✗ HEAD is NOT approved (%s commits ahead of pin)%s\n' "$C_DIM" "$C_OFF" \
      "$C_RED" "$(sgit rev-list --count "${hash}..${head_hash}" 2>/dev/null || echo '?')" "$C_OFF"
  else
    printf '%sstate:%s   %s✗ never approved%s\n' "$C_DIM" "$C_OFF" "$C_RED" "$C_OFF"
  fi
  if ! sgit_diff --quiet 2>/dev/null || ! sgit_diff --cached --quiet 2>/dev/null; then
    printf '%swarning: work tree is dirty (uncommitted changes are never approved)%s\n' "$C_YEL" "$C_OFF"
  fi
}

# ---- sign ------------------------------------------------------------------

do_sign() {
  # Export the pin as a normal signed release tag -- NO re-read anywhere in
  # the path. The hash comes from the root-owned pin file and is passed to
  # git explicitly, so "what gets signed" is exactly "what was approved";
  # a compromised environment can neither alter the hash nor this binary.
  # Runs as the plain user: signing needs the user's SSH agent (1Password),
  # which sudo strips. The agent popup is blind (shows key use, not
  # content) -- the binding to content is this code path, plus the rule
  # that an unprompted popup is always denied.
  [ "$EUID" -ne 0 ] || { echo "run sign WITHOUT sudo (it needs your SSH agent)" >&2; exit 1; }
  inv="$(id -un)"
  [ $# -eq 2 ] || usage
  local tag_name="$2"
  case "$tag_name" in
    -*) echo "invalid tag name: $tag_name" >&2; exit 1 ;;
  esac
  resolve_repo "$1"
  sgit check-ref-format "refs/tags/$tag_name" \
    || { echo "invalid tag name: $tag_name" >&2; exit 1; }

  local hash
  hash="$(read_pin "$default_pin_file")" || exit 1
  [ -n "$hash" ] || { echo "no pin for $repo -- approve first" >&2; exit 1; }

  # An existing tag may be signed IF it already points at the pinned rev
  # (e.g. an unsigned release tag being promoted). Pointing anywhere else
  # is refused: sign never moves what a tag means. Note -f replaces any
  # previous signature on the tag; co-signers use distinct tag names.
  local force=""
  if sgit rev-parse -q --verify "refs/tags/${tag_name}" >/dev/null 2>&1; then
    local existing
    existing="$(sgit rev-parse "refs/tags/${tag_name}"'^{commit}')"
    if [ "$existing" != "$hash" ]; then
      echo "ERROR: tag $tag_name exists at $existing, not the pinned $hash" >&2
      echo "       refusing to move it -- pick another name, or approve that rev first" >&2
      exit 1
    fi
    echo "note: $tag_name already points at the pinned rev; re-signing in place"
    force="-f"
  fi

  # User git config deliberately in play here: it supplies user.signingkey
  # and gpg.format=ssh. An attacker rewriting those can only produce a
  # signature by the WRONG key, which allowed_signers verification rejects
  # -- fail closed. The absolute git binary and the explicit hash are what
  # matter; `git tag` runs no hooks and builtins can't be alias-shadowed.
  if [ -n "$force" ]; then
    git -C "" --no-pager tag -s -f -m "signed by $inv via pinned" "$tag_name" "$hash"
  else
    git -C "" --no-pager tag -s -m "signed by $inv via pinned" "$tag_name" "$hash"
  fi
  printf '%s✓ signed:%s %s at %s%s%s (the pinned hash)\n' "$C_GRN$C_B" "$C_OFF" "$tag_name" "$C_CYN" "$hash" "$C_OFF"
  printf '%s  consumers verify with approve --tag %s against their allowed_signers%s\n' "$C_DIM" "$tag_name" "$C_OFF"
  log_action sign "$repo" "$hash"
}

# ---- list ------------------------------------------------------------------

do_list() {
  # All pins, one per line: short hash + decoded repo path. Unprivileged
  # (pin files are world-readable). Decode order reverses encode's:
  # %2F -> / first, then %25 -> %.
  inv="$(id -un)"
  [ -d "$PIN_ROOT" ] || { echo "no pin root ($PIN_ROOT) -- run setup first" >&2; exit 1; }
  local f name path hash found=0
  for f in "$PIN_ROOT"/%2F*; do
    [ -e "$f" ] || continue
    found=1
    name="$(basename "$f")"
    path="$(printf '%s' "$name" | sed -e 's|%2F|/|g' -e 's|%25|%|g')"
    if hash="$(read_pin "$f")"; then
      printf '%s%s%s  %s\n' "$C_CYN" "$hash" "$C_OFF" "$path"
    else
      printf '%sCORRUPT%s  %s\n' "$C_RED$C_B" "$C_OFF" "$path"
    fi
  done
  [ "$found" -eq 1 ] || echo "(no pins)"
}

# ---- read ------------------------------------------------------------------

# Trusted read of a file OUTSIDE any repo, for hash-gated consumers (e.g. a
# hook wired in a content-gated settings file: the wrapper reads once, hashes
# what it read, and executes only on match).
#
# The security-relevant act is the READ, not the hash. Hashing is trivial;
# what earns trust is that the bytes shown to you and the bytes hashed are the
# SAME single read -- never two reads of a file an attacker can swap between
# them. So: one read into memory, display those bytes, hash those bytes.
#
# Runs unprivileged (nothing to elevate -- it writes nothing). Root ownership
# of this binary is what protects the ceremony itself: a user-writable review
# script could show you innocent bytes and hash malicious ones, and unlike a
# falsified display that lie would SURVIVE (you would paste a hash that
# genuinely matches the malicious file). A lying display fails closed; a lying
# ceremony fails open. That asymmetry is why this lives here.
do_read() {
  local algo=sha256 file="" a length=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --algo|-a)
        [ $# -ge 2 ] || { echo "--algo needs a value" >&2; exit 1; }
        algo="$2"; shift 2 ;;
      --length|-l)
        [ $# -ge 2 ] || { echo "--length needs a value (bits)" >&2; exit 1; }
        length="$2"; shift 2 ;;
      --) shift; break ;;
      -*) echo "unknown option: $1" >&2; usage ;;
      *)  [ -z "$file" ] || { echo "read takes one file" >&2; usage; }
          file="$1"; shift ;;
    esac
  done
  [ -n "$file" ] || [ $# -eq 0 ] || { file="$1"; shift; }
  [ -n "$file" ] || usage

  # Only algorithms whose collision resistance still carries a trust decision.
  # The floor is 256 bits of OUTPUT (~128-bit collision resistance), applied by
  # output length rather than by family -- so sha512/256 is in and sha512/224 is
  # out, exactly like sha224, despite both being SHA-512 underneath. sha1/md5
  # are refused outright: this hash IS the gate, and a chosen-prefix collision
  # would let the bytes you reviewed and the bytes that execute differ.
  #
  # Post-quantum: nothing to do here. Grover only square-roots preimage search
  # and quantum collision search does not beat classical in practice, so a
  # 256-bit hash stays adequate; PQ pressure is on SIGNATURES, not digests.
  # 384/512 are available if you want margin anyway.
  #
  # Adding another function (blake2/blake3 below are the template) means one
  # case arm here plus one hash_cmd branch below. The constraint is not the
  # algorithm, it is the BINARY: whatever computes the digest decides whether
  # the gate passes, so it must resolve inside the trusted PATH pinned at the
  # top of this file. That is also why there is no --hasher flag taking a
  # path -- it would let the caller nominate an attacker-writable verifier.
  #
  # Values are each algorithm's standard name, one rule across families.
  # BLAKE2 kept per-length names (RFC 7693 era), so those carry a suffix;
  # BLAKE3 is one function whose standard digest is 256-bit, longer output
  # being the same function as an XOF -- that is what --length is for, and
  # why blake3 takes no suffix. sha512/256 and unsuffixed blake2b (= -512,
  # its standard default) are accepted, not advertised. $algo normalizes to
  # what the hasher's -a/-l flag wants.
  local algo_name
  case "$algo" in
    sha256)              algo_name="sha"; algo=256 ;;
    sha384)              algo_name="sha"; algo=384 ;;
    sha512)              algo_name="sha"; algo=512 ;;
    sha512/256)          algo_name="sha"; algo=512256 ;;
    blake2b-256)         algo_name="blake2"; algo=256 ;;
    blake2b-384)         algo_name="blake2"; algo=384 ;;
    blake2b-512|blake2b) algo_name="blake2"; algo=512 ;;
    blake3)              algo_name="blake3" ;;
    md5|sha1|MD5|SHA1)
      echo "refusing $algo: collision-vulnerable, and this hash is the gate" >&2
      exit 1 ;;
    sha224|sha512/224|blake2b-224)
      echo "refusing $algo: 224-bit output is below the 256-bit floor for a trust decision" >&2
      exit 1 ;;
    blake2s|blake2s-*)
      echo "unsupported: b2sum computes BLAKE2b only; blake2b-256 gives the same 256-bit output" >&2
      exit 1 ;;
    *)
      echo "unsupported algorithm: $algo (use sha256, sha384, sha512, blake2b-256/384/512, blake3)" >&2
      exit 1 ;;
  esac

  # --length: blake3 only -- the XOF's output size, in BITS like every length
  # in the algorithm names. Everything else carries its length in the name.
  if [ -n "$length" ]; then
    [ "$algo_name" = blake3 ] || {
      echo "--length applies only to blake3 (other algorithms carry their length in the name)" >&2
      exit 1
    }
    case "$length" in
      ''|*[!0-9]*) echo "--length must be a whole number of bits" >&2; exit 1 ;;
    esac
    [ $((length % 8)) -eq 0 ] || { echo "--length must be a multiple of 8 bits" >&2; exit 1; }
    [ "$length" -ge 256 ] || {
      echo "refusing --length $length: below the 256-bit floor for a trust decision" >&2
      exit 1
    }
  else
    length=256
  fi

  # Resolve the hashing command; fail closed and say what to install. The
  # usage text lists every algorithm regardless of what this machine has:
  # help describes the interface and must not vary by host -- availability
  # is this check's job.
  case "$algo_name" in
    blake3)
      command -v b3sum >/dev/null 2>&1 || {
        echo "blake3 requested but b3sum is not in the trusted PATH ($PATH)" >&2
        echo "       install b3sum system-wide (a user-writable one would defeat the gate)" >&2
        exit 1
      } ;;
    blake2)
      command -v b2sum >/dev/null 2>&1 || {
        echo "blake2b requested but b2sum is not in the trusted PATH ($PATH)" >&2
        echo "       install GNU coreutils system-wide (a user-writable b2sum would defeat the gate)" >&2
        exit 1
      } ;;
  esac

  [ -f "$file" ] || { echo "not a regular file: $file" >&2; exit 1; }

  # NUL bytes cannot survive a shell variable, so the consumer wrapper could
  # never execute the file's literal bytes. Refuse rather than hash something
  # that differs from what any wrapper would run.
  if [ "$(LC_ALL=C tr -d '\000' <"$file" | wc -c)" -ne "$(wc -c <"$file")" ]; then
    echo "refusing: file contains NUL bytes (not shell-executable text)" >&2
    exit 1
  fi

  # THE single read. Everything below is derived from $content, never from a
  # second look at the file. The `; printf x` + `%x` idiom preserves trailing
  # newlines, which plain $(cat) strips -- so $content is the file's bytes
  # EXACTLY, and the digest below equals `shasum -a <algo> <file>`. Matching
  # the ordinary check matters: you can verify this tool with any other tool.
  local content hash
  content="$(cat -- "$file"; printf x)" || { echo "cannot read: $file" >&2; exit 1; }
  content="${content%x}"

  printf '%s--- %s (exactly the bytes being hashed) ---%s\n' "$C_B" "$file" "$C_OFF"
  printf '%s' "$content" | page || true

  # Digest and the command that recomputes it, kept in lockstep: $hash_cmd is
  # emitted into the wrapper verbatim, so the two sides cannot drift.
  local hash hash_cmd label
  if [ "$algo_name" = blake3 ]; then
    hash_cmd="b3sum --no-names --length $((length / 8))"   # b3sum takes bytes
    if [ "$length" -eq 256 ]; then
      label="blake3"
    else
      label="blake3 (${length}-bit)"   # descriptive; there is no blake3-N name
    fi
  elif [ "$algo_name" = blake2 ]; then
    hash_cmd="b2sum -l $algo"
    label="blake2b-$algo"
  else
    hash_cmd="shasum -a $algo"
    case "$algo" in
      512256) label="sha512/256" ;;   # canonical name; -a takes the digit form
      *)      label="sha${algo}" ;;
    esac
  fi

  hash="$(printf '%s' "$content" | $hash_cmd)" || { echo "hashing failed" >&2; exit 1; }
  hash="${hash%% *}"
  [ -n "$hash" ] || { echo "hashing failed" >&2; exit 1; }

  echo
  printf '%s%s:%s %s%s%s\n' "$C_B" "$label" "$C_OFF" "$C_CYN" "$hash" "$C_OFF"
  echo
  # Emit the consumer snippet, not just the hash: the wrapper must read and
  # hash exactly as this did, or the two sides drift and every launch refuses.
  # It opens by pinning PATH for the same reason this script does -- a hook
  # inherits the session's PATH, which legitimately contains user-writable
  # prefixes (~/.nix-profile, ~/.local/bin, /opt/homebrew/bin), so bare names
  # would otherwise resolve through directories an attacker can write. One
  # pinned PATH, then bare tools, exactly as above.
  printf '%sfail-closed wrapper (paste into the hash-gated settings file):%s\n' "$C_DIM" "$C_OFF"
  cat <<EOF
export PATH=$PATH; c=\$(cat $file; printf x); c=\${c%x}; h=\$(printf '%s' "\$c" | $hash_cmd); [ "\${h%% *}" = "$hash" ] && exec bash -c "\$c" || { echo 'hook hash mismatch -- refusing' >&2; exit 2; }
EOF
  log_action read "$file" "$hash"
}

# ---- slot ------------------------------------------------------------------

do_slot() {
  # Print the repo's pin-file path, for consumers and root-owned symlinks:
  #   sudo ln -s "$(pinned slot <repo>)" /etc/nix-darwin/pinned-rev
  inv="$(id -un)"
  resolve_repo "$@"
  printf '%s\n' "$default_pin_file"
}

case "$action" in
  approve) do_approve "$@" ;;
  sign)    do_sign "$@" ;;
  status)  do_status "$@" ;;
  list)    do_list ;;
  slot)    do_slot "$@" ;;
  read)    do_read "$@" ;;
  *)       usage ;;
esac
